     RowBox[{"Transpose", "[", "Bejer3", "]"}]}]}], ",", " ", 
   "\"\<Es antisim\[EAcute]trica\>\"", ",", " ", 
   "\"\<No es antisim\[EAcute]trica\>\""}], 
  "]"}], "\n", "\"\<Matriz C\>\"", "\n", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"Cejer3", "==", 
    RowBox[{"Transpose", "[", "Cejer3", "]"}]}], ",", " ", 
