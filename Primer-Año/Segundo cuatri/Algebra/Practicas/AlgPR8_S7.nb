Cell[BoxData[{
 RowBox[{
  RowBox[{"Aejer3", "=", 
   RowBox[{"(", GridBox[{
      {"1", "2", "3"},
      {"2", "2", "5"},
      {"3", "5", "7"}
     }], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Bejer3", "=", 
   RowBox[{"(", GridBox[{
      {"1", "2", "4"},
      {"2", "2", "5"},
      {"3", "5", "7"}
     }], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Cejer3", "=", 
   RowBox[{"(", GridBox[{
      {"0", "2", "3"},
      {
       RowBox[{"-", "2"}], "0", "5"},
      {
       RowBox[{"-", "3"}], 
       RowBox[{"-", "5"}], "0"}
     }], ")"}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.9518830404665947`*^9, 3.951883136574127*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"d190f917-9614-b043-9585-fa3c0afd3e8b"],

Cell[CellGroupData[{

Cell[BoxData[{"\"\<Matriz A\>\"", "\n", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"Aejer3", "==", 
    RowBox[{"Transpose", "[", "Aejer3", "]"}]}], ",", " ", 
   "\"\<Es sim\[EAcute]trica\>\"", ",", " ", 
   "\"\<No es sim\[EAcute]trica\>\""}], "]"}], "\n", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"Aejer3", "==", 
    RowBox[{"-", 
     RowBox[{"Transpose", "[", "Aejer3", "]"}]}]}], ",", " ", 
   "\"\<Es antisim\[EAcute]trica\>\"", ",", " ", 
   "\"\<No es antisim\[EAcute]trica\>\""}], 
  "]"}], "\n", "\"\<Matriz B\>\"", "\n", 
