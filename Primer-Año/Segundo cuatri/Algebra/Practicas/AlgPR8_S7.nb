Cell[CellGroupData[{

Cell["C\[OAcute]digos", "Subsection",
 CellChangeTimes->{{3.95188079148316*^9, 
  3.9518808010376873`*^9}},ExpressionUUID->"ddc680c1-adc3-bc48-9117-\
95fc1639e040"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Rabgo", "*)"}], "\n", 
  RowBox[{
   RowBox[{"rango", "[", "A_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", "m", ",", "s", ",", "k"}], "}"}], ",", 
     "\[IndentingNewLine]", "\t\t", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{
        RowBox[{"Dimensions", "[", "A", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", "\t\t", 
      RowBox[{"m", "=", 
       RowBox[{
        RowBox[{"Dimensions", "[", "A", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", "\t\t", 
      RowBox[{"k", "=", 
       RowBox[{"Min", "[", 
        RowBox[{"n", ",", "m"}], "]"}]}], ";", "\[IndentingNewLine]", "\t\t", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"n", "\[Equal]", "m"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Det", "[", "A", "]"}], "\[NotEqual]", "0"}]}], ",", " ", 
        "\[IndentingNewLine]", "                             ", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<El rango de esta matriz es \>\"", ",", " ", "k"}], 
         "]"}], ",", "\[IndentingNewLine]", "                              ", 
        RowBox[{"For", "[", 
         RowBox[{
          RowBox[{"i", "=", "k"}], ",", " ", 
          RowBox[{"i", "\[GreaterEqual]", "1"}], ",", 
          RowBox[{"i", "--"}], ",", 
          RowBox[{
           RowBox[{"s", "=", 
            RowBox[{"Minors", "[", 
             RowBox[{"A", ",", "i"}], "]"}]}], ";", "         ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"s", "\[NotEqual]", 
              RowBox[{"Table", "[", 
               RowBox[{"0", ",", 
                RowBox[{"{", 
                 RowBox[{"j1", ",", 
                  RowBox[{
                   RowBox[{"Dimensions", "[", "s", "]"}], "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"j2", ",", 
                  RowBox[{
                   RowBox[{"Dimensions", "[", "s", "]"}], "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"Print", "[", "i", "]"}], ";", 
              RowBox[{"Break", "[", "]"}]}]}], " ", "]"}]}]}], "]"}]}], 
       "\[IndentingNewLine]", "]"}]}]}], "]"}]}]}]], "Code",
 CellChangeTimes->{{3.9518808091644154`*^9, 3.9518808101095257`*^9}, {
  3.9518815297677784`*^9, 3.9518815342706375`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"ae81c5fc-305e-2045-8fdc-c2efb3da3252"]
}, Open  ]],

