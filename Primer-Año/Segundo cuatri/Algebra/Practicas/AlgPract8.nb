                 RowBox[{"i", "<", "m"}], ",", 
                 RowBox[{
                  RowBox[{"i", "++"}], ";"}], ",", 
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"j", "<", "m"}], ",", 
                    RowBox[{
                    RowBox[{"i", "=", "t"}], ";", 
                    RowBox[{"j", "++"}], ";", 
                    RowBox[{"col", "++"}], ";"}], ",", 
                    RowBox[{
                    RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";"}]}], 
                "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"pivote", "=", 
             RowBox[{"A", "[", 
