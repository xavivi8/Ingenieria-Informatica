            RowBox[{"i", "=", "t"}], ";", "\[IndentingNewLine]", 
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"A", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}], "==", "0"}], ",", 
              RowBox[{
               RowBox[{"If", "[", 
