        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"t", "<", "m"}], "&&", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"t", "+", "col"}], ")"}], "\[LessEqual]", "n"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"opciones", "\[Equal]", "1"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{
                "\"\<  Buscamos el pivote \>\"", ",", "t", ",", 
                 "\"\<\.ba:\>\""}], "]"}], ";"}]}], 
             RowBox[{"(*", 
              RowBox[{"Buscamos", " ", "siguiente", " ", "pivote"}], "*)"}], 
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"j", "=", 
