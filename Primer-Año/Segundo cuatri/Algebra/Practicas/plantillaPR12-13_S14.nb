Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Coordenadas", "[", 
      RowBox[{"X_", ",", "B_"}], "]"}], ":=", 
     RowBox[{"LinearSolve", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", "B", "]"}], ",", "X"}], "]"}]}], ";"}], "\n",
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ExpMatricial", "[", 
      RowBox[{"f_", ",", "B1_", ",", "B2_"}], "]"}], ":=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Coordenadas", "[", 
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"B1", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", "B2"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "B1", "]"}]}], "}"}]}], "]"}], "]"}]}], 
    ";"}], "\n", "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"CambioBase", "[", 
      RowBox[{"B1_", ",", "B2_"}], "]"}], ":=", 
     RowBox[{"ExpMatricial", "[", 
      RowBox[{"Identity", ",", "B1", ",", "B2"}], "]"}]}], ";"}], 
   "\n"}]}]], "Code",
 CellChangeTimes->{{3.9561081024704227`*^9, 3.956108106196316*^9}, 
   3.95611004367828*^9, {3.956110627187933*^9, 3.956110657621355*^9}, {
