Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Param\[EAcute]tricas", "[", "Base_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Parte1", ",", "param\[EAcute]tricas"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Clear", "[", "\[Lambda]", "]"}], ";", 
      RowBox[{"(*", 
       RowBox[{"Borramos", " ", "las", " ", "variables", " ", 
        RowBox[{"\[Lambda]", "[", "i", "]"}], " ", "para", " ", "que", " ", 
        "sean", " ", "los", " ", "par\[AAcute]metros"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Parte1", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Lambda]", "[", "i", "]"}], "*", 
          RowBox[{"Base", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "Base", "]"}]}], "}"}]}], "]"}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
       "Coordenada", " ", "a", " ", "coordenada", " ", "se", " ", "hace", " ",
         "el", " ", "c\[AAcute]lculo"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"param\[EAcute]tricas", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{"param\[EAcute]tricas", ",", 
           RowBox[{
            RowBox[{"Subscript", "[", 
             RowBox[{"x", ",", "i"}], "]"}], "\[Equal]", 
            RowBox[{"Parte1", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}], ";"}], " ", 
        RowBox[{"(*", 
         RowBox[{
         "A\[NTilde]adimos", " ", "la", " ", "ecuaci\[OAcute]n", " ", 
          "param\[EAcute]trica"}], "*)"}], "\n", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", 
           RowBox[{"Base", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "param\[EAcute]tricas"}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]], "Input",
