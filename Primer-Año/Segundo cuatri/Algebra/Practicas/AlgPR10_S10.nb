 RowBox[{
  RowBox[{"param\[EAcute]tricas11c", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["x", "1"], "\[Equal]", 
      RowBox[{"-", 
       RowBox[{"\[Lambda]", "[", "2", "]"}]}]}], ",", 
     RowBox[{
      SubscriptBox["x", "2"], "\[Equal]", 
      RowBox[{"\[Lambda]", "[", "1", "]"}]}], ",", 
     RowBox[{
      SubscriptBox["x", "3"], "\[Equal]", 
      RowBox[{"\[Lambda]", "[", "1", "]"}]}], ",", 
     RowBox[{
      SubscriptBox["x", "4"], "\[Equal]", 
      RowBox[{"\[Lambda]", "[", "2", "]"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"Eliminate", "[", 
  RowBox[{"param\[EAcute]tricas11c", ",", 
   RowBox[{"{", 
