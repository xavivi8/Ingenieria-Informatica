Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"param\[EAcute]tricas11a", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["x", "1"], "\[Equal]", 
      RowBox[{"\[Lambda]", "[", "1", "]"}]}], ",", 
     RowBox[{
      SubscriptBox["x", "2"], "\[Equal]", 
      RowBox[{"\[Lambda]", "[", "2", "]"}]}], ",", 
     RowBox[{
      SubscriptBox["x", "3"], "\[Equal]", 
      RowBox[{"-", 
       RowBox[{"\[Lambda]", "[", "2", "]"}]}]}], ",", 
     RowBox[{
      SubscriptBox["x", "4"], "\[Equal]", 
      RowBox[{"\[Lambda]", "[", "3", "]"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"Eliminate", "[", 
  RowBox[{"param\[EAcute]tricas11a", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Lambda]", "[", "1", "]"}], ",", 
     RowBox[{"\[Lambda]", "[", "2", "]"}], ",", 
     RowBox[{"\[Lambda]", "[", "3", "]"}]}], "}"}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Eliminamos", " ", "par\[AAcute]metros", " ", "directamente"}], 
    ",", " ", 
    RowBox[{
    "indicando", " ", "los", " ", "par\[AAcute]metros", " ", "a", " ", 
     "eliminar"}]}], "*)"}]}]}], "Code",
