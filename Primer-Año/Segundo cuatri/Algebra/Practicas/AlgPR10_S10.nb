Cell[TextData[{
 "Estudiar si los siguientes vectores de ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "2"], TraditionalForm]],ExpressionUUID->
  "d3fdb00e-4bb4-2b43-9b69-a2a2e4e58ba4"],
 "(R) son base:\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{"p3", "[", "_x", "]"}], ":=", 
   FormBox[
    RowBox[{
     SuperscriptBox["x", "2"], "+", "x", "+", "1", " "}],
    TraditionalForm]}], "\n", 
  RowBox[{
   RowBox[{"q3", "[", "_x", "]"}], ":=", 
   RowBox[{
    RowBox[{"2", "x"}], "+", "1"}]}], "\n", 
  RowBox[{
   RowBox[{"r3", "[", "_x", "]"}], ":=", 
   FormBox[
    RowBox[{
     SuperscriptBox["x", "2"], "+", "1"}],
    TraditionalForm]}]}],ExpressionUUID->
  "e370303d-be11-1d44-b73b-690025af7671"],
 "\nSer\[AAcute]n base (como dimV = 3) sii son linealmente independientes sii \
rang (b3) = 3 o Det[B3] es distinto de cero\nBc={1,x,x^2}"
}], "Text",
 CellChangeTimes->{{3.9542970884740067`*^9, 3.954297293441021*^9}, {
  3.9542973839560547`*^9, 3.954297385178356*^9}, {3.9542976509878597`*^9, 
