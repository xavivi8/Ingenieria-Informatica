Cell[CellGroupData[{

Cell["Ejercicio 4 Ord 23-24", "Subsection",
 CellChangeTimes->{{3.9548235395968437`*^9, 
  3.954823557010376*^9}},ExpressionUUID->"19fcc247-ff7d-0147-827b-\
f1da0a3df889"],

Cell[TextData[{
 "Sea V el espacio vectorial de los polinomios de grado menor o igual que 3 \
con coeficiente en \:21245. Considerar el subconjunto\nU={p(x):p(0)=p(1)}\n\
Demostrar que U es subespacio vectorial de V. Obtener, de forma razonada, ",
 StyleBox["base",
  FontWeight->"Bold"],
 ", ",
 StyleBox["dimensi\[OAcute]n",
  FontWeight->"Bold"],
 ", ",
 StyleBox["ecuaciones param\[EAcute]tricas",
  FontWeight->"Bold"],
 " e ",
 StyleBox["impl\[IAcute]citas",
  FontWeight->"Bold"],
 " de U."
}], "Text",
 CellChangeTimes->{
  3.9548235628728695`*^9, {3.9548239575363655`*^9, 
   3.954824032430378*^9}},ExpressionUUID->"5c55541d-2bd1-774b-905e-\
38e674a32ef6"],

Cell["\<\
La ecuaci\[OAcute]n impl\[IAcute]cita ser\[IAcute]a 
\ta = a +b +c +d 
\t=> b+c+d=0\
\>", "Text",
 CellChangeTimes->{
  3.954824329530876*^9},ExpressionUUID->"9b650e4f-a5f9-f84b-937c-\
ec2eab57199a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"p", "[", "x_", "]"}], ":=", 
  RowBox[{"a0", "+", " ", 
   RowBox[{"a1", "*", "x"}], "+", 
   RowBox[{"a2", "*", 
    RowBox[{"x", "^", "2"}]}], "+", 
   RowBox[{"a3", "*", 
    RowBox[{"x", "^", "3"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p", "[", "0", "]"}], "\[Equal]", 
  RowBox[{"p", "[", "1", "]"}]}]}], "Input",
 CellChangeTimes->{{3.954993634321334*^9, 3.9549937351932335`*^9}},
 CellLabel->"In[93]:=",ExpressionUUID->"6888e098-48d0-4527-b413-c6474002c0e5"],

Cell[BoxData[
 RowBox[{"a0", "\[Equal]", 
  RowBox[{"a0", "+", "a1", "+", "a2", "+", "a3"}]}]], "Output",
 CellChangeTimes->{3.9549937391772833`*^9},
 CellLabel->"Out[94]=",ExpressionUUID->"cb6d69ef-d70a-4dca-b7c3-750a66320f37"]
}, Open  ]],

