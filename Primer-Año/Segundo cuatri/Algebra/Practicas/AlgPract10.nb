       RowBox[{"\[Lambda]", "[", "2", "]"}]}]}], ",", 
     RowBox[{
      SubscriptBox["x", "4"], "\[Equal]", 
      RowBox[{"\[Lambda]", "[", "3", "]"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"Eliminate", "[", 
