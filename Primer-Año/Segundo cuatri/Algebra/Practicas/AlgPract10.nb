41a4e4a3c033"],

Cell[TextData[{
 StyleBox["Ecuaciones Impl\[IAcute]citas",
  FontWeight->"Bold"],
 " desde las ",
 StyleBox["Ecuaciones Param\[EAcute]tricas",
  FontSlant->"Italic"],
 "\nSi tenemos las ecuaciones param\[EAcute]tricas, las ecuaciones impl\
\[IAcute]citas las calcularemos directamente eliminando los \
par\[AAcute]metros con la funci\[OAcute]n de Mathematica ",
 StyleBox["Eliminate[]",
  FontWeight->"Bold",
  FontColor->RGBColor[0.6, 0.4, 0.2]],
 ":\n\nPor ejemplo, para el espacio vectorial ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]", "3"], TraditionalForm]],
  ExpressionUUID->"86e5732a-e738-4a45-970b-fc5212d7d76a"],
 " y el subespacio con ecuaciones param\[EAcute]tricas:\n\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TagBox[GridBox[{
      {"\[Piecewise]", GridBox[{
         {
          SubscriptBox["x", "1"], 
          RowBox[{"=", "  ", 
           SubscriptBox["\[Lambda]", "1"]}]},
         {
          SubscriptBox["x", "2"], 
          RowBox[{"=", "  ", 
           SubscriptBox["\[Lambda]", "2"]}]},
         {
          SubscriptBox["x", "3"], 
          RowBox[{"=", " ", 
           RowBox[{"-", " ", 
            SubscriptBox["\[Lambda]", 
             RowBox[{"2", "\[IndentingNewLine]"}]]}]}]}
        },
        AllowedDimensions->{2, Automatic},
        Editable->True,
        GridBoxAlignment->{
         "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
          "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
        GridBoxItemSize->{
         "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}},
           "RowsIndexed" -> {}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.84]}, 
            Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}, "RowsIndexed" -> {}},
        Selectable->True]}
     },
     GridBoxAlignment->{
      "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, "Rows" -> {{Baseline}}, 
       "RowsIndexed" -> {}},
     GridBoxItemSize->{
      "Columns" -> {{Automatic}}, "ColumnsIndexed" -> {}, "Rows" -> {{1.}}, 
       "RowsIndexed" -> {}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.35]}, 
         Offset[0.27999999999999997`]}, "ColumnsIndexed" -> {}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}, "RowsIndexed" -> {}}],
    "Piecewise",
    DeleteWithContents->True,
    Editable->False,
    SelectWithContents->True,
    Selectable->False], TraditionalForm]],ExpressionUUID->
  "d677a206-8744-d346-ab10-e1ff4b954de7"],
 "\nsus ",
 StyleBox["ecuaciones impl\[IAcute]citas",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{
  3.9548212193910313`*^9},ExpressionUUID->"09ef8e61-59a0-994a-a48d-\
007032b0c88b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"param\[EAcute]tricas11c", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["x", "1"], "\[Equal]", 
      RowBox[{"-", 
       RowBox[{"\[Lambda]", "[", "2", "]"}]}]}], ",", 
     RowBox[{
      SubscriptBox["x", "2"], "\[Equal]", 
      RowBox[{"\[Lambda]", "[", "1", "]"}]}], ",", 
     RowBox[{
      SubscriptBox["x", "3"], "\[Equal]", 
      RowBox[{"\[Lambda]", "[", "1", "]"}]}], ",", 
     RowBox[{
      SubscriptBox["x", "4"], "\[Equal]", 
      RowBox[{"\[Lambda]", "[", "2", "]"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"Eliminate", "[", 
  RowBox[{"param\[EAcute]tricas11c", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Lambda]", "[", "1", "]"}], ",", 
     RowBox[{"\[Lambda]", "[", "2", "]"}]}], "}"}]}], "]"}], "\n", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Eliminamos", " ", "par\[AAcute]metros", " ", "directamente"}], 
    ",", " ", 
    RowBox[{
    "indicando", " ", "los", " ", "par\[AAcute]metros", " ", "a", " ", 
     "eliminar"}]}], "*)"}]}]}], "Code",
