Cell[TextData[{
 StyleBox["Ecuaciones Impl\[IAcute]citas",
  FontWeight->"Bold"],
 " desde las ",
 StyleBox["Ecuaciones Param\[EAcute]tricas",
  FontSlant->"Italic"],
 "\nSi tenemos las ecuaciones param\[EAcute]tricas, las ecuaciones impl\
\[IAcute]citas las calcularemos directamente eliminando los \
par\[AAcute]metros con la funci\[OAcute]n de Mathematica ",
 StyleBox["Eliminate[]",
  FontWeight->"Bold",
  FontColor->RGBColor[0.6, 0.4, 0.2]],
 ":\n\nPor ejemplo, para el espacio vectorial ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]", "3"], TraditionalForm]],
  ExpressionUUID->"c8b5cf55-10a8-354b-8e6e-84150745048f"],
 " y el subespacio con ecuaciones param\[EAcute]tricas:\n\t\t\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   TagBox[GridBox[{
      {"\[Piecewise]", GridBox[{
         {
          SubscriptBox["x", "1"], 
          RowBox[{"=", "  ", 
           SubscriptBox["\[Lambda]", "1"]}]},
         {
          SubscriptBox["x", "2"], 
          RowBox[{"=", "  ", 
           SubscriptBox["\[Lambda]", "2"]}]},
         {
          SubscriptBox["x", "3"], 
          RowBox[{"=", " ", 
           RowBox[{"-", " ", 
            SubscriptBox["\[Lambda]", 
             RowBox[{"2", "\[IndentingNewLine]"}]]}]}]}
        },
        AllowedDimensions->{2, Automatic},
        Editable->True,
        GridBoxAlignment->{
         "Columns" -> {{Left}}, "ColumnsIndexed" -> {}, 
          "Rows" -> {{Baseline}}, "RowsIndexed" -> {}},
