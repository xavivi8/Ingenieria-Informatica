Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "Coordenadas", " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Coordenadas", "[", 
      RowBox[{"X_", ",", "B_"}], "]"}], ":=", 
     RowBox[{"LinearSolve", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", "B", "]"}], ",", "X"}], "]"}]}], ";"}], "\n",
    "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Cambio", " ", "de", " ", "base"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"CambioBase", "[", 
      RowBox[{"B1_", ",", "B2_"}], "]"}], ":=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Coordenadas", "[", 
         RowBox[{
          RowBox[{"B1", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", "B2"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "B1", "]"}]}], "}"}]}], "]"}], "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{"(*", " ", "Base", " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Base", "[", "Generadores_", "]"}], ":=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"RowReduce", "[", "Generadores", "]"}], "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"MatrixRank", "[", "Generadores", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Filas", " ", "no", " ", "nulas", " ", "dela", " ", 
     RowBox[{"F", ".", " ", "N", ".", " ", "Hermite"}], " ", "por", " ", 
     "filas"}], "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", "Param\[EAcute]tricas", " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Param\[EAcute]tricas", "[", "Base_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Parte1", ",", "param\[EAcute]tricas"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Clear", "[", "\[Lambda]", "]"}], ";", 
        RowBox[{"(*", 
         RowBox[{"Borramos", " ", "las", " ", "variables", " ", 
          RowBox[{"\[Lambda]", "[", "i", "]"}], " ", "para", " ", "que", " ", 
          "sean", " ", "los", " ", "par\[AAcute]metros"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Parte1", "=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Lambda]", "[", "i", "]"}], "*", 
            RowBox[{"Base", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "Base", "]"}]}], "}"}]}], "]"}]}], ";", 
        " ", 
        RowBox[{"(*", 
         RowBox[{
         "Coordenada", " ", "a", " ", "coordenada", " ", "se", " ", "hace", 
          " ", "el", " ", "c\[AAcute]lculo"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"param\[EAcute]tricas", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"param\[EAcute]tricas", ",", 
             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"x", ",", "i"}], "]"}], "\[Equal]", 
              RowBox[{"Parte1", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}], ";"}], " ", 
          RowBox[{"(*", 
           RowBox[{
           "A\[NTilde]adimos", " ", "la", " ", "ecuaci\[OAcute]n", " ", 
            "param\[EAcute]trica"}], "*)"}], "\n", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", 
             RowBox[{"Base", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "param\[EAcute]tricas"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", "Implicitas", " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Impl\[IAcute]citas", "[", "Base_", "]"}], ":=", 
     RowBox[{"Eliminate", "[", 
      RowBox[{
       RowBox[{"Param\[EAcute]tricas", "[", "Base", "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"\[Lambda]", "[", "i", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "Base", "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
    ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Caculamos", " ", "las", " ", 
     RowBox[{"E", ".", " ", "param\[EAcute]tricas"}], " ", "desde", " ", "la",
      " ", "base", " ", "y", " ", "eliminamos", " ", "par\[AAcute]metros"}], 
    "*)"}], "\n"}]}]], "Code",
 CellChangeTimes->{{3.9542983800497*^9, 3.954298395157839*^9}, {
  3.954298957642004*^9, 3.95429897036145*^9}, {3.9543050270033207`*^9, 
