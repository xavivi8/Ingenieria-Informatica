                   RowBox[{"[", "i", "]"}], "]"}], "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", "W1"}], "]"}],
              "]"}], "\[Equal]", 
            RowBox[{"Sort", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{"F", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"F", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}]}], ",", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"F1", ",", 
             RowBox[{"F", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "F", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "F1"}]}], "\[IndentingNewLine]", "]"}]}], "\n", 
   RowBox[{
    RowBox[{"BIPARTITO", "[", 
     RowBox[{"W_", ",", "F_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i", ",", "subconjuntos", ",", "j", ",", "fin"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"bipartito", "=", "False"}], ";", "\[IndentingNewLine]", 
       RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"fin", "=", 
        RowBox[{"Quotient", "[", 
         RowBox[{
          RowBox[{"Length", "[", "W", "]"}], ",", "2"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"!", "bipartito"}], " ", "&&", " ", 
          RowBox[{"i", "<=", "fin"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"subconjuntos", "=", 
           RowBox[{"KSubsets", "[", 
            RowBox[{"W", ",", "i"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"j", "=", "1"}], ";", "\[IndentingNewLine]", 
          RowBox[{"While", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"!", "bipartito"}], " ", "&&", " ", 
             RowBox[{"j", "<=", 
              RowBox[{"Length", "[", "subconjuntos", "]"}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"IND", "[", 
                 RowBox[{
                  RowBox[{"subconjuntos", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], ",", "F"}], "]"}], "==", 
                RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"IND", "[", 
                    RowBox[{
                    RowBox[{"Complement", "[", 
                    RowBox[{"W", ",", 
                    RowBox[{"subconjuntos", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", "F"}], 
                    "]"}], "\[Equal]", 
                   RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"bipartito", "=", "True"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"W1", "=", 
                    RowBox[{"subconjuntos", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"W2", "=", 
                    RowBox[{"Complement", "[", 
                    RowBox[{"W", ",", 
                    RowBox[{"subconjuntos", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";"}]}], 
                 "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]",
               "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"j", "++"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"i", "++"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"bipartito", ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<Es bipartito: W1=\>\"", ",", "W1", ",", "\"\< y W2=\>\"", ",",
             "W2"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "F", "]"}], "==", 
             RowBox[{
              RowBox[{"Length", "[", "W1", "]"}], "*", 
              RowBox[{"Length", "[", "W2", "]"}]}]}], ",", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Es bipartito completo: \>\"", ",", 
              SubscriptBox["\"\<K\>\"", 
               RowBox[{
                RowBox[{"Length", "[", "W1", "]"}], ",", 
                RowBox[{"Length", "[", "W2", "]"}]}]]}], "  ", "]"}], ",", 
            " ", 
            RowBox[{"Print", "[", "\"\<No es bipartito completo\>\"", "]"}]}],
            "]"}], ";"}], "\[IndentingNewLine]", ",", 
         RowBox[{"Print", "[", "\"\<No es bipartito\>\"", "]"}]}], "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}]}]}]}]], "Code",
 CellChangeTimes->{{3.952594355612486*^9, 3.952594385672865*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"cdad6e05-5af6-2a48-b833-b92d43393316"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Ejercicio 5.29 Grafos I", "Subsection",
 CellChangeTimes->{{3.9507997789007607`*^9, 3.9507997932093124`*^9}, {
  3.9516567053186646`*^9, 
  3.9516567056116047`*^9}},ExpressionUUID->"4255ac15-60ed-1f4b-a88d-\
8dbb7fc733b9"],

Cell[TextData[{
 "a) Sea W el conjunto formado por todas las cifras distintas que componen su \
DNI junto con todas las letras distintas de su primer apellido.\nb) \
Consideramos el grafo no orientado ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "1"], TraditionalForm]],ExpressionUUID->
  "82044318-6444-9f42-b0f5-9b82b4eb4f65"],
 " cuyo conjunto de v\[EAcute]rtices es W y donde dos v\[EAcute]rtices cuales \
quiera ser\[AAcute]n adyacentes si y s\[OAcute]lo si son:\n\tI. Un \
n\[UAcute]mero par y una vocal\n\tII. Un n\[UAcute]mero impar y una \
consonante\n\tIII. Dos n\[UAcute]meros pares distintos\nc) Consideramos el \
grafo dirigido ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "2"], TraditionalForm]],ExpressionUUID->
  "bcf7087f-c15e-0544-8861-4de8ca4cd636"],
 " cuyo conjunto de v\[EAcute]rtices es W y donde el conjunto de flechas est\
\[AAcute] formado por todas aquellas flechas que podemos considerar de la \
forma:\n\tI. Origen en un n\[UAcute]mero impar y fin de una vocal \n\tII. \
Origen en una vocal y fin en una constante \n\tIII. Origen en un \
n\[UAcute]mero par y fin en un n\[UAcute]mero impar\nSe pide:\n\ti. Definir ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "1"], TraditionalForm]],ExpressionUUID->
  "28480a34-73bc-7246-b814-4a4a265b15d8"],
 " y ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["G", "2"], TraditionalForm]],ExpressionUUID->
  "a11f13ed-8f5c-fe40-8461-5d174b320d4b"],
 " directamente por sus conjuntos de v\[EAcute]rtices y lados o flechas"
}], "Text",
 CellChangeTimes->{{3.9507998075085545`*^9, 3.9508001464822807`*^9}, {
  3.950800188835346*^9, 3.9508002741427*^9}, {3.9508003283896065`*^9, 
  3.950800360222021*^9}},ExpressionUUID->"9f26fbf3-bc39-ec4d-bdd1-\
e5e1bd25f9c3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"W", "=", 
    RowBox[{"{", 
     RowBox[{
     "2", ",", "6", ",", "8", ",", "0", ",", ",", "\"\<m\>\"", ",", 
