       RowBox[{
        RowBox[{"grado", "=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"matrizadyacencia", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "j"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{
              RowBox[{"Dimensions", "[", "matrizadyacencia", "]"}], "[", 
