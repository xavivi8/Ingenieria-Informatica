           ";"}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", "Completo", "*)"}], "\n", 
   StyleBox[
    RowBox[{
     RowBox[{"COMPLETO", "[", "matrizadyacencia_", "]"}], ":=", "   ", 
