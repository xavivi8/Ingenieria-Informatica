      RowBox[{"\"\<i\>\"", ",", "\"\<l\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<i\>\"", ",", "\"\<s\>\""}], "}"}], ",", "\n", "\t", 
     RowBox[{"{", 
      RowBox[{"\"\<u\>\"", ",", "\"\<m\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<u\>\"", ",", "\"\<r\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<u\>\"", ",", "\"\<t\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<u\>\"", ",", "\"\<n\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<u\>\"", ",", "\"\<l\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<u\>\"", ",", "\"\<s\>\""}], "}"}]}], "\n", "\t", "}"}]}], 
  ";"}]}], "Code",
