       RowBox[{"8", ",", "\"\<u\>\""}], "}"}], ",", "\n", "\t", 
      RowBox[{"{", 
       RowBox[{"2", ",", "6"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "8"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "6"}], "}"}]}], "\n", "\t", "}"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"ARISTAS", " ", "SEGUNDO", " ", 
     RowBox[{"GRAFO", ":", " ", 
      RowBox[{"impar", " ", "a", " ", "vocal"}]}]}], " ", ",", " ", 
    RowBox[{
    "vocal", " ", "a", " ", "consonante", " ", "y", " ", "par", " ", "a", " ",
      "impar"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"F2", "=", 
   RowBox[{"{", "\n", "\t", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<a\>\"", ",", "\"\<m\>\""}], "}"}], ",", 
