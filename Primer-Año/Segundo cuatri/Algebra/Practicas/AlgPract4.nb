              RowBox[{"{", "n", "}"}]}], "]"}], "\[Equal]", 
            RowBox[{"{", "n", "}"}]}], ",", 
           RowBox[{"grado", "++"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "F", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "grado"}]}], "\[IndentingNewLine]", "]"}]}], 
   "\n", 
   RowBox[{"(*", "Regular", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"REGULAR", "[", "matrizadyacencia_", "]"}], ":=", 
