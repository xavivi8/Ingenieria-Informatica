                RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}]}], ",", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"F1", ",", 
             RowBox[{"F", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
