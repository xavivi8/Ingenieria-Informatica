       "\[IndentingNewLine]", "F1"}]}], "\[IndentingNewLine]", "]"}]}], "\n", 
   RowBox[{"(*", "Bipartito", "*)"}], "\n", 
   RowBox[{
    RowBox[{"BIPARTITO", "[", 
     RowBox[{"W_", ",", "F_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"i", ",", "subconjuntos", ",", "j", ",", "fin"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"bipartito", "=", "False"}], ";", "\[IndentingNewLine]", 
       RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"fin", "=", 
        RowBox[{"Quotient", "[", 
         RowBox[{
          RowBox[{"Length", "[", "W", "]"}], ",", "2"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"!", "bipartito"}], " ", "&&", " ", 
          RowBox[{"i", "<=", "fin"}]}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"subconjuntos", "=", 
           RowBox[{"KSubsets", "[", 
            RowBox[{"W", ",", "i"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"j", "=", "1"}], ";", "\[IndentingNewLine]", 
          RowBox[{"While", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"!", "bipartito"}], " ", "&&", " ", 
             RowBox[{"j", "<=", 
              RowBox[{"Length", "[", "subconjuntos", "]"}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"IND", "[", 
                 RowBox[{
                  RowBox[{"subconjuntos", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], ",", "F"}], "]"}], "==", 
                RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"IND", "[", 
                    RowBox[{
                    RowBox[{"Complement", "[", 
                    RowBox[{"W", ",", 
                    RowBox[{"subconjuntos", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", "F"}], 
                    "]"}], "\[Equal]", 
                   RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"bipartito", "=", "True"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"W1", "=", 
                    RowBox[{"subconjuntos", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"W2", "=", 
                    RowBox[{"Complement", "[", 
                    RowBox[{"W", ",", 
                    RowBox[{"subconjuntos", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";"}]}], 
                 "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]",
               "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"j", "++"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"i", "++"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"bipartito", ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<Es bipartito: W1=\>\"", ",", "W1", ",", "\"\< y W2=\>\"", ",",
             "W2"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "F", "]"}], "==", 
             RowBox[{
              RowBox[{"Length", "[", "W1", "]"}], "*", 
              RowBox[{"Length", "[", "W2", "]"}]}]}], ",", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Es bipartito completo: \>\"", ",", 
              SubscriptBox["\"\<K\>\"", 
               RowBox[{
                RowBox[{"Length", "[", "W1", "]"}], ",", 
                RowBox[{"Length", "[", "W2", "]"}]}]]}], "  ", "]"}], ",", 
