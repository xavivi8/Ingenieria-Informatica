          RowBox[{
           RowBox[{
            RowBox[{"matrizadyacencia", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"F", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "1"}], "]"}], "]"}], ",", 
               RowBox[{"F", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], "=", 
