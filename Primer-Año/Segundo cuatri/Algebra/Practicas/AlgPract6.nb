Cell["\tiii. Comprobar si es un \[AAcute]rbol", "Text",
 CellChangeTimes->{{3.9512729476148663`*^9, 
  3.951272958984663*^9}},ExpressionUUID->"da87601f-f1f7-244c-8993-\
08c48f8a1236"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"CICLOSELEMENTALES", "[", 
     RowBox[{"vertice1_", ",", "longitud_", ",", "A_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "i", ",", "ultvertice", ",", "caminos", ",", "adyacentes", ",", 
        "caminostemp", ",", "k", ",", "j", ",", "t"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"caminos", "=", 
        RowBox[{"{", 
         RowBox[{"{", "vertice1", "}"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"caminostemp", "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Do", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"adyacentes", "=", 
              RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
             "\[IndentingNewLine]", 
             RowBox[{"ultvertice", "=", 
              RowBox[{
               RowBox[{"caminos", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"A", "[", 
                    RowBox[{"[", 
                    RowBox[{"ultvertice", ",", "j"}], "]"}], "]"}], 
                   "\[Equal]", "1"}], ",", 
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"adyacentes", ",", "j"}], "]"}]}], "]"}], ";"}], 
               ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", 
                 RowBox[{
                  RowBox[{"Dimensions", "[", "A", "]"}], "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ";", 
             "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"adyacentes", "=", 
              RowBox[{"Complement", "[", 
               RowBox[{"adyacentes", ",", 
                RowBox[{"caminos", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"adyacentes", "\[NotEqual]", 
                RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
               "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Do", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"AppendTo", "[", 
                    RowBox[{"caminostemp", ",", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"caminos", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", 
                    RowBox[{"adyacentes", "[", 
                    RowBox[{"[", "t", "]"}], "]"}]}], "]"}]}], "]"}], ";"}], 
                  ",", 
                  RowBox[{"{", 
                   RowBox[{"t", ",", 
                    RowBox[{"Length", "[", "adyacentes", "]"}]}], "}"}]}], 
                 "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
            "\[IndentingNewLine]", ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", 
              RowBox[{"Length", "[", "caminos", "]"}]}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"caminos", "=", "caminostemp"}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"longitud", "-", "1"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"caminostemp", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"A", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{
                 RowBox[{"caminos", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "[", 
                 RowBox[{"[", "longitud", "]"}], "]"}], ",", "vertice1"}], 
               "]"}], "]"}], "\[Equal]", "1"}], ",", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"caminostemp", ",", 
               RowBox[{"Append", "[", 
                RowBox[{
                 RowBox[{"caminos", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], ",", "vertice1"}], "]"}]}], 
              "]"}], ";"}]}], "]"}], ";"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", "caminos", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "caminostemp"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BOSQUE", "[", "matrizadyacencia_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", "longitud", ",", "i", ","}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"bosque", "=", "True"}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{
         RowBox[{"Dimensions", "[", "matrizadyacencia", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"potencia", "=", 
           RowBox[{"MatrixPower", "[", 
            RowBox[{"matrizadyacencia", ",", "longitud"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Do", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"potencia", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "i"}], "]"}], "]"}], ">", "0"}], ",", " ",
                "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"CICLOSELEMENTALES", "[", 
                    RowBox[{"i", ",", "longitud", ",", "matrizadyacencia"}], 
                    "]"}], "\[NotEqual]", 
                   RowBox[{"{", "}"}]}], ",", 
                  RowBox[{
                   RowBox[{"bosque", "=", "False"}], ";", 
                   RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";"}]}], 
              "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"bosque", "==", "False"}], ",", 
            RowBox[{
             RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"longitud", ",", "3", ",", "n"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "bosque"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CONEXO", "[", "A_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"i", ",", "j", ",", "B"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"B", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"MatrixPower", "[", 
          RowBox[{"A", ",", "j"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{
            RowBox[{"Dimensions", "[", "A", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"conexo", "=", "True"}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"i", "\[NotEqual]", "j"}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"B", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "j"}], "]"}], "]"}], "\[Equal]", "0"}]}], 
              ",", 
              RowBox[{
               RowBox[{"conexo", "=", "False"}], ";"}]}], "]"}], ";"}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{
              RowBox[{"Dimensions", "[", "B", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ";"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{
           RowBox[{"Dimensions", "[", "B", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "conexo"}]}], "\[IndentingNewLine]", "]"}]}], 
  "\n"}], "\n", 
 RowBox[{
  StyleBox[
   RowBox[{"ARBOL", "[", "matrizadyacencia_", "]"}],
   FormatType->StandardForm,
   FontSize->12], 
