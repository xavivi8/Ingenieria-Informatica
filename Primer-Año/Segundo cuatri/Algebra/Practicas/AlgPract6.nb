 RowBox[{
  RowBox[{
   RowBox[{"COMPONENTESCONEXAS", "[", "matrizadyacencia_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"j", ",", "B", ",", "conjunto", ",", "temp"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"B", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"MatrixPower", "[", 
          RowBox[{"matrizadyacencia", ",", "j"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{
            RowBox[{"Dimensions", "[", "matrizadyacencia", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"componentesconexas", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"conjunto", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"i", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{
            RowBox[{"Dimensions", "[", "B", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"conjunto", "\[NotEqual]", 
         RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"temp", "=", 
          RowBox[{"{", 
           RowBox[{"conjunto", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"B", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"conjunto", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], ",", 
                  RowBox[{"conjunto", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], 
               "\[NotEqual]", "0"}], ",", 
              RowBox[{
               RowBox[{"AppendTo", "[", 
                RowBox[{"temp", ",", 
                 RowBox[{"conjunto", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ";"}]}], "]"}], 
            ";"}], "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "2", ",", 
             RowBox[{"Length", "[", "conjunto", "]"}]}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"componentesconexas", ",", "temp"}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"conjunto", "=", 
          RowBox[{"Complement", "[", 
           RowBox[{"conjunto", ",", "temp"}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      "componentesconexas"}]}], "\[IndentingNewLine]", "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"IND2", "[", 
     RowBox[{"W1_", ",", "matrizadyacencia_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", "i", ",", "j"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "W1", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"matrizadyacencia2", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "n"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Do", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"matrizadyacencia2", "[", 
               RowBox[{"[", 
