                    "]"}]}], ";"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Do", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Adib", "[", 
                    RowBox[{"[", 
                    RowBox[{"t", ",", "j"}], "]"}], "]"}], "=", 
                    RowBox[{"Style", "[", 
