         RowBox[{"Print", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
            "\"\<C\[CapitalAAcute]LCULO DE LA FORMA NORMAL DE HERMITE POR \
FILAS DE \>\"", ",", 
             RowBox[{"{", "Bold", "}"}]}], "]"}], ",", 
           RowBox[{"A", "//", "MatrixForm"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
         "Print", "[", "\"\<1. Calculamos la matriz escalonada:\>\"", "]"}], 
         ";"}]}], "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"pivote", "=", "1"}], ";", 
      RowBox[{"t", "=", "1"}], ";", 
      RowBox[{"col", "=", "0"}], ";", "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"pivote", "\[NotEqual]", "0"}], " ", ",", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"t", "<", "m"}], "&&", " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"t", "+", "col"}], ")"}], "\[LessEqual]", "n"}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"opciones", "\[Equal]", "1"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Print", "[", 
                RowBox[{
                "\"\<  Buscamos el pivote \>\"", ",", "t", ",", 
                 "\"\<\.ba:\>\""}], "]"}], ";"}]}], 
             RowBox[{"(*", 
              RowBox[{"Buscamos", " ", "siguiente", " ", "pivote"}], "*)"}], 
             "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"j", "=", 
             RowBox[{"t", "+", "col"}]}], ";", 
            RowBox[{"i", "=", "t"}], ";", "\[IndentingNewLine]", 
            RowBox[{"While", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"A", "[", 
                RowBox[{"[", 
                 RowBox[{"i", ",", "j"}], "]"}], "]"}], "==", "0"}], ",", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"i", "<", "m"}], ",", 
                 RowBox[{
                  RowBox[{"i", "++"}], ";"}], ",", 
                 RowBox[{
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"j", "<", "m"}], ",", 
                    RowBox[{
                    RowBox[{"i", "=", "t"}], ";", 
                    RowBox[{"j", "++"}], ";", 
                    RowBox[{"col", "++"}], ";"}], ",", 
                    RowBox[{
                    RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";"}]}], 
                "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
            RowBox[{"pivote", "=", 
             RowBox[{"A", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"A", "[", 
