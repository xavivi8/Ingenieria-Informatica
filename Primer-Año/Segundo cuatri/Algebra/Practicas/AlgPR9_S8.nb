                    RowBox[{"t", ",", "kt"}], "]"}]}], "]"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"opciones", "\[Equal]", "1"}], ",", 
