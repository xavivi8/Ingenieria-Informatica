                    RowBox[{"Italic", ",", "Bold", ",", "Blue"}], "}"}]}], 
                    "]"}]}], ";"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Do", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Adib", "[", 
                    RowBox[{"[", 
                    RowBox[{"t", ",", "j"}], "]"}], "]"}], "=", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"Adib", "[", 
                    RowBox[{"[", 
                    RowBox[{"t", ",", "j"}], "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"Bold", ",", "Blue"}], "}"}]}], "]"}]}], ";"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<    * \>\"", ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<Transf. elemental tipo I\>\"", ",", 
                    RowBox[{"{", "Blue", "}"}]}], "]"}], ",", 
                    "\"\<, cambiar\>\"", ",", "\"\< fila \>\"", ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"i", ",", 
                    RowBox[{"{", 
                    RowBox[{"Italic", ",", "Bold", ",", "Blue"}], "}"}]}], 
                    "]"}], ",", "\"\< por fila \>\"", ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"t", ",", 
                    RowBox[{"{", 
                    RowBox[{"Bold", ",", "Blue"}], "}"}]}], "]"}], ",", 
                    "\"\<: \>\"", ",", "\[IndentingNewLine]", 
                    RowBox[{"Adib", "//", "MatrixForm"}]}], "]"}], ";"}]}], 
                   "\[IndentingNewLine]", "]"}], ";"}]}], 
                "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"A", "[", 
