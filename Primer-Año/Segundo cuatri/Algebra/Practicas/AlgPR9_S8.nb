                    RowBox[{"k", ",", "j"}], "]"}], "]"}], "\[NotEqual]", 
                  "0"}], ",", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"kt", "=", 
                   RowBox[{"(", 
                    RowBox[{"-", 
                    RowBox[{"A", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", ",", "j"}], "]"}], "]"}]}], ")"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"A", "[", 
