           "\[IndentingNewLine]", ",", 
           RowBox[{
            RowBox[{"col", "=", "0"}], ";", "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"t", "<", "n"}], ",", "\[IndentingNewLine]", 
