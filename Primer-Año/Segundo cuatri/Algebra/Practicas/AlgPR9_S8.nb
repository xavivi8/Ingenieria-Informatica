                  "\[IndentingNewLine]", 
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"transformaciones", ",", 
                    RowBox[{"el1", "[", 
                    RowBox[{"i", ",", "t"}], "]"}]}], "]"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"opciones", "\[Equal]", "1"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{
                    "\"\<     Lo ponemos en la fila \>\"", ",", "t", ",", 
                    "\"\<\.aa\>\""}], "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Adib", "=", "A"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Do", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Adib", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"Adib", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}], ",", 
