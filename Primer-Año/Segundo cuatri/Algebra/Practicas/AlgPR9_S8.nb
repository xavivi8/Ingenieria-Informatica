               RowBox[{"While", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"A", "[", 
                   RowBox[{"[", 
                    RowBox[{"t", ",", 
                    RowBox[{"t", "+", "col"}]}], "]"}], "]"}], "\[Equal]", 
                  "0"}], " ", ",", 
                 RowBox[{
                  RowBox[{"col", "++"}], ";", 
