                    RowBox[{"Bold", ",", "Red"}], "}"}]}], "]"}]}], ";"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    "Print", "[", "\"\<      Hacemos 1 el pivote.\>\"", "]"}],
                     ";", "\[IndentingNewLine]", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"\<    * \>\"", ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<Transf. elemental tipo II\>\"", ",", 
                    RowBox[{"{", "Red", "}"}]}], "]"}], ",", 
                    "\"\<, la fila \>\"", ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"t", ",", 
                    RowBox[{"{", 
                    RowBox[{"Bold", ",", "Red"}], "}"}]}], "]"}], ",", 
                    "\"\< por escalar \>\"", ",", "kt", ",", "\"\<: \>\"", 
                    ",", 
                    RowBox[{"Adib", "//", "MatrixForm"}]}], "]"}], ";"}]}], 
                   "\[IndentingNewLine]", "]"}], ";"}]}], 
