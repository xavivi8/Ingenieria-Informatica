                  RowBox[{"{", 
                   RowBox[{"Bold", ",", " ", "Green"}], "}"}]}], "]"}]}], ";",
                "\[IndentingNewLine]", 
               RowBox[{"Print", "[", 
                RowBox[{
                "\"\<    ---> Pivote \>\"", ",", "t", ",", "\"\<\.ba: \>\"", 
                 ",", 
                 RowBox[{"Adib", "//", "MatrixForm"}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
