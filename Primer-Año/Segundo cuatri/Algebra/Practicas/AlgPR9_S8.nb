                    RowBox[{"\"\<    * \>\"", ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"\"\<Transf. elemental tipo II\>\"", ",", 
                    RowBox[{"{", "Red", "}"}]}], "]"}], ",", 
                    "\"\<, la fila \>\"", ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{"t", ",", 
                    RowBox[{"{", 
                    RowBox[{"Bold", ",", "Red"}], "}"}]}], "]"}], ",", 
                    "\"\< por escalar \>\"", ",", "kt", ",", "\"\<: \>\"", 
                    ",", 
                    RowBox[{"Adib", "//", "MatrixForm"}]}], "]"}], ";"}]}], 
