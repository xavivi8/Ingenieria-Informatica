   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "pivote", ",", "aux", ",", "col", ",", "i", ",", "j", ",", "t", ",", 
       "kt", ",", "Adib", ",", "A", ",", "transformaciones", ",", "n", ",", 
       "m", ",", "el1", ",", "el2", ",", "el3"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"A", "=", "matriz"}], ";", 
      RowBox[{"m", "=", 
       RowBox[{
        RowBox[{"Dimensions", "[", "A", "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", 
      RowBox[{"n", "=", 
