                  RowBox[{"i", "\[LessEqual]", "m"}]}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"aux", "=", 
                   RowBox[{"A", "[", 
                    RowBox[{"[", "t", "]"}], "]"}]}], ";", 
                  RowBox[{
                   RowBox[{"A", "[", 
                    RowBox[{"[", "t", "]"}], "]"}], "=", 
                   RowBox[{"A", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ";", 
                  RowBox[{
                   RowBox[{"A", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "=", "aux"}], ";", 
                  RowBox[{"(*", 
                   RowBox[{
                   "Intercambio", " ", "de", " ", "filas", " ", "para", " ", 
                    "subir", " ", "el", " ", "pivote"}], "*)"}], 
                  "\[IndentingNewLine]", 
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"transformaciones", ",", 
                    RowBox[{"el1", "[", 
                    RowBox[{"i", ",", "t"}], "]"}]}], "]"}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"opciones", "\[Equal]", "1"}], ",", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{
                    "\"\<     Lo ponemos en la fila \>\"", ",", "t", ",", 
                    "\"\<\.aa\>\""}], "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Adib", "=", "A"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Do", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Adib", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}], "=", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"Adib", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}], ",", 
