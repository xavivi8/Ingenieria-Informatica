                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"aux", "=", 
                   RowBox[{"A", "[", 
                    RowBox[{"[", "t", "]"}], "]"}]}], ";", 
                  RowBox[{
                   RowBox[{"A", "[", 
                    RowBox[{"[", "t", "]"}], "]"}], "=", 
                   RowBox[{"A", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ";", 
                  RowBox[{
                   RowBox[{"A", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "=", "aux"}], ";", 
                  RowBox[{"(*", 
                   RowBox[{
                   "Intercambio", " ", "de", " ", "filas", " ", "para", " ", 
