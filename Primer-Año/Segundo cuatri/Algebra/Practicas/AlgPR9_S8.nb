                    RowBox[{"Bold", ",", "Red"}], "}"}]}], "]"}]}], ";"}], 
                    ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{
                    "Print", "[", "\"\<      Hacemos 1 el pivote.\>\"", "]"}],
                     ";", "\[IndentingNewLine]", 
