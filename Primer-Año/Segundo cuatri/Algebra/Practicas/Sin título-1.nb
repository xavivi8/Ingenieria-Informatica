 RowBox[{
  RowBox[{
   RowBox[{"Euclides2", "[", "m_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", ",", "q", ",", "d"}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "m", "]"}], "\[Equal]", "3"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"p", "[", "x_", "]"}], ":=", 
          RowBox[{"PolynomialMod", "[", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"m", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"q", "[", "x_", "]"}], ":=", 
          RowBox[{"PolynomialMod", "[", 
           RowBox[{
            RowBox[{"m", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"m", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"d", "[", "x_", "]"}], ":=", 
          RowBox[{"PolynomialQuotientRemainder", "[", 
           RowBox[{
            RowBox[{"p", "[", "x", "]"}], ",", 
            RowBox[{"q", "[", "x", "]"}], ",", "x", ",", 
            RowBox[{"Modulus", "\[Rule]", 
             RowBox[{"m", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}]}], "]"}]}], ";"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"p", "[", "x_", "]"}], ":=", 
          RowBox[{"m", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", 
         RowBox[{
          RowBox[{"q", "[", "x_", "]"}], ":=", 
          RowBox[{"m", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"d", "[", "x_", "]"}], ":=", 
          RowBox[{"PolynomialQuotientRemainder", "[", 
           RowBox[{
            RowBox[{"p", "[", "x", "]"}], ",", 
            RowBox[{"q", "[", "x", "]"}], ",", "x"}], "]"}]}], ";"}]}], "]"}],
       ";", 
      RowBox[{"Print", "[", 
       RowBox[{
        RowBox[{"p", "[", "x", "]"}], ",", "\"\< = (\>\"", ",", 
        RowBox[{"q", "[", "x", "]"}], ",", "\"\<) \[CenterDot] (\>\"", ",", 
        RowBox[{
         RowBox[{"d", "[", "x", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<) +\>\"", ",", 
        RowBox[{
         RowBox[{"d", "[", "x", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Exponent", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"d", "[", "x", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", "x"}], "]"}], "<", "0"}], 
        ",", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<El m\[AAcute]ximo com\[UAcute]n divisor es\>\"", 
          "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Return", "[", 
          RowBox[{"q", "[", "x", "]"}], "]"}]}], ",", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "m", "]"}], "\[Equal]", "3"}], ",", 
          RowBox[{"Euclides2", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"q", "[", "x", "]"}], ",", 
             RowBox[{
              RowBox[{"d", "[", "x", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"m", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "}"}], "]"}], ",", 
          RowBox[{"Euclides2", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"q", "[", "x", "]"}], ",", 
             RowBox[{
              RowBox[{"d", "[", "x", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}]}], "]"}]}], 
       "]"}]}]}], "]"}]}], ";"}]], "Code",
 CellChangeTimes->{3.9530085896711273`*^9},
 CellLabel->"In[3]:=",ExpressionUUID->"29e37332-b8df-484b-bde3-3610cae1ec62"],

