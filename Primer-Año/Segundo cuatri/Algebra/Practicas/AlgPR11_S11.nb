Cell[TextData[{
 "Sea V el conjunto de los polinomios de grado menor o igual que 1. Definimos\
\n<p(x),q(x)>= ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "1"], 
    RowBox[{
     RowBox[{"\|01d45d", "(", "\|01d465", ")"}], 
     RowBox[{"\|01d45e", "(", "\|01d465", ")"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "dda4a254-8a4d-644f-a17b-e40de82b5406"]
}], "Text",
 CellChangeTimes->{{3.9551627424615135`*^9, 3.955162778744087*^9}, {
  3.9551628252157383`*^9, 
  3.9551628482126045`*^9}},ExpressionUUID->"61947573-3ccb-5d4b-8aa7-\
afe4bec2919e"],

Cell[CellGroupData[{

Cell["1) Demostrar que <, > es un producto escalar en V", "Subsubsection",
 CellChangeTimes->{{3.9551628597811337`*^9, 3.9551628653633976`*^9}, {
   3.955162904891697*^9, 3.955162906478405*^9}, 
   3.955162956090025*^9},ExpressionUUID->"770a673e-09ce-3646-9878-\
97b1f4783a53"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PE8", "[", 
    RowBox[{"p_", ",", "q_"}], "]"}], ":=", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"p", "[", "x", "]"}], "*", 
      RowBox[{"q", "[", "x", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"p1", "[", "x_", "]"}], ":=", 
  RowBox[{"a1", "+", 
   RowBox[{"b1", "*", "x"}]}]}], "\n", 
 RowBox[{
  RowBox[{"p2", "[", "x_", "]"}], ":=", 
  RowBox[{"a2", "+", 
   RowBox[{"b2", "*", "x"}]}]}], "\n", 
 RowBox[{
  RowBox[{"p3", "[", "x_", "]"}], ":=", 
  RowBox[{"a3", "+", 
   RowBox[{"b3", "*", "x"}]}]}], "\n", 
 RowBox[{
  RowBox[{"sumap1p2", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"p1", "[", "x", "]"}], "+", 
   RowBox[{"p2", "[", "x", "]"}]}]}], "\n", 
 RowBox[{
  RowBox[{"ap1", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"a", "*", "a1"}], "+", 
   RowBox[{"a", "*", "b1", "*", "x"}]}]}]}], "Code",
 CellChangeTimes->{{3.955163968023945*^9, 3.9551639801810627`*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"f0cd0004-e511-2f4b-9306-20eb062ebf96"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Expand", "[", 
   RowBox[{"PE8", "[", 
    RowBox[{"p1", ",", "p2"}], "]"}], "]"}], "==", 
  RowBox[{"Expand", "[", 
   RowBox[{"PE8", "[", 
    RowBox[{"p2", ",", "p1"}], "]"}], "]"}]}]], "Code",
 CellChangeTimes->{{3.955163992101433*^9, 3.955163995777582*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"43d15918-2244-3e4e-a868-abc2952990b2"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9551640281761303`*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"90b20d3c-c9cc-864c-bc47-1de460427a3f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Expand", "[", 
   RowBox[{"PE8", "[", 
    RowBox[{"sumap1p2", ",", "p3"}], "]"}], "]"}], "==", 
  RowBox[{
   RowBox[{"Expand", "[", 
    RowBox[{"PE8", "[", 
     RowBox[{"p1", ",", "p3"}], "]"}], "]"}], "+", 
   RowBox[{"Expand", "[", 
    RowBox[{"PE8", "[", 
     RowBox[{"p2", ",", "p3"}], "]"}], "]"}]}]}]], "Code",
 CellChangeTimes->{{3.9551640394212666`*^9, 3.9551640418025513`*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"a8bb3a4d-a55e-9541-a071-44e9b2d57f4d"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9551640429034386`*^9},
 CellLabel->"Out[11]=",ExpressionUUID->"38360f99-7cd7-1c44-93d6-6b274c9e0f0f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Expand", "[", 
   RowBox[{"PE8", "[", 
    RowBox[{"ap1", ",", "p2"}], "]"}], "]"}], "==", 
  RowBox[{"Expand", "[", 
   RowBox[{"a", "*", 
