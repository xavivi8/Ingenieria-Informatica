Cell[CellGroupData[{

Cell["C\[OAcute]digo", "Subsection",
 CellChangeTimes->{{3.9551621233497887`*^9, 3.955162136859989*^9}, 
   3.955162207967346*^9},ExpressionUUID->"1cde37fa-da7c-cf4c-847c-\
a98178cfb0fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "Gram", " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Gram", "[", 
      RowBox[{"base_", ",", " ", "PE_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"PE", "[", 
        RowBox[{
         RowBox[{"base", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
         RowBox[{"base", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"Length", "[", "base", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", 
         RowBox[{"Length", "[", "base", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Gram", " ", "Schmidt"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"GramSchmidt", "[", 
      RowBox[{"base_", ",", "p_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "baseortogonal", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"baseortogonal", "=", 
         RowBox[{"{", 
          RowBox[{"base", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"baseortogonal", ",", 
             RowBox[{
              RowBox[{"base", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"p", "[", 
                    RowBox[{
                    RowBox[{"base", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"baseortogonal", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "/", 
                   RowBox[{"p", "[", 
                    RowBox[{
                    RowBox[{"baseortogonal", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ",", 
                    RowBox[{"baseortogonal", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ")"}], "*", 
                 RowBox[{"baseortogonal", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "i"}], "}"}]}], "]"}]}]}], "]"}], ";"}], 
          " ", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"M\[EAcute]todo", " ", "de", " ", "Gram"}], "-", 
            "Schmidt"}], "*)"}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{
             RowBox[{"Length", "[", "base", "]"}], "-", "1"}]}], "}"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "baseortogonal", "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", "Norma", " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Norma", "[", 
      RowBox[{"x_", ",", "p_"}], "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"p", "[", 
       RowBox[{"x", ",", "x"}], "]"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", "Coordenadas", " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Coordenadas", "[", 
      RowBox[{"X_", ",", "B_"}], "]"}], ":=", 
     RowBox[{"LinearSolve", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", "B", "]"}], ",", "X"}], "]"}]}], ";"}], "\n",
    "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Cambio", " ", "de", " ", "base"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"CambioBase", "[", 
      RowBox[{"B1_", ",", "B2_"}], "]"}], ":=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Coordenadas", "[", 
         RowBox[{
          RowBox[{"B1", "[", 
           RowBox[{"[", "i", "]"}], "]"}], ",", "B2"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "B1", "]"}]}], "}"}]}], "]"}], "]"}]}], 
    ";"}]}]}]], "Code",
 CellChangeTimes->{{3.955163657790983*^9, 3.9551636829105625`*^9}, {
  3.955163809936945*^9, 3.9551638148680725`*^9}, {3.9551642093526325`*^9, 
  3.955164234872284*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"89f22456-7490-8944-9561-a68f0cbc7836"]
}, Open  ]],

