Cell[CellGroupData[{

Cell["\<\
c) Utilizar Gram - Schmidt para calcular una base ortonormal que contenga al \
vector (1, 1)\
\>", "Subsubsection",
 CellChangeTimes->{{3.9551631261549416`*^9, 
  3.9551631416262894`*^9}},ExpressionUUID->"fae633aa-2f54-2c49-881e-\
939265347829"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"B9c", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"B1", "=", 
   RowBox[{"GramSchmidt", "[", 
    RowBox[{"B9c", ",", "PE9"}], "]"}]}], ";"}], "\n", 
 RowBox[{"B2", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"B1", "[", 
      RowBox[{"[", "i", "]"}], "]"}], "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"PE9", "[", 
       RowBox[{
        RowBox[{"B1", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{"B1", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"Length", "[", "B1", "]"}]}], "}"}]}], "]"}]}]}], "Code",
 CellChangeTimes->{{3.955164457215372*^9, 3.955164470401024*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"4b76c63d-f9a8-534b-9efc-c9ac530dfa34"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", 
      SqrtBox["5"]], ",", 
     FractionBox["1", 
      SqrtBox["5"]]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["3", 
       SqrtBox["5"]]}], ",", 
     FractionBox["2", 
      SqrtBox["5"]]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9551644735488377`*^9},
 CellLabel->"Out[48]=",ExpressionUUID->"5552c631-bd55-a241-bfd9-e5617dd166c7"]
}, Open  ]]
}, Closed]]
}, Closed]],

