Cell[CellGroupData[{

Cell["C\[OAcute]digo", "Subsection",
 CellChangeTimes->{{3.9551621233497887`*^9, 3.955162136859989*^9}, 
   3.955162207967346*^9},ExpressionUUID->"1cde37fa-da7c-cf4c-847c-\
a98178cfb0fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "Gram", " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Gram", "[", 
      RowBox[{"base_", ",", " ", "PE_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"PE", "[", 
        RowBox[{
         RowBox[{"base", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
         RowBox[{"base", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"Length", "[", "base", "]"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", 
         RowBox[{"Length", "[", "base", "]"}]}], "}"}]}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Gram", " ", "Schmidt"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"GramSchmidt", "[", 
      RowBox[{"base_", ",", "p_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "baseortogonal", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"baseortogonal", "=", 
         RowBox[{"{", 
          RowBox[{"base", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"baseortogonal", ",", 
             RowBox[{
              RowBox[{"base", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"p", "[", 
                    RowBox[{
                    RowBox[{"base", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"baseortogonal", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "/", 
                   RowBox[{"p", "[", 
                    RowBox[{
                    RowBox[{"baseortogonal", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ",", 
                    RowBox[{"baseortogonal", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ")"}], "*", 
                 RowBox[{"baseortogonal", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "i"}], "}"}]}], "]"}]}]}], "]"}], ";"}], 
          " ", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"M\[EAcute]todo", " ", "de", " ", "Gram"}], "-", 
            "Schmidt"}], "*)"}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{
             RowBox[{"Length", "[", "base", "]"}], "-", "1"}]}], "}"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "baseortogonal", "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", "Norma", " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Norma", "[", 
      RowBox[{"x_", ",", "p_"}], "]"}], ":=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"p", "[", 
       RowBox[{"x", ",", "x"}], "]"}], "]"}]}], ";"}]}]}]], "Code",
 CellChangeTimes->{{3.955163657790983*^9, 3.9551636829105625`*^9}, {
  3.955163809936945*^9, 3.9551638148680725`*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"89f22456-7490-8944-9561-a68f0cbc7836"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Ejercicio 7: Rel 4", "Subsection",
 CellChangeTimes->{{3.9551621383595066`*^9, 
  3.955162149593796*^9}},ExpressionUUID->"0bad1a1e-8820-ab47-ac0e-\
db795c6cfaa9"],

Cell["\<\
Consideramos V un espacio vectorial de dimensi\[OAcute]n 3, y <,> un producto \
escalar respecto de una base B={u1,u2,u3} verifica:
< u1, u1>=1, < u1, u2>=1, < u1, u3>=1,
< u2, u2>=2, < u2, u3>=2, < u3, u3>=3
Se pide:\
\>", "Text",
 CellChangeTimes->{{3.9551622464983826`*^9, 
  3.955162304774679*^9}},ExpressionUUID->"f485b5b5-cec8-454a-82aa-\
36fc851fec54"],

Cell[CellGroupData[{

Cell["a) Calcular la matriz de Gram respecto a la base can\[OAcute]nica", \
"Subsubsection",
 CellChangeTimes->{{3.955162307644617*^9, 3.955162308361864*^9}, {
  3.9551624259161453`*^9, 
  3.9551624441512585`*^9}},ExpressionUUID->"110a05a2-96c6-b04c-b987-\
b5bc99544b52"],

Cell[BoxData[
 RowBox[{
  RowBox[{"G", "=", 
   RowBox[{"(", GridBox[{
      {"1", "1", "1"},
      {"1", "2", "2"},
      {"1", "2", "3"}
     }], ")"}]}], ";"}]], "Code",
 CellChangeTimes->{{3.955163623189863*^9, 3.955163641050888*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"049fe2e6-4679-1546-80e0-f0c6e90990d8"]
}, Closed]],

Cell[CellGroupData[{

Cell["b) Calcular la expresi\[OAcute]n del producto escalar", "Subsubsection",
 CellChangeTimes->{{3.955162312312519*^9, 3.95516231263562*^9}, {
  3.955162408847658*^9, 
  3.9551624236611404`*^9}},ExpressionUUID->"69f17085-4ad6-1a49-b1bd-\
75405e1a942a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PE", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"Expand", "[", 
    RowBox[{"x", ".", "G", ".", "y"}], "]"}]}], ";"}], "\n", 
 RowBox[{"PE", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["x", "1"], ",", 
     SubscriptBox["x", "2"], ",", 
     SubscriptBox["x", "3"]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["y", "1"], ",", 
     SubscriptBox["y", "2"], ",", 
     SubscriptBox["y", "3"]}], "}"}]}], "]"}]}], "Code",
 CellChangeTimes->{3.955163698876606*^9},
 CellLabel->"In[24]:=",ExpressionUUID->"03aa85a7-e1e0-fb41-9d69-8fd4a0fec967"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["x", "1"], " ", 
   SubscriptBox["y", "1"]}], "+", 
  RowBox[{
   SubscriptBox["x", "2"], " ", 
   SubscriptBox["y", "1"]}], "+", 
  RowBox[{
   SubscriptBox["x", "3"], " ", 
   SubscriptBox["y", "1"]}], "+", 
  RowBox[{
   SubscriptBox["x", "1"], " ", 
   SubscriptBox["y", "2"]}], "+", 
  RowBox[{"2", " ", 
   SubscriptBox["x", "2"], " ", 
   SubscriptBox["y", "2"]}], "+", 
  RowBox[{"2", " ", 
   SubscriptBox["x", "3"], " ", 
   SubscriptBox["y", "2"]}], "+", 
  RowBox[{
   SubscriptBox["x", "1"], " ", 
   SubscriptBox["y", "3"]}], "+", 
  RowBox[{"2", " ", 
   SubscriptBox["x", "2"], " ", 
   SubscriptBox["y", "3"]}], "+", 
  RowBox[{"3", " ", 
   SubscriptBox["x", "3"], " ", 
   SubscriptBox["y", "3"]}]}]], "Output",
 CellChangeTimes->{3.9551637016282005`*^9},
 CellLabel->"Out[25]=",ExpressionUUID->"0263c9ac-74b2-944d-bdbb-e57f8d4702e7"]
}, Open  ]]
}, Closed]],

