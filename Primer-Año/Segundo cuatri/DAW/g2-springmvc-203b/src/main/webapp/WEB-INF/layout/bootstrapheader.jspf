<%@ taglib prefix="c" uri="jakarta.tags.core" %>

<!-- Bootstrap 5.0.0 WebJar (sin carpeta dist) -->
<c:url var="bootstrapMinCss" value="/webjars/bootstrap/5.0.0/css/bootstrap.min.css" />
<link rel="stylesheet" href="${bootstrapMinCss}" />

<c:url var="bootstrapBundleJs" value="/webjars/bootstrap/5.0.0/js/bootstrap.bundle.min.js" />
<script src="${bootstrapBundleJs}"></script>
