Cell[TextData[{
 "Soluci\[OAcute]n:\nEn el m\[EAcute]todo de Euler, aproximamos los valores \
de la funci\[OAcute]n soluci\[OAcute]n de la ecuaci\[OAcute]n diferencial \
utilizando el valor de la derivada.\n\nLa ecuaci\[OAcute]n diferencial es y\
\[CloseCurlyQuote](x)=f(x,y), en este caso es y\[CloseCurlyQuote](x) = x*y(x) \
+ x + 2; con f(x,y) = x*y + x + 2.\nEl punto inicial es ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "3595b2c2-94db-4f3e-acff-8971a863b80e"],
 "= 1, la condici\[OAcute]n inicial es y(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "36f033c5-f21c-4e0d-b4e2-0550b49547c1"],
 ")= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "b819ab2f-1d41-4960-bf7a-bf9a01ada603"],
 " = 1, el paso es h=1 (para en dos pasos, llegar desde el 1 al 3).\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "n"], TraditionalForm]],ExpressionUUID->
  "c9e03e4b-2085-4066-a79f-1005849c0f60"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "a8515dde-fb39-4a18-8435-8920c9f5cea5"],
 " + n h, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "n"], TraditionalForm]],ExpressionUUID->
  "ba831fc5-3bf7-48ed-91a9-9e8f8104cda7"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "b9b4fbeb-410a-42bb-8abc-b7df8daad4da"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "2c4e67fb-1f5d-4719-be73-5701f81b4d1d"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "8b8d8875-01d8-4071-becc-e234680cb036"],
 ")\n\nCalculamos ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "0"], "=", "1"}], ",", " ", 
    SubscriptBox["y", "0"]}], TraditionalForm]],ExpressionUUID->
  "73e234ea-9669-4bc3-89fb-bd8ea3daa283"],
 " = 1, \n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "0aeff9df-9b40-40ae-9b7c-7987fd5d9608"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "afac4785-ff66-4c36-bc6a-1759fd54f6b8"],
 " + h = 1 + 1 = 2; ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "bee7e065-17d2-4d6e-847b-8667d5e9339a"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "00663310-5aba-475d-b12f-a5c254b66005"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "b82aaa6f-cd05-41af-a6bf-76c66b807446"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "439187eb-2e12-45a3-97f4-582a43031132"],
 ") = 1 + 1*f(1,1) = 1 + (1*1 + 1 + 2)=5.\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "bfebdb80-97b5-4024-986a-faef154e852e"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "09af495d-adf9-40ae-aefd-a17c3459dc02"],
 " + h = 2 + 1 = 3; ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "13b17271-a017-4058-92c5-60ec2b00acc0"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "1834719e-2cc2-4249-a8e5-68d43ca7f3ad"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "a9a01b03-bf42-4fce-98af-44fee4fe22a3"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "dc62842b-8089-447a-9089-d63e9f1a809e"],
 ") = 5 + 1*f(1,5) = 5 + (2*5 + 2 + 2)=19.\n\nDe esta forma, y(3) \
\[TildeEqual] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "e99a879c-9ccb-4809-b5ac-3440df0f5f3e"],
 "=19."
}], "Text",
