Cell[TextData[{
 "Soluci\[OAcute]n:\nEn el m\[EAcute]todo de Euler, aproximamos los valores \
de la funci\[OAcute]n soluci\[OAcute]n de la ecuaci\[OAcute]n diferencial \
utilizando el valor de la derivada.\n\nLa ecuaci\[OAcute]n diferencial es y\
\[CloseCurlyQuote](x)=f(x,y), en este caso es y\[CloseCurlyQuote](x) = x y(x) \
+ x + 2; con f(x,y) = x y + x + 2.\nEl punto inicial es ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "ef09cb60-7c6e-4559-9c1e-f9f36aa07e0e"],
 "= 0, la condici\[OAcute]n inicial es y(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "8afe2a14-386b-4f87-a85e-2c2d050c1eb7"],
 ")= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "c61da84e-d19f-49ed-8ee5-9f39f614ca78"],
 " = 1, el paso es h=1 (para en dos pasos, llegar desde el 0 al 2).\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "n"], TraditionalForm]],ExpressionUUID->
  "f92956be-f37d-47b9-8bd7-80266604e58b"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "6d97f01e-88b7-4bba-85e4-f41811d75ce1"],
 " + n h, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "n"], TraditionalForm]],ExpressionUUID->
  "d6e5b5b6-29f4-4cf2-bf69-f73577e66656"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "6feed231-5fe7-41df-a0d3-372ef78b1e07"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "cfe5ad3c-bea2-44d3-ba73-b38eebde47d8"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "007c3c89-decc-4661-913b-74f938c22b83"],
 ")\n\nCalculamos ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "0"], "=", "0"}], ",", " ", 
    SubscriptBox["y", "0"]}], TraditionalForm]],ExpressionUUID->
  "dc1f686d-11c0-4e27-ae28-2af7b442e6d0"],
 " = 1, \n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "30b1de5c-270a-48dd-bd09-f2c9b42bab96"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "99d9caf0-ba6c-46fa-a6b5-35bedf854dd4"],
 " + h = 0 + 1 = 1; ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "ca78fca1-d7a5-4086-80e0-c110290497dc"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "3c20cc8b-e4ce-4b8c-9e58-273577ed2236"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "95068c3a-edb1-4716-80eb-88519a479685"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "225f155f-1f3c-4519-850f-67c0d8334bfd"],
 ") = 1 + 1*f(0,1) = 1 + (0*1 + 0 + 2)=3.\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "4bed14bd-015c-4fb3-87f7-e7b985c6e3b9"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "1037d1b6-559d-4d72-bb85-4b80c627d3dc"],
 " + h = 1 + 1 = 2; ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "447d4ebe-6a58-4a0d-8a12-86886531f93f"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "26d5fc02-afe0-4187-8efc-62ce13c4e061"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "c49b7d53-723f-40d4-b8de-a74e60675782"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "bcf67f30-a636-4644-927b-4c4ef0bd0bac"],
 ") = 3 + 1*f(1,3) = 3 + (1*3 + 1 + 2)=9.\n\nDe esta forma, y(2) \
\[TildeEqual] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "a9871341-8ee3-45ad-8670-c3db46b95a2c"],
 "=9."
}], "Text",
 CellChangeTimes->{{3.610967983265625*^9, 3.610968082640625*^9}, {
   3.6109681208125*^9, 3.61096812653125*^9}, {3.610976777453125*^9, 
   3.610976922484375*^9}, {3.610977092296875*^9, 3.610977288828125*^9}, {
   3.6109957936514254`*^9, 3.6109958150390635`*^9}, 3.6109962528538322`*^9, {
