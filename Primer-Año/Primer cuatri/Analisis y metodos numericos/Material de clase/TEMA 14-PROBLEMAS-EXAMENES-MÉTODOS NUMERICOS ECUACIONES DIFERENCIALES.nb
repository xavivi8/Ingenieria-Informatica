 RowBox[{
  RowBox[{"y0", "=", "1"}], ";", 
  RowBox[{"h", "=", "0.5"}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"k1", "=", 
      RowBox[{"f", "[", 
       RowBox[{"x0", ",", "y0"}], "]"}]}], ";", 
     RowBox[{"k2", "=", 
      RowBox[{"f", "[", 
       RowBox[{
        RowBox[{"x0", "+", 
         RowBox[{"h", "/", "2"}]}], ",", 
        RowBox[{"y0", "+", 
