Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"x0", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"y0", "=", "1"}], ";", 
  RowBox[{"h", "=", "0.5"}], ";", 
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"k1", "=", 
      RowBox[{"f", "[", 
       RowBox[{"x0", ",", "y0"}], "]"}]}], ";", 
     RowBox[{"k2", "=", 
      RowBox[{"f", "[", 
       RowBox[{
        RowBox[{"x0", "+", 
         RowBox[{"h", "/", "2"}]}], ",", 
        RowBox[{"y0", "+", 
         RowBox[{"k1", " ", 
          RowBox[{"h", "/", "2"}]}]}]}], "]"}]}], ";", 
     RowBox[{"k3", "=", 
      RowBox[{"f", "[", 
       RowBox[{
        RowBox[{"x0", "+", 
         RowBox[{"h", "/", "2"}]}], ",", 
        RowBox[{"y0", "+", 
         RowBox[{"k2", " ", 
          RowBox[{"h", "/", "2"}]}]}]}], "]"}]}], ";", 
     RowBox[{"k4", "=", 
      RowBox[{"f", "[", 
       RowBox[{
        RowBox[{"x0", "+", "h"}], ",", 
        RowBox[{"y0", "+", 
         RowBox[{"k3", " ", "h"}]}]}], "]"}]}], ";", 
     RowBox[{"y0", "=", 
      RowBox[{"y0", "+", 
       RowBox[{"h", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"k1", "+", 
           RowBox[{"2", "k2"}], "+", 
           RowBox[{"2", "k3"}], "+", "k4"}], ")"}], "/", "6"}]}]}]}], ";", 
     " ", 
     RowBox[{"x0", "=", 
      RowBox[{"x0", "+", "h"}]}], ";", 
     RowBox[{"Print", "[", 
      RowBox[{
      "\"\<En \>\"", " ", ",", "x0", ",", "\"\< vale aprox. \>\"", ",", 
       "y0"}], "]"}]}], ",", 
    RowBox[{"{", "4", "}"}]}], "]"}]}]}], "Input",
