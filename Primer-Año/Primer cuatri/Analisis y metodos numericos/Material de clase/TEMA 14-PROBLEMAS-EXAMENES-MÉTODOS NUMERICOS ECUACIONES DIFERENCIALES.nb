Cell[CellGroupData[{

Cell["\<\

 \t13.- Dada la ecuaci\[OAcute]n diferencial y\[CloseCurlyQuote](x) = 2 x \
y(x) + 1 junto con la condici\[OAcute]n inicial y(0)=2, utilizar el \
m\[EAcute]todo de Euler para aproximar y(1) con paso 0.5.
\tOctubre 22\t\
\>", "Section",
 CellChangeTimes->{{3.500751345359375*^9, 3.500751379984375*^9}, {
   3.500790035609375*^9, 3.500790048953125*^9}, {3.569509423875*^9, 
   3.56950942659375*^9}, {3.570537368580125*^9, 3.57053737997075*^9}, {
   3.599199111625*^9, 3.5991991196875*^9}, {3.723477468774*^9, 
   3.723477473212*^9}, {3.723478212648*^9, 3.723478232406*^9}, {
   3.723478462157*^9, 3.723478463176*^9}, {3.723478670633*^9, 
   3.723478671652*^9}, {3.72356892631*^9, 3.7235690780550003`*^9}, {
   3.723569130146*^9, 3.723569177783*^9}, {3.7235692175769997`*^9, 
   3.723569247399*^9}, {3.723569308648*^9, 3.723569328826*^9}, {
   3.723569485984*^9, 3.723569513233*^9}, {3.7236081819960003`*^9, 
   3.7236083309300003`*^9}, {3.7236509376520233`*^9, 3.7236509459610233`*^9}, 
   3.7236517258530235`*^9, 3.723651765606024*^9, {3.7236521565550237`*^9, 
   3.7236522309350233`*^9}, {3.7238353873130035`*^9, 3.723835410693304*^9}, {
   3.7239071598070183`*^9, 3.723907162602418*^9}, {3.724158365534717*^9, 
   3.724158429733717*^9}, {3.724164938261321*^9, 3.724164963029321*^9}, 
   3.7254239244656124`*^9, {3.819906851493*^9, 3.8199068540039997`*^9}, 
   3.821078952863801*^9, 3.852292062240802*^9, 3.882707267537986*^9, {
   3.882707594149387*^9, 3.882707595921489*^9}, 3.88270764296146*^9, {
   3.882707760772815*^9, 3.8827077692617764`*^9}, {3.906788505837646*^9, 
   3.906788506477516*^9}, {3.9139156030488815`*^9, 3.913915607448875*^9}, {
   3.9139156917258863`*^9, 3.9139157027459135`*^9}},
 FontFamily->"Arial",
 FontSize->14,
 FontColor->RGBColor[0., 0.25098039215686274`, 0.5019607843137255],
 Background->RGBColor[
  0.807843137254902, 0.9058823529411765, 
   1.],ExpressionUUID->"97205f79-f581-415a-9c07-dd92eb676116"],

Cell[TextData[{
 "Soluci\[OAcute]n:\nEn el m\[EAcute]todo de Euler, aproximamos los valores \
de la funci\[OAcute]n soluci\[OAcute]n de la ecuaci\[OAcute]n diferencial \
utilizando el valor de la derivada.\n\nLa ecuaci\[OAcute]n diferencial es y\
\[CloseCurlyQuote](x)=f(x,y), en este caso es y\[CloseCurlyQuote](x) = 2 x \
y(x) + 1; con f(x,y) = 2 x y + 1.\nEl punto inicial es ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "83ac3ab9-a6bc-42a4-b216-4e5ec478bf0b"],
 "= 0, la condici\[OAcute]n inicial es y(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "c715f3c6-bfe8-451c-a4b9-2a54f62128d4"],
 ")= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "b6e5b76e-56ce-46c2-8114-f0c8bd18f8a5"],
 " = 2, el paso es h=1/2 (para en dos pasos, llegar desde el 0 al 1).\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "n"], TraditionalForm]],ExpressionUUID->
  "fa6bdb72-ecc6-4187-ad08-19f1af155196"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "099d4a7e-2a04-4c7b-89e0-cb73ef0421b3"],
 " + n h, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "n"], TraditionalForm]],ExpressionUUID->
  "9c917cad-fd01-402b-8bff-a548d5c92721"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "da5944bf-fc1e-4767-891e-4d7a5c0c4a19"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "8682a93d-9c80-463f-9035-46be6d652c91"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "d132943e-c23b-4509-b8ad-51080ed2ddb2"],
 ")\n\nCalculamos ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "0"], "=", "0"}], ",", " ", 
    SubscriptBox["y", "0"]}], TraditionalForm]],ExpressionUUID->
  "9f17c1aa-2f31-47ab-a8bd-5b3bc804ecdd"],
 " = 2, \n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "7a3895e2-c6cd-4563-b6c0-928a40891d6a"],
 "= 0 + h = 1/2 = 3/2;\t\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "7faa1a5f-12ce-4c7d-8660-4125c136d50a"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "c0aead32-bb93-4954-8ffa-15e727bf65d8"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "f3a59dae-8109-473c-9560-15d7934bd7d4"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "ae6ac4b1-0d1f-47bc-b210-ba11cc18292d"],
 ") = 2 + (1/2)*f(0,2) = 2 + (1/2)(2*0*1+1)=5/2.\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "93daa994-f3bc-4f7a-9c53-33b7ad200d0d"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "74a8baf4-3a00-49eb-a7a3-05db59a6fc45"],
 " + h = 1/2 + 1/2 = 1; \t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "2fed41f9-bc1b-492f-adbb-290de9f73745"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "f3817832-3d60-4639-8d87-61cbe1bcbbbe"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "3e481434-52d3-42a8-80a4-6ff883e875af"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "ea50af7a-f33d-4dc9-9c88-298935b75a87"],
 ") = 5/2 + (1/2)*f(1/2,5/2) = 5/2 + (1/2) (2*(1/2)*(5/2)+1) = 5/2 + (1/2) \
(7/2) = (10+7)/2 = 17/2..\n\nDe esta forma, aproximamos y(2) \[TildeEqual] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "93c91273-b8d4-4870-82ea-1e0017d4345f"],
 "=17/2."
}], "Text",
 CellChangeTimes->{{3.610967983265625*^9, 3.610968082640625*^9}, {
   3.6109681208125*^9, 3.61096812653125*^9}, {3.610976777453125*^9, 
   3.610976922484375*^9}, {3.610977092296875*^9, 3.610977288828125*^9}, {
   3.6109957936514254`*^9, 3.6109958150390635`*^9}, 3.6109962528538322`*^9, {
   3.6424694360273438`*^9, 3.6424694787837896`*^9}, {3.6424700316294107`*^9, 
   3.6424700321944427`*^9}, {3.6424720136857777`*^9, 3.642472061084489*^9}, {
   3.6454100586949635`*^9, 3.6454100770310125`*^9}, 3.645410430082206*^9, {
   3.6624089952532687`*^9, 3.6624090425009713`*^9}, {3.662409267561844*^9, 
   3.662409459075798*^9}, {3.6624097101341577`*^9, 3.6624097110942125`*^9}, {
   3.662433188751014*^9, 3.6624332023592386`*^9}, {3.6938415743082104`*^9, 
   3.693841703835619*^9}, {3.693842309229245*^9, 3.693842342670158*^9}, {
   3.7076626173158207`*^9, 3.7076627588878202`*^9}, {3.7076629091388206`*^9, 
   3.70766292683782*^9}, {3.7076636380288205`*^9, 3.7076636438088207`*^9}, {
   3.70766570065182*^9, 3.7076657036808205`*^9}, 3.724512190180803*^9, {
   3.72451659757423*^9, 3.72451659821883*^9}, {3.72452130307646*^9, 
   3.7245213484978604`*^9}, {3.819895503528*^9, 3.819895535209*^9}, {
   3.8198959172390003`*^9, 3.8198959365769997`*^9}, {3.8211023766244063`*^9, 
   3.8211024699298067`*^9}, {3.8211025030238066`*^9, 
   3.8211029826644063`*^9}, {3.8211030512394066`*^9, 3.821103192595007*^9}, {
   3.8211032337422066`*^9, 3.8211032496824064`*^9}, {3.852292074865737*^9, 
   3.8522922980645294`*^9}, {3.8827073404100776`*^9, 
   3.8827074938193035`*^9}, {3.882707528352394*^9, 3.882707550525609*^9}, {
   3.8827075892686434`*^9, 3.882707591589325*^9}, 3.882707645609621*^9, {
   3.8827077787715235`*^9, 3.8827078973167715`*^9}, {3.882707939551778*^9, 
   3.882707959265574*^9}, {3.8830612099736223`*^9, 3.8830612139947853`*^9}, {
   3.91391573041109*^9, 3.9139158828061056`*^9}, {3.9139159190056477`*^9, 
   3.913916176401235*^9}},
 FontSize->16,ExpressionUUID->"7ee2c769-50e4-4d31-80c6-81aa82ccc75b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\

 \t13.- Dada la ecuaci\[OAcute]n diferencial y\[CloseCurlyQuote](x) = 2 x \
y(x) + 1 junto con la condici\[OAcute]n inicial y(0)=2, utilizar el \
m\[EAcute]todo de Euler para aproximar y(1) con paso 0.5.
\tOctubre 21\t\
\>", "Section",
 CellChangeTimes->{{3.500751345359375*^9, 3.500751379984375*^9}, {
   3.500790035609375*^9, 3.500790048953125*^9}, {3.569509423875*^9, 
   3.56950942659375*^9}, {3.570537368580125*^9, 3.57053737997075*^9}, {
   3.599199111625*^9, 3.5991991196875*^9}, {3.723477468774*^9, 
   3.723477473212*^9}, {3.723478212648*^9, 3.723478232406*^9}, {
   3.723478462157*^9, 3.723478463176*^9}, {3.723478670633*^9, 
   3.723478671652*^9}, {3.72356892631*^9, 3.7235690780550003`*^9}, {
   3.723569130146*^9, 3.723569177783*^9}, {3.7235692175769997`*^9, 
   3.723569247399*^9}, {3.723569308648*^9, 3.723569328826*^9}, {
   3.723569485984*^9, 3.723569513233*^9}, {3.7236081819960003`*^9, 
   3.7236083309300003`*^9}, {3.7236509376520233`*^9, 3.7236509459610233`*^9}, 
   3.7236517258530235`*^9, 3.723651765606024*^9, {3.7236521565550237`*^9, 
   3.7236522309350233`*^9}, {3.7238353873130035`*^9, 3.723835410693304*^9}, {
   3.7239071598070183`*^9, 3.723907162602418*^9}, {3.724158365534717*^9, 
   3.724158429733717*^9}, {3.724164938261321*^9, 3.724164963029321*^9}, {
   3.7254239244656124`*^9, 3.7254239449172125`*^9}, 3.725424049640013*^9, 
   3.725424176748814*^9, {3.844055296826615*^9, 3.844055324797415*^9}, {
   3.90698721059918*^9, 3.9069872111319914`*^9}, {3.9429894759816103`*^9, 
   3.942989481459014*^9}},
 FontFamily->"Arial",
 FontSize->14,
 FontColor->RGBColor[0., 0.25098039215686274`, 0.5019607843137255],
 Background->RGBColor[
  0.807843137254902, 0.9058823529411765, 
   1.],ExpressionUUID->"e9ead504-fd06-4923-8b46-d888cb387265"],

Cell[TextData[{
 "Soluci\[OAcute]n: \nConocemos el valor y(0) (por ser la condici\[OAcute]n \
inicial). Como nos piden aproximar y(1) con paso 0.5, tendremos que aplicar \
dos veces el m\[EAcute]todo de Euler, del 0 al 0.5 y del 0.5 al 1.\ny\
\[CloseCurlyQuote](x) = 2 x y(x) + 1\ny(0)=2\n\nf(x,y)=2xy+1\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "d6a8d8b8-648d-43b8-8676-2f02d5d142d7"],
 "=0\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "96ac6721-3e1b-48af-b194-ae65f885ee7c"],
 "=2\nh=0.5\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "n"], TraditionalForm]],ExpressionUUID->
  "0199d4cd-b18f-4e81-b988-5f09c1073c3a"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "82c3b33a-a037-40dc-b05b-02364f6db127"],
 "+ nh\n\ny(0.5)  \[TildeEqual]  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "ef381426-027d-40c6-8b07-2a7bc46a89ec"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "0ef8ab4f-0059-428c-a4ae-618da04c68c1"],
 " + h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "789c9da8-88da-46eb-8267-1256421fc3c1"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "8f5756df-69b4-4944-8f55-6e6ad678fd49"],
 ") = 2 + 0.5 f(0,2) = 2 + 0.5*(2*0*2+1) = 2.5\ny(1)  \[TildeEqual]  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "e4fff67b-3f28-4139-ac96-ca3228a1c319"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "e39fbc2e-b23a-42cf-a0fe-225615c4fd6c"],
 " + h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "3220a76f-33d8-415b-9eb5-b2d4f2824ea2"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "e86c81b6-157f-469e-8dd3-bf74827b893b"],
 ") = 2.5 + 0.5 f(0.5, 2.5) = 2.5 + 0.5*(2*0.5*2.5+1) = 2.5+1.75 = 4.25"
}], "Text",
 CellChangeTimes->{{3.725422492619603*^9, 3.7254227251220045`*^9}, {
   3.725422756088005*^9, 3.7254230246732063`*^9}, {3.725423062628007*^9, 
   3.725423114872407*^9}, {3.725423164995208*^9, 3.7254232007036076`*^9}, {
   3.725423239937608*^9, 3.7254233041004086`*^9}, {3.7254238586336117`*^9, 
   3.7254238641404123`*^9}, {3.913977435780467*^9, 3.913977463151664*^9}, {
   3.913977495751896*^9, 3.913977533681931*^9}, {3.913977569656954*^9, 
   3.9139775805261765`*^9}, {3.9139776909782114`*^9, 3.913977724710778*^9}, 
   3.913977782612822*^9},ExpressionUUID->"0f61ed40-b056-4ce9-9077-\
e79542239ce4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\

 \t13.- Dada la ecuaci\[OAcute]n diferencial y\[CloseCurlyQuote](x) = y(x) + \
x + 2 junto con la condici\[OAcute]n inicial y(1)=1, utilizar el \
m\[EAcute]todo de Euler para aproximar y(3) con paso 1.
\tJunio 21\t\
\>", "Section",
 CellChangeTimes->{{3.500751345359375*^9, 3.500751379984375*^9}, {
   3.500790035609375*^9, 3.500790048953125*^9}, {3.569509423875*^9, 
   3.56950942659375*^9}, {3.570537368580125*^9, 3.57053737997075*^9}, {
   3.599199111625*^9, 3.5991991196875*^9}, {3.723477468774*^9, 
   3.723477473212*^9}, {3.723478212648*^9, 3.723478232406*^9}, {
   3.723478462157*^9, 3.723478463176*^9}, {3.723478670633*^9, 
   3.723478671652*^9}, {3.72356892631*^9, 3.7235690780550003`*^9}, {
   3.723569130146*^9, 3.723569177783*^9}, {3.7235692175769997`*^9, 
   3.723569247399*^9}, {3.723569308648*^9, 3.723569328826*^9}, {
   3.723569485984*^9, 3.723569513233*^9}, {3.7236081819960003`*^9, 
   3.7236083309300003`*^9}, {3.7236509376520233`*^9, 3.7236509459610233`*^9}, 
   3.7236517258530235`*^9, 3.723651765606024*^9, {3.7236521565550237`*^9, 
