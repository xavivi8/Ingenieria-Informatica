   3.72451659757423*^9, 3.72451659821883*^9}, {3.7245193144148474`*^9, 
   3.7245193149044476`*^9}, {3.7245194435442486`*^9, 3.724519524402649*^9}, {
   3.7245196444144497`*^9, 3.72451967425465*^9}, {3.7245202803412533`*^9, 
   3.7245203632992544`*^9}, {3.7245212242460594`*^9, 
   3.7245212245892596`*^9}, {3.819895971867*^9, 3.819895977527*^9}, {
   3.819897139632*^9, 3.81989716323*^9}, {3.8210868558944025`*^9, 
   3.8210868759416027`*^9}, {3.8210869488060026`*^9, 
   3.8210870356724033`*^9}, {3.821087101294403*^9, 3.821087151865003*^9}, {
   3.8210876090102034`*^9, 3.821087628085603*^9}, {3.821101371471806*^9, 
   3.821101962951206*^9}, {3.821102000101406*^9, 3.821102356732806*^9}},
 FontSize->16,ExpressionUUID->"8e5d2143-552a-4d63-ad4d-ceae812afa1d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\

 \t13.- Dada la ecuaci\[OAcute]n diferencial y\[CloseCurlyQuote]= 2x - 3 y + \
1 junto con la condici\[OAcute]n inicial y(2)=3, utilizar el m\[EAcute]todo \
de Euler para aproximar y(3) con paso 0.5.
\tOctubre 18, Julio 18\t\
\>", "Section",
 CellChangeTimes->{{3.500751345359375*^9, 3.500751379984375*^9}, {
   3.500790035609375*^9, 3.500790048953125*^9}, {3.569509423875*^9, 
   3.56950942659375*^9}, {3.570537368580125*^9, 3.57053737997075*^9}, {
   3.599199111625*^9, 3.5991991196875*^9}, {3.723477468774*^9, 
   3.723477473212*^9}, {3.723478212648*^9, 3.723478232406*^9}, {
   3.723478462157*^9, 3.723478463176*^9}, {3.723478670633*^9, 
   3.723478671652*^9}, {3.72356892631*^9, 3.7235690780550003`*^9}, {
   3.723569130146*^9, 3.723569177783*^9}, {3.7235692175769997`*^9, 
   3.723569247399*^9}, {3.723569308648*^9, 3.723569328826*^9}, {
   3.723569485984*^9, 3.723569513233*^9}, {3.7236081819960003`*^9, 
   3.7236083309300003`*^9}, {3.7236509376520233`*^9, 3.7236509459610233`*^9}, 
   3.7236517258530235`*^9, 3.723651765606024*^9, {3.7236521565550237`*^9, 
