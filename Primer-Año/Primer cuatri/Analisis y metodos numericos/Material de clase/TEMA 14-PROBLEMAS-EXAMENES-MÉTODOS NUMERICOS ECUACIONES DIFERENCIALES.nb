Cell[TextData[{
 "Soluci\[OAcute]n:\nEn el m\[EAcute]todo de Euler, aproximamos los valores \
de la funci\[OAcute]n soluci\[OAcute]n de la ecuaci\[OAcute]n diferencial \
utilizando el valor de la derivada.\n\nLa ecuaci\[OAcute]n diferencial es y\
\[CloseCurlyQuote](x)=f(x,y), en este caso es y\[CloseCurlyQuote](x) = y(x) + \
x + 2; con f(x,y) = y + x + 2.\nEl punto inicial es ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "34cce305-59da-4641-a0b3-0e9bd4c381e8"],
 "= 1, la condici\[OAcute]n inicial es y(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "be67fe92-cce4-45f7-8821-73bdb8c192f1"],
 ")= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "211b4463-80f7-46a0-bb9d-9ca6747d7e38"],
 " = 1, el paso es h=1 (para en dos pasos, llegar desde el 1 al 3).\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "n"], TraditionalForm]],ExpressionUUID->
  "7c89d660-79f9-40ac-88ee-5024f0d469c4"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "30d90a16-5ba4-4914-bac4-88a37a9a40f8"],
 " + n h, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "n"], TraditionalForm]],ExpressionUUID->
  "3b8368c1-e7b5-494a-8f16-6775c5b37969"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "1be14106-db92-4c3f-b908-44b913c75c0b"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "43fef856-cab6-4c68-a869-c3a08247b6d4"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "bb914c89-6041-488c-9087-54a942dc600b"],
 ")\n\nCalculamos ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "0"], "=", "1"}], ",", " ", 
    SubscriptBox["y", "0"]}], TraditionalForm]],ExpressionUUID->
  "2afd1127-e7d3-42f0-9073-8698eaa1f316"],
 " = 1, \n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "9edefdd8-45cc-4736-a8fc-539e7c7728e1"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "feda6b44-9315-4bb7-bb5b-68689d108985"],
 " + h = 1 + 1 = 2; ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "a75a5bd0-0d11-4f79-8116-49ddc708a5bf"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "d0fb3401-2da6-48f5-a1c1-06470af73b43"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "7c20dd41-40df-4786-a49a-2229f73a8dc1"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "3f986638-103e-4875-8ef9-a4e3f495a3a9"],
 ") = 1 + 1*f(1,1) = 1 + (1 + 1 + 2)=5.\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "d3d53687-73eb-40db-92dd-44433b65ebb3"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "0426a611-9db2-4183-9c82-c17e3f2af2ff"],
 " + h = 2 + 1 = 3; ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "1c6b965c-bbfe-4bec-b542-6efc541f0ec6"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "22349d4f-fec2-4f25-aa6e-ff20abf9d7f3"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "43c36de4-5119-4d60-a08e-e52b14510079"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "747ca9cd-6c83-47b7-9923-315f0aed2074"],
 ") = 5 + 1*f(1,5) = 5 + (5 + 2 + 2)=14.\n\nDe esta forma, y(3) \[TildeEqual] \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "d7f8f17f-0f82-4ad5-bbe6-edc1eab99a77"],
 "=14."
}], "Text",
 CellChangeTimes->{{3.610967983265625*^9, 3.610968082640625*^9}, {
   3.6109681208125*^9, 3.61096812653125*^9}, {3.610976777453125*^9, 
   3.610976922484375*^9}, {3.610977092296875*^9, 3.610977288828125*^9}, {
   3.6109957936514254`*^9, 3.6109958150390635`*^9}, 3.6109962528538322`*^9, {
