   3.7245212245892596`*^9}, {3.819895971867*^9, 3.819895977527*^9}, {
   3.819897139632*^9, 3.81989716323*^9}, {3.8210868558944025`*^9, 
   3.8210868759416027`*^9}, {3.8210869488060026`*^9, 
   3.8210870356724033`*^9}, {3.821087101294403*^9, 3.821087151865003*^9}, {
   3.8210876090102034`*^9, 3.821087628085603*^9}, {3.821101371471806*^9, 
   3.821101962951206*^9}, {3.821102000101406*^9, 3.821102356732806*^9}, {
   3.8350146463671217`*^9, 3.835014653108122*^9}, {3.835014775805122*^9, 
   3.8350147765381217`*^9}, {3.8350148278731217`*^9, 
   3.8350148869521217`*^9}, {3.835015010504122*^9, 3.8350150791781216`*^9}},
 FontSize->16,ExpressionUUID->"920bbfc7-3514-4195-b100-a6714642b868"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\

 \t13.- Dada la ecuaci\[OAcute]n diferencial y\[CloseCurlyQuote](x) = x y(x) \
+ x + 2 junto con la condici\[OAcute]n inicial y(1)=1, utilizar el \
m\[EAcute]todo de Euler para aproximar y(3) con paso 1.
\tFebrero 21\t\
\>", "Section",
 CellChangeTimes->{{3.500751345359375*^9, 3.500751379984375*^9}, {
   3.500790035609375*^9, 3.500790048953125*^9}, {3.569509423875*^9, 
