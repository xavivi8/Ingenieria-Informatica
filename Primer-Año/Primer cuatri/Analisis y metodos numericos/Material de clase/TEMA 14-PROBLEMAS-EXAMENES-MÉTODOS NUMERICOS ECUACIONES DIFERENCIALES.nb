   3.6109957936514254`*^9, 3.6109958150390635`*^9}, 3.6109962528538322`*^9, {
   3.6424694360273438`*^9, 3.6424694787837896`*^9}, {3.6424700316294107`*^9, 
   3.6424700321944427`*^9}, {3.6424720136857777`*^9, 3.642472061084489*^9}, {
   3.6454100586949635`*^9, 3.6454100770310125`*^9}, 3.645410430082206*^9, {
   3.6624089952532687`*^9, 3.6624090425009713`*^9}, {3.662409267561844*^9, 
   3.662409459075798*^9}, {3.6624097101341577`*^9, 3.6624097110942125`*^9}, {
   3.662433188751014*^9, 3.6624332023592386`*^9}, {3.6938415743082104`*^9, 
   3.693841703835619*^9}, {3.693842309229245*^9, 3.693842342670158*^9}, {
   3.7076626173158207`*^9, 3.7076627588878202`*^9}, {3.7076629091388206`*^9, 
   3.70766292683782*^9}, {3.7076636380288205`*^9, 3.7076636438088207`*^9}, {
   3.70766570065182*^9, 3.7076657036808205`*^9}, 3.724512190180803*^9, {
   3.72451659757423*^9, 3.72451659821883*^9}, {3.72452130307646*^9, 
   3.7245213484978604`*^9}, {3.819895503528*^9, 3.819895535209*^9}, {
   3.8198959172390003`*^9, 3.8198959365769997`*^9}, {3.8211023766244063`*^9, 
   3.8211024699298067`*^9}, {3.8211025030238066`*^9, 
   3.8211029826644063`*^9}, {3.8211030512394066`*^9, 3.821103192595007*^9}, {
   3.8211032337422066`*^9, 3.8211032496824064`*^9}, {3.852292074865737*^9, 
   3.8522922980645294`*^9}, {3.8827073404100776`*^9, 
   3.8827074938193035`*^9}, {3.882707528352394*^9, 3.882707550525609*^9}, {
   3.8827075892686434`*^9, 3.882707591589325*^9}, 3.882707645609621*^9, {
   3.8827077787715235`*^9, 3.8827078973167715`*^9}, {3.882707939551778*^9, 
   3.882707959265574*^9}, {3.8830612099736223`*^9, 3.8830612139947853`*^9}, {
   3.92993521502639*^9, 3.9299354480246124`*^9}, {3.9299354788882303`*^9, 
   3.9299355418948307`*^9}, {3.942990860606571*^9, 3.942990902389516*^9}},
 FontSize->16,ExpressionUUID->"baec9fc0-b489-4cfa-8565-104ad7bdece6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\

 \t14.- Utilizando el m\[EAcute]todo de Euler, aproximar el valor de y(2), \
siendo y(x) la soluci\[OAcute]n de la ecuaci\[OAcute]n diferencial y\
\[CloseCurlyQuote]= -y+x+1 con la condici\[OAcute]n inicial y(1)=1. Dar dos \
saltos con paso h=1/2.
\tEnero 23 \t\
\>", "Section",
 CellChangeTimes->{{3.500751345359375*^9, 3.500751379984375*^9}, {
   3.500790035609375*^9, 3.500790048953125*^9}, {3.569509423875*^9, 
   3.56950942659375*^9}, {3.570537368580125*^9, 3.57053737997075*^9}, {
   3.599199111625*^9, 3.5991991196875*^9}, {3.723477468774*^9, 
   3.723477473212*^9}, {3.723478212648*^9, 3.723478232406*^9}, {
   3.723478462157*^9, 3.723478463176*^9}, {3.723478670633*^9, 
   3.723478671652*^9}, {3.72356892631*^9, 3.7235690780550003`*^9}, {
   3.723569130146*^9, 3.723569177783*^9}, {3.7235692175769997`*^9, 
   3.723569247399*^9}, {3.723569308648*^9, 3.723569328826*^9}, {
   3.723569485984*^9, 3.723569513233*^9}, {3.7236081819960003`*^9, 
   3.7236083309300003`*^9}, {3.7236509376520233`*^9, 3.7236509459610233`*^9}, 
   3.7236517258530235`*^9, 3.723651765606024*^9, {3.7236521565550237`*^9, 
   3.7236522309350233`*^9}, {3.7238353873130035`*^9, 3.723835410693304*^9}, {
   3.7239071598070183`*^9, 3.723907162602418*^9}, {3.724158365534717*^9, 
   3.724158429733717*^9}, {3.724164938261321*^9, 3.724164963029321*^9}, 
   3.7254239244656124`*^9, {3.819906851493*^9, 3.8199068540039997`*^9}, 
   3.821078952863801*^9, 3.852292062240802*^9, 3.882707267537986*^9, {
   3.882707594149387*^9, 3.882707595921489*^9}, 3.88270764296146*^9, {
   3.882707760772815*^9, 3.8827077692617764`*^9}, {3.906788505837646*^9, 
   3.906788506477516*^9}, {3.9139156030488815`*^9, 3.913915607448875*^9}},
 FontFamily->"Arial",
 FontSize->14,
 FontColor->RGBColor[0., 0.25098039215686274`, 0.5019607843137255],
 Background->RGBColor[
  0.807843137254902, 0.9058823529411765, 
   1.],ExpressionUUID->"32565680-be65-467f-9702-10b05b319a14"],

Cell[TextData[{
 "Soluci\[OAcute]n:\nEn el m\[EAcute]todo de Euler, aproximamos los valores \
de la funci\[OAcute]n soluci\[OAcute]n de la ecuaci\[OAcute]n diferencial \
utilizando el valor de la derivada.\n\nLa ecuaci\[OAcute]n diferencial es y\
\[CloseCurlyQuote](x)=f(x,y), en este caso es y\[CloseCurlyQuote](x) = - \
y(x)+ x + 1; con f(x,y) = -y+x+1.\nEl punto inicial es ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "540a0b69-8a8a-4a17-a401-7f3d1ab3c995"],
 "= 1, la condici\[OAcute]n inicial es y(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "f5397987-002d-43f5-8b7d-bb366ac6cb0a"],
 ")= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "3858b2b7-83f0-49dd-87b2-8b5e45604c21"],
 " = 1, el paso es h=1/2 (para en dos pasos, llegar desde el 1 al 2).\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "n"], TraditionalForm]],ExpressionUUID->
  "6e226d1c-5637-4434-955b-b5ecb3ef05aa"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "d3508c99-20f0-46b3-93dd-6c7b790ab9b4"],
 " + n h, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "n"], TraditionalForm]],ExpressionUUID->
  "df61917c-de08-4de4-8838-5e08ed52a163"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "0e9ac6f3-35d2-49dc-9c7a-26cd4963b082"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "ed998e59-36a7-46b1-8920-64972749b6a3"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "c63d398b-5822-4f63-b4fe-3653fd86f5eb"],
 ")\n\nCalculamos ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "0"], "=", "1"}], ",", " ", 
    SubscriptBox["y", "0"]}], TraditionalForm]],ExpressionUUID->
  "8c5ae467-0944-4d6c-80ea-45f1674b5f76"],
 " = 1, \n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "95fa5893-57bc-4ee8-84ea-a6a484fb5c88"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "a5909b8f-0288-4067-8d08-7bf591f8c0fa"],
 " + h = 1 + 1/2 = 3/2; ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "5512d744-8c07-473e-b925-e46a646f7b90"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "47892f22-41e6-4860-9114-372ae0c31cbc"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "cb0e90b6-6d0c-47a7-887d-b48b318d20cc"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "8a87f7d9-8594-445f-8b6c-aa72d0d9897c"],
 ") = 1 + (1/2)*f(1,1) = 1 + (1/2)(-1+1+1)=3/2.\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "7dfcc784-faf7-4eec-bbca-b85436121629"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "56220330-9976-42fd-ae88-1adb317029dc"],
 " + h = 3/2 + 1/2 = 2; ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "68f26aa2-9fb5-4267-94b0-e36ed2ad9143"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "bc9991d0-17e7-4830-b32d-8e6daf63303a"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "63b59de5-34bd-41b1-b29c-ce4aa4f3c73e"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "4638e844-af8c-4f34-bced-65c98490aa13"],
 ") = 3/2 + (1/2)*f(3/2,3/2) = 3/2 + (1/2) (-3/2 + 3/2 + 1)=2.\n\nDe esta \
forma, aproximamos y(2) \[TildeEqual] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "268eed01-eb94-4b23-8c67-03cb1e9b685d"],
 "=2."
}], "Text",
 CellChangeTimes->{{3.610967983265625*^9, 3.610968082640625*^9}, {
   3.6109681208125*^9, 3.61096812653125*^9}, {3.610976777453125*^9, 
