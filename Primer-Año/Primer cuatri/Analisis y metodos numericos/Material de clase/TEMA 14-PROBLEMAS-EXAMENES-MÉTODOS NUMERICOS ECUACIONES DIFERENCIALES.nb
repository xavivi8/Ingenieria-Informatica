Cell[CellGroupData[{

Cell[TextData[{
 "\n \t14.- Utilizando el m\[EAcute]todo de Euler, aproximar el valor de ",
 StyleBox["y(6)",
  FontSlant->"Italic"],
 ", siendo ",
 StyleBox["y(x)",
  FontSlant->"Italic"],
 " la soluci\[OAcute]n de la ecuaci\[OAcute]n diferencial ",
 StyleBox["y\[CloseCurlyQuote] =  y + x + 1",
  FontSlant->"Italic"],
 " con la condici\[OAcute]n inicial ",
 StyleBox["y(0)=0",
  FontSlant->"Italic"],
 ". Dar tres saltos con paso ",
 StyleBox["h=2",
  FontSlant->"Italic"],
 ".\n \tJulio 24"
}], "Section",
 CellChangeTimes->{{3.500751345359375*^9, 3.500751379984375*^9}, {
   3.500790035609375*^9, 3.500790048953125*^9}, {3.569509423875*^9, 
   3.56950942659375*^9}, {3.570537368580125*^9, 3.57053737997075*^9}, {
   3.599199111625*^9, 3.5991991196875*^9}, {3.723477468774*^9, 
   3.723477473212*^9}, {3.723478212648*^9, 3.723478232406*^9}, {
   3.723478462157*^9, 3.723478463176*^9}, {3.723478670633*^9, 
   3.723478671652*^9}, {3.72356892631*^9, 3.7235690780550003`*^9}, {
   3.723569130146*^9, 3.723569177783*^9}, {3.7235692175769997`*^9, 
   3.723569247399*^9}, {3.723569308648*^9, 3.723569328826*^9}, {
   3.723569485984*^9, 3.723569513233*^9}, {3.7236081819960003`*^9, 
   3.7236083309300003`*^9}, {3.7236509376520233`*^9, 3.7236509459610233`*^9}, 
   3.7236517258530235`*^9, 3.723651765606024*^9, {3.7236521565550237`*^9, 
   3.7236522309350233`*^9}, {3.7238353873130035`*^9, 3.723835410693304*^9}, {
   3.7239071598070183`*^9, 3.723907162602418*^9}, {3.724158365534717*^9, 
   3.724158429733717*^9}, {3.724164938261321*^9, 3.724164963029321*^9}, 
   3.7254239244656124`*^9, {3.819906851493*^9, 3.8199068540039997`*^9}, 
   3.85221277501379*^9, {3.8826734491183653`*^9, 3.882673472996007*^9}, {
   3.914701409076379*^9, 3.9147014454467764`*^9}, {3.929859591412386*^9, 
   3.929859606451701*^9}, 3.92987374419495*^9, 3.929874029195141*^9, {
   3.9429831293327713`*^9, 3.942983131754698*^9}},
 FontFamily->"Arial",
 FontSize->14,
 FontColor->RGBColor[0., 0.25098039215686274`, 0.5019607843137255],
 Background->RGBColor[
  0.807843137254902, 0.9058823529411765, 
   1.],ExpressionUUID->"0443d9e9-d24d-4b46-8fc4-0eb29d58e376"],

Cell[TextData[{
 "Soluci\[OAcute]n:\nEn el m\[EAcute]todo de Euler, aproximamos los valores \
de la funci\[OAcute]n soluci\[OAcute]n de la ecuaci\[OAcute]n diferencial \
utilizando el valor de la derivada.\n\nLa ecuaci\[OAcute]n diferencial es y\
\[CloseCurlyQuote](x)=f(x,y), en este caso es y\[CloseCurlyQuote](x) = y(x)+ \
x + 1; con f(x,y) = y+x+1.\nEl punto inicial es ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "bbd74ce4-03fb-4751-aac1-4d67dc7cac10"],
 "= 0, la condici\[OAcute]n inicial es y(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "9aed999b-7db6-4694-862d-f290ac3b4c08"],
 ")= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "a1ba220e-e327-4dc7-9354-055c7a6a49e2"],
 " = 0, el paso es h=2 (en tres pasos llegaremos desde el 0 al 6).\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "n"], TraditionalForm]],ExpressionUUID->
  "5be0e9fc-76e9-4296-8d9a-c94bbdb7a761"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "1610af11-96b0-41a6-8689-b09af7b3c64f"],
 " + n h, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "n"], TraditionalForm]],ExpressionUUID->
  "382d67fb-79db-4585-84d1-60aa15ddb438"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "a8c9c6dc-f4ec-47a9-a4a9-6a38e987f028"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "f53425ab-6d39-4efb-853a-f5edc68ceb3c"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "13a3f5cf-5fc9-4f30-9e19-9dc010f95389"],
 ")\n\nComenzando con  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "0"], "=", "0"}], ",", " ", 
    SubscriptBox["y", "0"]}], TraditionalForm]],ExpressionUUID->
  "87959772-dddd-416e-86d3-ccaf0f004559"],
 " = 0, calculamos:\n ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "0d117c75-ed0c-48c8-a81f-c2ad1454b181"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "d2376ee0-9c8b-45cf-969c-001b7b81c383"],
 " + h = 0 + 2 = 2; \t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "a8eda5c6-9d1d-4599-8ccb-21846c878d1d"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "909ce57d-c12c-4ff7-a721-fd76d6b47e39"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "63d5d4ea-006d-4152-8d82-537fec7b1eda"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "be5ea6d9-c773-4f9a-aa36-d2bf660837af"],
 ") = 0 + 2*f(0,0) = 0 + (2)(0+0+1)=2.\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "80461c5b-d02d-4e3e-8a8c-b3c1b72be47d"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "ae1bcabc-c700-4eaa-9159-4c6b6d99515c"],
 " + h = 2 + 2 = 4; \t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "5a24b814-b72c-44fd-b7ea-60f20c8da3e2"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "f2dc0e32-6a45-42e5-ae30-8d4174c63b10"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "2c24662c-24f6-435a-89a7-24168293a399"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "17a61621-23e5-48fb-81a3-0674fe2f0d6c"],
 ") = 2 + 2*f(2,2) = 2 + (2) (2 + 2 + 1)=12.\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "e8a554bf-e7ae-4dfa-91b6-c5b5c753e882"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "3f96069a-612f-46ff-814e-750a8c53a5ff"],
 " + h = 4 + 2 = 6; \t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "3"], TraditionalForm]],ExpressionUUID->
  "9d9a9bc2-88b2-4b82-8531-d3608bf77e12"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "dcd9d7b2-a394-4dc2-84d8-f0e1d9b2de42"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "3f10c35e-5d7e-40bc-9eb2-0629bca38bc8"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "448a74f4-2008-4178-b3bd-713aa748e3e2"],
 ") = 12 + (2)*f(4,12) = 12 + (2) (12 + 4 + 1)=46.\n\nDe esta forma, \
aproximamos y(6) \[TildeEqual] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "3"], TraditionalForm]],ExpressionUUID->
  "08a9727c-c17b-44f5-961d-f6e85757e2d2"],
 "=46."
}], "Text",
 CellChangeTimes->{{3.610967983265625*^9, 3.610968082640625*^9}, {
   3.6109681208125*^9, 3.61096812653125*^9}, {3.610976777453125*^9, 
