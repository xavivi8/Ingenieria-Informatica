Cell[TextData[{
 "Soluci\[OAcute]n:\nEn el m\[EAcute]todo de Euler, aproximamos los valores \
de la funci\[OAcute]n soluci\[OAcute]n de la ecuaci\[OAcute]n diferencial \
utilizando el valor de la derivada.\n\nLa ecuaci\[OAcute]n diferencial es y\
\[CloseCurlyQuote](x)=f(x,y), en este caso es y\[CloseCurlyQuote](x) = 2x - \
3y(x) + 1; con f(x,y) = 2x -3y + 1.\nEl punto inicial es ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "93d5dd88-e827-41f4-ae64-bf93ae3e8a15"],
 "= 2, la condici\[OAcute]n inicial es y(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "c61012f6-88ef-426b-a99e-4764e7be1de7"],
 ")= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "2700cc39-ae35-4e75-8d4b-b032cd51576c"],
 " = 3, el paso es h=0.5 (para en dos pasos, llegar desde el 2 al 3).\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "n"], TraditionalForm]],ExpressionUUID->
  "ecb9976d-e4eb-4580-8616-e42cac5c210f"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "45725b47-5908-49e9-a9fa-651af8114409"],
 " + n h, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "n"], TraditionalForm]],ExpressionUUID->
  "e65d9528-4d1f-49ef-8f4a-89f133dfb20d"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "92de073f-21a7-48b6-ae7e-e716ed46fe0c"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "8a9e8bc3-3462-41dd-9236-da81d7d02edd"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", 
    RowBox[{"n", "-", "1"}]], TraditionalForm]],ExpressionUUID->
  "bea65ff5-11e0-47b8-8698-a086d00d2d07"],
 ")\n\nCalculamos ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "0"], "=", "2"}], ",", " ", 
    SubscriptBox["y", "0"]}], TraditionalForm]],ExpressionUUID->
  "0a7ab667-3cf9-430f-b3e9-49ca800e76f4"],
 " = 3, \n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "9349f55b-f577-4068-9b80-a221be51b54b"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "8ce1007c-8ac2-4832-a17e-e8cfdb99b800"],
 " + h = 2 + 0.5 = 2.5; ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "f96320d9-8075-4c15-aff1-ce69ac5fd95c"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "8812590f-664a-4e8a-8307-d7d786358cd1"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "61b91dbd-df80-4a52-bee1-c9b6b262ada3"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "6fb189d4-7f13-43ac-b560-7039f3e303c8"],
 ") = 3 + 0.5*f(2,3) = 3 + 0.5*(2*2 -3*3+1)=3+0.5*(-4)=1.\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "14566f00-c167-4d62-9234-2ecf23acb0e3"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "05fcc2e6-4af6-4199-962d-e465ed1e0156"],
 " + h = 2.5 + 0.5 = 3; ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "d2b0d5de-2688-4864-bf6e-fc9e98399bd1"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "4944ef0c-f90b-4410-80fd-e50d4af89885"],
 "+ h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "6c3e0523-2926-4e87-9f80-2e9d82dbf3b0"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "d4be9ebd-fdc6-4870-a580-44123998f4df"],
 ") = 1 + 0.5*f(2.5,1) = 1 + 0.5*(2*2.5-3*1 + 1)=1+0.5*3=2.5.\n\nDe esta \
forma, y(3) \[TildeEqual] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "49dec673-860c-46be-a31f-12d44753d8b5"],
 "=2.5."
}], "Text",
 CellChangeTimes->{{3.610967983265625*^9, 3.610968082640625*^9}, {
   3.6109681208125*^9, 3.61096812653125*^9}, {3.610976777453125*^9, 
   3.610976922484375*^9}, {3.610977092296875*^9, 3.610977288828125*^9}, {
   3.6109957936514254`*^9, 3.6109958150390635`*^9}, 3.6109962528538322`*^9, {
