Cell[TextData[{
 "\n \t5.- Aproximar el valor de la soluci\[OAcute]n de la ecuaci\[OAcute]n \
diferencial y\[CloseCurlyQuote] = x y - 3x -1, con la condici\[OAcute]n \
inicial y(0)=0, en el punto x=2, utilizando el m\[EAcute]todo de Runge-Kutta \
cl\[AAcute]sico con paso h=0.2 .\n El segundo decimal de la aproximaci\
\[OAcute]n es:\n\t1) 3, \t\t\t2) 2, \t\t\t3) 4, \t\t\t4) 7, \t\t\t",
 StyleBox["5) 0",
  FontWeight->"Bold"],
 "\nEl tercer decimal es:\n\t",
 StyleBox["1) 3,",
  FontWeight->"Bold"],
 " \t\t\t2) 2, \t\t\t3) 4, \t\t\t4) 7, \t\t\t5) 0\nEnero 24. Aula de Inform\
\[AAcute]tica \t"
}], "Section",
