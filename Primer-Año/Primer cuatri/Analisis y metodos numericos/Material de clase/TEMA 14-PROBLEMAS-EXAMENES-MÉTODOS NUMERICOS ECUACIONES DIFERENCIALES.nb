   3.7245196444144497`*^9, 3.72451967425465*^9}, {3.7245202803412533`*^9, 
   3.7245203632992544`*^9}, {3.7245212242460594`*^9, 
   3.7245212245892596`*^9}, {3.819895971867*^9, 3.819895977527*^9}, {
   3.819897139632*^9, 3.81989716323*^9}, {3.8210868558944025`*^9, 
   3.8210868759416027`*^9}, {3.8210869488060026`*^9, 
   3.8210870356724033`*^9}, {3.821087101294403*^9, 3.821087151865003*^9}, {
   3.8210876090102034`*^9, 3.821087628085603*^9}, {3.821101371471806*^9, 
   3.821101962951206*^9}, {3.821102000101406*^9, 3.821102356732806*^9}, {
   3.9139786573497095`*^9, 3.9139786886104593`*^9}, {3.913978722425888*^9, 
   3.913978892314432*^9}, {3.913978962509488*^9, 3.913978975203049*^9}, {
   3.9139790408468666`*^9, 3.9139791003931313`*^9}},
 FontSize->16,ExpressionUUID->"e7249cf6-29dc-4dac-b8c1-551cd014b953"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\

 \t13.- Dada la ecuaci\[OAcute]n diferencial y\[CloseCurlyQuote](x) = 3 x \
y(x) + 2 junto con la condici\[OAcute]n inicial y(0)=1, utilizar el \
m\[EAcute]todo de Euler para aproximar y(1) con paso 0.5.
\tEnero 18 \t\
\>", "Section",
 CellChangeTimes->{{3.500751345359375*^9, 3.500751379984375*^9}, {
   3.500790035609375*^9, 3.500790048953125*^9}, {3.569509423875*^9, 
   3.56950942659375*^9}, {3.570537368580125*^9, 3.57053737997075*^9}, {
   3.599199111625*^9, 3.5991991196875*^9}, {3.723477468774*^9, 
   3.723477473212*^9}, {3.723478212648*^9, 3.723478232406*^9}, {
   3.723478462157*^9, 3.723478463176*^9}, {3.723478670633*^9, 
   3.723478671652*^9}, {3.72356892631*^9, 3.7235690780550003`*^9}, {
   3.723569130146*^9, 3.723569177783*^9}, {3.7235692175769997`*^9, 
   3.723569247399*^9}, {3.723569308648*^9, 3.723569328826*^9}, {
   3.723569485984*^9, 3.723569513233*^9}, {3.7236081819960003`*^9, 
   3.7236083309300003`*^9}, {3.7236509376520233`*^9, 3.7236509459610233`*^9}, 
   3.7236517258530235`*^9, 3.723651765606024*^9, {3.7236521565550237`*^9, 
   3.7236522309350233`*^9}, {3.7238353873130035`*^9, 3.723835410693304*^9}, {
   3.7239071598070183`*^9, 3.723907162602418*^9}, {3.724158365534717*^9, 
   3.724158429733717*^9}, {3.724164938261321*^9, 3.724164963029321*^9}, {
   3.7254239244656124`*^9, 3.7254239449172125`*^9}, 3.725424049640013*^9, 
   3.725424176748814*^9, {3.90678178128305*^9, 3.906781782172597*^9}, {
   3.913979142778575*^9, 3.9139791461518707`*^9}},
 FontFamily->"Arial",
 FontSize->14,
 FontColor->RGBColor[0., 0.25098039215686274`, 0.5019607843137255],
 Background->RGBColor[
  0.807843137254902, 0.9058823529411765, 
   1.],ExpressionUUID->"634f717c-ff56-4d62-a90a-35349776cc68"],

Cell[TextData[{
 "Soluci\[OAcute]n: \nConocemos el valor y(0) (por ser la condici\[OAcute]n \
inicial). Como nos piden aproximar y(1) con paso 0.5, tendremos que aplicar \
dos veces el m\[EAcute]todo de Euler, del 0 al 0.5 y del 0.5 al 1.\ny\
\[CloseCurlyQuote](x) = 3 x y(x) + 2\ny(0)=1\n\nf(x,y)=3xy+2\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "9baf3770-7caf-4a69-b413-eb1c71a5e5db"],
 "=0\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "5adfab8d-af34-49ab-8112-2c771c61b018"],
 "=1\nh=0.5\n",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "n"], TraditionalForm]],ExpressionUUID->
  "1f768d60-a3de-4b64-bbed-23e24b7ea910"],
 "= ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "f5d19cd9-0bb6-4a05-895c-9c785c98781a"],
 "+ nh\n\ny(0.5)  \[TildeEqual]  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "a560b2f8-50bf-4fa5-aeb3-b555101dc5a9"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "3c572efb-c25e-42bc-9a5e-ed6314148802"],
 " + h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "ebfe430e-fbce-4dac-a7f6-8f00a6c8f42f"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "0"], TraditionalForm]],ExpressionUUID->
  "92feab6f-ce26-4136-84ae-efb2f0fb07f5"],
 ") = 1 + 0.5 f(0,1) = 1 + 0.5*(3*0*1+2) = 2\ny(1)  \[TildeEqual]  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "54c6e3da-2401-4c72-808b-6027bb8c9a24"],
 " = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "af8b1095-18af-4528-89ba-3541d60bbc73"],
 " + h f(",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "1"], TraditionalForm]],ExpressionUUID->
  "72922f4e-c7b5-496b-bd27-13a75ffcb7e4"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "1"], TraditionalForm]],ExpressionUUID->
  "0d80f99f-3571-4060-98eb-3e62b5f28787"],
 ") = 2 + 0.5 f(0.5, 2) = 2 + 0.5*(3*0.5*2+2) = 2+2.5 = 4.5"
}], "Text",
 CellChangeTimes->{{3.725422492619603*^9, 3.7254227251220045`*^9}, {
   3.725422756088005*^9, 3.7254230246732063`*^9}, {3.725423062628007*^9, 
   3.725423114872407*^9}, {3.725423164995208*^9, 3.7254232007036076`*^9}, {
   3.725423239937608*^9, 3.7254233041004086`*^9}, {3.7254238586336117`*^9, 
   3.7254238641404123`*^9}, 
   3.913979171733633*^9},ExpressionUUID->"1fe60f00-b45a-465d-9e80-\
f0a4db336a7b"]
}, Open  ]],

Cell["M\[EAcute]todo de Taylor", "Section",
 CellChangeTimes->{{3.942989233502557*^9, 
  3.942989247463023*^9}},ExpressionUUID->"4acb8a47-2b30-448e-bc5c-\
2f3fc82261e2"],

Cell[CellGroupData[{

Cell[TextData[{
 "\n \t14.- Utilizando el m\[EAcute]todo de Taylor de segundo orden, \
aproximar el valor de ",
 StyleBox["y(2)",
  FontSlant->"Italic"],
 ", siendo ",
 StyleBox["y(x)",
  FontSlant->"Italic"],
 " la soluci\[OAcute]n de la ecuaci\[OAcute]n diferencial ",
 StyleBox["y\[CloseCurlyQuote] =  y + x + 1",
  FontSlant->"Italic"],
 " con la condici\[OAcute]n inicial ",
 StyleBox["y(0)=1",
  FontSlant->"Italic"],
 ". Dar dos saltos con paso ",
 StyleBox["h=1",
  FontSlant->"Italic"],
 ".\n \tEnero 24"
}], "Section",
 CellChangeTimes->{{3.500751345359375*^9, 3.500751379984375*^9}, {
   3.500790035609375*^9, 3.500790048953125*^9}, {3.569509423875*^9, 
   3.56950942659375*^9}, {3.570537368580125*^9, 3.57053737997075*^9}, {
   3.599199111625*^9, 3.5991991196875*^9}, {3.723477468774*^9, 
   3.723477473212*^9}, {3.723478212648*^9, 3.723478232406*^9}, {
   3.723478462157*^9, 3.723478463176*^9}, {3.723478670633*^9, 
   3.723478671652*^9}, {3.72356892631*^9, 3.7235690780550003`*^9}, {
   3.723569130146*^9, 3.723569177783*^9}, {3.7235692175769997`*^9, 
   3.723569247399*^9}, {3.723569308648*^9, 3.723569328826*^9}, {
   3.723569485984*^9, 3.723569513233*^9}, {3.7236081819960003`*^9, 
   3.7236083309300003`*^9}, {3.7236509376520233`*^9, 3.7236509459610233`*^9}, 
   3.7236517258530235`*^9, 3.723651765606024*^9, {3.7236521565550237`*^9, 
   3.7236522309350233`*^9}, {3.7238353873130035`*^9, 3.723835410693304*^9}, {
   3.7239071598070183`*^9, 3.723907162602418*^9}, {3.724158365534717*^9, 
   3.724158429733717*^9}, {3.724164938261321*^9, 3.724164963029321*^9}, 
   3.7254239244656124`*^9, {3.819906851493*^9, 3.8199068540039997`*^9}, 
   3.85221277501379*^9, {3.8826734491183653`*^9, 3.882673472996007*^9}, 
   3.9147651472529464`*^9, 3.9147652143929834`*^9, 3.914765441464222*^9, {
   3.942982813775809*^9, 3.9429828156475*^9}},
 FontFamily->"Arial",
 FontSize->14,
 FontColor->RGBColor[0., 0.25098039215686274`, 0.5019607843137255],
 Background->RGBColor[
  0.807843137254902, 0.9058823529411765, 
   1.],ExpressionUUID->"1f518ce1-7446-40ca-b994-a3f1eb9cfdf3"],

Cell[TextData[{
 "Soluci\[OAcute]n:\nSe trata de aproximar la soluci\[OAcute]n de una ecuaci\
\[OAcute]n diferencial con una condici\[OAcute]n inicial en un punto. La \
ecuaci\[OAcute]n diferencial es ",
 StyleBox["y\[CloseCurlyQuote] =  y + x + 1",
  FontSlant->"Italic"],
 ". La condici\[OAcute]n inicial es y(0)=1. Hay que aproximar el valor de \
y(2).\nEl m\[EAcute]todo para hacerlo es el de Taylor de segundo orden. Este \
m\[EAcute]todo, utiliza no solo la primera derivada (como hace el \
m\[EAcute]todo de Euler), tambi\[EAcute]n usa la derivada segunda para tratar \
de avanzar con m\[AAcute]s precisi\[OAcute]n en cada salto.\nEl salto se hace \
con paso h=1. Por tanto, necesitaremos dar dos saltos para llegar  al punto \
2.\n\nLa primera derivada de y, y\[CloseCurlyQuote], es igual a y+x+1=f(x,y).\
\nLa segunda derivada de y ser\[AAcute]:\ny\[CloseCurlyQuote]\
\[CloseCurlyQuote] = (y\[CloseCurlyQuote])\[CloseCurlyQuote] = (y+x+1)\
\[CloseCurlyQuote] = y\[CloseCurlyQuote] + 1 + 0 = (y+x+1) + 1 = y + x + 2 \
=g(x,y)\nUtilizando la primera y segunda derivada, la aproximaci\[OAcute]n \
por Taylor en cada punto vendr\[AAcute] dada por \n",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["y", 
      RowBox[{"i", "+", "1"}]], "=", 
     RowBox[{
      SubscriptBox["y", "i"], "+", 
      RowBox[{"h", " ", 
       RowBox[{"f", "(", 
        RowBox[{
         SubscriptBox["x", 
          RowBox[{"i", " "}]], ",", " ", 
         SubscriptBox["y", 
          RowBox[{"i", " "}]]}], ")"}]}], "+", 
      RowBox[{
       FractionBox[
        SuperscriptBox["h", "2"], "2"], 
       RowBox[{"g", 
        StyleBox["(",
         FontWeight->"Plain"], 
        StyleBox[
         RowBox[{
          SubscriptBox["x", 
           RowBox[{"i", " "}]], ",", " ", 
          SubscriptBox["y", 
           RowBox[{"i", " "}]]}],
         FontWeight->"Plain"], 
        StyleBox[")",
         FontWeight->"Plain"]}]}]}]}],
    FontWeight->"Plain"], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"21a79472-0e43-45ec-8ec5-66fe01f3cab3"],
 "\nEn nuestro caso;\nf(x,y) = x+y+1;\ng(x,y)=x+y+2;\nh=1\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "0"], 
    StyleBox["=",
     FontWeight->"Plain"], 
    StyleBox["0",
     FontWeight->"Plain"]}], TraditionalForm]],ExpressionUUID->
  "5af15d94-c05b-45f0-b4ea-3620293336a0"],
 "; \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "1"], "="}], TraditionalForm]],ExpressionUUID->
  "aabd9a2b-d487-4e6e-93fe-4d2f338f406d"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "0"], "+", " ", "h"}], 
    StyleBox["=",
     FontWeight->"Plain"], 
    StyleBox[
     RowBox[{
      RowBox[{"0", "+", "1"}], "=", "1"}],
     FontWeight->"Plain"]}], TraditionalForm]],ExpressionUUID->
  "0bf623d7-d5d9-47aa-bb0f-23731cb6abad"],
 "; \n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "2"], 
    StyleBox["=",
     FontWeight->"Plain"]}], TraditionalForm]],ExpressionUUID->
  "75caa4d7-4fd8-4611-9509-e6c7668e5480"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["x", "1"], "+", "h"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"1", "+", "1"}], "=", "2"}]}], TraditionalForm]],ExpressionUUID->
  "54220dcf-4c2b-4c48-bf9b-72f3c4b41f5a"],
 "; \n",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["y", "0"], "=", "1"}],
    FontWeight->"Plain"], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"ef886f1c-4c97-441c-8cdb-52f78f749e9b"],
 ";\n",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["y", "1"], "=", 
     RowBox[{
      SubscriptBox["y", "0"], "+", 
      RowBox[{"h", " ", 
       RowBox[{"f", "(", 
        RowBox[{
         SubscriptBox["x", 
          RowBox[{"0", " "}]], ",", " ", 
         SubscriptBox["y", 
          RowBox[{"0", " "}]]}], ")"}]}], "+", 
      RowBox[{
       FractionBox[
        SuperscriptBox["h", "2"], "2"], 
       RowBox[{"g", "(", 
        RowBox[{
         SubscriptBox["x", "0"], ",", " ", 
         SubscriptBox["y", 
          RowBox[{"0", " "}]]}], ")"}]}]}]}],
    FontWeight->"Plain"], TraditionalForm]],ExpressionUUID->
  "056f2f1e-4f8d-42be-bd43-1e3db4f21525"],
 " \[DoubleLongRightArrow] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     SubscriptBox["y", "1"],
     FontWeight->"Plain"], 
    StyleBox["=",
     FontWeight->"Plain"], 
    RowBox[{
     StyleBox["1",
      FontWeight->"Plain"], 
     StyleBox["+",
      FontWeight->"Plain"], 
     RowBox[{
      StyleBox["1",
       FontWeight->"Plain"], 
      StyleBox["*",
       FontWeight->"Plain"], 
      StyleBox[" ",
       FontWeight->"Plain"], 
      RowBox[{
       StyleBox["f",
        FontWeight->"Plain"], "(", 
       RowBox[{
        SubscriptBox["0", " "], ",", " ", 
        SubscriptBox["1", " "]}], 
       StyleBox[")",
        FontWeight->"Plain"]}]}], 
     StyleBox["+",
      FontWeight->"Plain"], 
     RowBox[{
      StyleBox[
       FractionBox[
        SuperscriptBox["1", "2"], "2"],
       FontWeight->"Plain"], 
      RowBox[{
       StyleBox["g",
        FontWeight->"Plain"], 
       StyleBox["(",
        FontWeight->"Plain"], 
       RowBox[{
        StyleBox["0",
         FontWeight->"Plain"], ",", " ", 
        SubscriptBox["1", " "]}], 
       StyleBox[")",
        FontWeight->"Plain"]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "cd359531-3859-4dd5-a291-2a22120d60a3"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["1",
     FontWeight->"Plain"], 
    StyleBox["+",
     FontWeight->"Plain"], 
    StyleBox[" ",
     FontWeight->"Plain"], 
    RowBox[{
     StyleBox["f",
      FontWeight->"Plain"], "(", 
     RowBox[{
      SubscriptBox["0", " "], ",", " ", 
      SubscriptBox["1", " "]}], 
     StyleBox[")",
      FontWeight->"Plain"]}], 
    StyleBox["+",
     FontWeight->"Plain"], 
    RowBox[{
     StyleBox[
      FractionBox["1", "2"],
      FontWeight->"Plain"], 
     RowBox[{
      StyleBox["g",
       FontWeight->"Plain"], 
      StyleBox["(",
       FontWeight->"Plain"], 
      RowBox[{
       StyleBox["0",
        FontWeight->"Plain"], ",", " ", 
       SubscriptBox["1", " "]}], 
      StyleBox[")",
       FontWeight->"Plain"]}]}]}], TraditionalForm]],ExpressionUUID->
  "4f193df9-2e2e-415d-8a83-2cf087daefa6"],
 " = ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"1", "+", 
     RowBox[{"(", 
      RowBox[{"0", "+", "1", "+", "1"}], ")"}], "+", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{"0", "+", "1", "+", "2"}], ")"}]}]}],
    FontWeight->"Plain"], TraditionalForm]],ExpressionUUID->
  "c8cd96b4-5be1-40e8-8293-298e0a51a5bc"],
 " = 1+2+",
 Cell[BoxData[
  FormBox[
   FractionBox["3", "2"], TraditionalForm]],ExpressionUUID->
  "3d8619bb-313c-431c-8855-b6179ede1c95"],
 " = ",
 Cell[BoxData[
  FormBox[
   FractionBox["9", "2"], TraditionalForm]],ExpressionUUID->
  "6ff26cb2-877c-4a93-8586-321198a441ea"],
 "\n",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["y", "2"], "=", 
     RowBox[{
      SubscriptBox["y", "1"], "+", 
      RowBox[{"h", " ", 
       RowBox[{"f", "(", 
        RowBox[{
         SubscriptBox["x", 
          RowBox[{"1", " "}]], ",", " ", 
         SubscriptBox["y", 
          RowBox[{"1", " "}]]}], ")"}]}], "+", 
      RowBox[{
       FractionBox[
        SuperscriptBox["h", "2"], "2"], 
       RowBox[{"g", "(", 
        RowBox[{
         SubscriptBox["x", "1"], ",", " ", 
         SubscriptBox["y", 
          RowBox[{"1", " "}]]}], ")"}]}]}]}],
    FontWeight->"Plain"], TraditionalForm]],ExpressionUUID->
  "864b1d51-5c89-4912-b554-6ccc3fded717"],
 " \[DoubleLongRightArrow] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     SubscriptBox["y", "2"],
     FontWeight->"Plain"], 
    StyleBox["=",
     FontWeight->"Plain"], 
    RowBox[{
     StyleBox[
      FractionBox["9", "2"],
      FontWeight->"Plain"], 
     StyleBox["+",
      FontWeight->"Plain"], 
     RowBox[{
      StyleBox["1",
       FontWeight->"Plain"], 
      StyleBox["*",
       FontWeight->"Plain"], 
      StyleBox[" ",
       FontWeight->"Plain"], 
      RowBox[{
       StyleBox["f",
        FontWeight->"Plain"], "(", 
       RowBox[{
        SubscriptBox["1", " "], ",", " ", 
        SubscriptBox[
         RowBox[{"(", 
          FractionBox["9", "2"], ")"}], " "]}], 
       StyleBox[")",
        FontWeight->"Plain"]}]}], 
     StyleBox["+",
      FontWeight->"Plain"], 
     RowBox[{
      StyleBox[
       FractionBox[
        SuperscriptBox["1", "2"], "2"],
       FontWeight->"Plain"], 
      RowBox[{
       StyleBox["g",
        FontWeight->"Plain"], 
       StyleBox["(",
        FontWeight->"Plain"], 
       RowBox[{
        StyleBox["1",
         FontWeight->"Plain"], ",", " ", 
        SubscriptBox[
         RowBox[{"(", 
          FractionBox["9", "2"], ")"}], " "]}], 
       StyleBox[")",
        FontWeight->"Plain"]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "d5cf0299-eb91-4ef3-89c5-30b57d21b383"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     FractionBox["9", "2"],
     FontWeight->"Plain"], 
    StyleBox["+",
     FontWeight->"Plain"], 
    StyleBox[" ",
     FontWeight->"Plain"], 
    RowBox[{
     StyleBox["f",
      FontWeight->"Plain"], "(", 
     RowBox[{
      SubscriptBox["1", " "], ",", " ", 
      SubscriptBox[
       RowBox[{"(", 
        FractionBox["9", "2"], ")"}], " "]}], 
     StyleBox[")",
      FontWeight->"Plain"]}], 
    StyleBox["+",
     FontWeight->"Plain"], 
    RowBox[{
     StyleBox[
      FractionBox["1", "2"],
      FontWeight->"Plain"], 
     RowBox[{
      StyleBox["g",
       FontWeight->"Plain"], 
      StyleBox["(",
       FontWeight->"Plain"], 
      RowBox[{
       StyleBox["1",
        FontWeight->"Plain"], ",", " ", 
       SubscriptBox[
        RowBox[{"(", 
         FractionBox["9", "2"], ")"}], " "]}], 
      StyleBox[")",
       FontWeight->"Plain"]}]}]}], TraditionalForm]],ExpressionUUID->
  "dbd5d831-d28e-4dd0-a808-4068f9f71539"],
 " = ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     FractionBox["9", "2"], "+", 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       FractionBox["9", "2"], "+", "1"}], ")"}], "+", 
     RowBox[{
      FractionBox["1", "2"], 
      RowBox[{"(", 
       RowBox[{"1", "+", 
        FractionBox["9", "2"], "+", "2"}], ")"}]}]}],
    FontWeight->"Plain"], TraditionalForm]],ExpressionUUID->
  "3452d5f6-1fa2-4d9b-8824-6c923ed1e47d"],
 " =  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     FractionBox["9", "2"], "+", 
     FractionBox["13", "2"], "+", 
     RowBox[{
      FractionBox["1", "2"], "*", 
      FractionBox["15", "2"]}]}],
    FontWeight->"Plain"], TraditionalForm]],ExpressionUUID->
  "5cb505fc-dac8-463f-9dcf-7ee543250129"],
 " = 11+",
 Cell[BoxData[
  FormBox[
   FractionBox["15", "4"], TraditionalForm]],ExpressionUUID->
  "a7bee7e4-8df6-4db8-8538-f10a102e60cc"],
 " =  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox[
     RowBox[{"44", "+", "15"}], "4"],
    FontWeight->"Plain"], TraditionalForm]],ExpressionUUID->
  "7fe32a8f-8630-42e9-a4a7-95ddf742700b"],
 "= ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["59", "4"],
    FontWeight->"Plain"], TraditionalForm]],ExpressionUUID->
  "b4e884a7-a42a-411a-9e1b-97733ef1a77d"],
 ".\nLa aproximaci\[OAcute]n de y(2) por el m\[EAcute]todo de Taylor de \
segundo orden ser\[IAcute]a ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    FractionBox["59", "4"],
    FontWeight->"Plain"], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"fbc742b2-cc13-43d0-b01b-28b74491fa09"],
 ".\nCon el Mathematica,"
}], "Text",
 CellChangeTimes->{{3.610967983265625*^9, 3.610968082640625*^9}, {
   3.6109681208125*^9, 3.61096812653125*^9}, {3.610976777453125*^9, 
   3.610976922484375*^9}, {3.610977092296875*^9, 3.610977288828125*^9}, {
   3.6109957936514254`*^9, 3.6109958150390635`*^9}, 3.6109962528538322`*^9, {
   3.6424694360273438`*^9, 3.6424694787837896`*^9}, {3.6424700316294107`*^9, 
   3.6424700321944427`*^9}, {3.6424720136857777`*^9, 3.642472061084489*^9}, {
   3.6454100586949635`*^9, 3.6454100770310125`*^9}, 3.645410430082206*^9, {
   3.6624089952532687`*^9, 3.6624090425009713`*^9}, {3.662409267561844*^9, 
