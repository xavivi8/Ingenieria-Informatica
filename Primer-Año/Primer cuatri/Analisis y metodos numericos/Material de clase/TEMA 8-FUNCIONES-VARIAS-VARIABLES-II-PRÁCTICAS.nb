Cell["\<\
La variable y se mover\[IAcute]a desde el 0 hasta el punto de la recta que \
une (1,0) y (0,1). Se trata de la recta x+y=1, o y=1-x. \
\>", "Text",
 CellChangeTimes->{{3.724080357921029*^9, 3.724080383817029*^9}, {
  3.72408045563943*^9, 
  3.72408050501343*^9}},ExpressionUUID->"5e46c39e-a6dd-4369-a8ae-\
60838234264d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  SubsuperscriptBox["\[Integral]", "0", "1"], 
  RowBox[{
   SubsuperscriptBox["\[Integral]", "0", 
    RowBox[{"1", "-", "x"}]], 
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"x", ",", "y"}], "]"}], 
    RowBox[{"\[DifferentialD]", "y"}], 
    RowBox[{"\[DifferentialD]", "x"}]}]}]}]], "Input",
 CellChangeTimes->{{3.7207593448523054`*^9, 3.720759363313361*^9}, {
  3.7207596702949195`*^9, 3.7207596740701356`*^9}},
 FontSize->14,ExpressionUUID->"bae834db-5424-4454-9ac4-8d5aa14c0cc1"],

Cell[BoxData[
 FractionBox["1", "24"]], "Output",
 CellChangeTimes->{3.720759366821562*^9, 3.7207596750071893`*^9},
 FontSize->14,ExpressionUUID->"287ca73f-df1c-4f10-8b4d-3fe5c1cd2ce7"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", 
       RowBox[{"1", "-", "y"}]}], "}"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "1"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.7207593910879498`*^9, 3.7207594121041517`*^9}, {
  3.7207597120473075`*^9, 3.7207597158065224`*^9}},
 FontSize->14,ExpressionUUID->"9544e209-07f4-4726-8291-ca255e87b5e0"],

Cell[BoxData[
 FractionBox["1", "24"]], "Output",
 CellChangeTimes->{3.720759412741188*^9, 3.7207597165305643`*^9, 
  3.720777265505558*^9},
 FontSize->14,ExpressionUUID->"4634c0e8-6cc7-4f19-9eb5-4fd1cec88973"]
}, Open  ]],

Cell["\<\
Un recinto m\[AAcute]s complejo es el cuadril\[AAcute]tero de \
v\[EAcute]rtices (0,0), (3,0), (4,1), (1,1).\
\>", "Text",
 CellChangeTimes->{{3.7240805333898306`*^9, 
  3.7240806137142305`*^9}},ExpressionUUID->"c83eeefe-f7f2-480e-8980-\
be37b10428f9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RegionPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"0", "\[LessEqual]", "y", "\[LessEqual]", "1"}], "&&", 
    RowBox[{"y", "\[LessEqual]", "x", "\[LessEqual]", 
     RowBox[{"y", "+", "3"}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.720759466488262*^9, 3.7207595183602295`*^9}, {
  3.7207595854090643`*^9, 3.7207595915284147`*^9}, {3.720760409554203*^9, 
