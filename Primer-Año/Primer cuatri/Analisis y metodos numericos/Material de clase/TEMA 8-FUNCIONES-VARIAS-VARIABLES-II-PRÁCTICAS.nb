Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "\[Equal]", "0"}],
      ",", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}], "\[Equal]", 
      "0"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.7207579101162434`*^9, 3.720757948107416*^9}},
 FontSize->14,ExpressionUUID->"7b108880-1c95-47e8-b6c6-94e77dbc751a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", "0"}], ",", 
     RowBox[{"y", "\[Rule]", 
      RowBox[{"-", "2"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", "0"}], ",", 
     RowBox[{"y", "\[Rule]", 
      FractionBox["2", "3"]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", "0"}], ",", 
     RowBox[{"y", "\[Rule]", 
      RowBox[{"-", "2"}]}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.720757953352716*^9, 3.7207586915709395`*^9},
 FontSize->14,ExpressionUUID->"a5e7253a-6ab4-4c04-bc7f-de82f485742f"]
}, Open  ]],

Cell[TextData[{
 "El punto (0, -2) est\[AAcute] fuera del disco (o no cumple la condici\
\[OAcute]n). Queda como candidato el punto (0,2/3).\n\n",
 StyleBox["2) Borde:",
  FontWeight->"Bold"],
 " Tambi\[EAcute]n podr\[IAcute]a estar en la frontera, el borde del disco \
(cuando ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "9507b3d8-3256-42cc-b512-571201c2b9e8"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "445dc5a1-0f2e-4eed-9a88-2c3b499f267f"],
 " = 1).\n\nPara estudiar los m\[AAcute]ximos y m\[IAcute]nimos en el borde, \
es decir, sujetos a esa condici\[OAcute]n, podemos utilizar la \
t\[EAcute]cnica de los multiplicadores de Lagrange. \n\n\t2.1) ",
 StyleBox["Multiplicadores de Lagrange:",
  FontWeight->"Bold"],
 " Se trata de reunir en una misma funci\[OAcute]n, la funci\[OAcute]n f y la \
condici\[OAcute]n de estar en el borde. "
}], "Text",
 CellChangeTimes->{{3.720758697448276*^9, 3.7207587796279764`*^9}, {
  3.724079349849023*^9, 3.7240794645090237`*^9}, {3.845903060617206*^9, 
  3.8459030654112062`*^9}, {3.8791593078160577`*^9, 3.8791593118811064`*^9}, {
  3.8791593650814085`*^9, 3.8791593755623045`*^9}, {3.87915941653802*^9, 
  3.879159421825688*^9}},ExpressionUUID->"49f05590-64bc-49ca-9bf6-\
771862127b2c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"F", "[", 
   RowBox[{"x_", ",", "y_", ",", "t_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x", ",", "y"}], "]"}], "+", 
   RowBox[{"t", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"x", "^", "2"}], "+", 
      RowBox[{"y", "^", "2"}], "-", "1"}], ")"}]}]}]}]], "Input",
 CellChangeTimes->{{3.7207587859363375`*^9, 3.720758835852192*^9}},
 FontSize->14,ExpressionUUID->"527a69f7-6eec-41e2-b067-5a648120b97c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"F", "[", 
         RowBox[{"x", ",", "y", ",", "t"}], "]"}], ",", "x"}], "]"}], 
      "\[Equal]", "0"}], ",", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"F", "[", 
         RowBox[{"x", ",", "y", ",", "t"}], "]"}], ",", "y"}], "]"}], 
      "\[Equal]", "0"}], ",", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"F", "[", 
         RowBox[{"x", ",", "y", ",", "t"}], "]"}], ",", "t"}], "]"}], 
      "\[Equal]", "0"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "t"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.7207579101162434`*^9, 3.720757948107416*^9}, {
  3.7207588573014193`*^9, 3.720758891605381*^9}},
 FontSize->14,ExpressionUUID->"6f6c818a-2710-4aa7-b624-150116ca4d74"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", "0"}], ",", 
     RowBox[{"y", "\[Rule]", 
      RowBox[{"-", "1"}]}], ",", 
     RowBox[{"t", "\[Rule]", 
      RowBox[{"-", 
       FractionBox["5", "2"]}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", "0"}], ",", 
     RowBox[{"y", "\[Rule]", "1"}], ",", 
     RowBox[{"t", "\[Rule]", 
      RowBox[{"-", 
       FractionBox["3", "2"]}]}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.720757953352716*^9, 3.7207586915709395`*^9, 
  3.7207588934704876`*^9, 3.72077646304666*^9, 3.7240794827298236`*^9},
 FontSize->14,ExpressionUUID->"b58ab8f0-747a-4a68-89c8-28b29dbd9abc"]
}, Open  ]],

Cell["\<\
Al hacer las derivadas parciales e igualar a cero, tenemos como puntos \
candidatos (0, 1), (0, -1).

Reuniendo todos los puntos candidatos tenemos (0,2/3), (0,1), (0,-1). Ahora \
evaluamos la funci\[OAcute]n y vemos d\[OAcute]nde vale m\[AAcute]s y d\
\[OAcute]nde vale menos.\
\>", "Text",
 CellChangeTimes->{{3.7207589120645514`*^9, 3.7207589365469513`*^9}, {
  3.7240794913410234`*^9, 
  3.724079589106224*^9}},ExpressionUUID->"f81638ba-1bb4-4d49-830a-\
5501def7d46f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"0", ",", 
      RowBox[{"2", "/", "3"}]}], "]"}], ",", 
    RowBox[{"f", "[", 
     RowBox[{"0", ",", "1"}], "]"}], ",", 
    RowBox[{"f", "[", 
     RowBox[{"0", ",", 
      RowBox[{"-", "1"}]}], "]"}]}], "}"}], "//", "N"}]], "Input",
 CellChangeTimes->{{3.72075895051375*^9, 3.720758980947491*^9}},
 FontSize->14,ExpressionUUID->"3c62bece-93b2-4a02-bc69-45019ce8e2a9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "9.481481481481481`"}], ",", 
   RowBox[{"-", "9.`"}], ",", 
   RowBox[{"-", "3.`"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.7207589687437935`*^9, 3.720758981660532*^9}},
 FontSize->14,ExpressionUUID->"c0797320-d3aa-4588-bcfc-cc36cbe45291"]
}, Open  ]],

Cell[TextData[{
 "El m\[AAcute]ximo de la funci\[OAcute]n se alcanza en el punto (0,-1) y es \
-3. El m\[IAcute]nimo se alcanza en el punto (0,2/3) y vale -9.48.\n\n\t2.2) ",
 StyleBox["Otra forma: despejando",
  FontWeight->"Bold"],
 "\nEn algunos casos, en lugar de usar la t\[EAcute]cnica de los \
Multiplicadores de Lagrange, podr\[IAcute]amos dejar la funci\[OAcute]n en el \
borde con una sola variable. Para ello podr\[IAcute]amos tratar de despejar x \
\[OAcute] y, en funci\[OAcute]n de la otra variable y sustituir en la funci\
\[OAcute]n f.\n\nPor ejemplo, en este caso ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "20a89da7-c15a-4c4e-9d19-5d0f8634f8c1"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "eda010ea-9728-4125-a372-7a2982ffac0c"],
 " = 1, por tanto ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "13e68a76-69b4-4ff4-a0c5-0c11a98b2a40"],
 " = 1 - ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "29811d52-2358-4c8f-a78e-025b999b763e"],
 ". Sustituyendo:\nf(x,y)=",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["y", "3"], "+", 
   RowBox[{
    SuperscriptBox["x", "2"], " ", "y"}], " ", "+", " ", 
   RowBox[{"2", " ", 
    SuperscriptBox["x", "2"]}], " ", "+", " ", 
   RowBox[{"2", " ", 
    SuperscriptBox["y", "2"]}], "-", 
   RowBox[{"4", "y"}], "-", "8"}]],
  CellChangeTimes->{{3.845903346804206*^9, 3.8459033530222063`*^9}},
  ExpressionUUID->"bf2a9e64-7c0b-4e2f-ba00-ad780b23e0d7"],
 " =  ",
 Cell[BoxData[
  RowBox[{
   SuperscriptBox["y", "3"], "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SuperscriptBox["y", "2"]}], ")"}], " ", "y"}], " ", "+", " ", 
   RowBox[{"2", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SuperscriptBox["y", "2"]}], ")"}]}], " ", "+", " ", 
   RowBox[{"2", " ", 
    SuperscriptBox["y", "2"]}], "-", 
   RowBox[{"4", "y"}], "-", "8"}]],
  CellChangeTimes->{{3.845903346804206*^9, 3.8459033530222063`*^9}},
  ExpressionUUID->"0198ab4b-23f2-40c8-a30b-9738ab35b054"],
 " = -3 (2+y) = g(y)\n\nObtenemos una funci\[OAcute]n que depende ahora de \
una sola variable, y. En el borde, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "671088d7-0fde-4455-9eb4-37d14d73694d"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "b0d0288a-6c7e-4484-86b9-6a97cc31e34a"],
 " = 1, la variable y se mueve en el intervalo [-1,1]. Por tanto, deber\
\[IAcute]amos buscar los m\[AAcute]ximos y m\[IAcute]nimos de g(y) en el \
intervalo [-1,1]. Ahora tenemos un problema de m\[AAcute]ximos y \
m\[IAcute]nimos absolutos en una variable. La funci\[OAcute]n es continua en \
un intervalo cerrado y acotado. Como la derivada g\[CloseCurlyQuote](y) =-3, \
no es cero, no tenemos candidatos del interior del intervalo. Al ser \
derivable s\[OAcute]lo nos quedan como candidatos los extremos del intervalo, \
y=1, -1. Dado que ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "e857fa4e-430f-453f-a5f1-c66a0f968a0a"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "a0ee4f13-423a-4496-97d1-9337f81fea83"],
 " = 1, cuando y=1, x debe ser 0. Igualmente, si y=-1, x=0. Por tanto, los \
puntos candidatos que encontramos son (0,1) y (0,-1).\nLos candidatos son \
(0,1), (0,-1), (0,2/3).\n\n\t2.3) ",
 StyleBox["Otra forma m\[AAcute]s: parametrizando\n",
  FontWeight->"Bold"],
 "S",
 "e tratar\[IAcute]a de parametrizar el borde, es decir, recorrer los puntos \
del borde, en funci\[OAcute]n de un par\[AAcute]metro. Los puntos de la \
circunferencia ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "d9225b9b-6140-4031-826e-0662a3700f6c"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "02b022cc-7223-454c-9b66-f92f0064eed6"],
 " = 1, pueden parametrizarse escribiendo los puntos de la forma (cos t, sen \
t) con t movi\[EAcute]ndose en [0,2\[Pi]]. Ahora evaluamos la funci\[OAcute]n \
f en estos puntos y obtendremos una funci\[OAcute]n de una sola variable."
}], "Text",
 CellChangeTimes->{{3.720758997782454*^9, 3.720759046338231*^9}, {
  3.845903114909206*^9, 3.845903143326206*^9}, {3.845903177942206*^9, 
  3.8459033042802057`*^9}, {3.845903363270206*^9, 3.845903399381206*^9}, {
  3.845903447005206*^9, 3.845903617881206*^9}, {3.845904093605206*^9, 
  3.845904145032206*^9}, {3.8459043193722057`*^9, 3.845904558664206*^9}, {
  3.845904714986206*^9, 3.845904718399206*^9}, {3.845904887619206*^9, 
  3.845904906979206*^9}, {3.845905076915206*^9, 3.845905092183206*^9}, {
  3.845905135966206*^9, 3.845905301211206*^9}, {3.845906179429206*^9, 
  3.845906211182206*^9}, {3.879159439851819*^9, 3.879159446409757*^9}, {
  3.8791596813638115`*^9, 
  3.8791597120444*^9}},ExpressionUUID->"c8643539-5a78-4ab8-b9bb-a2e24eb413bb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{
    RowBox[{"Cos", "[", "t", "]"}], ",", 
    RowBox[{"Sin", "[", "t", "]"}]}], "]"}], "//", "Simplify"}]], "Input",
 CellChangeTimes->{{3.845905310814206*^9, 
  3.845905323652206*^9}},ExpressionUUID->"4b02b6b7-a619-4588-bb08-\
eca96a1879f6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "3"}], " ", 
  RowBox[{"(", 
   RowBox[{"2", "+", 
    RowBox[{"Sin", "[", "t", "]"}]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.8459053182062063`*^9, 
  3.845905324725206*^9}},ExpressionUUID->"610208a7-dae8-4634-aa39-\
ec36dd59adba"]
}, Open  ]],

Cell["\<\
El problema ahora es buscar los m\[AAcute]ximos y m\[IAcute]nimos de \
g(t)=-3(2 + sen t) con t en [0,2\[Pi]]. Como es habitual, buscamos dentro del \
intervalo puntos con derivada cero, y tambi\[EAcute]n consideramos los \
extremos.\
\>", "Text",
 CellChangeTimes->{{3.8459062212202063`*^9, 3.8459062614712057`*^9}, {
  3.8459062948272057`*^9, 3.8459063441802063`*^9}, {3.8791598520860577`*^9, 
  3.879159853416381*^9}},ExpressionUUID->"bc363f9b-c7cb-45a8-a450-\
1e8d7a631861"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "[", "t_", "]"}], ":=", 
  RowBox[{
   RowBox[{"-", "3"}], 
   RowBox[{"(", 
    RowBox[{"2", "+", 
     RowBox[{"Sin", "[", "t", "]"}]}], ")"}], " "}]}]], "Input",
 CellChangeTimes->{{3.845906355509206*^9, 3.845906374579206*^9}, {
  3.845906405887206*^9, 
  3.8459064122732058`*^9}},ExpressionUUID->"b02ca432-0fa4-4a21-bea0-\
417b60e06369"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"g", "'"}], "[", "t", "]"}], "\[Equal]", "0"}], ",", "t"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.8459064153902063`*^9, 
  3.845906471543206*^9}},ExpressionUUID->"ed89d982-5eb9-4735-a87d-\
8852bd6807f9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"t", "\[Rule]", 
     RowBox[{"ConditionalExpression", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox["\[Pi]", "2"]}], "+", 
        RowBox[{"2", " ", "\[Pi]", " ", 
         RowBox[{"C", "[", "1", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"C", "[", "1", "]"}], "\[Element]", "Integers"}]}], "]"}]}], 
    "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", "\[Rule]", 
     RowBox[{"ConditionalExpression", "[", 
      RowBox[{
       RowBox[{
        FractionBox["\[Pi]", "2"], "+", 
        RowBox[{"2", " ", "\[Pi]", " ", 
         RowBox[{"C", "[", "1", "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"C", "[", "1", "]"}], "\[Element]", "Integers"}]}], "]"}]}], 
    "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.845906435718206*^9, 
  3.845906472745206*^9}},ExpressionUUID->"c0e5e012-9c41-4b17-86cb-\
ab4d4ce591cd"]
}, Open  ]],

Cell[TextData[{
 "Obtenemos los valores de ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", 
    FractionBox[
     RowBox[{"-", "\[Pi]"}], "2"]}], TraditionalForm]],ExpressionUUID->
  "c22954d5-c236-47dc-8bea-0d93d6f3c898"],
 " y ",
 Cell[BoxData[
  FormBox[
   RowBox[{"t", "=", 
    FractionBox["\[Pi]", "2"]}], TraditionalForm]],ExpressionUUID->
  "fc20b2ce-2355-4fa9-abda-10af98e05c30"],
 ". Los extremos del intervalo son t=0, y t= 2\[Pi]. Estos puntos se \
corresponden en el borde con (cos (",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"-", "\[Pi]"}], "2"], TraditionalForm]],ExpressionUUID->
  "2c91ac4a-f235-4fdb-bb20-f3b1d62462eb"],
 ") , sen(",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"-", "\[Pi]"}], "2"], TraditionalForm]],ExpressionUUID->
  "ead76e4e-5502-4c58-882c-3e58a633c6a7"],
 ") )=(0,-1), (cos (",
 Cell[BoxData[
  FormBox[
   FractionBox["\[Pi]", "2"], TraditionalForm]],ExpressionUUID->
  "8f359d12-7f0b-4791-b88a-ed2075b6524b"],
 ") , sen(",
 Cell[BoxData[
  FormBox[
   FractionBox["\[Pi]", "2"], TraditionalForm]],ExpressionUUID->
  "1b881c43-9357-4e78-8a1f-7923af46f617"],
 ") )=(0,1), (cos (0) , sen(",
 Cell[BoxData[
  FormBox["0", TraditionalForm]],ExpressionUUID->
  "c312313b-31bf-4cfa-aa4a-322f74f99b4b"],
 ") )=(1,0), (cos (",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Pi]"}], TraditionalForm]],ExpressionUUID->
  "b6368eaf-19df-44cf-873c-ba9353e2ada4"],
 ") , sen(",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", "\[Pi]"}], TraditionalForm]],ExpressionUUID->
  "6e4daaaa-8605-4301-b6ca-c639f381dce9"],
 ") )=(1,0). El \[UAcute]ltimo punto se repite.\nAhora evaluamos la funci\
\[OAcute]n en los puntos posibles y vemos el m\[AAcute]ximo y/o el \
m\[IAcute]nimo."
}], "Text",
 CellChangeTimes->{{3.845906492819206*^9, 3.845906774974206*^9}, {
  3.845906824192206*^9, 3.845906832098206*^9}, {3.8767498229546404`*^9, 
  3.876749839866825*^9}, {3.876749870686285*^9, 
  3.8767498968915625`*^9}},ExpressionUUID->"7c8785e4-5482-4532-b137-\
07e883965014"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"0", ",", 
      RowBox[{"2", "/", "3"}]}], "]"}], ",", 
    RowBox[{"f", "[", 
     RowBox[{"0", ",", 
      RowBox[{"-", "1"}]}], "]"}], ",", 
    RowBox[{"f", "[", 
     RowBox[{"0", ",", "1"}], "]"}], ",", 
    RowBox[{"f", "[", 
     RowBox[{"1", ",", "0"}], "]"}]}], "}"}], "//", "N"}]], "Input",
 CellChangeTimes->{{3.845906777196206*^9, 
  3.845906817602206*^9}},ExpressionUUID->"1661fa0f-964e-4d8d-b57b-\
eae2b76e9fb8"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"-", "9.481481481481481`"}], ",", 
   RowBox[{"-", "3.`"}], ",", 
   RowBox[{"-", "9.`"}], ",", 
   RowBox[{"-", "6.`"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.845906807929206*^9, 
  3.845906818599206*^9}},ExpressionUUID->"36efb533-11c6-47d6-b805-\
a621cff1609d"]
}, Open  ]]
}, Open  ]],

