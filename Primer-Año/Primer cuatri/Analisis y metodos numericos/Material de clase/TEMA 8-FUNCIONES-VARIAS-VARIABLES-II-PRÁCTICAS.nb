Cell[BoxData[
 RowBox[{"Grad", "[", 
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9399885268454385`*^9, 3.939988543334506*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"4aa875a9-51f7-4f7d-8c7d-677ff01b4db5"],

Cell[BoxData[
 RowBox[{"{", 
