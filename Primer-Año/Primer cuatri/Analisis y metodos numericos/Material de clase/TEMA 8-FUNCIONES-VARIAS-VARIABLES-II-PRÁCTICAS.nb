Cell["\<\
C\[AAcute]lculo de integrales dobles en diferentes recintos del plano. 

El caso m\[AAcute]s sencillo es el de un rect\[AAcute]ngulo de lados \
paralelos a los ejes, pues en ese caso cada variable se mueve en un intervalo \
y son independientes una de otra.\
\>", "Text",
 CellChangeTimes->{{3.724079613192624*^9, 3.724079706355825*^9}, {
  3.7240797961650257`*^9, 3.7240797995034256`*^9}, {3.8456427020671735`*^9, 
  3.8456427026241736`*^9}},ExpressionUUID->"d52249cc-efd7-4672-99af-\
ec42daf90b20"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", " ", 
  RowBox[{"x", " ", "y"}]}]], "Input",
 CellChangeTimes->{{3.720759270710065*^9, 3.7207592720651417`*^9}, {
  3.720759304416992*^9, 3.720759309072259*^9}},
 FontSize->14,ExpressionUUID->"6bba961b-f3c6-4ec9-90cc-24ae8f6ac75a"],

