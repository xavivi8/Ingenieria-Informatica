Cell["Tambi\[EAcute]n podemos evaluar en un punto determinado.", "Text",
 CellChangeTimes->{{3.72406111128673*^9, 
  3.7240611307057295`*^9}},ExpressionUUID->"c65ae92e-cc6f-4983-9474-\
ca4daa3464ce"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"D", "[", 
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", "2"}], "}"}]}], "]"}], "/.", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "\[Rule]", "1"}], ",", 
    RowBox[{"y", "\[Rule]", "2"}], ",", 
    RowBox[{"z", "\[Rule]", 
     RowBox[{"-", "1"}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.7201546499002757`*^9, 3.7201547123208456`*^9}, {
  3.7201547875201473`*^9, 3.7201548328487396`*^9}},
 FontSize->14,
 CellLabel->"In[6]:=",ExpressionUUID->"93b14c27-b1f0-40a2-9cfc-22dd2f68dc0c"],

Cell[BoxData[
 RowBox[{"2", " ", 
  RowBox[{"Cos", "[", "1", "]"}]}]], "Output",
 CellChangeTimes->{{3.7201546620479703`*^9, 3.720154712732869*^9}, {
   3.7201547919393997`*^9, 3.7201548331647577`*^9}, 3.845902189528206*^9, 
   3.939645902627163*^9},
 FontSize->14,
 CellLabel->"Out[6]=",ExpressionUUID->"0f90412d-cf7d-49b5-8a3b-cee7233cb550"]
}, Open  ]],

Cell["\<\
Observemos que el Mathematica no pregunta el orden para realizar las \
derivadas, simplemente pregunta cu\[AAcute]ntas veces en cada variable. Si \
las derivadas parciales existen y son continuas, entonces es independiente el \
orden de derivaci\[OAcute]n.\
\>", "Text",
 CellChangeTimes->{{3.720154926844116*^9, 3.720155008436783*^9}, {
  3.7240611711517296`*^9, 3.7240612148357296`*^9}, {3.845902203318206*^9, 
  3.8459022367472057`*^9}, {3.8767505592444763`*^9, 3.876750674571975*^9}, {
  3.879157958698591*^9, 3.879157959901046*^9}, {3.9396441726202765`*^9, 
  3.9396442234779477`*^9}, {3.9396456754161863`*^9, 3.9396457203995066`*^9}, {
  3.939645945217899*^9, 3.9396459476134315`*^9}, {3.9399876626883373`*^9, 
  3.939987664935166*^9}},ExpressionUUID->"82bf8b61-17b9-46c6-93ef-\
eb7948c96354"],

Cell[TextData[{
 StyleBox["Plano tangente a la gr\[AAcute]fica",
  FontWeight->"Bold"],
 " de g[x, y] en el punto (1, 2).\nLa f\[OAcute]rmula es similar a la de la \
recta tangente (recordemos y=f(x0)+f \[CloseCurlyQuote](x0)(x-x0) ) \
a\[NTilde]adiendo un nuevo sumando al haber dos derivadas parciales.\n\
z=g(1,2) + ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], 
    RowBox[{"g", "(", 
     RowBox[{"1", ",", "2"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "0a6db36b-101a-4949-91d8-13421b188d02"],
 " (x-1)+",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "y"], 
    RowBox[{"g", "(", 
     RowBox[{"1", ",", "2"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "112c2b3b-b04c-433b-a690-c39769f728a8"],
 " (y-2)"
}], "Text",
 CellChangeTimes->{{3.720154926844116*^9, 3.720155008436783*^9}, {
   3.7240611711517296`*^9, 3.7240612148357296`*^9}, {3.845902203318206*^9, 
   3.8459022367472057`*^9}, {3.8767505592444763`*^9, 3.876750674571975*^9}, {
   3.879157958698591*^9, 3.879157959901046*^9}, {3.9396441726202765`*^9, 
   3.9396442234779477`*^9}, {3.9396456754161863`*^9, 
   3.9396457203995066`*^9}, {3.939645945217899*^9, 3.9396459476134315`*^9}, 
   3.9399876693284683`*^9},ExpressionUUID->"a77446e7-88cb-43b4-93ac-\
9327bb7e15a8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"g", "[", 
  RowBox[{"x", ",", "y"}], "]"}]], "Input",
 CellChangeTimes->{{3.9396461282250814`*^9, 3.9396461298575277`*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"83b9a6a9-7e12-4292-bd85-92bf9243bf29"],

