  3.93995599826013*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"7846e6d5-f792-4851-a915-fd38937a9cba"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "[", 
   RowBox[{"1", ",", "2"}], "]"}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"u", ",", "v"}], "]"}], ",", "u"}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"u", "->", "1"}], ",", 
       RowBox[{"v", "->", "2"}]}], "}"}]}], ")"}], 
   RowBox[{"(", 
    RowBox[{"x", "-", "1"}], ")"}]}], "+", " ", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"u", ",", "v"}], "]"}], ",", "v"}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"u", "->", "1"}], ",", 
       RowBox[{"v", "->", "2"}]}], "}"}]}], " ", ")"}], 
   RowBox[{"(", 
    RowBox[{"y", "-", "2"}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.9396459713551416`*^9, 3.9396461004461527`*^9}, {
  3.939646146812264*^9, 3.939646212829981*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"2541ba84-53a6-4894-b122-babee16437e6"],

Cell[BoxData[
 RowBox[{"5", "+", 
