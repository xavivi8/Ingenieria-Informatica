  CellChangeTimes->{3.9396462538751907`*^9, 3.93995601529775*^9, 
   3.9399560566728287`*^9},ExpressionUUID->
  "963dd821-abc1-42eb-8d47-f4ad0181305c"],
 "\nEl vector formado por las derivadas parciales, (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], 
    RowBox[{"f", "(", 
     RowBox[{"x0", ",", "y0"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "717739c7-4cb3-4eb6-a15c-fffdffef6130"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "y"], 
    RowBox[{"g", "(", 
     RowBox[{"x0", ",", "y0"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "b3f8517d-d0cd-4da9-9b5e-8e7c12a4fdbf"],
 "), se llama ",
 StyleBox["vector gradiente",
  FontWeight->"Bold"],
 ". El vector gradiente marca la direcci\[OAcute]n de ",
 StyleBox["m\[AAcute]xima pendiente",
  FontWeight->"Bold"],
 " y es ",
 StyleBox["perpendicular a las curvas de nivel",
  FontWeight->"Bold"],
 ".\n\nCuando la funci\[OAcute]n es diferenciable, las derivadas \
direccionales pueden calcularse haciendo el producto escalar del vector v por \
el vector gradiente:\n\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["D", 
     RowBox[{"(", 
      RowBox[{"v1", ",", "v2"}], ")"}]], 
    RowBox[{"f", "(", 
     RowBox[{"x0", ",", "y0"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "c6882c11-96f1-488e-8c60-6035b4833b42"],
 " = v1*",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", "f"}], 
     RowBox[{"\[PartialD]", "x"}]], 
    RowBox[{"(", 
     RowBox[{"x0", ",", "y0"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "948bcb0b-2a62-47ee-80b9-480fe8a6dc4f"],
 " + v2*",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", "f"}], 
     RowBox[{"\[PartialD]", "y"}]], 
    RowBox[{"(", 
     RowBox[{"x0", ",", "y0"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "fb8db476-839b-4546-b1bf-cc5fb889f040"],
 "\n\n",
 Cell[BoxData[
