Cell["\<\
Si decidimos considerar primero la variable x, movi\[EAcute]ndose entre 0 y \
4, nos encontramos que para ver c\[OAcute]mo se mueve la variable y, debemos \
considerar tres intervalos para la x. Parece m\[AAcute]s conveniente \
considerar la variable y entre el 0 y el 1. Para cada valor fijado de y, \
estudiamos c\[OAcute]mo se mueve la x.
Se mover\[AAcute] entre el recta que pasa por los puntos (0,0) y (1,1), y la \
recta que pasa por los puntos (3,0) y (4,1).
La primera recta es y=x, la segunda es y=x-3. Despejando x, encontramos entre \
qu\[EAcute] valores se mueve.\
\>", "Text",
 CellChangeTimes->{{3.7240806205470304`*^9, 3.7240808394462323`*^9}, {
  3.845906968350206*^9, 3.845906968819206*^9}, {3.8791602157007103`*^9, 
  3.879160215918816*^9}},ExpressionUUID->"b360d418-fc65-404b-a37b-\
de8fb973c66d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  SubsuperscriptBox["\[Integral]", "0", "1"], 
  RowBox[{
   SubsuperscriptBox["\[Integral]", "y", 
    RowBox[{"y", "+", "3"}]], 
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"x", ",", "y"}], "]"}], 
    RowBox[{"\[DifferentialD]", "x"}], 
    RowBox[{"\[DifferentialD]", "y"}]}]}]}]], "Input",
 CellChangeTimes->{{3.7207593448523054`*^9, 3.720759363313361*^9}, {
  3.7207596702949195`*^9, 3.7207596740701356`*^9}, {3.720759839213581*^9, 
  3.7207598495731735`*^9}},
 FontSize->14,ExpressionUUID->"5af3b7b1-71dc-440d-8c97-a499606adf1a"],

Cell[BoxData[
 FractionBox["13", "4"]], "Output",
 CellChangeTimes->{3.720759366821562*^9, 3.7207596750071893`*^9, 
  3.720759850506227*^9},
 FontSize->14,ExpressionUUID->"0228f60f-7139-462c-bf17-185a4fd7bec7"]
}, Open  ]],

Cell["\<\
Si hubi\[EAcute]semos considerado la variable x entre 0 y 4, \
habr\[IAcute]amos tenido que calcular estas tres integrales.\
\>", "Text",
 CellChangeTimes->{{3.7240808475582323`*^9, 
  3.724080887634632*^9}},ExpressionUUID->"dfab69dc-affe-4f23-b4be-\
8b0179e91645"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubsuperscriptBox["\[Integral]", "0", "1"], 
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "x"], 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], 
     RowBox[{"\[DifferentialD]", "y"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}], "+", 
  RowBox[{
   SubsuperscriptBox["\[Integral]", "1", "3"], 
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "1"], 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], 
     RowBox[{"\[DifferentialD]", "y"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}], "+", 
  RowBox[{
   SubsuperscriptBox["\[Integral]", "3", "4"], 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"x", "-", "3"}], "1"], 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], 
     RowBox[{"\[DifferentialD]", "y"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.7207593448523054`*^9, 3.720759363313361*^9}, {
  3.7207596702949195`*^9, 3.7207596740701356`*^9}, {3.7207598620778885`*^9, 
  3.720759918957142*^9}},
 FontSize->14,ExpressionUUID->"62268535-622f-4242-8dfc-ef93fa57c61a"],

Cell[BoxData[
 FractionBox["13", "4"]], "Output",
 CellChangeTimes->{3.720759366821562*^9, 3.7207596750071893`*^9, 
  3.7207599203032193`*^9},
 FontSize->14,ExpressionUUID->"28d4813c-8b59-474f-a1f0-54a50d0f69a7"]
}, Open  ]],

Cell[TextData[{
 "Otro recinto ser\[IAcute]a el cuarto de circulo unidad centrado en el (0,0) \
con argumentos entre 0 y ",
 Cell[BoxData[
  FormBox[
   FractionBox["\[Pi]", "2"], TraditionalForm]],ExpressionUUID->
  "2a74e409-6c7a-4635-aad9-77763963ab57"],
 " radianes."
}], "Text",
 CellChangeTimes->{{3.7240809005982323`*^9, 
  3.724080971515833*^9}},ExpressionUUID->"fd94925f-6797-4f02-ab3b-\
68f1d8902acd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RegionPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     SuperscriptBox["y", "2"]}], "\[LessEqual]", " ", "1"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "1"}], "}"}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.720759466488262*^9, 3.7207595183602295`*^9}, {
  3.7207595854090643`*^9, 3.7207595915284147`*^9}, {3.720760409554203*^9, 
  3.720760419017744*^9}, {3.7207604733548517`*^9, 3.720760513745162*^9}, {
  3.7240810237134333`*^9, 3.7240811112762337`*^9}},
 FontSize->14,ExpressionUUID->"50e87015-9258-4140-a9ad-eb3f8634e1de"],

