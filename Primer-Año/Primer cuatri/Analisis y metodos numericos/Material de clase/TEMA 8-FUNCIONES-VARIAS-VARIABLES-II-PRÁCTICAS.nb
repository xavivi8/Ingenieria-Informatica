Cell["En este caso, las integrales ser\[IAcute]an", "Text",
 CellChangeTimes->{{3.7240815704778366`*^9, 
  3.7240815805710373`*^9}},ExpressionUUID->"88a22ba4-7e27-4efa-ad5f-\
97cbb5ddab2b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubsuperscriptBox["\[Integral]", "1", "5"], 
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"2", "^", "2"}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"y", "-", "3"}], ")"}], "^", "2"}]}], "]"}]], 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], 
     RowBox[{"\[DifferentialD]", "x"}], 
     RowBox[{"\[DifferentialD]", "y"}]}]}]}], "-", 
  RowBox[{
   SubsuperscriptBox["\[Integral]", "2", "4"], 
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       RowBox[{"1", "^", "2"}], "-", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"y", "-", "3"}], ")"}], "^", "2"}]}], "]"}]], 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], 
     RowBox[{"\[DifferentialD]", "x"}], 
     RowBox[{"\[DifferentialD]", "y"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.7207593448523054`*^9, 3.720759363313361*^9}, {
  3.7207596702949195`*^9, 3.7207596740701356`*^9}, {3.720759839213581*^9, 
  3.7207598495731735`*^9}, {3.7207601310912757`*^9, 3.720760191332721*^9}},
 FontSize->14,ExpressionUUID->"de7b62ac-5554-471d-8e26-148b27b3dc86"],

Cell[BoxData["14"], "Output",
 CellChangeTimes->{3.720759366821562*^9, 3.7207596750071893`*^9, 
  3.720759850506227*^9, 3.7207601534355536`*^9, 3.720760192655797*^9},
 FontSize->14,ExpressionUUID->"00b9f337-5105-43c6-8ca2-fd39ccc5f7c6"]
}, Open  ]],

Cell[TextData[{
 "Como es l\[OAcute]gico todos los resultados coinciden, aunque las \
integrales que estamos calculando pueden ser de diferente dificultad.\n\nPara \
hallar los recintos y d\[OAcute]nde se mueven cada una de las variables, \
tenemos que conocer la ecuaci\[OAcute]n de una circunferencia si nos dan el \
centro (a,b) y el radio r.\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"x", " ", "-", " ", "a"}], ")"}], "^", "2"}], " ", "+", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"y", " ", "-", " ", "b"}], ")"}], "^", "2"}]}], "=", 
    SuperscriptBox["r", "2"]}], TraditionalForm]],ExpressionUUID->
  "183bedd3-946c-48aa-ae41-90fe80508b6d"],
 "\nEn el ejemplo anterior, ten\[IAcute]amos dos circunferencias (la de radio \
1 y la de radio 2) y para cada recinto deb\[IAcute]amos despejar una de las \
variables de alguna de las ecuaciones.\nIgualmente, es importante poder \
calcular la ecuaci\[OAcute]n de una recta que pasa por dos puntos."
}], "Text",
 CellChangeTimes->{{3.724082271588641*^9, 
  3.724082526555043*^9}},ExpressionUUID->"0904091b-3069-4e72-a9a5-\
b3a386e93c00"]
}, Open  ]],

Cell[TextData[{
 StyleBox["M\[CapitalAAcute]S EJERCICIOS",
  FontWeight->"Bold"],
 "\n\n\[FilledSmallCircle] Calcular los extremos relativos de la funci\
\[OAcute]n:\n\t\[FilledVerySmallSquare] f(x,y) =",
 StyleBox[" xy",
  FontSlant->"Italic"],
 " + ",
 Cell[BoxData[
  FormBox[
   FractionBox["2", "x"], TraditionalForm]], "Subsection",
  FontFamily->"Book Antiqua",
  FontSize->14,
  FontColor->GrayLevel[0],ExpressionUUID->
  "5ee3f779-c842-403b-9165-0a0fac71b216"],
 "+ ",
 Cell[BoxData[
  FormBox[
   FractionBox["4", "y"], TraditionalForm]],ExpressionUUID->
  "fd6b396f-3646-485e-9116-643cb6137537"],
 "\n\t\[FilledVerySmallSquare] f(x,y) = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"-", " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "2"], "+", " ", 
       SuperscriptBox["y", "2"], " ", "-", " ", 
       RowBox[{"4", "y"}]}], " ", ")"}]}]], TraditionalForm]],ExpressionUUID->
  "15d688d1-689c-4916-95d5-7a108bdd00ec"],
 "\n\t\[FilledVerySmallSquare] f(x,y) = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "d3e2d6f7-01ff-4533-a885-7c661d68ae11"],
 " + 4 ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "98d6c76f-710d-425f-9c3c-e2bd3abdd18e"],
 " - 2",
 StyleBox["x",
  FontSlant->"Italic"],
 " + 8",
 StyleBox["y",
  FontSlant->"Italic"],
 " - 1\n\t\n\[FilledSmallCircle] Calcular los extremos de la funci\[OAcute]n \
\n\t\[FilledVerySmallSquare] f(x,y) ",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", 
    RowBox[{
     SuperscriptBox["y", "2"], " ", "-", " ", 
     SuperscriptBox["x", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "82c0f8f2-653c-40ea-809a-6ba847936e37"],
 " en ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SuperscriptBox["x", "2"], "4"], TraditionalForm]],ExpressionUUID->
  "e4172048-225e-47b2-8525-627e7f3548dd"],
 "+ ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "63066608-13a5-4fb1-9157-661b10f7bad2"],
 " = 1\n\t\[FilledVerySmallSquare] f(x,y) ",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", " ", 
    SuperscriptBox["x", "2"]}], TraditionalForm]],ExpressionUUID->
  "3782cf28-eff6-43a4-8355-7f1322764997"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "b12800b0-38eb-48d5-be97-a0b658340f46"],
 " en  ",
 StyleBox["xy",
  FontSlant->"Italic"],
 " -3 = 0\n\t\[FilledVerySmallSquare] f(x,y) = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "79206402-dd65-4bf1-8216-d9180454b6e5"],
 " + 4",
 StyleBox["xy",
  FontSlant->"Italic"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "1597dee5-8732-4c35-a114-d5b546581ef3"],
 "  en",
 StyleBox[" x - y",
  FontSlant->"Italic"],
 " - 6 = 0\n\[FilledSmallCircle] Calcular el gradiente de ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", 
     RowBox[{"(", 
      RowBox[{"x", ",", "y"}], ")"}]}], "=", 
    SuperscriptBox["x", "2"]}], TraditionalForm]],ExpressionUUID->
  "daa641bd-dcda-4dc6-a943-c752e1b15c47"],
 StyleBox["y - x",
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "a876195b-ad27-4133-9822-1ba2e7eda0ac"],
 "  en el punto P=(-2,3).\n\[FilledSmallCircle] Calcular el plano tangente a \
z= -10",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    StyleBox["xy",
     FontSlant->"Italic"]], TraditionalForm]],ExpressionUUID->
  "bf24e8be-d176-4ba9-a84f-4d4558c8d97e"],
 " en (1,-1)\n\[FilledSmallCircle] Calcular el plano tangente a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"2", 
    SuperscriptBox["z", "2"]}], TraditionalForm]],ExpressionUUID->
  "6aefec08-92c1-471e-b8f5-8dcde920ce91"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "dc8be4b0-88cd-483f-84d9-18e6b5f104fa"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "e05ab814-e1d1-424e-98ea-1a420a5a4b9b"],
 " = 23 en (1,2,3)\n\[FilledSmallCircle] Calcular el plano tangente a ",
 Cell[BoxData[
  FormBox[
   RowBox[{"z", "=", 
    SuperscriptBox["xe", 
     RowBox[{
      RowBox[{"-", " ", "2"}], "y"}]]}], TraditionalForm]],ExpressionUUID->
  "54c6daa3-5b10-4bbe-a5fe-d5bae10dcea3"],
 "  en (1,0,1)\n\[FilledSmallCircle] Calcular el volumen de la figura \
limitada por arriba por la gr\[AAcute]fica de f(x,y) = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "a1ef9d5c-4b02-40d7-9095-4152c8bde6e8"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "ab306dfb-ef1d-49a0-bc75-d87940a0878f"],
 " , y en el plano por las rectas x=1, x=3, y=0, y=1.\n\n\[FilledSmallCircle] \
Calcular las siguientes integrales:\n\t\[FilledVerySmallSquare] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "1"}], "2"], 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "3", "6"], 
     RowBox[{"10", " ", "x", " ", 
      SuperscriptBox["y", "2"], 
      RowBox[{"\[DifferentialD]", "y"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}]}], TraditionalForm]], "Subsection",
  FontFamily->"Book Antiqua",
  FontSize->14,
  FontColor->GrayLevel[0],ExpressionUUID->
  "a8bd3f97-6230-40ef-8607-3bdb26e06c25"],
 "\n\t\n\t\[FilledVerySmallSquare]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "1"], 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "1", "3"], 
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       RowBox[{"-", "1"}], "2"], 
      RowBox[{
       RowBox[{"(", " ", 
        RowBox[{
         RowBox[{"2", "x"}], " ", "+", 
         RowBox[{"3", "y"}], " ", "-", "z"}], ")"}], 
       RowBox[{"\[DifferentialD]", "x"}], 
       RowBox[{"\[DifferentialD]", "y"}], 
       RowBox[{"\[DifferentialD]", "z"}]}]}]}]}], TraditionalForm]], "Text",
  FontFamily->"Book Antiqua",
  FontColor->GrayLevel[0],ExpressionUUID->
  "76049a5e-e72e-4d58-85ab-77e274b1949a"],
 "\n\t\n\t\[FilledVerySmallSquare] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "1", "2"], 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", 
      RowBox[{"x", " ", "-", " ", "1"}]], " ", 
     RowBox[{"y", 
      RowBox[{"\[DifferentialD]", "y"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}]}], TraditionalForm]], "Text",
  FontFamily->"Book Antiqua",
  FontColor->GrayLevel[0],ExpressionUUID->
  "8a056954-a4c9-4816-aebc-25f21986a393"],
 "\n\t\n\t\[FilledVerySmallSquare] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "3"}], "1"], 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", "x"], 
     RowBox[{
      FractionBox["3", 
       RowBox[{
        SuperscriptBox["x", "2"], " ", "+", " ", 
        SuperscriptBox["y", "2"]}]], 
      RowBox[{"\[DifferentialD]", "y"}], 
      RowBox[{"\[DifferentialD]", "x"}]}]}]}], TraditionalForm]], "Subsection",
  FontFamily->"Book Antiqua",
  FontSize->14,
  FontColor->GrayLevel[0],ExpressionUUID->
  "962ecade-8b9d-46c1-8505-66d259022260"],
 "\n\t\n\t\[FilledVerySmallSquare] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "2"], 
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", 
      SqrtBox[
       RowBox[{"4", " ", "-", " ", 
        SuperscriptBox["x", "2"]}]]], 
     RowBox[{
      RowBox[{"(", " ", 
       RowBox[{"x", "+", "y"}], ")"}], 
      RowBox[{"\[DifferentialD]", "x"}], 
      RowBox[{"\[DifferentialD]", "y"}]}]}]}], TraditionalForm]], "Subsection",
  FontFamily->"Book Antiqua",
  FontSize->14,
  FontColor->GrayLevel[0],ExpressionUUID->
  "f59f0d91-c305-44c4-9236-27ebd9c93f28"],
 "\n\n\t\[FilledVerySmallSquare] Integral de la funci\[OAcute]n f(x,y) = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    SuperscriptBox["y", "2"]], TraditionalForm]],ExpressionUUID->
  "3eb36f94-dd45-4ee4-8232-2bb3f7c2c162"],
 " en la regi\[OAcute]n R={(x,y) / ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]],ExpressionUUID->
  "2a0d5465-3666-451e-981b-4e6d05924a4a"],
 "\[LessEqual]x\[LessEqual]2y, 0\[LessEqual]y\[LessEqual]2 }"
}], "Section",
