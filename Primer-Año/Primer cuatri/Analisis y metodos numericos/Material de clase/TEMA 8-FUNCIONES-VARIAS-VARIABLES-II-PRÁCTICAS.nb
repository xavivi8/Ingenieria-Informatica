       RowBox[{"1", "+", 
        RowBox[{"t", " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"Pi", "/", "6"}], "]"}]}]}]}], "]"}], "-", 
     RowBox[{"g", "[", 
      RowBox[{"2", ",", "1"}], "]"}]}], "t"], ",", 
