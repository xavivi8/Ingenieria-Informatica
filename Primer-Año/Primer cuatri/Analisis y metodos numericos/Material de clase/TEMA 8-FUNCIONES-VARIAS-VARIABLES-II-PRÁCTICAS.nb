Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Limit", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{
      RowBox[{"t", " ", 
       RowBox[{"Cos", "[", "s", "]"}]}], ",", 
      RowBox[{"t", " ", 
       RowBox[{"Sin", "[", "s", "]"}]}]}], "]"}], "/", "t"}], ",", 
   RowBox[{"t", "->", "0"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.939902270421013*^9, 3.9399022781821303`*^9}, {
   3.939902320486673*^9, 3.9399023665020247`*^9}, 3.9399024599641156`*^9, {
   3.939902494030745*^9, 3.9399025250320764`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"e40c5066-cfdc-40a0-8f88-07b3ccccb0d6"],

Cell[BoxData[
 FractionBox[
  SuperscriptBox[
   RowBox[{"Cos", "[", "s", "]"}], "3"], 
  RowBox[{
   SuperscriptBox[
    RowBox[{"Cos", "[", "s", "]"}], "2"], "+", 
   SuperscriptBox[
    RowBox[{"Sin", "[", "s", "]"}], "2"]}]]], "Output",
 CellChangeTimes->{3.939902369149304*^9, 3.9399025292034936`*^9},
 CellLabel->"Out[8]=",ExpressionUUID->"307a4a9e-88f6-43a2-bb2a-5b1a0e406f19"]
}, Open  ]],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"x", "^", "3"}], "/", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"x", "^", "2"}], "+", 
     RowBox[{"y", "^", "2"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.9399024269283266`*^9, 3.939902441853619*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"4cb2c39d-a264-4dbd-b48b-5b351c2a3810"],

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"-", 
    FractionBox[
     RowBox[{"2", " ", 
      SuperscriptBox["x", "4"]}], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["x", "2"], "+", 
        SuperscriptBox["y", "2"]}], ")"}], "2"]]}], "+", 
   FractionBox[
    RowBox[{"3", " ", 
     SuperscriptBox["x", "2"]}], 
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     SuperscriptBox["y", "2"]}]]}]}]], "Input",
 CellChangeTimes->{{3.9399158670283413`*^9, 3.9399158787112727`*^9}},
 CellLabel->"In[12]:=",ExpressionUUID->"f518e6e5-38f7-472d-a55c-c6f01f6d3438"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Limit", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"g", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "/.", 
    RowBox[{"y", "->", "0"}]}], ",", 
   RowBox[{"x", "->", "0"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9399159388417416`*^9, 3.9399159921440287`*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"e0c159b8-6154-4e07-883a-c9213ab4138b"],

