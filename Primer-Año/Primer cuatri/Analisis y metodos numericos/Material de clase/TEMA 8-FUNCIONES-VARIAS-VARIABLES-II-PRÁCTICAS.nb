Cell[CellGroupData[{

Cell["\<\

\tIntroducci\[OAcute]n
\tDerivadas parciales
\tPlano tangente a la gr\[AAcute]fica de una funci\[OAcute]n de dos variables
\tAproximaci\[OAcute]n de una funci\[OAcute]n por el plano tangente
\tEstimaci\[OAcute]n de errores\
\>", "Section",
 CellChangeTimes->{{3.500751345359375*^9, 3.500751379984375*^9}, {
   3.500790035609375*^9, 3.500790048953125*^9}, {3.569509423875*^9, 
