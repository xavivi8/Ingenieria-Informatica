Cell["\<\
Se trata de un rect\[AAcute]ngulo del plano de lados paralelos a los ejes. La \
variable x se mueve entre 0 y 3, mientras que la variable y se mueve entre 0 \
y 2.\
\>", "Text",
 CellChangeTimes->{{3.724079806585826*^9, 3.7240798688298264`*^9}, {
  3.8456427093661737`*^9, 
  3.8456427109911737`*^9}},ExpressionUUID->"9e016319-65f1-4458-93e0-\
1df7eceae7cc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  SubsuperscriptBox["\[Integral]", "0", "3"], 
  RowBox[{
   SubsuperscriptBox["\[Integral]", "0", "2"], 
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"x", ",", "y"}], "]"}], 
    RowBox[{"\[DifferentialD]", "y"}], 
    RowBox[{"\[DifferentialD]", "x"}]}]}]}]], "Input",
 CellChangeTimes->{{3.7207593448523054`*^9, 3.720759363313361*^9}},
 FontSize->14,ExpressionUUID->"fe112233-3d4f-4134-aaff-a66b43fee350"],

Cell[BoxData["9"], "Output",
 CellChangeTimes->{3.720759366821562*^9, 3.72077685992136*^9},
 FontSize->14,ExpressionUUID->"a63abd58-b688-4b17-8ca3-d5ca0ebcca20"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "3"}], "}"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "2"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.7207593910879498`*^9, 3.7207594121041517`*^9}},
 FontSize->14,ExpressionUUID->"720f0de9-501c-41ad-b238-cc8a913e3899"],

Cell[BoxData["9"], "Output",
 CellChangeTimes->{3.720759412741188*^9, 3.7207769055469694`*^9},
 FontSize->14,ExpressionUUID->"ce13f975-92f5-4573-8ee8-02efcf0ca4ab"]
}, Open  ]],

Cell["\<\
El valor calculado es el volumen de la regi\[OAcute]n en el espacio dada por \
la variable x entre 0 y 3, la variable y entre 0 y 2, y la variable z entre 0 \
y f(x,y)=xy.

El valor medio ser\[IAcute]a el correspondiente a dividir el valor obtenido \
(9) entre la superficie del dominio ( en este caso el rect\[AAcute]ngulo \
[0,3]x[0,2], por tanto 6). El valor medio es 9/6=3/2. \
\>", "Text",
 CellChangeTimes->{{3.724079872573826*^9, 3.7240800353910275`*^9}, {
  3.724080162031828*^9, 
  3.724080205087828*^9}},ExpressionUUID->"314846a8-811e-4b6c-8f00-\
7306e6a8a1f0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"RegionPlot3D", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", "3"}], "&&", 
       RowBox[{"0", "\[LessEqual]", "y", "\[LessEqual]", "2"}], "&&", 
       RowBox[{"0", "\[LessEqual]", "z", "\[LessEqual]", 
        RowBox[{"x", " ", "y"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "0", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"z", ",", "0", ",", "6"}], "}"}], ",", 
      RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}], ",", 
    RowBox[{"Plot3D", "[", 
     RowBox[{
      RowBox[{"3", "/", "2"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "3"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"y", ",", "0", ",", "2"}], "}"}]}], "]"}]}], "}"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.720759466488262*^9, 3.7207595183602295`*^9}, {
  3.7207595854090643`*^9, 3.7207595915284147`*^9}, {3.7207770043756223`*^9, 
  3.7207770297770753`*^9}},
 FontSize->14,ExpressionUUID->"5af03acf-278f-4621-8a15-fe1dafb53158"],

