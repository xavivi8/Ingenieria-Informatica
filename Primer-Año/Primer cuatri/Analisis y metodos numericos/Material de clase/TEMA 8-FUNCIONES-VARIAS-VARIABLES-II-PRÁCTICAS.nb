Cell["Otra forma ser\[IAcute]a,", "Text",
 CellChangeTimes->{{3.724081426957836*^9, 3.724081443166236*^9}, {
  3.724081734979838*^9, 
  3.724081747537838*^9}},ExpressionUUID->"ad89357e-3e4a-408c-a303-\
09a55f498775"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"RegionPlot", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox["1", "2"], "\[LessEqual]", " ", 
