Cell[TextData[{
 "Si consideramos la variable x en el intervalo [0,1], fijado x, la variable \
y se mover\[AAcute] entre 0 y el punto de la circunferencia ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "e05cc2d4-f42c-42b9-b998-e4c41b4d878f"],
 "+ ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "02d64469-a95f-4687-87d4-51073ba4cac9"],
 "=1. Despejando la y obtenemos, y=",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{"1", "-", 
     SuperscriptBox["x", "2"]}]], TraditionalForm]],ExpressionUUID->
  "df461268-35cc-402f-bd7b-a53d8cf73ca6"]
}], "Text",
 CellChangeTimes->{{3.7240811272818336`*^9, 
  3.724081236481835*^9}},ExpressionUUID->"0d4cffc6-9d87-4b7a-8509-\
c1868475e178"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  SubsuperscriptBox["\[Integral]", "0", "1"], 
  RowBox[{
   SubsuperscriptBox["\[Integral]", "0", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"1", "-", 
      SuperscriptBox["x", "2"]}], "]"}]], 
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"x", ",", "y"}], "]"}], 
    RowBox[{"\[DifferentialD]", "y"}], 
    RowBox[{"\[DifferentialD]", "x"}]}]}]}]], "Input",
 CellChangeTimes->{{3.7207593448523054`*^9, 3.720759363313361*^9}, {
  3.7207596702949195`*^9, 3.7207596740701356`*^9}, {3.720759839213581*^9, 
  3.7207598495731735`*^9}, {3.7207599967095895`*^9, 3.7207600122924805`*^9}, {
  3.724081246715435*^9, 3.724081250490635*^9}},
 FontSize->14,ExpressionUUID->"b666c3d6-f9b5-4a05-8b9e-2fc6348c9b84"],

Cell[BoxData[
 FractionBox["1", "8"]], "Output",
 CellChangeTimes->{
  3.720759366821562*^9, 3.7207596750071893`*^9, 3.720759850506227*^9, {
   3.7207600052180758`*^9, 3.720760012872514*^9}},
 FontSize->14,ExpressionUUID->"c05c773d-da27-4159-8531-5d56de03f095"]
}, Open  ]],

Cell["\<\
Finalmente consideremos el recinto dado por media corona circular, centrada \
en el punto (0,3), de radio menor 1 y radio mayor 2, con x mayor o igual que \
cero.\
\>", "Text",
 CellChangeTimes->{{3.724081266979835*^9, 
  3.7240813335606356`*^9}},ExpressionUUID->"ae752dd8-2348-4ffb-843a-\
0d39e1fa8751"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"RegionPlot", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["1", "2"], "\[LessEqual]", " ", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"y", "-", "3"}], ")"}], "2"]}], "\[LessEqual]", " ", 
    SuperscriptBox["2", "2"]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "2"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", "0", ",", "6"}], "}"}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.720759466488262*^9, 3.7207595183602295`*^9}, {
  3.7207595854090643`*^9, 3.7207595915284147`*^9}, {3.720760409554203*^9, 
  3.720760419017744*^9}, {3.7207604733548517`*^9, 3.720760513745162*^9}, {
  3.7240810237134333`*^9, 3.7240811112762337`*^9}, {3.7240813556658354`*^9, 
  3.724081398940236*^9}},
 FontSize->14,ExpressionUUID->"30f72651-86bf-41ee-8463-569e578970a8"],

