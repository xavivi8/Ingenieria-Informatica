Cell[TextData[{
 "Observemos que el Mathematica no pregunta el orden para realizar las \
derivadas, simplemente pregunta cu\[AAcute]ntas veces en cada variable. Si \
las derivadas parciales existen y son continuas, entonces es independiente el \
orden de derivaci\[OAcute]n.\n\n\n",
 StyleBox["Plano tangente a la gr\[AAcute]fica",
  FontWeight->"Bold"],
 " de g[x, y] en el punto (1, 2).\nLa f\[OAcute]rmula es similar a la de la \
recta tangente (recordemos y=f(x0)+f \[CloseCurlyQuote](x0)(x-x0) ) \
a\[NTilde]adiendo un nuevo sumando al haber dos derivadas parciales.\n\
z=g(1,2) + ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], 
    RowBox[{"g", "(", 
     RowBox[{"1", ",", "2"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "e7241cc5-e182-41d4-883d-8093f5b06947"],
 " (x-1)+",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "y"], 
    RowBox[{"g", "(", 
     RowBox[{"1", ",", "2"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "ef0eb379-fdbf-4c72-ae9f-7458328a1de8"],
 " (y-2)\n\n",
 StyleBox["El vector gradiente",
  FontWeight->"Bold"],
 " en ese punto es el vector  (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], 
    RowBox[{"g", "(", 
     RowBox[{"1", ",", "2"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "caa6e4be-b7b3-4589-9300-4f9f64c3a82b"],
 " , ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "y"], 
    RowBox[{"g", "(", 
     RowBox[{"1", ",", "2"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "37c0a4f6-4aa0-44c4-8eb0-470fd2b4689c"],
 "). Muestra la direcci\[OAcute]n de mayor crecimiento de la funci\[OAcute]n \
g(x,y) en ese punto."
}], "Text",
 CellChangeTimes->{{3.720154926844116*^9, 3.720155008436783*^9}, {
  3.7240611711517296`*^9, 3.7240612148357296`*^9}, {3.845902203318206*^9, 
  3.8459022367472057`*^9}, {3.8767505592444763`*^9, 3.876750674571975*^9}, {
  3.879157958698591*^9, 3.879157959901046*^9}, {3.9396441726202765`*^9, 
  3.9396442234779477`*^9}, {3.9396456754161863`*^9, 3.9396457203995066`*^9}, {
  3.9399877023162985`*^9, 
  3.939987705440604*^9}},ExpressionUUID->"617f78d3-fbb9-4e2e-8457-\
ad0e1a677047"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"g", "[", 
   RowBox[{"1", ",", "2"}], "]"}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "\[Rule]", "1"}], ",", 
       RowBox[{"y", "\[Rule]", "2"}]}], "}"}]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"x", "-", "1"}], ")"}]}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"g", "[", 
        RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "\[Rule]", "1"}], ",", 
       RowBox[{"y", "\[Rule]", "2"}]}], "}"}]}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"y", "-", "2"}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.7201550164062386`*^9, 3.720155092806608*^9}},
 FontSize->14,
 CellLabel->"In[7]:=",ExpressionUUID->"743e3d2c-4e1f-4419-941c-26e098d8e8d6"],

Cell[BoxData[
 RowBox[{"5", "+", 
  RowBox[{"2", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "x"}], ")"}]}], "+", 
  RowBox[{"4", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "2"}], "+", "y"}], ")"}]}]}]], "Output",
 CellChangeTimes->{{3.7201550662230883`*^9, 3.720155093594653*^9}, 
   3.9396459085887203`*^9},
 FontSize->14,
 CellLabel->"Out[7]=",ExpressionUUID->"b27c1bd3-aaae-4ab4-80a7-b52a89059712"]
}, Open  ]],

Cell["\<\
El vector gradiente marca una direcci\[OAcute]n perpendicular a las curvas de \
nivel.\
\>", "Text",
 CellChangeTimes->{{3.879158138874459*^9, 3.879158184409281*^9}, {
  3.879158229391323*^9, 
  3.8791582504112425`*^9}},ExpressionUUID->"8496156f-6fb4-4457-a1b8-\
1a85d4b6fd06"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"ContourPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"g", "[", 
       RowBox[{"x", ",", "y"}], "]"}], "==", 
      RowBox[{"g", "[", 
       RowBox[{"1", ",", "2"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"y", ",", "1", ",", "3"}], "}"}]}], "]"}], ",", 
   RowBox[{"ParametricPlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], "+", 
      RowBox[{"t", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"x", "\[Rule]", "1"}], ",", 
             RowBox[{"y", "\[Rule]", "2"}]}], "}"}]}], ")"}], " ", ",", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"D", "[", 
            RowBox[{
             RowBox[{"g", "[", 
              RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"x", "\[Rule]", "1"}], ",", 
             RowBox[{"y", "\[Rule]", "2"}]}], "}"}]}], ")"}]}], "}"}]}]}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], ",", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], "}"}], "]"}], ",", 
   RowBox[{"AspectRatio", "->", "Automatic"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.876750760175231*^9, 3.876750897657795*^9}, {
  3.8767509323042316`*^9, 3.87675099192258*^9}, {3.876751034190442*^9, 
  3.876751097555668*^9}},
 CellLabel->"In[14]:=",ExpressionUUID->"4581ca8a-7dc8-48b5-b8f6-2c1ba1b7e080"],

