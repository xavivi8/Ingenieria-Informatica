Cell[TextData[{
 StyleBox["Plano tangente a la gr\[AAcute]fica",
  FontWeight->"Bold"],
 " de f(x, y) en el punto (x0, y0).\nCuando la funci\[OAcute]n es \
diferenciable, tenemos garantizada la existencia de plano tangente.\nLa f\
\[OAcute]rmula es similar a la de la recta tangente (recordemos y=f(x0)+f \
\[OpenCurlyQuote](x0)(x-x0) ) a\[NTilde]adiendo un nuevo sumando al haber dos \
derivadas parciales.\n\t\t\tz=f(x0,y0) + ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], 
    RowBox[{"f", "(", 
     RowBox[{"x0", ",", "y0"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "efd19a42-071b-43ef-99ce-e4dd76d53125"],
 " (x-x0)+",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "y"], 
    RowBox[{"f", "(", 
     RowBox[{"x0", ",", "y0"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "a00d0ec4-7e99-4934-a7df-256b533b8449"],
