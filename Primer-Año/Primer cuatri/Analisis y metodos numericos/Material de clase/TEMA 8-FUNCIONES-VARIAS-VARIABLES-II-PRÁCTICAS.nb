Cell[TextData[{
 "La derivada direccional de la funci\[OAcute]n g en el punto (x,y) en la \
direcci\[OAcute]n (cos s, sen s) es 2x cos s + 2 y sen s. \nEl gradiente de \
g(x,y) es ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", "g"}], 
     RowBox[{"\[PartialD]", "x"}]], "=", 
    RowBox[{"2", "x"}]}], TraditionalForm]],ExpressionUUID->
  "359d4737-1114-4717-854b-d934bc3f5846"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", "g"}], 
     RowBox[{"\[PartialD]", "y"}]], "=", 
    RowBox[{"2", "y"}]}], TraditionalForm]],ExpressionUUID->
  "e484b17e-4a06-4b6c-b529-4cf92f432f1f"],
 "."
}], "Text",
 CellChangeTimes->{{3.939987927507389*^9, 3.9399880024597692`*^9}, {
  3.93998813120479*^9, 
  3.9399881670467305`*^9}},ExpressionUUID->"a7b349dc-e73d-4115-9c32-\
3f59cb2f9fe1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], 
    RowBox[{"g", "[", 
     RowBox[{"x", ",", "y"}], "]"}]}], ",", 
   RowBox[{
    SubscriptBox["\[PartialD]", "y"], 
    RowBox[{"g", "[", 
     RowBox[{"x", ",", "y"}], "]"}]}]}], "}"}]], "Input",
 CellChangeTimes->{{3.9399880047627745`*^9, 3.93998803014596*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"c5dea84c-a40a-437b-9f73-47a0785eb328"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"2", " ", "x"}], ",", 
   RowBox[{"2", " ", "y"}]}], "}"}]], "Output",
 CellChangeTimes->{3.939988031443997*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"de12cde7-8a74-4196-b0b1-b56784513e09"]
}, Open  ]],

Cell[TextData[{
 "La derivada direccional de la funci\[OAcute]n g en el punto (x,y) en la \
direcci\[OAcute]n (cos s, sen s) es 2x cos s + 2 y sen s. \nEl gradiente de \
g(x,y) es ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", "g"}], 
     RowBox[{"\[PartialD]", "x"}]], "=", 
    RowBox[{"2", "x"}]}], TraditionalForm]],ExpressionUUID->
  "55d85faf-4b10-45e6-87de-4aea032b2851"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{"\[PartialD]", "g"}], 
     RowBox[{"\[PartialD]", "y"}]], "=", 
    RowBox[{"2", "y"}]}], TraditionalForm]],ExpressionUUID->
  "f2788593-5d18-42e9-a86a-6a148a149b7f"],
 ".\nComo g(x,y) es diferenciable, la derivada direccional de g(x,y) se puede \
calcular multiplicando el vector unitario de direcci\[OAcute]n por el vector \
gradiente."
}], "Text",
 CellChangeTimes->{{3.939987927507389*^9, 3.9399880024597692`*^9}, {
  3.93998813120479*^9, 3.9399881670467305`*^9}, {3.9399884668944645`*^9, 
  3.9399885218099065`*^9}},ExpressionUUID->"db7766dc-2912-4e1b-8aa5-\
1dc79bd4e44b"],

