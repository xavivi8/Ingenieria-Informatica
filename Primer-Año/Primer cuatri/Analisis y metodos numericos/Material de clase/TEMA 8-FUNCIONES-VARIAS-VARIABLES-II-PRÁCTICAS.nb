Cell["En este caso, las integrales ser\[IAcute]an", "Text",
 CellChangeTimes->{{3.7240815704778366`*^9, 
  3.7240815805710373`*^9}},ExpressionUUID->"dedecbaf-05e4-4aed-99bb-\
017efb723c29"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubsuperscriptBox["\[Integral]", "0", "1"], 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"3", "+", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"1", "^", "2"}], "-", 
        RowBox[{"x", "^", "2"}]}], "]"}]}], 
     RowBox[{"3", "+", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"2", "^", "2"}], "-", 
        RowBox[{"x", "^", "2"}]}], "]"}]}]], 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], 
     RowBox[{"\[DifferentialD]", "y"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}], "+", 
  RowBox[{
   SubsuperscriptBox["\[Integral]", "0", "1"], 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"3", "-", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"2", "^", "2"}], "-", 
        RowBox[{"x", "^", "2"}]}], "]"}]}], 
     RowBox[{"3", "-", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"1", "^", "2"}], "-", 
        RowBox[{"x", "^", "2"}]}], "]"}]}]], 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], 
     RowBox[{"\[DifferentialD]", "y"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}], "+", 
  RowBox[{
   SubsuperscriptBox["\[Integral]", "1", "2"], 
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"3", "-", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"2", "^", "2"}], "-", 
        RowBox[{"x", "^", "2"}]}], "]"}]}], 
     RowBox[{"3", "+", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        RowBox[{"2", "^", "2"}], "-", 
        RowBox[{"x", "^", "2"}]}], "]"}]}]], 
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"x", ",", "y"}], "]"}], 
     RowBox[{"\[DifferentialD]", "y"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}]}]}]], "Input",
 CellChangeTimes->{{3.7207593448523054`*^9, 3.720759363313361*^9}, {
  3.7207596702949195`*^9, 3.7207596740701356`*^9}, {3.720759839213581*^9, 
  3.7207598495731735`*^9}, {3.7207601310912757`*^9, 3.720760191332721*^9}, {
  3.724081598448637*^9, 3.724081618603837*^9}, {3.7240816736250377`*^9, 
  3.724081705620638*^9}, {3.724081864927839*^9, 3.7240819305570393`*^9}, {
