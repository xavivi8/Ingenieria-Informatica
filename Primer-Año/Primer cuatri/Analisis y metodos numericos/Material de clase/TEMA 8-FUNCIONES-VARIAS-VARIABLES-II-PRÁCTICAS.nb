   RowBox[{
    RowBox[{"f3", "[", 
     RowBox[{"x", ",", "y"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "2"}], "}"}]}], "]"}], "/.", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"x", "\[Rule]", "0"}], ",", 
    RowBox[{"y", "\[Rule]", "0"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.7240780587462144`*^9, 3.7240780781058145`*^9}, {
