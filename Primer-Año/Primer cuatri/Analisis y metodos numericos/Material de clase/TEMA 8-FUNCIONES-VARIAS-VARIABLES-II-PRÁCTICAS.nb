Cell[TextData[{
 "En el caso de f1 tenemos un m\[IAcute]nimo, en el de f2 un punto de silla, \
en el de f3 un m\[AAcute]ximo y en el de f4 hay un m\[IAcute]nimo, aunque el \
criterio no nos dio informaci\[OAcute]n. Si en lugar de f4, \
hubi\[EAcute]semos estudiado las funciones ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "4"], TraditionalForm]],ExpressionUUID->
  "a37162e7-6ee9-4558-88ee-ea00fb05657a"],
 "- ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "4"], TraditionalForm]],ExpressionUUID->
  "10413fa8-7764-437b-a856-43d418a30b47"],
 " o -",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "4"], TraditionalForm]],ExpressionUUID->
  "7162198d-beca-4819-a066-f701f9677ca8"],
 "- ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "4"], TraditionalForm]],ExpressionUUID->
  "7bf5293c-edf1-4037-aac8-1126e369d74c"],
 ", el criterio del hessiano no nos dar\[IAcute]a informaci\[OAcute]n, siendo \
el primer ejemplo un punto de silla y el segundo un m\[AAcute]ximo.\n\nEste \
criterio es similar al que ten\[IAcute]amos de la derivada segunda en \
funciones de una variable. Si la derivada segunda era mayor que cero hab\
\[IAcute]a un m\[IAcute]nimo, si era menor que cero hab\[IAcute]a un m\
\[AAcute]ximo, pero si era cero no pod\[IAcute]amos concluir nada."
}], "Text",
 CellChangeTimes->{{3.7240785471198177`*^9, 3.7240786122342176`*^9}, {
  3.724078645930218*^9, 
  3.72407890435982*^9}},ExpressionUUID->"4ee7d571-b4d9-4f48-9fef-\
626a538e0fa2"],

Cell["\<\
Veamos otro ejemplo. Calcular los extremos de la funci\[OAcute]n f(x,y).\
\>", "Text",
 CellChangeTimes->{{3.72407892866462*^9, 3.72407894181542*^9}, {
  3.8456433348011737`*^9, 
  3.8456433544921737`*^9}},ExpressionUUID->"876ddbe3-66ea-4f8a-a46e-\
4725ddffa1f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   SuperscriptBox["y", "3"], "+", 
   RowBox[{
    SuperscriptBox["x", "2"], " ", "y"}], " ", "+", " ", 
   RowBox[{"2", " ", 
    SuperscriptBox["x", "2"]}], " ", "+", " ", 
   RowBox[{"2", " ", 
    SuperscriptBox["y", "2"]}], "-", 
   RowBox[{"4", "y"}], "-", "8"}]}]], "Input",
 CellChangeTimes->{{3.720757864856654*^9, 3.720757906635044*^9}, {
  3.7240789474314203`*^9, 3.7240789777422204`*^9}},
 FontSize->14,ExpressionUUID->"60da17c4-729a-4ad3-8e78-90da32dfc292"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "x"}], "]"}], "\[Equal]", "0"}],
      ",", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"x", ",", "y"}], "]"}], ",", "y"}], "]"}], "\[Equal]", 
      "0"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.7207579101162434`*^9, 3.720757948107416*^9}},
 FontSize->14,ExpressionUUID->"504bbdcb-32cd-46b9-ba6a-a26cf7f8a7e6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", "0"}], ",", 
     RowBox[{"y", "\[Rule]", 
      RowBox[{"-", "2"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", "0"}], ",", 
     RowBox[{"y", "\[Rule]", 
      FractionBox["2", "3"]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"x", "\[Rule]", "0"}], ",", 
     RowBox[{"y", "\[Rule]", 
      RowBox[{"-", "2"}]}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.720757953352716*^9, 3.720775539775852*^9, 
  3.7240766670850058`*^9, 3.72407898707102*^9},
 FontSize->14,ExpressionUUID->"7ef6e686-d91d-476b-93b8-97e7240df8ad"]
}, Open  ]],

Cell["\<\
Los puntos (0, -2) y (0, 2/3) son puntos cr\[IAcute]ticos (Candidatos a ser m\
\[AAcute]ximos, m\[IAcute]nimos o puntos de silla). Para evaluar el hessiano \
en diferentes puntos, definimos la funci\[OAcute]n hessiano.\
\>", "Text",
 CellChangeTimes->{{3.7207755661693616`*^9, 3.720775588975666*^9}, {
  3.72077561982343*^9, 3.720775648415066*^9}, {3.7240789994574203`*^9, 
  3.7240790243238206`*^9}},ExpressionUUID->"186d031b-34bc-45a0-9b34-\
139872318877"],

Cell[BoxData[
 RowBox[{
  RowBox[{"hess", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Det", "[", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         SubscriptBox["\[PartialD]", 
          RowBox[{"u", ",", "u"}]], 
         RowBox[{"f", "[", 
          RowBox[{"u", ",", "v"}], "]"}]}], 
        RowBox[{
         SubscriptBox["\[PartialD]", 
          RowBox[{"u", ",", "v"}]], 
         RowBox[{"f", "[", 
          RowBox[{"u", ",", "v"}], "]"}]}]},
       {
        RowBox[{
         SubscriptBox["\[PartialD]", 
          RowBox[{"u", ",", "v"}]], 
         RowBox[{"f", "[", 
          RowBox[{"u", ",", "v"}], "]"}]}], 
        RowBox[{
         SubscriptBox["\[PartialD]", 
          RowBox[{"v", ",", "v"}]], 
         RowBox[{"f", "[", 
          RowBox[{"u", ",", "v"}], "]"}]}]}
      }], ")"}], "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u", "\[Rule]", "x"}], ",", 
     RowBox[{"v", "\[Rule]", "y"}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.7207579866006174`*^9, 3.7207581298288097`*^9}},
 FontSize->14,ExpressionUUID->"8c0fb033-1c15-4249-bf03-1c0e5089c601"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"hess", "[", 
    RowBox[{"0", ",", 
     RowBox[{"-", "2"}]}], "]"}], ",", 
   RowBox[{"hess", "[", 
    RowBox[{"0", ",", 
     RowBox[{"2", "/", "3"}]}], "]"}]}], "}"}]], "Input",
 CellChangeTimes->{{3.720758172576255*^9, 3.7207581994417915`*^9}},
 FontSize->14,ExpressionUUID->"07e9b940-b5d4-4b39-808e-67da2dabea69"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", 
   FractionBox["128", "3"]}], "}"}]], "Output",
 CellChangeTimes->{{3.720758179345642*^9, 3.7207582001868343`*^9}, 
   3.724076682451006*^9, 3.7240790333718204`*^9},
 FontSize->14,ExpressionUUID->"accb1ac5-74e8-4050-8dc4-351055bef93c"]
}, Open  ]],

Cell["\<\
El hessiano en el (0,-2) es cero y no nos da informaci\[OAcute]n. En el punto \
(0,2/3) el hessiano es positivo y habr\[AAcute] m\[AAcute]ximo o \
m\[IAcute]nimo. Para saberlo evaluamos la derivada segunda en la primera o la \
segunda variable.\
\>", "Text",
 CellChangeTimes->{{3.720775855712922*^9, 3.7207759347094407`*^9}, 
   3.720775979821021*^9},ExpressionUUID->"1adb7e0d-7b6f-42ec-8763-\
e7ec7abb8077"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["\[PartialD]", 
    RowBox[{"u", ",", "u"}]], 
   RowBox[{"f", "[", 
    RowBox[{"u", ",", "v"}], "]"}]}], "/.", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"u", "\[Rule]", "0"}], ",", 
    RowBox[{"v", "\[Rule]", 
     RowBox[{"2", "/", "3"}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.7207582592562127`*^9, 3.720758271328903*^9}},
 FontSize->14,ExpressionUUID->"db685733-5196-4e00-89b0-e1c11b94b99f"],

Cell[BoxData[
 FractionBox["16", "3"]], "Output",
 CellChangeTimes->{3.7207582720509443`*^9, 3.720775965848222*^9, 
  3.724079040454221*^9},
 FontSize->14,ExpressionUUID->"76f3dcc0-a9d1-4ae7-8b23-dd849ecfdc71"]
}, Open  ]],

Cell["\<\
La funci\[OAcute]n en (0, 2/3) tiene un m\[IAcute]nimo local. En el punto (0, \
-2) no sabemos con la prueba del Hessiano si tiene m\[AAcute]ximo, \
m\[IAcute]nimo o punto de silla.\
\>", "Text",
 CellChangeTimes->{{3.72075829434122*^9, 
  3.720758337328678*^9}},ExpressionUUID->"be1ab7c1-5b37-4b38-8cfb-\
4988a3deb95b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot3D", "[", 
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"x", ",", "y"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "3"}], ",", "3"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.720758428710905*^9, 3.7207584534563203`*^9}},
 FontSize->14,ExpressionUUID->"6b0f5d3c-ca32-4184-857a-67a0df6d0f86"],

