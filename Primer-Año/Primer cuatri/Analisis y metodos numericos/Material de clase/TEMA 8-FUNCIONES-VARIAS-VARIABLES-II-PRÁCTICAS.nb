   RowBox[{"2", " ", "x"}], ",", 
   RowBox[{"2", " ", "y"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9399885443549747`*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"1f0e3a48-3121-44e8-9d97-266d20715662"]
}, Open  ]],

