Cell[TextData[{
 "2.- Calcular la suma de la serie ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "1"}], "\[Infinity]"], 
    FractionBox[
     RowBox[{"n", "!"}], 
     RowBox[{
      RowBox[{
       RowBox[{"1", "*", "3", "*", "5", "*"}], "..."}], "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", "n"}], "-", "1"}], ")"}]}]]}], TraditionalForm]],
  ExpressionUUID->"413be5ca-16d1-48b2-919f-e0fbc9ccc7a0"],
 ".\n",
 "El s\[EAcute]ptimo decimal es:\nA)  3,             B) 5,               C) \
7,                      D) 9,            E) 1 "
}], "Text",
