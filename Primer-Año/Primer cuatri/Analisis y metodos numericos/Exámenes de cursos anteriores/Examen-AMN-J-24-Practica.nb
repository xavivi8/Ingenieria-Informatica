Cell[TextData[{
 "4.- Calcular una aproximaci\[OAcute]n de la integral de ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "1", "2"], 
    RowBox[{
     FractionBox["1", 
      RowBox[{"1", "+", "x", "+", 
       SuperscriptBox["x", "2"]}]], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "98875651-82fe-4688-96dc-89f583547dad"],
 " utilizando la f\[OAcute]rmula del trapecio compuesta haciendo 20 trozos en \
el intervalo [1,2], comparadla con el valor exacto y encontrar el error.\nEl \
sexto decimal del error es:\nA)  8,             B) 0,               C) 2,     \
                 D) 4,            E) 6 "
}], "Text",
 CellChangeTimes->{{3.610967983265625*^9, 3.610968082640625*^9}, {
