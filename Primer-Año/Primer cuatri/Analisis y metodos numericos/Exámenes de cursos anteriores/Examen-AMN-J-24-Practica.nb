Cell[TextData[{
 "5.- Calcular la integral de la funci\[OAcute]n f(x,y)= ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "+", "x", "+", 
    RowBox[{"\[ExponentialE]", " ", "y"}]}], TraditionalForm]],ExpressionUUID->
  "daa86550-5503-44bc-ac8f-2655834a6e2c"],
