Cell[TextData[{
 "13.- Calcular el polinomio de ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[DoubleStruckCapitalP]", "3"], TraditionalForm]],
  ExpressionUUID->"42134249-13af-4f49-8776-365fd4b0b953"],
 " que interpola los datos f(1) = 1, f \[CloseCurlyQuote](1) =-1, f(3)=1, f \
\[CloseCurlyQuote](3)=1."
}], "Text",
