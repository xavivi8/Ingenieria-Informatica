Cell[TextData[{
 "1.- Demostrar por inducci\[OAcute]n que  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"1", "*", "4"}], "+", 
       RowBox[{"2", "*", "5"}], "+", 
       RowBox[{"3", "*", "6"}], "+"}], "..."}], "+", 
     RowBox[{"n", "(", 
      RowBox[{"n", "+", "3"}], ")"}]}], " ", "=", 
    RowBox[{
     RowBox[{"n", "(", 
      RowBox[{"1", "+", "n"}], ")"}], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"5", "+", "n"}], ")"}], "/", "3"}]}]}], TraditionalForm]],
  ExpressionUUID->"8909eaf7-019e-4031-b10e-7412ee0bff95"],
 ", para todo n\[UAcute]mero natural (n= 1, 2, 3, ...)."
}], "Text",
