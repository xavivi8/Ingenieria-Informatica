Cell[TextData[{
 "12.- Sabemos que la integral ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     RowBox[{
      SubsuperscriptBox["\[Integral]", 
       RowBox[{" ", "1"}], 
       RowBox[{" ", "3"}]], " ", 
      RowBox[{
       FractionBox["1", "x"], 
       RowBox[{"\[DifferentialD]", "x"}]}]}], "=", 
     RowBox[{"log", " ", "3"}]}],
    FontSize->16], TraditionalForm]],ExpressionUUID->
  "816aba7d-570e-4e38-8b7e-1b142f2ae961"],
 ", aproximar la integral por el m\[EAcute]todo de Simpson (f\[OAcute]rmula \
compuesta, dividiendo el intervalo inicial en dos subintervalos de igual \
longitud) y obtener una fracci\[OAcute]n que aproxime log 3."
}], "Text",
