Cell[TextData[{
 "14.- Utilizando el m\[EAcute]todo de Euler, aproximar el valor de ",
 StyleBox["y(6)",
  FontSlant->"Italic"],
 ", siendo ",
 StyleBox["y(x)",
  FontSlant->"Italic"],
 " la soluci\[OAcute]n de la ecuaci\[OAcute]n diferencial ",
 StyleBox["y\[CloseCurlyQuote] =  y + x + 1",
  FontSlant->"Italic"],
 " con la condici\[OAcute]n inicial ",
 StyleBox["y(0)=0",
  FontSlant->"Italic"],
 ". Dar tres saltos con paso ",
 StyleBox["h=2",
  FontSlant->"Italic"],
 "."
}], "Text",
