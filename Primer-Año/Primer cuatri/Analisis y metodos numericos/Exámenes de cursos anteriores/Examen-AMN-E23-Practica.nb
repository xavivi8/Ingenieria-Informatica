Cell[TextData[{
 "1.- El l\[IAcute]mite de la sucesi\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RadicalBox[
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox["3", "2"], "*", 
        FractionBox["6", "8"], "*"}], "..."}], "*", 
      FractionBox[
       RowBox[{
        SuperscriptBox["n", "2"], "+", " ", "2"}], 
       RowBox[{"2", 
        SuperscriptBox["n", "2"]}]]}], "n"], "}"}], TraditionalForm]],
  ExpressionUUID->"2de17706-9f82-4732-b3c0-01297b420729"],
 " es:\n1)  1,             2) Mayor que 2,               3) No existe,        \
              4) 3/4,            5) Menor que 2/3"
}], "Text",
