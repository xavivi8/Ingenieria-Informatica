Cell[TextData[{
 "1.- El l\[IAcute]mite de la sucesi\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RadicalBox[
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox["6", "2"], "*", 
        FractionBox["21", "8"], "*"}], "..."}], "*", 
      FractionBox[
       RowBox[{
        RowBox[{"5", 
         SuperscriptBox["n", "2"]}], "+", "1"}], 
       RowBox[{"2", 
        SuperscriptBox["n", "2"]}]]}], "n"], "}"}], TraditionalForm]],
  ExpressionUUID->"293e40d1-6dda-411d-b608-d0152b452aa9"],
 " es:\n1)  1,             2) Mayor que 2,               3) No existe,        \
              4) 3/4,            5) Menor que 2/3"
}], "Text",
