Cell[TextData[{
 "5.- Aproximar el valor de la integral ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "1"], 
    RowBox[{
     FractionBox["1", 
      RowBox[{"1", "+", 
