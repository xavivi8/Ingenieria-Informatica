Cell[TextData[{
 "4.- Realizar cuatro iteraciones por el m\[EAcute]todo de la secante para \
aproximar la soluci\[OAcute]n de la ecuaci\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "bbd7efc9-2156-469d-8f61-bac00b62f630"],
