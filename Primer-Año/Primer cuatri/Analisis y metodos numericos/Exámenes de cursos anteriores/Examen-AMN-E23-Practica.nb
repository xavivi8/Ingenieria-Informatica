Cell[TextData[{
 "3.- El conjunto de las soluciones de la ecuaci\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    FractionBox[
     RowBox[{"x", "-", "1"}], 
     RowBox[{"x", "+", "1"}]], "|"}], TraditionalForm]],ExpressionUUID->
  "e644c887-bc5c-49f3-b8ea-193e66438e34"],
