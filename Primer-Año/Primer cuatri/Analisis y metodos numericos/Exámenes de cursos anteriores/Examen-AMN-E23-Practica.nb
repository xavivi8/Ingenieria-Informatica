Cell[TextData[{
 "1.- El l\[IAcute]mite de la sucesi\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RadicalBox[
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox["2", "3"], "*", 
        FractionBox["5", "9"], "*"}], "..."}], "*", 
      FractionBox[
       RowBox[{
        SuperscriptBox["n", "2"], "+", " ", "1"}], 
       RowBox[{
        RowBox[{"2", 
         SuperscriptBox["n", "2"]}], "+", "1"}]]}], "n"], "}"}], 
   TraditionalForm]],ExpressionUUID->"6e095f7c-b275-4782-aa25-1a8d743867f8"],
 " es:\n1) 3/4,            2) Menor que 2/3\t3)  1,             4) Mayor que \
2,               5) No existe,"
}], "Text",
