Cell[TextData[{
 "1.- El l\[IAcute]mite de la sucesi\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RadicalBox[
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox["3", "3"], "*", 
        FractionBox["6", "9"], "*"}], "..."}], "*", 
      FractionBox[
       RowBox[{
        SuperscriptBox["n", "2"], "+", " ", "2"}], 
       RowBox[{
        RowBox[{"2", 
         SuperscriptBox["n", "2"]}], "+", "1"}]]}], "n"], "}"}], 
   TraditionalForm]],ExpressionUUID->"e7b13a37-b4fb-4326-9f1a-b93766c20a0e"],
 " es:\n1) 3/4,            2) Menor que 2/3\t3)  1,             4) Mayor que \
2,               5) No existe,"
}], "Text",
