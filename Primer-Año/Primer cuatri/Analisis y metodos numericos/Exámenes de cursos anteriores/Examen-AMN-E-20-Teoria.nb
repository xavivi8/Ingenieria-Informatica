Cell[TextData[{
 "9.- Para aproximar una soluci\[OAcute]n real de la ecuaci\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "3"], "-", 
     RowBox[{"2", "x"}], "-", "1"}], "=", "0"}], TraditionalForm]],
  ExpressionUUID->"321e7c18-daf4-4ee1-ae8b-c08380078a1a"],
 " realizar tres iteraciones del m\[EAcute]todo de Newton-Raphson partiendo \
del valor inicial ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "d74949b2-e9ee-4053-bd20-32c437ed82f3"],
 "=0."
}], "Text",
