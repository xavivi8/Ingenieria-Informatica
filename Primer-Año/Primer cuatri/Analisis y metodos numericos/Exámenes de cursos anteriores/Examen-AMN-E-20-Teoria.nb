  FormBox[
   SubscriptBox["P", "3"], TraditionalForm]],ExpressionUUID->
  "bbfda7ef-2020-4308-b0ba-8b8e30b58a0d"],
 " que interpola ",
 StyleBox["f",
  FontSlant->"Italic"],
 "(0)=1,",
 StyleBox[" f",
  FontSlant->"Italic"],
 "(1)=3, ",
 StyleBox["f",
  FontSlant->"Italic"],
 "(2)=6,",
 StyleBox[" f",
  FontSlant->"Italic"],
 "(3)=10 mediante el m\[EAcute]todo de las diferencias divididas."
}], "Text",
