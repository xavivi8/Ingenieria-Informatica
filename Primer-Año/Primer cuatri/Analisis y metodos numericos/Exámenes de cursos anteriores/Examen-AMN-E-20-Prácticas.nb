Cell[TextData[{
 "6.- ",
 StyleBox[" ",
  FontWeight->"Bold"],
 "Los datos siguientes representan el crecimiento bacterial en un cultivo l\
\[IAcute]quido durante cierto n\[UAcute]mero de d\[IAcute]as\n\n\t\t",
 Cell[BoxData[GridBox[{
    {"D\[IAcute]a", "0", "4", "8", "12", "16", "20"},
    {
     RowBox[{"Cantidad", " "}], "67", "84", "98", "125", "149", "185"}
   },
   GridBoxDividers->{
    "Columns" -> {{True}}, "ColumnsIndexed" -> {}, "Rows" -> {{True}}, 
     "RowsIndexed" -> {}}]],ExpressionUUID->
  "de2ebfa0-9aee-4dc1-a69e-79679ed636fc"],
 "\n\t\t\nCalcular el polinomio que interpola los datos para aproximar la \
cantidad de bacterias que hab\[IAcute]a los d\[IAcute]as 10 y 18. \n\t",
 StyleBox["Polinomio:\n\tBacterias d\[IAcute]a 10:\n\tBacterias d\[IAcute]a \
18:",
  FontWeight->"Bold"]
}], "Text",
