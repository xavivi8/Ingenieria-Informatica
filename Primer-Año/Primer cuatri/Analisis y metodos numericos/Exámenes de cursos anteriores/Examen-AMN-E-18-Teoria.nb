 FontSize->16,ExpressionUUID->"54a29c90-59e5-45f2-8a27-ab85eeda3212"],

Cell[TextData[{
 "10.- Para aproximar las soluciones real de la ecuaci\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "3"], "+", "x", "+", "1"}], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"65e9abfe-700b-4281-bcb0-e05bfc20f6ba"],
 ", considerar la funci\[OAcute]n f(x) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "3"], "+", "x", "+", "1"}], TraditionalForm]],
  ExpressionUUID->"53331fde-693d-414c-a44a-f15d042b3690"],
 ". \[DownQuestion]Es continua? \[DownQuestion]Es derivable? Evaluarla en -1 \
y 1. \[DownQuestion]Cuantas ra\[IAcute]ces tiene la ecuaci\[OAcute]n? Aplicar \
el m\[EAcute]todo de bisecci\[OAcute]n  3 veces partiendo del intervalo \
[-1,1]."
}], "Text",
 CellChangeTimes->{{3.610967983265625*^9, 3.610968082640625*^9}, {
   3.6109681208125*^9, 3.61096812653125*^9}, {3.610976777453125*^9, 
