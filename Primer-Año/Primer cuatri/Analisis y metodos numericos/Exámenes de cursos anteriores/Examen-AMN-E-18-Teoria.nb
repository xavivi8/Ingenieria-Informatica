Cell[TextData[{
 "11.- Sabemos que la integral ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", "1", "2"], 
     RowBox[{
      FractionBox["1", "x"], 
      RowBox[{"\[DifferentialD]", "x"}]}]}], "=", 
    RowBox[{"ln", " ", "2"}]}], TraditionalForm]],ExpressionUUID->
  "4fe9d9ef-880d-4941-891c-5a3b35867d72"],
 ", aproximar la integral por el m\[EAcute]todo de Simpson (f\[OAcute]rmula \
simple) y obtener una fracci\[OAcute]n que aproxime ln 2."
}], "Text",
 CellChangeTimes->{{3.610967983265625*^9, 3.610968082640625*^9}, {
