Cell[CellGroupData[{

Cell["\<\
Ejercicio 14. Sea V el espacio vectorial de las matrices cuadradas de orden 2 \
con coeficientes en C. Consideremos U y W los conjuntos formados por las \
matrices sim\[EAcute]tricas y antisim\[EAcute]tricas, respectivamente. \
Demostrar que ambos son subespacios vectoriales. Calcular dimensi\[OAcute]n, \
base, ecuaciones param\[EAcute]tricas e impl\[IAcute]citas de U, W, U\:2229W \
y U+W.\
\>", "Subsection",
 CellChangeTimes->{{3.9876837523115253`*^9, 3.987683758745775*^9}, {
  3.987683791745207*^9, 3.9876838179020233`*^9}, {3.988014293511999*^9, 
  3.9880142957708473`*^9}},ExpressionUUID->"d544fb25-3f71-ff40-a68b-\
37d153b11295"],

Cell[BoxData[""], "Code",ExpressionUUID->"de8098ef-ae8f-334a-bfa4-94f8bed63a66"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Ejercicio 4 Ord Sea V el espacio vectorial de los polinomios de grado menos o \
igual que 2 con coeficientes en R
A) Considerar subconjuntos U={p\.b4(x):p(x)\[Element]V}, siendo p\.b4(x) \
respecto la variable x. Demostrar que U es subconjunto vectorial de V. \
Obtener, de forma razonada, base, dimensi\[OAcute]n, ecuaciones \
param\[EAcute]tricas e impl\[IAcute]citas de U.\
\>", "Subsection",
 CellChangeTimes->{{3.9876838319932976`*^9, 3.9876839790028114`*^9}, {
  3.98801430440345*^9, 
  3.9880143084590206`*^9}},ExpressionUUID->"6bcb962f-896f-c847-91de-\
ed08a05fc05c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "a", ",", " ", "b", ",", " ", "c", ",", " ", "x", ",", " ", "\[Lambda]"}], 
   "]"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"a", " ", "+", " ", 
    RowBox[{"b", "*", "x"}], " ", "+", " ", 
    RowBox[{"c", "*", 
     RowBox[{"x", "^", "2"}]}]}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"dp", " ", "=", " ", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"p", "[", "x", "]"}], ",", " ", "x"}], "]"}]}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Coordenadas", " ", "respecto", " ", "de", " ", "la", " ", "base", " ", 
    "can\[OAcute]nica", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "x", ",", " ", 
      RowBox[{"x", "^", "2"}]}], "}"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"coord", "[", "pol_", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{"pol", ",", " ", "x", ",", " ", "i"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"BaseVpol", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "x", ",", " ", 
      RowBox[{"x", "^", "2"}]}], "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"GeneradoresU", " ", "=", " ", 
   RowBox[{"coord", " ", "/@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"#", ",", " ", "x"}], "]"}], " ", "&"}], " ", "/@", " ", 
      "BaseVpol"}], ")"}]}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"BaseU", " ", "=", " ", 
   RowBox[{"Base2", "[", "GeneradoresU", "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Param\[EAcute]tricas", "[", "BaseU", "]"}], "\n"}], "\n", 
 RowBox[{"Impl\[IAcute]citas", "[", "BaseU", "]"}]}], "Code",
 CellChangeTimes->{3.987684627688402*^9},
 CellLabel->"In[20]:=",ExpressionUUID->"344ae71f-dd3e-e549-9a6d-abc4837cfc75"],

Cell[BoxData[
 RowBox[{"b", "+", 
  RowBox[{"2", " ", "c", " ", "x"}]}]], "Output",
