 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Intersecci\[OAcute]n", " ", 
    RowBox[{"U", "\\", "cap"}], " ", "W"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"implInter", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"x", ",", " ", "2"}], "]"}], " ", "-", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"x", ",", " ", "3"}], "]"}]}], " ", "\[Equal]", " ", "0"}], 
       ",", " ", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"x", ",", " ", "1"}], "]"}], " ", "\[Equal]", " ", "0"}], 
       ",", "\n", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"x", ",", " ", "4"}], "]"}], " ", "\[Equal]", " ", "0"}], 
       ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Subscript", "[", 
          RowBox[{"x", ",", " ", "2"}], "]"}], " ", "+", " ", 
         RowBox[{"Subscript", "[", 
          RowBox[{"x", ",", " ", "3"}], "]"}]}], " ", "\[Equal]", " ", 
        "0"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{"Solve", "[", 
    RowBox[{"implInter", ",", "\n", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"x", ",", " ", "1"}], "]"}], ",", " ", 
       RowBox[{"Subscript", "[", 
        RowBox[{"x", ",", " ", "2"}], "]"}], ",", " ", 
       RowBox[{"Subscript", "[", 
        RowBox[{"x", ",", " ", "3"}], "]"}], ",", " ", 
       RowBox[{"Subscript", "[", 
        RowBox[{"x", ",", " ", "4"}], "]"}]}], "}"}]}], "]"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Suma", " ", "U"}], "+", "W"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"baseSuma", " ", "=", "\n", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "0"}], "}"}], 
         ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "1", ",", " ", "1", ",", " ", "0"}], "}"}], 
         ",", " ", 
         RowBox[{"{", 
          RowBox[{"0", ",", " ", "0", ",", " ", "0", ",", " ", "1"}], "}"}]}],
         "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"-", "1"}], ",", " ", "1", ",", " ", "0"}], "}"}], "}"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"RowReduce", "[", "baseSuma", "]"}]}]}]], "Code",
 CellChangeTimes->{3.9880268920538826`*^9},
 CellLabel->
  "In[109]:=",ExpressionUUID->"8b43d81d-215b-6c42-b967-ddc29bc925a2"],

