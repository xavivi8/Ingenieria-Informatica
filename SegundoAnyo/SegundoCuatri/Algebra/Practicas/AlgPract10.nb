  3.9880269495351143`*^9}},ExpressionUUID->"c2601de4-633c-9c4d-85ee-\
59553236691b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"impl\[IAcute]citas", " ", "=", " ", 
  RowBox[{"Eliminate", "[", 
   RowBox[{"param\[EAcute]tricas", ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Lambda]", "[", "1", "]"}], ",", " ", 
      RowBox[{"\[Lambda]", "[", "2", "]"}]}], "}"}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Eliminamos", " ", "par\[AAcute]metros", " ", "directamente"}], 
    ",", "\n", 
    RowBox[{
    "indicando", " ", "los", " ", "par\[AAcute]metros", " ", "a", " ", 
     "eliminar"}]}], "*)"}]}]}], "Code",
