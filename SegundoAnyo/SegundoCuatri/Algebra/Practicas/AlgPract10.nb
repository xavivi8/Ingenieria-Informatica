Cell["Calculamos la base desde las ecuaciones impl\[IAcute]citas", "Text",
 CellChangeTimes->{{3.9880270367069626`*^9, 
  3.9880270466889057`*^9}},ExpressionUUID->"f42e0648-b729-a644-a0f6-\
1f5cc30723c5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dimensi\[OAcute]n", " ", "=", " ", "2"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Dimensi\[OAcute]n", " ", "del", " ", "subespacio"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"n", " ", "=", " ", "3"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Dimensi\[OAcute]n", " ", "del", " ", "espacio", " ", "vectorial"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SISTimpl\[IAcute]citas", " ", "=", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"dimensi\[OAcute]n", " ", "\[Equal]", " ", 
       RowBox[{"(", 
        RowBox[{"n", " ", "-", " ", "1"}], ")"}]}], ",", "\n", 
      RowBox[{"{", "impl\[IAcute]citas", "}"}], ",", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
        "impl\[IAcute]citas", "\[LeftDoubleBracket]", "i", 
         "\[RightDoubleBracket]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"n", " ", "-", " ", "dimensi\[OAcute]n"}]}], "}"}]}], 
       "]"}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Sistema", " ", "de", " ", "ecuaciones", " ", "lineales"}], ",", 
    " ", 
    RowBox[{
    "cuya", " ", "soluci\[OAcute]n", "\n", "son", " ", "los", " ", "vectores",
      " ", "del", " ", "subespacio"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BaseImpl\[IAcute]citas", "[", 
     RowBox[{"SISTimpl\[IAcute]citas_", ",", " ", "dimensi\[OAcute]n_"}], 
     "]"}], " ", ":=", "\n", 
    RowBox[{"NullSpace", "[", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Normal", "[", 
         RowBox[{"CoefficientArrays", "[", 
          RowBox[{"SISTimpl\[IAcute]citas", ",", "\n", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Subscript", "[", 
              RowBox[{"x", ",", " ", "i"}], "]"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"i", ",", " ", "dimensi\[OAcute]n"}], "}"}]}], "]"}]}], 
          "]"}], "]"}], "\[LeftDoubleBracket]", "2", 
        "\[RightDoubleBracket]"}], ",", " ", 
       RowBox[{"Table", "[", "\n", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "dimensi\[OAcute]n"}], "}"}]}], "]"}], ",",
          " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"dimensi\[OAcute]n", " ", "-", " ", 
            RowBox[{"Length", "[", "Impl\[IAcute]citas", "]"}]}]}], "}"}]}], 
        "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"C\[AAcute]lculo", " ", "de", " ", "la", " ", "base"}], 
   "*)"}]}], "\n", 
 RowBox[{"BaseImpl\[IAcute]citas", "[", 
  RowBox[{"SISTimpl\[IAcute]citas", ",", " ", "3"}], "]"}]}], "Code",
 CellChangeTimes->{3.988027102987459*^9},
 CellLabel->
  "In[126]:=",ExpressionUUID->"b56cee56-36de-a947-a058-b2e4ba5db244"],

