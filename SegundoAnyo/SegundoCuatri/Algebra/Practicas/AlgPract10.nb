Cell[CellGroupData[{

Cell["\<\
Ejercicio 14. Sea V el espacio vectorial de las matrices cuadradas de orden 2 \
con coeficientes en C. Consideremos U y W los conjuntos formados por las \
matrices sim\[EAcute]tricas y antisim\[EAcute]tricas, respectivamente. \
Demostrar que ambos son subespacios vectoriales. Calcular dimensi\[OAcute]n, \
base, ecuaciones param\[EAcute]tricas e impl\[IAcute]citas de U, W, U\:2229W \
y U+W.\
\>", "Subsection",
 CellChangeTimes->{{3.9876837523115253`*^9, 3.987683758745775*^9}, {
  3.987683791745207*^9, 3.9876838179020233`*^9}, {3.988014293511999*^9, 
  3.9880142957708473`*^9}},ExpressionUUID->"d544fb25-3f71-ff40-a68b-\
37d153b11295"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"m", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "b"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"c", ",", " ", "d"}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mT", " ", "=", " ", 
    RowBox[{"Transpose", "[", "m", "]"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"U", ":", 
    RowBox[{"Sim\[EAcute]tricas", " ", 
     RowBox[{"(", 
      RowBox[{"b", "\[Equal]", "c"}], ")"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"coordU", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"a", ",", " ", "b", ",", " ", "b", ",", " ", "d"}], "}"}]}], 
   ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"W", ":", 
    RowBox[{"Antisim\[EAcute]tricas", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"a", "\[Equal]", "0"}], ",", 
       RowBox[{"d", "\[Equal]", "0"}], ",", 
       RowBox[{"b", "\[Equal]", 
        RowBox[{"-", "c"}]}]}], ")"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"coordW", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "b", ",", " ", 
     RowBox[{"-", "b"}], ",", " ", "0"}], "}"}]}], ";"}]}], "Code",
 CellChangeTimes->{
  3.9880232427783127`*^9, {3.9880232822622356`*^9, 3.988023282582117*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"de8098ef-ae8f-334a-bfa4-94f8bed63a66"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"param\[EAcute]tricas", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     SubscriptBox["x", "1"], " ", "\[Equal]", " ", 
     RowBox[{"\[Lambda]", "[", "1", "]"}]}], ",", " ", 
    RowBox[{
     SubscriptBox["x", "2"], " ", "\[Equal]", " ", 
     RowBox[{"\[Lambda]", "[", "2", "]"}]}], ",", " ", 
    RowBox[{
     SubscriptBox["x", "3"], " ", "\[Equal]", " ", 
     RowBox[{"\[Lambda]", "[", "2", "]"}]}], ",", " ", 
    RowBox[{
     SubscriptBox["x", "4"], " ", "\[Equal]", " ", 
     RowBox[{"\[Lambda]", "[", "3", "]"}]}]}], "}"}]}]], "Code",
 CellChangeTimes->{{3.9880232786842957`*^9, 3.988023279621172*^9}, {
  3.9880265920653496`*^9, 3.9880266115448074`*^9}},
 CellLabel->"In[97]:=",ExpressionUUID->"3015811c-d96b-5f48-9c07-980cec6e0c3c"],

Cell[BoxData[
 RowBox[{"{", 
