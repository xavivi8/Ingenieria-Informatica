Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Sesion", " ", "9"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Coordenadas", "[", 
      RowBox[{"X_", ",", "B_"}], "]"}], ":=", 
     RowBox[{"LinearSolve", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", "B", "]"}], ",", "X"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Sesion", " ", "12"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ExpMatricial", "[", 
      RowBox[{"f_", ",", "B1_", ",", "B2_"}], "]"}], ":=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Coordenadas", "[", 
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"B1", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", "B2"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "B1", "]"}]}], "}"}]}], "]"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Sesion", " ", "9"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Param\[EAcute]tricas", "[", "Base_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Parte1", ",", "param\[EAcute]tricas"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Clear", "[", "\[Lambda]", "]"}], ";", 
        RowBox[{"(*", 
         RowBox[{"Borramos", " ", "las", " ", "variables", " ", 
          RowBox[{"\[Lambda]", "[", "i", "]"}], " ", "para", " ", "que", " ", 
          "sean", " ", "los", " ", "par\[AAcute]metros"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Parte1", "=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Lambda]", "[", "i", "]"}], "*", 
            RowBox[{"Base", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "Base", "]"}]}], "}"}]}], "]"}]}], ";", 
        " ", 
        RowBox[{"(*", 
         RowBox[{
         "Coordenada", " ", "a", " ", "coordenada", " ", "se", " ", "hace", 
          " ", "el", " ", "c\[AAcute]lculo"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"param\[EAcute]tricas", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"param\[EAcute]tricas", ",", 
             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"x", ",", "i"}], "]"}], "\[Equal]", 
              RowBox[{"Parte1", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}], ";"}], " ", 
          RowBox[{"(*", 
           RowBox[{
           "A\[NTilde]adimos", " ", "la", " ", "ecuaci\[OAcute]n", " ", 
            "param\[EAcute]trica"}], "*)"}], "\n", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", 
             RowBox[{"Base", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "param\[EAcute]tricas"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Sesion", " ", "9"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Impl\[IAcute]citas", "[", "Base_", "]"}], ":=", 
     RowBox[{"Eliminate", "[", 
      RowBox[{
       RowBox[{"Param\[EAcute]tricas", "[", "Base", "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"\[Lambda]", "[", "i", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "Base", "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
    ";"}], " ", "\n", 
   RowBox[{"(*", "*)"}]}]}]], "Code",
