Cell[CellGroupData[{

Cell["Pr\[AAcute]ctica 6", "Section",
 CellChangeTimes->{
  3.98385401530805*^9},ExpressionUUID->"f8d5ec19-38fa-1f4e-93af-4d9988354024"],

Cell[CellGroupData[{

Cell["\<\
Ejercicio 1 Se pide:
i. Comprobar si es conexo
ii. Calcular sus componentes conexas
iii. Comprobar si es de Euler
iv. Comprobar si es Hamilton
v. Utilizar el teorema del n\[UAcute]mero de caminos para calcular la \
distancia entre el primer y \[UAcute]ltimo v\[EAcute]rtice de cada grafo
vi. Determinar, si existen un ciclo de Euler, un ciclo de Hamilton y una geod\
\[EAcute]sica entre el primer y el \[UAcute]ltimo v\[EAcute]rtice del grafo.
Dados los siguientes grafos\
\>", "Subsection",
 CellChangeTimes->{
  3.98385403084857*^9},ExpressionUUID->"babf6424-6a8e-ec48-ac70-0dbcb0a2ed3c"],

Cell[CellGroupData[{

Cell["\<\
a) Cada uno de los grafos del ejercicio 5.29 del manual de pr\[AAcute]cticas \
\>", "Subsubsection",
 CellChangeTimes->{
  3.983854040445404*^9},ExpressionUUID->"378a52d0-7efa-994d-b83e-\
774951efecaf"],

Cell[CellGroupData[{

Cell[BoxData[{"\"\<---------------\>\"", "\n", "\"\<Ejercicio 5.39 G1\>\"", "\
\n", "\"\<---------------\>\"", "\n", 
 RowBox[{"Clear", "[", "pract6Adya", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pract6Adya", "=", "Eje529G1Adya"}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Primer", " ", "y", " ", "\[UAcute]ltimo", " ", "v\[EAcute]rtice"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"u", " ", "=", " ", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"v", " ", "=", " ", 
    RowBox[{"Length", "[", "pract6Adya", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Matriz de adyacencia:\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"MatrixForm", "[", "pract6Adya", "]"}], "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{" ", "i", ")"}], " ", "Comprobar", " ", "si", " ", "es", " ", 
    "conexo"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<i) \[DownQuestion]Es conexo?\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"esConexo", " ", "=", " ", 
   RowBox[{"CONEXO", "[", "pract6Adya", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "esConexo", "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{" ", "ii", ")"}], " ", "Componentes", " ", "conexas"}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<ii) Componentes conexas:\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"componentes", " ", "=", " ", 
   RowBox[{"COMPONENTESCONEXAS", "[", "pract6Adya", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "componentes", "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{" ", "iii", ")"}], " ", "Comprobar", " ", "si", " ", "es", " ", 
    "de", " ", "Euler"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<iii) \[DownQuestion]Es de Euler?\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"esEuler", " ", "=", " ", 
   RowBox[{"EULER", "[", "pract6Adya", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "esEuler", "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{" ", "iv", ")"}], " ", "Comprobar", " ", "si", " ", "es", " ", 
    "Hamilton"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<iv) \[DownQuestion]Es Hamilton?\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ciclosHamilton", " ", "=", " ", 
   RowBox[{"HAMILTON", "[", "pract6Adya", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"esHamilton", " ", "=", " ", 
   RowBox[{"ciclosHamilton", " ", "=!=", " ", 
    RowBox[{"{", "}"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", "esHamilton", "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{" ", "v", ")"}], " ", "Distancia", " ", "entre", " ", "el", " ", 
    "primer", " ", "y", " ", "el", " ", "\[UAcute]ltimo", " ", 
    "v\[EAcute]rtice"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
  "Print", "[", 
   "\"\<v) Distancia entre el primer y el \[UAcute]ltimo \
v\[EAcute]rtice:\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dist", " ", "=", " ", 
   RowBox[{"distancia", "[", 
    RowBox[{"u", ",", " ", "v", ",", " ", "pract6Adya"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{
    "\"\<Distancia entre \>\"", ",", " ", "u", ",", " ", "\"\< y \>\"", ",", 
     " ", "v", ",", " ", "\"\< = \>\"", ",", " ", "dist"}], "]"}], ";"}], 
  "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Tambi\[EAcute]n", " ", "puedes", " ", "comprobar", " ", "el", " ", 
    "teorema", " ", "del", " ", "n\[UAcute]mero", " ", "de", " ", "caminos"}],
    " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<Caminos de longitud 1 entre \>\"", ",", " ", "u", ",", " ", 
    "\"\< y \>\"", ",", " ", "v", ",", " ", "\"\<:\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"CAMINOS", "[", 
     RowBox[{"u", ",", " ", "v", ",", " ", "1", ",", " ", "pract6Adya"}], 
     "]"}], "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<Caminos de longitud 2 entre \>\"", ",", " ", "u", ",", " ", 
    "\"\< y \>\"", ",", " ", "v", ",", " ", "\"\<:\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"CAMINOS", "[", 
     RowBox[{"u", ",", " ", "v", ",", " ", "2", ",", " ", "pract6Adya"}], 
     "]"}], "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<Caminos de longitud 3 entre \>\"", ",", " ", "u", ",", " ", 
    "\"\< y \>\"", ",", " ", "v", ",", " ", "\"\<:\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"CAMINOS", "[", 
     RowBox[{"u", ",", " ", "v", ",", " ", "3", ",", " ", "pract6Adya"}], 
     "]"}], "]"}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{" ", "vi", ")"}], " ", "Determinar", " ", "si", " ", "existen", 
     " ", "ciclo", " ", "de", " ", "Euler"}], ",", " ", 
    RowBox[{
    "ciclo", " ", "de", " ", "Hamilton", " ", "y", " ", 
     "geod\[EAcute]sica"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
   "Print", "[", 
    "\"\<vi) Existencia de ciclo de Euler, ciclo de Hamilton y \
geod\[EAcute]sica\>\"", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{"esEuler", ",", "\n", "   ", 
     RowBox[{"Print", "[", "\"\<S\[IAcute] existe ciclo de Euler.\>\"", "]"}],
      ",", "\n", "   ", 
     RowBox[{"Print", "[", "\"\<No existe ciclo de Euler.\>\"", "]"}]}], "\n",
     "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{"esHamilton", ",", "\n", "   ", 
     RowBox[{
      RowBox[{
      "Print", "[", "\"\<S\[IAcute] existe ciclo de Hamilton.\>\"", "]"}], 
      ";", "\n", "   ", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Un ciclo de Hamilton es: \>\"", ",", " ", 
        RowBox[{"First", "[", "ciclosHamilton", "]"}]}], "]"}]}], ",", "\n", 
     "   ", 
     RowBox[{"Print", "[", "\"\<No existe ciclo de Hamilton.\>\"", "]"}]}], 
