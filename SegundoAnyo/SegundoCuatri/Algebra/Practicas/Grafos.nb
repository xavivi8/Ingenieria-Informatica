   "*)"}]}], "\n", 
 RowBox[{
  StyleBox[
   RowBox[{
    RowBox[{"COMPLETO", "[", "matrizadyacencia_", "]"}], ":=", "   ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MatrixPower", "[", 
          RowBox[{"matrizadyacencia", ",", "2"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "i"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
