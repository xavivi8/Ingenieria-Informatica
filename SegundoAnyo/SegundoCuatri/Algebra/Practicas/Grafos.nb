             RowBox[{
              RowBox[{"regular", "=", "False"}], ";", 
              RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";"}], 
          "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "2", ",", 
            RowBox[{
             RowBox[{"Dimensions", "[", "matrizadyacencia", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "regular"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Sesi\[OAcute]n", " ", "5", " ", "cap", " ", "6"}], " ", "*)"}], 
   "\n", 
   StyleBox[
    RowBox[{
     RowBox[{"COMPLETO", "[", "matrizadyacencia_", "]"}], ":=", "   ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"MatrixPower", "[", 
           RowBox[{"matrizadyacencia", ",", "2"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "i"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{
            RowBox[{"Dimensions", "[", "matrizadyacencia", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], "==", 
       RowBox[{
        RowBox[{
         RowBox[{"Dimensions", "[", "matrizadyacencia", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Dimensions", "[", "matrizadyacencia", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ")"}]}]}], ")"}]}],
    FormatType->StandardForm], 
   StyleBox["\n",
    FormatType->StandardForm], 
   RowBox[{"(*", " ", "K33", " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"K33", "[", 
     RowBox[{"W_", ",", "matrizadyacencia_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"subconjuntos", ",", "nok33", ",", "i", ",", "k1", ",", "k2"}],
        "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"contiene", "=", "False"}], ";", "\[IndentingNewLine]", 
       RowBox[{"subconjuntos", "=", 
        RowBox[{"KSubsets", "[", 
         RowBox[{
          RowBox[{"Complement", "[", 
           RowBox[{"W", ",", 
            RowBox[{"{", 
             RowBox[{"W", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "}"}]}], "]"}], ",", "2"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"nok33", "=", "False"}], ";", "\[IndentingNewLine]", 
          RowBox[{"A", "=", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"subconjuntos", "[", 
              RowBox[{"[", "i", "]"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"W", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"B", "=", 
           RowBox[{"Complement", "[", 
            RowBox[{"W", ",", "A"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"Do", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Sum", "[", 
                 RowBox[{
                  RowBox[{"matrizadyacencia", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"A", "[", 
                    RowBox[{"[", "k1", "]"}], "]"}], ",", 
                    RowBox[{"B", "[", 
