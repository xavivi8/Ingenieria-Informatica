           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{
              RowBox[{"Dimensions", "[", "matrizadyacencia", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"regular", "=", "True"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"grado", "!=", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{"matrizadyacencia", "[", 
