                  RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"regular", "=", "False"}], ";", 
             RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "2", ",", 
