Cell["\<\
Definir funciones auxiliares y test de subgrupo (Funciones 2.4, 2.7 y 3.1, M\
\[EAcute]todos Computacionales)\
\>", "Text",
 CellChangeTimes->{{3.9881988370283737`*^9, 
  3.988198839404808*^9}},ExpressionUUID->"b3010ede-e2d1-d04e-90df-\
9971d483f20b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ElementoNeutro", " ", "=", " ", "\"\<No existe\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"TrueQ", "[", 
         RowBox[{
          RowBox[{"operacion", "[", 
           RowBox[{"[", "CONTADORi", "]"}], "]"}], " ", "==", " ", "G"}], 
         "]"}], " ", "&&", " ", 
        RowBox[{"TrueQ", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Transpose", "[", "operacion", "]"}], "[", 
           RowBox[{"[", "CONTADORi", "]"}], "]"}], " ", "==", " ", 
          RowBox[{"operacion", "[", 
           RowBox[{"[", "CONTADORi", "]"}], "]"}]}], "]"}]}], ",", " ", 
       RowBox[{
        RowBox[{"ElementoNeutro", " ", "=", " ", 
         RowBox[{"G", "[", 
          RowBox[{"[", "CONTADORi", "]"}], "]"}]}], ";", " ", 
        RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"CONTADORi", ",", " ", 
      RowBox[{"Length", "[", "G", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Elemento neutro: \>\"", ",", " ", "ElementoNeutro"}], 
  "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"simetrico", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sim", ",", " ", "CONTADORi"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"sim", " ", "=", " ", "0"}], ";", "\n", "  ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"op", "[", 
             RowBox[{"x", ",", " ", 
              RowBox[{"G", "[", 
               RowBox[{"[", "CONTADORi", "]"}], "]"}]}], "]"}], " ", "==", 
            " ", "ElementoNeutro"}], ",", " ", 
           RowBox[{
            RowBox[{"sim", " ", "=", " ", 
             RowBox[{"G", "[", 
              RowBox[{"[", "CONTADORi", "]"}], "]"}]}], ";", " ", 
            RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"CONTADORi", ",", " ", "1", ",", " ", 
          RowBox[{"Length", "[", "G", "]"}]}], "}"}]}], "]"}], ";", "\n", 
      "  ", "sim"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SUBGRUPO", "[", "H_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"subgrupo", ",", " ", "CONTADORi", ",", " ", "CONTADORj"}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"subgrupo", " ", "=", " ", "True"}], ";", " ", 
      RowBox[{"CONTADORi", " ", "=", " ", "1"}], ";", "\n", "  ", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"subgrupo", " ", "&&", " ", 
         RowBox[{"CONTADORi", " ", "<=", " ", 
          RowBox[{"Length", "[", "H", "]"}]}]}], ",", " ", 
        RowBox[{
         RowBox[{"CONTADORj", " ", "=", " ", "1"}], ";", "\n", "    ", 
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{"subgrupo", " ", "&&", " ", 
            RowBox[{"CONTADORj", " ", "<=", " ", 
             RowBox[{"Length", "[", "H", "]"}]}]}], ",", "\n", "      ", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Intersection", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"op", "[", 
                   RowBox[{
                    RowBox[{"H", "[", 
                    RowBox[{"[", "CONTADORi", "]"}], "]"}], ",", " ", 
                    RowBox[{"simetrico", "[", 
                    RowBox[{"H", "[", 
                    RowBox[{"[", "CONTADORj", "]"}], "]"}], "]"}]}], "]"}], 
                  "}"}], ",", " ", "H"}], "]"}], " ", "==", " ", 
               RowBox[{"{", "}"}]}], ",", " ", 
              RowBox[{
               RowBox[{"subgrupo", " ", "=", " ", "False"}], ";"}]}], "]"}], 
            ";", "\n", "      ", 
            RowBox[{"CONTADORj", "++"}], ";"}]}], "]"}], ";", "\n", "    ", 
         RowBox[{"CONTADORi", "++"}], ";"}]}], "]"}], ";", "\n", "  ", 
      "subgrupo"}]}], "]"}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.9881988646044807`*^9, 3.9881988782929115`*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"aaa64c69-6e6e-9a4d-94ec-912c82f60cc7"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Elemento neutro: \"\>", "\[InvisibleSpace]", "9"}],
  SequenceForm["Elemento neutro: ", 9],
  Editable->False]], "Print",
 CellChangeTimes->{3.9881988788092537`*^9},
 CellLabel->
  "Durante la evaluaci\[OAcute]n de \
In[26]:=",ExpressionUUID->"0f71f895-081a-d947-9f79-7bb9d4746961"]
}, Open  ]],

Cell["\<\
Calcular todos los subgrupos de 4 elementos (Funci\[OAcute]n 3.7/SUBGRUPOSN, \
M\[EAcute]todos Computacionales)\
\>", "Text",
 CellChangeTimes->{{3.988198897980856*^9, 
  3.98819889995105*^9}},ExpressionUUID->"00031ba7-b142-4d40-94fd-\
e3a0235f61d1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SUBGRUPOSN", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Subconjuntos", ",", " ", "Subgrupos", ",", " ", "CONTADORi"}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"Subconjuntos", " ", "=", " ", 
       RowBox[{"Subsets", "[", 
        RowBox[{"G", ",", " ", 
         RowBox[{"{", "n", "}"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"Subgrupos", " ", "=", " ", 
       RowBox[{"{", "}"}]}], ";", "\n", "  ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"SUBGRUPO", "[", 
            RowBox[{"Subconjuntos", "[", 
             RowBox[{"[", "CONTADORi", "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"Subgrupos", ",", " ", 
             RowBox[{"Subconjuntos", "[", 
              RowBox[{"[", "CONTADORi", "]"}], "]"}]}], "]"}]}], "]"}], ";"}],
         ",", " ", 
        RowBox[{"{", 
         RowBox[{"CONTADORi", ",", " ", "1", ",", " ", 
          RowBox[{"Length", "[", "Subconjuntos", "]"}]}], "}"}]}], "]"}], ";",
       "\n", "  ", "Subgrupos"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"SUBGRUPOSN", "[", "4", "]"}]}], "Code",
 CellChangeTimes->{3.9881989069141064`*^9},
 CellLabel->"In[31]:=",ExpressionUUID->"f4518066-765f-8043-9060-4c4200862e5e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"0", ",", "3", ",", "6", ",", "9"}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.988198907652132*^9},
 CellLabel->"Out[32]=",ExpressionUUID->"350531be-18e3-f946-8a9d-debf344fe550"]
}, Open  ]],

