Cell["Redefinir G = \:2124\:2085 y la operaci\[OAcute]n", "Text",
 CellChangeTimes->{
  3.9881992718626537`*^9},ExpressionUUID->"dc2d14eb-3f92-a042-ba94-\
afe03f34cd9b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"G", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", "4"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"operacion", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"2", "*", 
         RowBox[{"G", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], " ", "+", " ", 
        RowBox[{"3", "*", 
         RowBox[{"G", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}]}], ",", " ", "5"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "1", ",", " ", 
       RowBox[{"Length", "[", "G", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "1", ",", " ", 
       RowBox[{"Length", "[", "G", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"op", "[", 
    RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"operacion", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"G", ",", " ", "x"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"G", ",", " ", "y"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.988199278011265*^9, 3.988199278623665*^9}},
 CellLabel->"In[34]:=",ExpressionUUID->"8c410796-3aa4-5244-9ebc-304fd18f096e"],

