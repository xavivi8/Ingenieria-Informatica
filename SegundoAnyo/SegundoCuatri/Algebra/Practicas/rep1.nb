Cell[" Definir G y la tabla de operaciones", "Text",
 CellChangeTimes->{
  3.9881982634966297`*^9},ExpressionUUID->"ef88e098-9f27-cb41-a2ca-\
5d0c51fafd60"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"G", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", " ", "96"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"operacion", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"3", "*", 
         RowBox[{"G", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}], " ", "+", " ", 
        RowBox[{"8", "*", 
         RowBox[{"G", "[", 
          RowBox[{"[", "j", "]"}], "]"}]}]}], ",", " ", "97"}], "]"}], ",", 
     " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "1", ",", " ", 
       RowBox[{"Length", "[", "G", "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"j", ",", " ", "1", ",", " ", 
       RowBox[{"Length", "[", "G", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"op", "[", 
    RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"operacion", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"G", ",", " ", "x"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"G", ",", " ", "y"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], "Code",
 CellChangeTimes->{3.988198273659914*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"3175a55f-6708-0f48-8c0e-77f723131bc8"],

Cell["Comprobar operaci\[OAcute]n interna (Funci\[OAcute]n 2.3, \
Sesi\[OAcute]n 02)", "Text",
 CellChangeTimes->{
  3.988198299450077*^9},ExpressionUUID->"24177490-aa31-4347-aa65-\
4bcd5d1e9ecf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"INTERNA", "[", 
    RowBox[{"G_", ",", " ", "operacion_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"CONTADORi", ",", " ", "interna"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"interna", " ", "=", " ", 
       RowBox[{"{", "}"}]}], ";", "\n", "  ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"interna", " ", "=", " ", 
         RowBox[{"Union", "[", 
          RowBox[{
           RowBox[{"operacion", "[", 
            RowBox[{"[", "CONTADORi", "]"}], "]"}], ",", " ", "interna"}], 
          "]"}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"CONTADORi", ",", " ", 
          RowBox[{"Length", "[", "operacion", "]"}]}], "}"}]}], "]"}], ";", 
      "\n", "  ", 
      RowBox[{
       RowBox[{"Length", "[", 
        RowBox[{"Union", "[", 
         RowBox[{"G", ",", " ", "interna"}], "]"}], "]"}], " ", "==", " ", 
       RowBox[{"Length", "[", "G", "]"}]}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"INTERNA", "[", 
  RowBox[{"G", ",", " ", "operacion"}], "]"}]}], "Code",
 CellChangeTimes->{3.9881983117430534`*^9},
 CellLabel->"In[4]:=",ExpressionUUID->"d5d881a2-ba24-5741-84ff-09582089147e"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.988198317481409*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"b8526502-4e8d-0f45-9d4b-850007ef6280"]
}, Open  ]],

Cell["Comprobar elemento neutro (Funci\[OAcute]n 2.4, Sesi\[OAcute]n 02)", \
"Text",
 CellChangeTimes->{
  3.988198328199724*^9},ExpressionUUID->"dfc470b9-cbf4-fd4b-ac4d-\
a41f92406fac"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ELEMENTONEUTRO", "[", 
    RowBox[{"G_", ",", " ", "operacion_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"CONTADORi", ",", " ", "Neutro"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"Neutro", " ", "=", " ", "\"\<No existe\>\""}], ";", "\n", "  ", 
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{
              RowBox[{"operacion", "[", 
               RowBox[{"[", "CONTADORi", "]"}], "]"}], " ", "==", " ", "G"}], 
             "]"}], " ", "&&", " ", 
            RowBox[{"TrueQ", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Transpose", "[", "operacion", "]"}], "[", 
               RowBox[{"[", "CONTADORi", "]"}], "]"}], " ", "==", " ", 
              RowBox[{"operacion", "[", 
               RowBox[{"[", "CONTADORi", "]"}], "]"}]}], "]"}]}], ",", "\n", 
           "      ", 
           RowBox[{
            RowBox[{"Neutro", " ", "=", " ", 
             RowBox[{"G", "[", 
              RowBox[{"[", "CONTADORi", "]"}], "]"}]}], ";", " ", 
            RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";"}], "\n", "  ", 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"CONTADORi", ",", " ", 
          RowBox[{"Length", "[", "G", "]"}]}], "}"}]}], "]"}], ";", "\n", 
      "  ", "Neutro"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{"ELEMENTONEUTRO", "[", 
  RowBox[{"G", ",", " ", "operacion"}], "]"}]}], "Code",
 CellChangeTimes->{3.9881983375028954`*^9},
 CellLabel->"In[6]:=",ExpressionUUID->"6e1f18c8-abc1-ef4e-b53a-ae899d19d53a"],

Cell[BoxData["\<\"No existe\"\>"], "Output",
 CellChangeTimes->{3.9881983382834587`*^9},
 CellLabel->"Out[7]=",ExpressionUUID->"76abe473-905f-7b47-a243-81da6e78cff9"]
}, Open  ]],

Cell["Comprobar elemento sim\[EAcute]trico (Funci\[OAcute]n 2.6, \
Sesi\[OAcute]n 02)", "Text",
 CellChangeTimes->{
  3.9881983595532055`*^9},ExpressionUUID->"4b2cfca3-5832-db40-9322-\
85e086fdf217"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ELEMENTOSIMETRICO", "[", 
    RowBox[{"G_", ",", " ", "operacion_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "CONTADORi", ",", " ", "CONTADORj", ",", " ", "Nosim", ",", " ", 
       "ElementoSimetrico", ",", " ", "op", ",", " ", "Neutro", ",", " ", 
       "salida"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"op", "[", 
        RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"operacion", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{"G", ",", " ", "x"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{"G", ",", " ", "y"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"Neutro", " ", "=", " ", "\"\<No existe\>\""}], ";", "\n", "  ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{
              RowBox[{"operacion", "[", 
               RowBox[{"[", "CONTADORi", "]"}], "]"}], " ", "==", " ", "G"}], 
             "]"}], " ", "&&", " ", 
            RowBox[{"TrueQ", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Transpose", "[", "operacion", "]"}], "[", 
               RowBox[{"[", "CONTADORi", "]"}], "]"}], " ", "==", " ", 
              RowBox[{"operacion", "[", 
               RowBox[{"[", "CONTADORi", "]"}], "]"}]}], "]"}]}], ",", " ", 
           RowBox[{
            RowBox[{"Neutro", " ", "=", " ", 
             RowBox[{"G", "[", 
              RowBox[{"[", "CONTADORi", "]"}], "]"}]}], ";", " ", 
            RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"CONTADORi", ",", " ", 
          RowBox[{"Length", "[", "G", "]"}]}], "}"}]}], "]"}], ";", "\n", 
      "  ", 
      RowBox[{"salida", " ", "=", " ", "False"}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"Neutro", " ", "===", " ", "\"\<No existe\>\""}], ",", "\n", 
        "    ", 
        RowBox[{
         RowBox[{
         "Print", "[", 
          "\"\<Error: no se verifica la propiedad del elemento neutro.\>\"", 
          "]"}], ";"}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Elemento neutro: \>\"", ",", " ", "Neutro"}], "]"}], 
         ";", "\n", "    ", 
         RowBox[{"ElementoSimetrico", " ", "=", " ", 
          RowBox[{"{", 
           RowBox[{"G", ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{"\"\<-\>\"", ",", " ", 
              RowBox[{"{", 
               RowBox[{"CONTADORi", ",", " ", "1", ",", " ", 
                RowBox[{"Length", "[", "G", "]"}]}], "}"}]}], "]"}]}], 
           "}"}]}], ";", "\n", "    ", 
         RowBox[{"Nosim", " ", "=", " ", 
          RowBox[{"{", "}"}]}], ";", "\n", "    ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"TrueQ", "[", 
                   RowBox[{
                    RowBox[{"op", "[", 
                    RowBox[{
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORi", "]"}], "]"}], ",", " ", 
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORj", "]"}], "]"}]}], "]"}], " ", "==",
                     " ", 
                    RowBox[{"op", "[", 
                    RowBox[{
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORj", "]"}], "]"}], ",", " ", 
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORi", "]"}], "]"}]}], "]"}]}], "]"}], 
                  " ", "&&", " ", 
                  RowBox[{"TrueQ", "[", 
                   RowBox[{
                    RowBox[{"op", "[", 
                    RowBox[{
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORi", "]"}], "]"}], ",", " ", 
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORj", "]"}], "]"}]}], "]"}], " ", "==",
                     " ", "Neutro"}], "]"}]}], ",", " ", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"ElementoSimetrico", "[", 
                    RowBox[{"[", 
                    RowBox[{"2", ",", " ", "CONTADORi"}], "]"}], "]"}], " ", 
                   "=", " ", 
                   RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORj", "]"}], "]"}]}], ";", " ", 
                  RowBox[{"Break", "[", "]"}]}]}], "]"}], ";"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{"CONTADORj", ",", " ", "1", ",", " ", 
                RowBox[{"Length", "[", "G", "]"}]}], "}"}]}], "]"}], ";", 
            "\n", "    ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ElementoSimetrico", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", " ", "CONTADORi"}], "]"}], "]"}], " ", "==",
                " ", "\"\<-\>\""}], ",", " ", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"Nosim", ",", " ", 
                RowBox[{"G", "[", 
                 RowBox[{"[", "CONTADORi", "]"}], "]"}]}], "]"}]}], "]"}], 
            ";"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"CONTADORi", ",", " ", "1", ",", " ", 
             RowBox[{"Length", "[", "G", "]"}]}], "}"}]}], "]"}], ";", "\n", 
         "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"Nosim", " ", "==", " ", 
            RowBox[{"{", "}"}]}], ",", " ", 
           RowBox[{
            RowBox[{"salida", " ", "=", " ", "True"}], ";"}]}], "]"}], 
         ";"}]}], "]"}], ";", "\n", "  ", "salida"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"ELEMENTOSIMETRICO", "[", 
