  RowBox[{"ElementoNeutro", " ", "=", " ", "\"\<No existe\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"TrueQ", "[", 
          RowBox[{
           RowBox[{"operacion", "[", 
            RowBox[{"[", "CONTADORi", "]"}], "]"}], " ", "==", " ", "G"}], 
          "]"}], " ", "&&", " ", 
         RowBox[{"TrueQ", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Transpose", "[", "operacion", "]"}], "[", 
            RowBox[{"[", "CONTADORi", "]"}], "]"}], " ", "==", " ", 
           RowBox[{"operacion", "[", 
            RowBox[{"[", "CONTADORi", "]"}], "]"}]}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"ElementoNeutro", " ", "=", " ", 
          RowBox[{"G", "[", 
           RowBox[{"[", "CONTADORi", "]"}], "]"}]}], ";", " ", 
         RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"CONTADORi", ",", " ", 
       RowBox[{"Length", "[", "G", "]"}]}], "}"}]}], "]"}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"simetrico", "[", "x_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"sim", ",", " ", "CONTADORi"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"sim", " ", "=", " ", "0"}], ";", "\n", "  ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"op", "[", 
              RowBox[{"x", ",", " ", 
               RowBox[{"G", "[", 
                RowBox[{"[", "CONTADORi", "]"}], "]"}]}], "]"}], " ", "==", 
             " ", "ElementoNeutro"}], ",", " ", 
            RowBox[{
             RowBox[{"sim", " ", "=", " ", 
              RowBox[{"G", "[", 
               RowBox[{"[", "CONTADORi", "]"}], "]"}]}], ";", " ", 
             RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"CONTADORi", ",", " ", "1", ",", " ", 
           RowBox[{"Length", "[", "G", "]"}]}], "}"}]}], "]"}], ";", "\n", 
       "  ", "sim"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"Divisors", "[", 
  RowBox[{"Length", "[", "G", "]"}], "]"}]}], "Code",
