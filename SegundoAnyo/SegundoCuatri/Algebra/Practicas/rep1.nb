  3.9881983945704346`*^9}},ExpressionUUID->"9ff5c91f-e32f-9443-b21a-\
ac530231e0a7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"ASOCIATIVA", "[", 
     RowBox[{"G_", ",", " ", "operacion_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "CONTADORi", ",", " ", "CONTADORj", ",", " ", "CONTADORk", ",", " ", 
        "asociativa"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"asociativa", " ", "=", " ", "True"}], ";", " ", 
       RowBox[{"CONTADORi", " ", "=", " ", "1"}], ";", "\n", "  ", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"asociativa", " ", "&&", " ", 
          RowBox[{"CONTADORi", " ", "<=", " ", 
           RowBox[{"Length", "[", "G", "]"}]}]}], ",", " ", 
         RowBox[{
          RowBox[{"CONTADORj", " ", "=", " ", "1"}], ";", "\n", "    ", 
          RowBox[{"While", "[", 
           RowBox[{
            RowBox[{"asociativa", " ", "&&", " ", 
             RowBox[{"CONTADORj", " ", "<=", " ", 
              RowBox[{"Length", "[", "G", "]"}]}]}], ",", " ", 
            RowBox[{
             RowBox[{"CONTADORk", " ", "=", " ", "1"}], ";", "\n", "      ", 
             RowBox[{"While", "[", 
              RowBox[{
               RowBox[{"asociativa", " ", "&&", " ", 
                RowBox[{"CONTADORk", " ", "<=", " ", 
                 RowBox[{"Length", "[", "G", "]"}]}]}], ",", "\n", "        ", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"TrueQ", "[", 
                   RowBox[{
                    RowBox[{"op", "[", 
                    RowBox[{
                    RowBox[{"op", "[", 
                    RowBox[{
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORi", "]"}], "]"}], ",", " ", 
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORj", "]"}], "]"}]}], "]"}], ",", " ", 
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORk", "]"}], "]"}]}], "]"}], " ", "==",
                     " ", 
                    RowBox[{"op", "[", 
                    RowBox[{
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORi", "]"}], "]"}], ",", " ", 
                    RowBox[{"op", "[", 
                    RowBox[{
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORj", "]"}], "]"}], ",", " ", 
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORk", "]"}], "]"}]}], "]"}]}], 
                    "]"}]}], "]"}], ",", " ", ",", " ", 
                  RowBox[{"asociativa", " ", "=", " ", "False"}]}], "]"}], 
                ";", "\n", "        ", 
                RowBox[{"CONTADORk", "++"}], ";"}]}], "]"}], ";", "\n", 
             "      ", 
             RowBox[{"CONTADORj", "++"}], ";"}]}], "]"}], ";", "\n", "    ", 
          RowBox[{"CONTADORi", "++"}], ";"}]}], "]"}], ";", "\n", "  ", 
       "asociativa"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GRUPO", "[", 
    RowBox[{"Conjunto_", ",", " ", "Operacion_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"INTERNA", "[", 
     RowBox[{"Conjunto", ",", " ", "Operacion"}], "]"}], " ", "&&", " ", 
    RowBox[{"ELEMENTOSIMETRICO", "[", 
     RowBox[{"Conjunto", ",", " ", "Operacion"}], "]"}], " ", "&&", " ", 
    RowBox[{"ASOCIATIVA", "[", 
     RowBox[{"Conjunto", ",", " ", "Operacion"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{"GRUPO", "[", 
  RowBox[{"G", ",", " ", "operacion"}], "]"}]}], "Code",
 CellChangeTimes->{3.9881984056711483`*^9},
