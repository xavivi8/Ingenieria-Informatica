Cell["\<\
Definir G = \:2124\:2081\:2082 y la tabla de operaciones (Funci\[OAcute]n \
2.1.bis, Sesi\[OAcute]n 02)\
\>", "Text",
 CellChangeTimes->{
  3.988198688696537*^9},ExpressionUUID->"3fabee46-26c5-514b-8a1c-\
