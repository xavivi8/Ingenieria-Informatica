Cell[BoxData[{
 RowBox[{
  RowBox[{"G", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
    "\"\<a\>\"", ",", " ", "\"\<b\>\"", ",", " ", "\"\<c\>\"", ",", " ", 
     "\"\<d\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"operacion", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\"\<a\>\"", ",", " ", "\"\<b\>\"", ",", " ", "\"\<c\>\"", ",", " ", 
       "\"\<d\>\""}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "\"\<b\>\"", ",", " ", "\"\<a\>\"", ",", " ", "\"\<d\>\"", ",", " ", 
       "\"\<c\>\""}], "}"}], ",", "\n", "\t\t ", 
     RowBox[{"{", 
      RowBox[{
      "\"\<c\>\"", ",", " ", "\"\<d\>\"", ",", " ", "\"\<a\>\"", ",", " ", 
       "\"\<b\>\""}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
      "\"\<d\>\"", ",", " ", "\"\<c\>\"", ",", " ", "\"\<b\>\"", ",", " ", 
       "\"\<a\>\""}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"op", "[", 
    RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"operacion", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"G", ",", " ", "x"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"G", ",", " ", "y"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.9881994690717583`*^9, 3.9881995186409626`*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"3636b20b-5cda-524d-9dbf-8beeb540ee8e"],

