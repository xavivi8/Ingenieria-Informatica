Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CAMINOS", "[", 
    RowBox[{
    "vertice1_", ",", "vertice2_", ",", "longitud_", ",", 
     "matrizadyacencia_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "i", ",", "ultvertice", ",", "caminos", ",", "adyacentes", ",", 
       "caminostemp", ",", "k", ",", "j", ",", "t"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"caminos", "=", 
       RowBox[{"{", 
        RowBox[{"{", "vertice1", "}"}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"caminostemp", "=", 
          RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"adyacentes", "=", 
             RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"ultvertice", "=", 
             RowBox[{
              RowBox[{"caminos", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"matrizadyacencia", "[", 
                   RowBox[{"[", 
                    RowBox[{"ultvertice", ",", "j"}], "]"}], "]"}], 
                  "\[Equal]", "1"}], ",", 
                 RowBox[{"AppendTo", "[", 
                  RowBox[{"adyacentes", ",", "j"}], "]"}]}], "]"}], ";"}], 
              ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", 
                RowBox[{
                 RowBox[{"Dimensions", "[", "matrizadyacencia", "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"adyacentes", "\[NotEqual]", 
               RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
              "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Do", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"caminostemp", ",", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"caminos", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", 
                    RowBox[{"adyacentes", "[", 
                    RowBox[{"[", "t", "]"}], "]"}]}], "]"}]}], "]"}], ";"}], 
                 ",", 
                 RowBox[{"{", 
                  RowBox[{"t", ",", 
                   RowBox[{"Length", "[", "adyacentes", "]"}]}], "}"}]}], 
                "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"Length", "[", "caminos", "]"}]}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"caminos", "=", "caminostemp"}], ";"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "longitud"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"caminostemp", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"caminos", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"longitud", "+", "1"}], "]"}], "]"}], "\[Equal]", 
            "vertice2"}], ",", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"caminostemp", ",", 
              RowBox[{"caminos", "[", 
               RowBox[{"[", "k", "]"}], "]"}]}], "]"}], ";"}]}], "]"}], ";"}],
         ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"Length", "[", "caminos", "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "caminostemp"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Code",
 CellChangeTimes->{3.9881055893392487`*^9},
 CellLabel->"In[50]:=",ExpressionUUID->"7cd64639-cd68-2343-8479-a9f862e991b0"],

