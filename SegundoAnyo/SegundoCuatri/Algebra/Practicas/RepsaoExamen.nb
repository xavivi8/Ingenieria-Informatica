Cell["\<\
Ecuaciones param\[EAcute]tricas de la imagen (Sesi\[OAcute]n 9, \
ep\[IAcute]grafe (2), funci\[OAcute]n Param\[EAcute]tricas[] + Sesi\[OAcute]n \
12, Ejemplo 4):\
\>", "Text",
 CellChangeTimes->{{3.988112059736763*^9, 
  3.9881120606472034`*^9}},ExpressionUUID->"edff97f5-1469-0b40-a16f-\
77983a0296bf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Param\[EAcute]tricas", "[", "Base_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Parte1", ",", " ", "param\[EAcute]tricas"}], "}"}], ",", "\n",
       "   ", 
      RowBox[{
       RowBox[{"Clear", "[", "\[Lambda]", "]"}], ";", "\n", "   ", 
       RowBox[{"Parte1", " ", "=", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Lambda]", "[", "i", "]"}], "*", 
           RowBox[{"Base", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", 
            RowBox[{"Length", "[", "Base", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\n", "   ", 
       RowBox[{"param\[EAcute]tricas", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ";", "\n", "   ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"param\[EAcute]tricas", ",", " ", 
            RowBox[{
             RowBox[{"Subscript", "[", 
              RowBox[{"x", ",", " ", "i"}], "]"}], " ", "==", " ", 
             RowBox[{"Parte1", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}], ";"}], "\n", "   ", 
         ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", 
            RowBox[{"Base", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ";", 
       "\n", "   ", "param\[EAcute]tricas"}]}], "\n", "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{"Param\[EAcute]tricas", "[", "baseimagen", "]"}]}], "Code",
 CellChangeTimes->{{3.988112070114008*^9, 3.9881120744496307`*^9}},
 CellLabel->
  "In[151]:=",ExpressionUUID->"e6e0d70a-1f14-ca48-940e-1eb70650536a"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SubscriptBox["x", "1"], "\[Equal]", 
    RowBox[{"\[Lambda]", "[", "1", "]"}]}], ",", 
   RowBox[{
    SubscriptBox["x", "2"], "\[Equal]", 
    RowBox[{"\[Lambda]", "[", "2", "]"}]}], ",", 
   RowBox[{
    SubscriptBox["x", "3"], "\[Equal]", 
    RowBox[{"\[Lambda]", "[", "3", "]"}]}]}], "}"}]], "Output",
 CellChangeTimes->{3.988112075304407*^9},
 CellLabel->
  "Out[152]=",ExpressionUUID->"9eec6111-ca79-ab4b-8925-58b8baa2a514"]
}, Open  ]],

Cell["\<\
Ecuaciones impl\[IAcute]citas de la imagen (Sesi\[OAcute]n 9, \
ep\[IAcute]grafe (3), funci\[OAcute]n Impl\[IAcute]citas[]):\
\>", "Text",
