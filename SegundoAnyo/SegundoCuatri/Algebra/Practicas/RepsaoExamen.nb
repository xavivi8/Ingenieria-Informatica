   RowBox[{"Declaro", " ", "codominio", " ", 
    SuperscriptBox["R", "3"]}], "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"A1", " ", "=", " ", 
   RowBox[{"ExpMatricial", "[", 
    RowBox[{"f", ",", " ", "Bc1", ",", " ", "Bc2"}], "]"}]}], ";"}], "\n", 
 RowBox[{"A1", "//", "MatrixForm"}], "\n", 
 RowBox[{"Det", "[", "A1", "]"}]}], "Code",
