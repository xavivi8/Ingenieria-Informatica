Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"el1", "[", 
    RowBox[{"i_", ",", "j_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "B", "}"}], ",", "\n", "\t\t\t\t", 
     RowBox[{
      RowBox[{"B", "=", 
       RowBox[{"IdentityMatrix", "[", "n", "]"}]}], ";", "\n", "\t\t\t\t", 
      RowBox[{
       RowBox[{"B", "\[LeftDoubleBracket]", 
        RowBox[{"i", ",", "i"}], "\[RightDoubleBracket]"}], "=", "0"}], ";", 
      "\n", "\t\t\t\t", 
      RowBox[{
       RowBox[{"B", "\[LeftDoubleBracket]", 
        RowBox[{"j", ",", "j"}], "\[RightDoubleBracket]"}], "=", "0"}], ";", 
      "\n", "\t\t\t\t", 
      RowBox[{
       RowBox[{"B", "\[LeftDoubleBracket]", 
        RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "=", "1"}], ";", 
      "\n", "\t\t\t\t", 
      RowBox[{
       RowBox[{"B", "\[LeftDoubleBracket]", 
        RowBox[{"j", ",", "i"}], "\[RightDoubleBracket]"}], "=", 
       RowBox[{"B", "\[LeftDoubleBracket]", 
        RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}]}], ";", "\n", 
      "\t\t                   ", "B"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"el2", "[", 
    RowBox[{"i_", ",", "s_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "B", "}"}], ",", "\n", "\t\t\t\t", 
     RowBox[{
      RowBox[{"B", "=", 
       RowBox[{"IdentityMatrix", "[", "n", "]"}]}], ";", "\n", "\t\t\t\t", 
      RowBox[{
       RowBox[{"B", "\[LeftDoubleBracket]", 
        RowBox[{"i", ",", "i"}], "\[RightDoubleBracket]"}], "=", "s"}], ";", 
      "\n", "\t\t\t\t", "B"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"el3", "[", 
    RowBox[{"i_", ",", "j_", ",", "t_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "B", "}"}], ",", "\n", "\t\t\t\t\t ", 
     RowBox[{
      RowBox[{"B", "=", 
       RowBox[{"IdentityMatrix", "[", "n", "]"}]}], ";", "\n", "\t\t\t\t\t ", 
      RowBox[{
       RowBox[{"B", "\[LeftDoubleBracket]", 
        RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "=", "t"}], ";", 
      "\[IndentingNewLine]", "\t\t\t\t      ", "B"}]}], "]"}]}], 
  ";"}]}], "Code",
 CellChangeTimes->{
  3.9881062829488106`*^9, {3.9881066216118526`*^9, 3.9881066559292088`*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"bbd58233-e547-a34e-8332-99c5ba67f31c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Coordenadas", "[", 
    RowBox[{"X_", ",", " ", "B_"}], "]"}], " ", ":=", " ", 
   RowBox[{"LinearSolve", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", "B", "]"}], ",", " ", "X"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ExpMatricial", "[", 
    RowBox[{"f_", ",", " ", "B1_", ",", " ", "B2_"}], "]"}], " ", ":=", " ", 
   "\n", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Coordenadas", "[", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"B1", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", " ", "B2"}], "]"}], ",",
       " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", 
        RowBox[{"Length", "[", "B1", "]"}]}], "}"}]}], "]"}], "]"}]}], 
  ";"}]}], "Code",
 CellChangeTimes->{{3.988106319887829*^9, 3.988106369885153*^9}, {
  3.988106431013336*^9, 3.988106436781004*^9}, {3.988107913667433*^9, 
