Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"MATRIZADYACENCIA", "[", 
     RowBox[{"W_", ",", "F_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k", ",", "i", ",", "j", ",", "CONTADORi", ",", "nuevoF"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"nuevoF", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"nuevoF", ",", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Position", "[", 
                RowBox[{"W", ",", 
                 RowBox[{
                  RowBox[{"F", "[", 
                   RowBox[{"[", "CONTADORi", "]"}], "]"}], "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "->", 
             RowBox[{
              RowBox[{
               RowBox[{"Position", "[", 
                RowBox[{"W", ",", 
                 RowBox[{
                  RowBox[{"F", "[", 
                   RowBox[{"[", "CONTADORi", "]"}], "]"}], "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ";"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"CONTADORi", ",", 
           RowBox[{"Length", "[", "F", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"matrizadyacencia", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "W", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", "W", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"matrizadyacencia", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"nuevoF", "[", 
               RowBox[{"[", 
                RowBox[{"k", ",", "1"}], "]"}], "]"}], ",", 
              RowBox[{"nuevoF", "[", 
               RowBox[{"[", 
                RowBox[{"k", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], "=", 
           "1"}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"matrizadyacencia", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"nuevoF", "[", 
               RowBox[{"[", 
                RowBox[{"k", ",", "2"}], "]"}], "]"}], ",", 
              RowBox[{"nuevoF", "[", 
               RowBox[{"[", 
                RowBox[{"k", ",", "1"}], "]"}], "]"}]}], "]"}], "]"}], "=", 
           "1"}], ";"}], "\[IndentingNewLine]", ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", "F", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", "matrizadyacencia"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"Adya3", "=", 
   RowBox[{"MATRIZADYACENCIA", "[", 
    RowBox[{"W3", ",", "F3"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Adya3", "//", "MatrixForm"}]}], "Code",
 CellChangeTimes->{{3.9881178476434364`*^9, 3.988117874978937*^9}},
 CellLabel->
  "In[266]:=",ExpressionUUID->"f5a8406b-60d5-d347-8ec3-5cfa0ae1f672"],

