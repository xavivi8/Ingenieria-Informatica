Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Param\[EAcute]tricas", "[", "Base_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Parte1", ",", " ", "param\[EAcute]tricas"}], "}"}], ",", "\n",
       "   ", 
      RowBox[{
       RowBox[{"Clear", "[", "\[Lambda]", "]"}], ";", "\n", "   ", 
       RowBox[{"Parte1", " ", "=", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Lambda]", "[", "i", "]"}], "*", 
           RowBox[{"Base", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", 
            RowBox[{"Length", "[", "Base", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\n", "   ", 
       RowBox[{"param\[EAcute]tricas", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ";", "\n", "   ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"param\[EAcute]tricas", ",", " ", 
            RowBox[{
             RowBox[{"Subscript", "[", 
              RowBox[{"x", ",", " ", "i"}], "]"}], " ", "==", " ", 
             RowBox[{"Parte1", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}], ";"}], "\n", "   ", 
         ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", 
            RowBox[{"Base", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ";", 
       "\n", "   ", "param\[EAcute]tricas"}]}], "\n", "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{"Param\[EAcute]tricas", "[", "basenucleo", "]"}]}], "Code",
 CellChangeTimes->{3.9881170713977966`*^9},
 CellLabel->
  "In[242]:=",ExpressionUUID->"b99ccc3b-78d8-ea40-a46f-a87c12c399ed"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SubscriptBox["x", "1"], "\[Equal]", 
    RowBox[{
     RowBox[{"-", "2"}], " ", 
     RowBox[{"\[Lambda]", "[", "1", "]"}]}]}], ",", 
   RowBox[{
    SubscriptBox["x", "2"], "\[Equal]", 
    RowBox[{"\[Lambda]", "[", "1", "]"}]}], ",", 
   RowBox[{
    SubscriptBox["x", "3"], "\[Equal]", "0"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9881170805558014`*^9},
 CellLabel->
  "Out[243]=",ExpressionUUID->"aeae1b3b-b82e-1c4c-99be-d7a359328199"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Impl\[IAcute]citas", "[", "Base_", "]"}], " ", ":=", " ", 
    RowBox[{"Eliminate", "[", 
     RowBox[{
      RowBox[{"Param\[EAcute]tricas", "[", "Base", "]"}], ",", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"\[Lambda]", "[", "i", "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{"Length", "[", "Base", "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{"Impl\[IAcute]citas", "[", "basenucleo", "]"}]}], "Code",
 CellChangeTimes->{3.9881171082994957`*^9},
 CellLabel->
  "In[244]:=",ExpressionUUID->"00522a30-8a84-a843-a386-3eba5512d1c8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"2", " ", 
    SubscriptBox["x", "2"]}], "\[Equal]", 
   RowBox[{"-", 
    SubscriptBox["x", "1"]}]}], "&&", 
  RowBox[{
   SubscriptBox["x", "3"], "\[Equal]", "0"}]}]], "Output",
 CellChangeTimes->{3.988117109372095*^9},
 CellLabel->
  "Out[245]=",ExpressionUUID->"04aa5269-82c2-c94e-a801-45afc2b1c420"]
}, Open  ]],

