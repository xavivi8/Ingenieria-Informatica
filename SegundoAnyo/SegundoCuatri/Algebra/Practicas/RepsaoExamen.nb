       RowBox[{"2", " ", "z"}]}], ",", " ", 
      RowBox[{"x", " ", "+", " ", "y", " ", "+", " ", 
       RowBox[{"4", " ", "z"}]}]}], "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
