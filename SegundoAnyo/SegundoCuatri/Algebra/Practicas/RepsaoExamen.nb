Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Base", "[", "Generadores_", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"RowReduce", "[", "Generadores", "]"}], "[", 
      RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", 
       RowBox[{"MatrixRank", "[", "Generadores", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"baseimagen", " ", "=", " ", 
  RowBox[{"Base", "[", 
