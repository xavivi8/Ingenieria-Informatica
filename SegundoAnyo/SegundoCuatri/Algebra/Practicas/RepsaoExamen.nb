Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Param\[EAcute]tricas", "[", "Base_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Parte1", ",", " ", "param\[EAcute]tricas"}], "}"}], ",", "\n",
       "   ", 
      RowBox[{
       RowBox[{"Clear", "[", "\[Lambda]", "]"}], ";", "\n", "   ", 
       RowBox[{"Parte1", " ", "=", " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Lambda]", "[", "i", "]"}], "*", 
           RowBox[{"Base", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", 
            RowBox[{"Length", "[", "Base", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\n", "   ", 
       RowBox[{"param\[EAcute]tricas", " ", "=", " ", 
        RowBox[{"{", "}"}]}], ";", "\n", "   ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"param\[EAcute]tricas", ",", " ", 
            RowBox[{
             RowBox[{"Subscript", "[", 
              RowBox[{"x", ",", " ", "i"}], "]"}], " ", "==", " ", 
             RowBox[{"Parte1", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}], ";"}], "\n", "   ", 
         ",", " ", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", 
           RowBox[{"Length", "[", 
            RowBox[{"Base", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ";", 
       "\n", "   ", "param\[EAcute]tricas"}]}], "\n", "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{"Param\[EAcute]tricas", "[", "baseimagen", "]"}]}], "Code",
 CellChangeTimes->{3.9881172388787975`*^9},
 CellLabel->
  "In[250]:=",ExpressionUUID->"d4aada59-e6fb-6b4a-b7e4-37295ac56d42"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SubscriptBox["x", "1"], "\[Equal]", 
    RowBox[{"\[Lambda]", "[", "1", "]"}]}], ",", 
   RowBox[{
    SubscriptBox["x", "2"], "\[Equal]", 
    RowBox[{"2", " ", 
     RowBox[{"\[Lambda]", "[", "1", "]"}]}]}], ",", 
   RowBox[{
    SubscriptBox["x", "3"], "\[Equal]", 
