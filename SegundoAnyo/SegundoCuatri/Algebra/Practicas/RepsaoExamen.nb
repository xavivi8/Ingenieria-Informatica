 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", " ", "x", ",", " ", "y", ",", " ", "z"}], "]"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"{", 
