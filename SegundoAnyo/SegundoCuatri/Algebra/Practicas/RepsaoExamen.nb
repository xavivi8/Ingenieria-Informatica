Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"NCOLORACIONES", "[", 
    RowBox[{"matrizadyacencia_", ",", "lambda_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "coloracionestemp", ",", "t", ",", "h", ",", "i", ",", "j", ",", 
       "colorady", ",", "k"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"coloraciones", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", "k", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "lambda"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"coloracionestemp", "=", 
          RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"colorady", "=", 
             RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"Do", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"matrizadyacencia", "[", 
                   RowBox[{"[", 
                    RowBox[{"t", ",", "i"}], "]"}], "]"}], "\[Equal]", "1"}], 
                 " ", "\[IndentingNewLine]", ",", 
                 RowBox[{"colorady", "=", 
                  RowBox[{"Union", "[", 
                   RowBox[{"colorady", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"coloraciones", "[", 
                    RowBox[{"[", "h", "]"}], "]"}], "[", 
                    RowBox[{"[", "t", "]"}], "]"}], "}"}]}], "]"}]}]}], "]"}],
                ";"}], "\[IndentingNewLine]", ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", 
                RowBox[{"Length", "[", 
                 RowBox[{"coloraciones", "[", 
                  RowBox[{"[", "h", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"Do", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Intersection", "[", 
                   RowBox[{
                    RowBox[{"{", "j", "}"}], ",", "colorady"}], "]"}], 
                  "\[Equal]", 
                  RowBox[{"{", "}"}]}], ",", 
                 RowBox[{"AppendTo", "[", 
                  RowBox[{"coloracionestemp", ",", 
                   RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"coloraciones", "[", 
                    RowBox[{"[", "h", "]"}], "]"}], ",", "j"}], "]"}]}], 
                  "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "lambda"}], "}"}]}], "]"}], ";"}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"{", 
            RowBox[{"h", ",", 
             RowBox[{"Length", "[", "coloraciones", "]"}]}], "}"}]}], "]"}], 
         ";", "\[IndentingNewLine]", 
         RowBox[{"coloraciones", "=", "coloracionestemp"}], ";"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "2", ",", 
          RowBox[{
           RowBox[{"Dimensions", "[", "matrizadyacencia", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "coloraciones"}]}], "\[IndentingNewLine]", 
    "]"}]}], ";"}]], "Code",
 CellChangeTimes->{3.988117967848488*^9},
 CellLabel->
  "In[272]:=",ExpressionUUID->"9ef6d1de-76b4-a141-9ec7-bfc6b5fd11fb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NUMEROCROMATICO", "[", "matrizadyacencia_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"t", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"NCOLORACIONES", "[", 
         RowBox[{"matrizadyacencia", ",", "t"}], "]"}], "\[Equal]", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"t", "++"}]}], "]"}], ";", "\[IndentingNewLine]", "t"}]}], 
   "]"}]}]], "Code",
 CellChangeTimes->{3.9881179887130585`*^9},
 CellLabel->
  "In[273]:=",ExpressionUUID->"2c4443c3-fb21-374f-9dc8-fcc0ba281782"],

