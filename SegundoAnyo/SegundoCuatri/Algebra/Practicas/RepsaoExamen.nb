Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MATRIZADYACENCIA", "[", 
    RowBox[{"W_", ",", "F_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", "i", ",", "j", ",", "CONTADORi", ",", "nuevoF"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"nuevoF", "=", 
       RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{"nuevoF", ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Position", "[", 
               RowBox[{"W", ",", 
                RowBox[{
                 RowBox[{"F", "[", 
                  RowBox[{"[", "CONTADORi", "]"}], "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], "->", 
            RowBox[{
             RowBox[{
              RowBox[{"Position", "[", 
               RowBox[{"W", ",", 
                RowBox[{
                 RowBox[{"F", "[", 
                  RowBox[{"[", "CONTADORi", "]"}], "]"}], "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}]}], "]"}], ";"}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"CONTADORi", ",", 
          RowBox[{"Length", "[", "F", "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"matrizadyacencia", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "W", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"Length", "[", "W", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"matrizadyacencia", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"nuevoF", "[", 
              RowBox[{"[", 
               RowBox[{"k", ",", "1"}], "]"}], "]"}], ",", 
             RowBox[{"nuevoF", "[", 
              RowBox[{"[", 
               RowBox[{"k", ",", "2"}], "]"}], "]"}]}], "]"}], "]"}], "=", 
          "1"}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"matrizadyacencia", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"nuevoF", "[", 
              RowBox[{"[", 
               RowBox[{"k", ",", "2"}], "]"}], "]"}], ",", 
             RowBox[{"nuevoF", "[", 
              RowBox[{"[", 
               RowBox[{"k", ",", "1"}], "]"}], "]"}]}], "]"}], "]"}], "=", 
          "1"}], ";"}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"Length", "[", "F", "]"}]}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "matrizadyacencia"}]}], "]"}]}], ";"}]], "Code",
 CellChangeTimes->{3.988112827653372*^9},
 CellLabel->
  "In[182]:=",ExpressionUUID->"a7b05e90-ce8a-694d-9c1e-3c5e122582d2"],

