Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"NCOLORACIONES", "[", 
    RowBox[{"matrizadyacencia_", ",", "lambda_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "coloracionestemp", ",", "t", ",", "h", ",", "i", ",", "j", ",", 
       "colorady", ",", "k"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"coloraciones", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"{", "k", "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "lambda"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"coloracionestemp", "=", 
          RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"colorady", "=", 
             RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"Do", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"matrizadyacencia", "[", 
                   RowBox[{"[", 
                    RowBox[{"t", ",", "i"}], "]"}], "]"}], "\[Equal]", "1"}], 
                 " ", "\[IndentingNewLine]", ",", 
                 RowBox[{"colorady", "=", 
                  RowBox[{"Union", "[", 
                   RowBox[{"colorady", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"coloraciones", "[", 
                    RowBox[{"[", "h", "]"}], "]"}], "[", 
                    RowBox[{"[", "t", "]"}], "]"}], "}"}]}], "]"}]}]}], "]"}],
                ";"}], "\[IndentingNewLine]", ",", 
              RowBox[{"{", 
               RowBox[{"t", ",", 
                RowBox[{"Length", "[", 
                 RowBox[{"coloraciones", "[", 
                  RowBox[{"[", "h", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], 
            ";", "\[IndentingNewLine]", 
            RowBox[{"Do", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Intersection", "[", 
                   RowBox[{
                    RowBox[{"{", "j", "}"}], ",", "colorady"}], "]"}], 
                  "\[Equal]", 
                  RowBox[{"{", "}"}]}], ",", 
                 RowBox[{"AppendTo", "[", 
                  RowBox[{"coloracionestemp", ",", 
                   RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"coloraciones", "[", 
                    RowBox[{"[", "h", "]"}], "]"}], ",", "j"}], "]"}]}], 
                  "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
              RowBox[{"{", 
