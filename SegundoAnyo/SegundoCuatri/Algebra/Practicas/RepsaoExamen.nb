  RowBox[{
   RowBox[{"Bc2", " ", "=", " ", 
    RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Declaro", " ", "codominio", " ", 
    RowBox[{"R", "^", "3"}]}], "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"A1", " ", "=", " ", 
   RowBox[{"ExpMatricial", "[", 
    RowBox[{"f", ",", " ", "Bc1", ",", " ", "Bc2"}], "]"}]}], ";"}], "\n", 
 RowBox[{"A1", " ", "//", " ", "MatrixForm"}], "\n", 
