Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"f", ",", " ", "x", ",", " ", "y", ",", " ", "z"}], "]"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"{", 
      RowBox[{"x_", ",", " ", "y_", ",", " ", "z_"}], "}"}], "]"}], " ", ":=",
     " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"x", " ", "+", " ", 
       RowBox[{"2", "y"}], " ", "+", " ", "z"}], ",", " ", 
      RowBox[{
       RowBox[{"2", "x"}], " ", "+", " ", 
       RowBox[{"4", "y"}], " ", "+", " ", 
       RowBox[{"2", "z"}]}], ",", " ", 
      RowBox[{"x", " ", "+", " ", 
       RowBox[{"2", "y"}], " ", "+", " ", 
       RowBox[{"3", "z"}]}]}], "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Bc1", " ", "=", " ", 
    RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Declaro", " ", "dominio", " ", 
    RowBox[{"R", "^", "3"}]}], "*)"}]}], "\n", 
