Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Impl\[IAcute]citas", "[", "Base_", "]"}], " ", ":=", " ", 
   RowBox[{"Eliminate", "[", 
    RowBox[{
     RowBox[{"Param\[EAcute]tricas", "[", "Base", "]"}], ",", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"\[Lambda]", "[", "i", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"Length", "[", "Base", "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Impl\[IAcute]citas", "[", "baseimagen", "]"}]}], "Code",
 CellChangeTimes->{3.9881121270784264`*^9},
