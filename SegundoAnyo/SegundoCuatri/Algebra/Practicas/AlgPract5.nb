             RowBox[{"!", "bipartito"}], " ", "&&", " ", 
             RowBox[{"j", "<=", 
              RowBox[{"Length", "[", "subconjuntos", "]"}]}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"IND", "[", 
                 RowBox[{
                  RowBox[{"subconjuntos", "[", 
                   RowBox[{"[", "j", "]"}], "]"}], ",", "F"}], "]"}], "==", 
                RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"IND", "[", 
                    RowBox[{
                    RowBox[{"Complement", "[", 
                    RowBox[{"W", ",", 
                    RowBox[{"subconjuntos", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", "F"}], 
                    "]"}], "\[Equal]", 
                   RowBox[{"{", "}"}]}], ",", "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"bipartito", "=", "True"}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"W1", "=", 
                    RowBox[{"subconjuntos", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"W2", "=", 
                    RowBox[{"Complement", "[", 
                    RowBox[{"W", ",", 
                    RowBox[{"subconjuntos", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";"}]}], 
                 "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]",
               "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"j", "++"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"i", "++"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"bipartito", ",", 
         RowBox[{
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<Es bipartito: W1=\>\"", ",", "W1", ",", "\"\< y W2=\>\"", ",",
             "W2"}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "F", "]"}], "==", 
             RowBox[{
              RowBox[{"Length", "[", "W1", "]"}], "*", 
              RowBox[{"Length", "[", "W2", "]"}]}]}], ",", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Es bipartito completo: \>\"", ",", 
              SubscriptBox["\"\<K\>\"", 
               RowBox[{
                RowBox[{"Length", "[", "W1", "]"}], ",", 
                RowBox[{"Length", "[", "W2", "]"}]}]]}], "  ", "]"}], ",", 
            " ", 
            RowBox[{"Print", "[", "\"\<No es bipartito completo\>\"", "]"}]}],
            "]"}], ";"}], "\[IndentingNewLine]", ",", 
         RowBox[{"Print", "[", "\"\<No es bipartito\>\"", "]"}]}], "]"}], 
       ";"}]}], "\[IndentingNewLine]", "]"}]}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Sesi\[OAcute]n", " ", "5", " ", "cap", " ", "6"}], " ", "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"REGULAR", "[", "matrizadyacencia_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"i", ",", "j"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"grado", "=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{"matrizadyacencia", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "j"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{
              RowBox[{"Dimensions", "[", "matrizadyacencia", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"regular", "=", "True"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"grado", "!=", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{"matrizadyacencia", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "j"}], "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "1", ",", 
                  RowBox[{
                   RowBox[{"Dimensions", "[", "matrizadyacencia", "]"}], "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}]}], ",", 
             RowBox[{
              RowBox[{"regular", "=", "False"}], ";", 
              RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";"}], 
          "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "2", ",", 
            RowBox[{
             RowBox[{"Dimensions", "[", "matrizadyacencia", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "regular"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Sesi\[OAcute]n", " ", "5", " ", "cap", " ", "6"}], " ", "*)"}], 
   "\n", 
   StyleBox[
    RowBox[{
     RowBox[{"COMPLETO", "[", "matrizadyacencia_", "]"}], ":=", "   ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"MatrixPower", "[", 
           RowBox[{"matrizadyacencia", ",", "2"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "i"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{
            RowBox[{"Dimensions", "[", "matrizadyacencia", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], "==", 
       RowBox[{
        RowBox[{
         RowBox[{"Dimensions", "[", "matrizadyacencia", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "*", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Dimensions", "[", "matrizadyacencia", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ")"}]}]}], ")"}]}],
    FormatType->StandardForm]}]}]], "Code",
