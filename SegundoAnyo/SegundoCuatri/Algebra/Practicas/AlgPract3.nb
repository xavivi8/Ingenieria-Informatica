         "\[RightDoubleBracket]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", 
        RowBox[{"n", "!"}]}], "}"}]}], "]"}]}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Cap", " ", "4"}], " ", "-", " ", 
     RowBox[{"2.1", " ", "El", " ", "grupo", " ", "sim\[EAcute]trico"}], " ", 
     "-", " ", 
     RowBox[{"2.1", ".2"}], " ", "-", " ", "4.7"}], "*)"}], "\n", 
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{"sigma", "[", 
       RowBox[{"k_", ",", "n_"}], "]"}], "[", "m_", "]"}], ":=", 
