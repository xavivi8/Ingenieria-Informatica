       RowBox[{"k", ",", "m"}], "]"}], "]"}]}],
    FormatType->StandardForm], 
   StyleBox["\n",
    FormatType->StandardForm], 
   RowBox[{
    StyleBox["(*",
     FormatType->StandardForm], 
