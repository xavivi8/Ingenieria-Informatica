     "-", "  ", 
     RowBox[{"-", " ", "4.8"}]}], 
    StyleBox["*)",
     FormatType->StandardForm]}], 
   StyleBox["\n",
    FormatType->StandardForm], 
   RowBox[{
    RowBox[{"composicion", "[", 
     RowBox[{"k_", ",", "j_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t", ",", "m", ",", "z", ",", "tabla"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"t", "=", "1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"tabla", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"sigma", "[", 
            RowBox[{"k", ",", "n"}], "]"}], "[", 
           RowBox[{
            RowBox[{"sigma", "[", 
             RowBox[{"j", ",", "n"}], "]"}], "[", "m", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"m", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"tabla", "!=", 
          RowBox[{
           RowBox[{"Permutations", "[", 
            RowBox[{"Table", "[", 
             RowBox[{"m", ",", 
              RowBox[{"{", 
               RowBox[{"m", ",", "n"}], "}"}]}], "]"}], "]"}], "[", 
           RowBox[{"[", "t", "]"}], "]"}]}], ",", 
         RowBox[{"t", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"A", "=", 
        RowBox[{"MatrixForm", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{"z", ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "n"}], "}"}]}], "]"}], ",", "tabla"}], "}"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
         SubscriptBox["\[Sigma]", "k"], ",", 
         SubscriptBox["\[Sigma]", "j"], ",", "\"\<=\>\"", ",", 
         SubscriptBox["\[Sigma]", "t"], ",", "\"\<=\>\"", ",", "A"}], 
        "]"}]}]}], "]"}]}], "\n", 
   RowBox[{
    RowBox[{"composicion2", "[", 
     RowBox[{"k_", ",", "j_", ",", "n_"}], "]"}], ":=", 
