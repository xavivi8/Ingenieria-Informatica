             RowBox[{"ciclo", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", "\"\< \>\"", ",", 
            RowBox[{"ToString", "[", 
             RowBox[{"ciclo", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"Length", "[", "ciclo", "]"}], "-", "i", "+", "1"}], 
               "]"}], "]"}], "]"}], ",", "\"\<)\>\""}], "]"}]}], ",", 
