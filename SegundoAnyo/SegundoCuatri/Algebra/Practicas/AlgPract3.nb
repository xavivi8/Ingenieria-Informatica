     RowBox[{
      RowBox[{"{", 
       RowBox[{"cadena", ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"cadena", "=", "\"\<\>\""}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"cadena", "=", 
          RowBox[{"StringJoin", "[", 
           RowBox[{"cadena", ",", "\"\<(\>\"", ",", 
            RowBox[{"ToString", "[", 
             RowBox[{"ciclo", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", "\"\< \>\"", ",", 
            RowBox[{"ToString", "[", 
             RowBox[{"ciclo", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"Length", "[", "ciclo", "]"}], "-", "i", "+", "1"}], 
               "]"}], "]"}], "]"}], ",", "\"\<)\>\""}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{
            RowBox[{"Length", "[", "ciclo", "]"}], "-", "1"}]}], "}"}]}], 
        "]"}], ";", "\[IndentingNewLine]", "cadena"}]}], 
