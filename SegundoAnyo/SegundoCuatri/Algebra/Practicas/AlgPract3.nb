      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "cadena", "]"}], ">", "1"}], ",", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"ciclos", ",", "cadena"}], "]"}]}], "]"}], ";", "\n", "\t", 
     RowBox[{"X", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{"X", ",", "cadena"}], "]"}]}], ";"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"signatura", "=", "0"}], ";"}], "\n", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{"signatura", "=", 
    RowBox[{"signatura", "+", 
     RowBox[{"Length", "[", 
      RowBox[{
      "ciclos", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "]"}],
      "-", "1"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", 
     RowBox[{"Length", "[", "ciclos", "]"}]}], "}"}]}], "]"}], "\n", 
 RowBox[{"signatura", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"-", "1"}], ")"}], "^", "signatura"}]}]}], "Code",
 CellChangeTimes->{{3.98100257996702*^9, 3.981002592480549*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"be9e95b0-3870-3941-b0fe-83816168e010"],

