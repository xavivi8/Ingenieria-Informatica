Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"permutacion", "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "1", ",", "5", ",", "4"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"inversion", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", "\n", "\t", 
   RowBox[{
    RowBox[{
     RowBox[{"Do", "[", "\n", "\t\t", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"i", "<", "j"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{
            "permutacion", "\[LeftDoubleBracket]", "j", 
             "\[RightDoubleBracket]"}], "<", " ", 
            RowBox[{
            "permutacion", "\[LeftDoubleBracket]", "i", 
             "\[RightDoubleBracket]"}]}]}], ",", 
          RowBox[{"inversion", "++"}]}], "]"}], ";"}], "\n", "\t", ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "i", ",", 
         RowBox[{"Length", "[", "permutacion", "]"}]}], "}"}]}], "]"}], ";"}],
     "\n", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "permutacion", "]"}]}], "}"}]}], "]"}], 
  ";"}], "\n", "inversion"}], "Code",
