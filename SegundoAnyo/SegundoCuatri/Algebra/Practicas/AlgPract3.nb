          RowBox[{"cadena", ",", "imagen"}], "]"}]}]}]}], "]"}], ";", "\n", 
     "\t", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "cadena", "]"}], ">", "1"}], ",", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"ciclos", ",", "cadena"}], "]"}]}], "]"}], ";", "\n", "\t", 
     RowBox[{"X", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{"X", ",", "cadena"}], "]"}]}], ";"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"signatura", "=", "0"}], ";"}], "\n", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{"signatura", "=", 
    RowBox[{"signatura", "+", 
     RowBox[{"Length", "[", 
      RowBox[{
      "ciclos", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "]"}],
      "-", "1"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", 
     RowBox[{"Length", "[", "ciclos", "]"}]}], "}"}]}], "]"}], "\n", 
 RowBox[{"signatura", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"-", "1"}], ")"}], "^", "signatura"}]}]}], "Code",
