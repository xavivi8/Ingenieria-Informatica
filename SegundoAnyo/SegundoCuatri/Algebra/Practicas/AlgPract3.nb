Cell[CellGroupData[{

Cell[TextData[{
 "Ejercicio 2 Ord2 24/25 A) En ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", "5"], TraditionalForm]],ExpressionUUID->
  "8ba57e4a-4ac4-154e-802c-fe2ab86b823f"],
 " consideramos la siguiente permutaci\[OAcute]n:\n\[Sigma] = (24) ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", "341", ")"}], "2"], TraditionalForm]],ExpressionUUID->
  "30d8243e-0720-ea49-b425-93c45bad2f01"],
 " (12)\nComprobar si \[Sigma] es un ciclo. \[DownQuestion]Pertenece a ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "5"], TraditionalForm]],ExpressionUUID->
  "d454afb6-b8a2-9441-b7a3-5d86abacab9c"],
 "? \[DownQuestion]Es cierto que ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Sigma]", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "07b67e9b-2b6d-3047-811c-c99e8967eba1"],
 " = (341)?"
}], "Subsection",
 CellChangeTimes->{{3.980397280481394*^9, 3.9803973204015694`*^9}, {
  3.9809994731206856`*^9, 
  3.980999648772791*^9}},ExpressionUUID->"026712d0-69fe-024f-8116-\
fba1171b71ac"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"<<", " ", "\"\<Combinatorica`\>\""}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"n", " ", "=", " ", "5"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"p24", "  ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", "4", ",", "3", ",", "2", ",", "5"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"p12", "  ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "3", ",", "4", ",", "5"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p341", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"3", ",", "2", ",", "4", ",", "1", ",", "5"}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"k24", "  ", "=", " ", 
   RowBox[{"Indice", "[", "p24", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k12", "  ", "=", " ", 
   RowBox[{"Indice", "[", "p12", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"k341", " ", "=", " ", 
    RowBox[{"Indice", "[", "p341", "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"(", "341", ")"}], "^", "2"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"k341sq", " ", "=", " ", 
    RowBox[{"composicion2", "[", 
     RowBox[{"k341", ",", " ", "k341", ",", " ", "n"}], "]"}]}], ";"}], "\n", 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"\[Sigma]", " ", "=", " ", 
    RowBox[{
     RowBox[{"(", "24", ")"}], " ", "\[SmallCircle]", " ", 
     RowBox[{
      RowBox[{"(", "341", ")"}], "^", "2"}], " ", "\[SmallCircle]", " ", 
     RowBox[{"(", "12", ")"}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"kSigma", " ", "=", " ", 
    RowBox[{"composicion2", "[", 
     RowBox[{"k24", ",", " ", 
      RowBox[{"composicion2", "[", 
       RowBox[{"k341sq", ",", " ", "k12", ",", " ", "n"}], "]"}], ",", " ", 
      "n"}], "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"lista", " ", "de", " ", "\[Sigma]"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"permSigma", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"sigma", "[", 
       RowBox[{"kSigma", ",", " ", "n"}], "]"}], "[", "m", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"m", ",", " ", "1", ",", " ", "n"}], "}"}]}], "]"}]}], 
  ";"}], "\n", "permSigma"}], "Code",
