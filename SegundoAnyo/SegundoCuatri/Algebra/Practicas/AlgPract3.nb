             RowBox[{"m", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], 
   StyleBox["\n",
    FormatType->StandardForm], 
   RowBox[{
    StyleBox["(*",
     FormatType->StandardForm], 
    StyleBox[" ",
     FormatType->StandardForm], 
    RowBox[{
     RowBox[{"Cap", " ", "4"}], " ", "-", " ", 
