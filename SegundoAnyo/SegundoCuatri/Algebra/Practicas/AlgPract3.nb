Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Cap", " ", "4"}], " ", "-", " ", 
    RowBox[{"2", " ", "El", " ", "grupo", " ", "sim\[EAcute]trico"}], " ", 
    "-", " ", 
    RowBox[{"2.1", ".2"}], " ", "-", " ", "4.4"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"S", "[", "n_", "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"MatrixForm", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{"j", ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "n"}], "}"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{"Permutations", "[", 
           RowBox[{"Table", "[", 
            RowBox[{"j", ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "n"}], "}"}]}], "]"}], "]"}], 
          "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], "}"}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"n", "!"}]}], "}"}]}], "]"}]}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Cap", " ", "4"}], " ", "-", " ", 
     RowBox[{"2", " ", "El", " ", "grupo", " ", "sim\[EAcute]trico"}], " ", 
     "-", " ", 
     RowBox[{"2.1", ".2"}], " ", "-", " ", "4.5"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"NombreS", "[", "n_", "]"}], ":=", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{
        SubscriptBox["\[Sigma]", "k"], ",", "\"\<=\>\"", ",", 
        RowBox[{
         RowBox[{"S", "[", "n", "]"}], "\[LeftDoubleBracket]", "k", 
         "\[RightDoubleBracket]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", 
        RowBox[{"n", "!"}]}], "}"}]}], "]"}]}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Cap", " ", "4"}], " ", "-", " ", 
     RowBox[{"2.1", " ", "El", " ", "grupo", " ", "sim\[EAcute]trico"}], " ", 
     "-", " ", 
     RowBox[{"2.1", ".2"}], " ", "-", " ", "4.7"}], "*)"}], "\n", 
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{"sigma", "[", 
       RowBox[{"k_", ",", "n_"}], "]"}], "[", "m_", "]"}], ":=", 
     RowBox[{
      RowBox[{"Permutations", "[", 
       RowBox[{"Table", "[", 
        RowBox[{"j", ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "n"}], "}"}]}], "]"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"k", ",", "m"}], "]"}], "]"}]}],
    FormatType->StandardForm], 
   StyleBox["\n",
    FormatType->StandardForm], 
   RowBox[{
    StyleBox["(*",
     FormatType->StandardForm], 
    RowBox[{
     RowBox[{"Cap", " ", "4"}], " ", "-", " ", 
     RowBox[{"2.2", " ", "El", " ", "grupo", " ", "sim\[EAcute]trico"}], " ", 
     "-", "  ", 
     RowBox[{"-", " ", "4.8"}]}], 
    StyleBox["*)",
     FormatType->StandardForm]}], 
   StyleBox["\n",
    FormatType->StandardForm], 
   RowBox[{
    RowBox[{"composicion", "[", 
     RowBox[{"k_", ",", "j_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t", ",", "m", ",", "z", ",", "tabla"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"t", "=", "1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"tabla", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"sigma", "[", 
            RowBox[{"k", ",", "n"}], "]"}], "[", 
           RowBox[{
            RowBox[{"sigma", "[", 
             RowBox[{"j", ",", "n"}], "]"}], "[", "m", "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"m", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{"tabla", "!=", 
          RowBox[{
           RowBox[{"Permutations", "[", 
            RowBox[{"Table", "[", 
             RowBox[{"m", ",", 
              RowBox[{"{", 
               RowBox[{"m", ",", "n"}], "}"}]}], "]"}], "]"}], "[", 
           RowBox[{"[", "t", "]"}], "]"}]}], ",", 
         RowBox[{"t", "++"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"A", "=", 
        RowBox[{"MatrixForm", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{"z", ",", 
             RowBox[{"{", 
              RowBox[{"z", ",", "n"}], "}"}]}], "]"}], ",", "tabla"}], "}"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
         SubscriptBox["\[Sigma]", "k"], ",", 
         SubscriptBox["\[Sigma]", "j"], ",", "\"\<=\>\"", ",", 
         SubscriptBox["\[Sigma]", "t"], ",", "\"\<=\>\"", ",", "A"}], 
        "]"}]}]}], "]"}]}], "\n", 
   RowBox[{
    StyleBox["(*",
     FormatType->StandardForm], 
    RowBox[{
     RowBox[{"Cap", " ", "4"}], " ", "-", " ", 
     RowBox[{"2.2", " ", "El", " ", "grupo", " ", "sim\[EAcute]trico"}], " ", 
     "-", "  ", 
     RowBox[{"-", " ", "4.8"}]}], 
    StyleBox["*)",
     FormatType->StandardForm]}], 
   StyleBox["\n",
    FormatType->StandardForm], 
   RowBox[{
    RowBox[{"composicion2", "[", 
     RowBox[{"k_", ",", "j_", ",", "n_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t", ",", "m", ",", "z"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Position", "[", 
         RowBox[{
          RowBox[{"Permutations", "[", 
           RowBox[{"Table", "[", 
            RowBox[{"m", ",", 
             RowBox[{"{", 
              RowBox[{"m", ",", "n"}], "}"}]}], "]"}], "]"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"sigma", "[", 
              RowBox[{"k", ",", "n"}], "]"}], "[", 
             RowBox[{
              RowBox[{"sigma", "[", 
               RowBox[{"j", ",", "n"}], "]"}], "[", "m", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", "1", ",", "n"}], "}"}]}], "]"}]}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], 
   StyleBox["\n",
    FormatType->StandardForm], 
   RowBox[{
    StyleBox["(*",
     FormatType->StandardForm], 
    StyleBox[" ",
     FormatType->StandardForm], 
    RowBox[{
     RowBox[{"Cap", " ", "4"}], " ", "-", " ", 
     RowBox[{"3.1", " ", "El", " ", "subgrupo"}], " ", "-", "  ", 
     RowBox[{"-", " ", "4.13"}]}], " ", 
    StyleBox[
     StyleBox[
      RowBox[{"*", ")"}]],
     FormatType->StandardForm]}], "\n", 
   StyleBox[
    RowBox[{
     RowBox[{
      RowBox[{"Indice", "[", "permutacion_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i", ",", "n", ",", "j"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"n", "=", 
          RowBox[{"Length", "[", "permutacion", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Permutations", "[", 
              RowBox[{"Table", "[", 
               RowBox[{"j", ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}], 
             "[", 
             RowBox[{"[", "i", "]"}], "]"}], "!=", "permutacion"}], ",", 
           RowBox[{"i", "++"}]}], "]"}], ";", "\[IndentingNewLine]", "i"}]}], 
       "\[IndentingNewLine]", "]"}]}], ";"}],
    FormatType->StandardForm], 
   StyleBox["\n",
    FormatType->StandardForm], 
   RowBox[{
    StyleBox["(*",
     FormatType->StandardForm], 
    RowBox[{
     RowBox[{"Cap", " ", "4"}], " ", "-", " ", 
     RowBox[{"2.2", " ", "El", " ", "grupo", " ", "sim\[EAcute]trico"}], " ", 
     "-", "  ", 
     RowBox[{"-", " ", "4.13"}]}], 
    StyleBox["*)",
     FormatType->StandardForm]}], 
   StyleBox["\n",
    FormatType->StandardForm], 
   RowBox[{
    RowBox[{"trasposiciones", "[", "ciclo_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"cadena", ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"cadena", "=", "\"\<\>\""}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"cadena", "=", 
          RowBox[{"StringJoin", "[", 
           RowBox[{"cadena", ",", "\"\<(\>\"", ",", 
            RowBox[{"ToString", "[", 
             RowBox[{"ciclo", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", "\"\< \>\"", ",", 
            RowBox[{"ToString", "[", 
             RowBox[{"ciclo", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"Length", "[", "ciclo", "]"}], "-", "i", "+", "1"}], 
               "]"}], "]"}], "]"}], ",", "\"\<)\>\""}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{
            RowBox[{"Length", "[", "ciclo", "]"}], "-", "1"}]}], "}"}]}], 
        "]"}], ";", "\[IndentingNewLine]", "cadena"}]}], 
