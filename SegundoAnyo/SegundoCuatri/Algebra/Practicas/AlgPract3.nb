Cell["III) La signatura de cada permutaci\[OAcute]n.", "Subsubsection",
 CellChangeTimes->{{3.9809994299529953`*^9, 
  3.980999441086439*^9}},ExpressionUUID->"a6ba8144-458e-6746-b802-\
541b862b2396"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"perm", "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "1", ",", "5", ",", "4"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"n", "=", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"k", "=", "32"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"X", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"i", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ciclos", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{"X", "\[NotEqual]", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{
     RowBox[{"primero", "=", 
      RowBox[{"X", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
     ";", "\n", "\t", 
     RowBox[{"imagen", "=", "primero"}], ";", "\n", "\t", 
     RowBox[{"cadena", "=", 
      RowBox[{"{", "primero", "}"}]}], ";", "\n", "\t", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"sigma", "[", 
          RowBox[{"k", ",", "n"}], "]"}], "[", "imagen", "]"}], "\[NotEqual]",
         "primero"}], ",", 
       RowBox[{
        RowBox[{"imagen", "=", 
         RowBox[{
          RowBox[{"sigma", "[", 
           RowBox[{"k", ",", "n"}], "]"}], "[", "imagen", "]"}]}], ";", "\n", 
        "\t\t", 
        RowBox[{"cadena", "=", 
         RowBox[{"Append", "[", 
          RowBox[{"cadena", ",", "imagen"}], "]"}]}]}]}], "]"}], ";", "\n", 
     "\t", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "cadena", "]"}], ">", "1"}], ",", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"ciclos", ",", "cadena"}], "]"}]}], "]"}], ";", "\n", "\t", 
     RowBox[{"X", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{"X", ",", "cadena"}], "]"}]}], ";"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"signatura", "=", "0"}], ";"}], "\n", 
 RowBox[{"Do", "[", 
  RowBox[{
   RowBox[{"signatura", "=", 
    RowBox[{"signatura", "+", 
     RowBox[{"Length", "[", 
      RowBox[{
      "ciclos", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], "]"}],
      "-", "1"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"i", ",", "1", ",", 
     RowBox[{"Length", "[", "ciclos", "]"}]}], "}"}]}], "]"}], "\n", 
 RowBox[{"signatura", "=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"-", "1"}], ")"}], "^", "signatura"}]}]}], "Code",
