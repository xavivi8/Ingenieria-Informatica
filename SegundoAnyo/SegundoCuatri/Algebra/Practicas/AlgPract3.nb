    RowBox[{
     RowBox[{
      RowBox[{"Indice", "[", "permutacion_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"i", ",", "n", ",", "j"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"n", "=", 
          RowBox[{"Length", "[", "permutacion", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"i", "=", "1"}], ";", "\[IndentingNewLine]", 
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Permutations", "[", 
              RowBox[{"Table", "[", 
               RowBox[{"j", ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}], 
             "[", 
             RowBox[{"[", "i", "]"}], "]"}], "!=", "permutacion"}], ",", 
           RowBox[{"i", "++"}]}], "]"}], ";", "\[IndentingNewLine]", "i"}]}], 
       "\[IndentingNewLine]", "]"}]}], ";"}],
    FormatType->StandardForm], 
   StyleBox["\n",
    FormatType->StandardForm], 
   RowBox[{
    StyleBox["(*",
