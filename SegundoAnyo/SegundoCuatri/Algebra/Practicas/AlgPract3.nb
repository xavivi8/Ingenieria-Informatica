    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t", ",", "m", ",", "z"}], "}"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Position", "[", 
         RowBox[{
          RowBox[{"Permutations", "[", 
           RowBox[{"Table", "[", 
            RowBox[{"m", ",", 
             RowBox[{"{", 
              RowBox[{"m", ",", "n"}], "}"}]}], "]"}], "]"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"sigma", "[", 
