Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", "NColoraciones", " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"NCOLORACIONES", "[", 
      RowBox[{"matrizadyacencia_", ",", "lambda_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "coloracionestemp", ",", "t", ",", "h", ",", "i", ",", "j", ",", 
         "colorady", ",", "k"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"coloraciones", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", "k", "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "lambda"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"coloracionestemp", "=", 
            RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Do", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"colorady", "=", 
               RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
              RowBox[{"Do", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"matrizadyacencia", "[", 
                    RowBox[{"[", 
                    RowBox[{"t", ",", "i"}], "]"}], "]"}], "\[Equal]", "1"}], 
                   " ", "\[IndentingNewLine]", ",", 
                   RowBox[{"colorady", "=", 
                    RowBox[{"Union", "[", 
                    RowBox[{"colorady", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"coloraciones", "[", 
                    RowBox[{"[", "h", "]"}], "]"}], "[", 
                    RowBox[{"[", "t", "]"}], "]"}], "}"}]}], "]"}]}]}], "]"}],
                  ";"}], "\[IndentingNewLine]", ",", 
                RowBox[{"{", 
                 RowBox[{"t", ",", 
                  RowBox[{"Length", "[", 
                   RowBox[{"coloraciones", "[", 
                    RowBox[{"[", "h", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{"Do", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Intersection", "[", 
                    RowBox[{
                    RowBox[{"{", "j", "}"}], ",", "colorady"}], "]"}], 
                    "\[Equal]", 
                    RowBox[{"{", "}"}]}], ",", 
                   RowBox[{"AppendTo", "[", 
                    RowBox[{"coloracionestemp", ",", 
                    RowBox[{"Append", "[", 
                    RowBox[{
                    RowBox[{"coloraciones", "[", 
                    RowBox[{"[", "h", "]"}], "]"}], ",", "j"}], "]"}]}], 
                    "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "lambda"}], "}"}]}], "]"}], ";"}], 
             "\[IndentingNewLine]", ",", 
             RowBox[{"{", 
              RowBox[{"h", ",", 
               RowBox[{"Length", "[", "coloraciones", "]"}]}], "}"}]}], "]"}],
            ";", "\[IndentingNewLine]", 
           RowBox[{"coloraciones", "=", "coloracionestemp"}], ";"}], 
          "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "2", ",", 
            RowBox[{
             RowBox[{"Dimensions", "[", "matrizadyacencia", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "coloraciones"}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", "NumeroCromatico", " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"NUMEROCROMATICO", "[", "matrizadyacencia_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"t", "=", "1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"NCOLORACIONES", "[", 
           RowBox[{"matrizadyacencia", ",", "t"}], "]"}], "\[Equal]", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"t", "++"}]}], "]"}], ";", "\[IndentingNewLine]", "t"}]}], 
     "]"}]}], "\n", 
   RowBox[{"(*", " ", "D3", " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"D3", "[", 
     RowBox[{"matrizadyacencia_", ",", "i_", ",", "j_"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"k1", "\[Equal]", "i"}], " ", "&&", " ", 
           RowBox[{"k2", "\[Equal]", "j"}]}], ")"}], "||", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"k1", "\[Equal]", "j"}], " ", "&&", 
           RowBox[{"k2", "\[Equal]", "i"}]}], ")"}]}], ",", "1", ",", 
        RowBox[{"matrizadyacencia", "[", 
         RowBox[{"[", 
          RowBox[{"k1", ",", "k2"}], "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k1", ",", 
        RowBox[{
         RowBox[{"Dimensions", "[", "matrizadyacencia", "]"}], "[", 
