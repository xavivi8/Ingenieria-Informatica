          RowBox[{"W1", "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"grado2", "=", "False"}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Dimensions", "[", "A", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], ">", "2"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"A", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "i"}], "]"}], "]"}], "\[Equal]", "2"}], 
                  " ", "||", " ", 
                  RowBox[{
                   RowBox[{"A", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "i"}], "]"}], "]"}], "\[Equal]", "1"}], 
                  " ", "||", " ", 
                  RowBox[{
                   RowBox[{"A", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "i"}], "]"}], "]"}], "\[Equal]", 
                   "0"}]}], ",", " ", 
                 RowBox[{
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"W1", ",", "i"}], "]"}], ";", 
                  RowBox[{"grado2", "=", "True"}], ";"}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", 
                 RowBox[{
                  RowBox[{"Dimensions", "[", "A", "]"}], "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
              "grado2", ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Sort", "[", "W1", "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"Do", "[", "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"m", "=", 
                    RowBox[{"W1", "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"Length", "[", "W1", "]"}], "-", "k", "+", "1"}], 
                    "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
                   "\[IndentingNewLine]", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Dimensions", "[", "Nueva", "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ">", "2"}], ",", 
                    "\[IndentingNewLine]", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"A", "[", 
                    RowBox[{"[", 
                    RowBox[{"m", ",", "m"}], "]"}], "]"}], "\[Equal]", "2"}], 
                    ",", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{"adyacentes", "=", 
                    RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Do", "[", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Nueva", "[", 
                    RowBox[{"[", 
                    RowBox[{"m", ",", "adya"}], "]"}], "]"}], "\[Equal]", 
                    "1"}], ",", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"adyacentes", ",", "adya"}], "]"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"adya", ",", 
                    RowBox[{
                    RowBox[{"Dimensions", "[", "Nueva", "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Nueva", "=", 
                    RowBox[{"D3", "[", 
                    RowBox[{"Nueva", ",", 
                    RowBox[{"adyacentes", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"adyacentes", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}]}]}], 
                    "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
                    RowBox[{"Nueva", "=", 
                    RowBox[{"Table", "[", "\[IndentingNewLine]", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"k1", "\[GreaterEqual]", "m"}], ",", 
                    RowBox[{"k3", "=", 
                    RowBox[{"k1", "+", "1"}]}], ",", 
                    RowBox[{"k3", "=", "k1"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"k2", "\[GreaterEqual]", "m"}], ",", 
                    RowBox[{"k4", "=", 
                    RowBox[{"k2", "+", "1"}]}], ",", 
                    RowBox[{"k4", "=", "k2"}]}], "]"}], ";", 
                    "\[IndentingNewLine]", 
                    RowBox[{"Nueva", "[", 
                    RowBox[{"[", 
                    RowBox[{"k3", ",", "k4"}], "]"}], "]"}]}], 
                    "\[IndentingNewLine]", ",", 
                    RowBox[{"{", 
                    RowBox[{"k1", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Dimensions", "[", "Nueva", "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "-", "1"}]}], "}"}], ",", 
