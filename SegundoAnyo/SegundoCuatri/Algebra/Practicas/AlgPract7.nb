       RowBox[{"grado2", "=", "True"}], ";", 
       RowBox[{"t", "=", "1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"While", "[", 
        RowBox[{"grado2", ",", "\[IndentingNewLine]", 
