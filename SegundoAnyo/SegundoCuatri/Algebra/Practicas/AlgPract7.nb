     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "grado2", ",", "t", ",", "W1", ",", "A", ",", "i", ",", "k", ",", "m", 
        ",", "adya", ",", "k1", ",", "k2", ",", "k3", ",", "k4", ",", 
        "adyacentes", ",", "j"}], "}"}], ",", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Nueva", "=", "matrizadyacencia"}], ";", "\[IndentingNewLine]", 
