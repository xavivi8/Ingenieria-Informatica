Cell[CellGroupData[{

Cell[TextData[{
 "Ejercicio 2. Sea ",
 Cell[BoxData[
  FormBox[
   RowBox[{"G", " ", "=", 
    RowBox[{
     SubscriptBox["Z", "2"], 
     SubscriptBox["xZ", "2"]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "a69bd6ec-45c7-fe47-90e8-5bfd5f2beb74"]
}], "Subsection",
 CellChangeTimes->{{3.9803971134133835`*^9, 
  3.9803971901591587`*^9}},ExpressionUUID->"d1dd2f65-0a15-844b-b102-\
d3af9393cc90"],

Cell[BoxData[
 RowBox[{
  RowBox[{"G", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", ",", " ", "1"}], "}"}]}], "}"}]}], ";"}]], "Code",
 CellChangeTimes->{3.980398862867626*^9},
 CellLabel->"In[46]:=",ExpressionUUID->"7cd1b6c5-e5ce-bc4d-9227-d456c84aecce"],

Cell[CellGroupData[{

Cell["\<\
A) Definir, si existe, una operaci\[OAcute]n interna * en G donde cada \
elemento sea su propio sim\[EAcute]trico. Demostrar expl\[IAcute]citamente \
que es grupo conmutativo.\
\>", "Subsubsection",
 CellChangeTimes->{{3.980397196993078*^9, 
  3.980397252880743*^9}},ExpressionUUID->"7e78913b-46c5-2740-b59b-\
48ddd2547fef"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"operacio", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{"Grid", "[", "operacio", "]"}]}], "Code",
 CellChangeTimes->{{3.9803987372876034`*^9, 3.980398770926668*^9}, 
   3.9803988785315247`*^9},
 CellLabel->"In[47]:=",ExpressionUUID->"97607dd1-32ff-3e42-9934-6cd8357132b3"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}]},
    {
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}], 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], 
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}]}
   },
   AutoDelete->False,
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}],
  "Grid"]], "Output",
 CellChangeTimes->{3.9803988819487114`*^9},
 CellLabel->"Out[48]=",ExpressionUUID->"ddef662a-c5b9-d44c-8049-a7c4c7c3f8ad"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"op", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"operacio", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"G", ",", "x"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"Position", "[", 
          RowBox[{"G", ",", "y"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"CONMUTATIVA", "[", 
  RowBox[{"G", ",", "operacio"}], "]"}]}], "Code",
 CellChangeTimes->{{3.98039878215143*^9, 3.9803988036366177`*^9}, {
  3.980398892662739*^9, 3.980398895722927*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"af1d71e2-6aca-cd40-92f8-2feec4b9d95e"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9803988965985546`*^9},
 CellLabel->"Out[50]=",ExpressionUUID->"5759a279-ca5a-ee49-9983-ca532c6df135"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["b) Calcular todos los subgrupos de G", "Subsubsection",
 CellChangeTimes->{{3.9803972654880943`*^9, 
  3.980397272790056*^9}},ExpressionUUID->"4f751848-b3cd-3d4d-b5a5-\
bbd6bd9e48a5"],

Cell["\<\
El cardinal de los subgrupos devbe ser divisor del cardinal de G. Por tanto \
los subgrupos tendr\[AAcute]n 1, 2 o 4 elementos. Adem\[AAcute]s, para ser \
subgrupo debe contener al elemento neutro y ser cerrado para las operaciones \
y para los elementos sim\[EAcute]tricos. Por tanto: \
\>", "Text",
 CellChangeTimes->{
  3.980398925710417*^9},ExpressionUUID->"e1aa216f-0e29-2247-9156-\
59b13c92585b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"subgrupos", "=", 
  RowBox[{"Subsets", "[", 
   RowBox[{"G", ",", 
    RowBox[{"{", "4", "}"}]}], "]"}]}], "\n", 
 RowBox[{"subgrupos", "=", 
  RowBox[{"Subsets", "[", 
   RowBox[{"G", ",", 
    RowBox[{"{", "2", "}"}]}], "]"}]}]}], "Code",
 CellChangeTimes->{3.9803987321903515`*^9, 3.98039893110227*^9},
 CellLabel->"In[51]:=",ExpressionUUID->"6315d906-8a2c-8d46-a669-bc64351b0d8d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"0", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "1"}], "}"}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.980398931947571*^9},
 CellLabel->"Out[51]=",ExpressionUUID->"31298d2e-a2a7-6b4b-819f-752d428abd4d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
