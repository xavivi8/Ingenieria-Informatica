            "\[IndentingNewLine]", "simetrico"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"subgrupo", "=", "True"}], ";", "\[IndentingNewLine]", 
        RowBox[{"CONTADORi", "=", "1"}], ";", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
