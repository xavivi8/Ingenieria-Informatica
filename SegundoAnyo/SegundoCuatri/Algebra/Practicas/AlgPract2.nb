                    RowBox[{"[", "CONTADORi", "]"}], "]"}]}], ";", 
                  RowBox[{"Break", "[", "]"}]}]}], "]"}], ";"}], 
              "\[IndentingNewLine]", ",", 
              RowBox[{"{", 
               RowBox[{"CONTADORi", ",", "1", ",", 
