           RowBox[{"[", "1", "]"}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"ElementoNeutro", "=", "\"\<No existe\>\""}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"If", " ", "[", 
            RowBox[{
             RowBox[{"ElementoNeutro", "==", "\"\<No existe\>\""}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"neutro", "=", "True"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Do", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"TrueQ", "[", 
                    RowBox[{
                    RowBox[{"op", "[", 
                    RowBox[{
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORi", "]"}], "]"}], ",", 
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORj", "]"}], "]"}]}], "]"}], "==", 
                    " ", 
                    RowBox[{"op", "[", 
                    RowBox[{
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORj", "]"}], "]"}], ",", 
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORi", "]"}], "]"}]}], "]"}]}], "]"}], 
                    " ", "&&", " ", 
                    RowBox[{"TrueQ", "[", 
                    RowBox[{
                    RowBox[{"op", "[", 
                    RowBox[{
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORi", "]"}], "]"}], ",", 
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORj", "]"}], "]"}]}], "]"}], 
                    "\[Equal]", 
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORj", "]"}], "]"}]}], "]"}]}], ",", 
                   ",", 
                   RowBox[{
                    RowBox[{"neutro", "=", "False"}], ";", 
                    RowBox[{"Break", "[", "]"}]}]}], "]"}], ";"}], 
                "\[IndentingNewLine]", ",", 
                RowBox[{"{", 
                 RowBox[{"CONTADORj", ",", "1", ",", 
                  RowBox[{"Length", "[", "G", "]"}]}], "}"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{"neutro", ",", 
                RowBox[{
                 RowBox[{"ElementoNeutro", "=", 
                  RowBox[{"G", "[", 
                   RowBox[{"[", "CONTADORi", "]"}], "]"}]}], ";", 
                 RowBox[{"Break", "[", "]"}]}]}], "]"}], ";"}]}], 
            "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"CONTADORi", ",", "1", ",", 
            RowBox[{"Length", "[", "G", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"simetrico", "[", "x_", "]"}], ":=", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"simetrico", ",", "CONTADORi"}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"simetrico", "=", "0"}], ";", "\[IndentingNewLine]", 
            RowBox[{"Do", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"op", "[", 
                   RowBox[{"x", ",", 
                    RowBox[{"G", "[", 
                    RowBox[{"[", "CONTADORi", "]"}], "]"}]}], "]"}], 
                  "\[Equal]", "ElementoNeutro"}], ",", 
                 RowBox[{
                  RowBox[{"simetrico", "=", 
