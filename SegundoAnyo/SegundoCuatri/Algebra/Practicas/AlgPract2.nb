   3.980396915026455*^9},ExpressionUUID->"b8ec6aa5-1b92-f74c-822e-\
9daaa8a3201d"],

Cell[CellGroupData[{

Cell["\<\
A) Definir en G=Z6 dos operaciones internas de manera que:
Una, que lo dote de estructura de grupo no conmutativo 
Otra que lo dote de estructura de grupo conmutativo
Hacer todas las comprobaciones expl\[IAcute]citamente\
\>", "Subsubsection",
 CellChangeTimes->{{3.948259532255142*^9, 3.9482596318451385`*^9}, {
   3.948259894229271*^9, 3.948259976446211*^9}, 3.9482601734248257`*^9, {
   3.952601603718918*^9, 3.952601618233303*^9}, {3.9797879993720665`*^9, 
   3.9797881018938313`*^9}, {3.98039691950782*^9, 
   3.980396996934376*^9}},ExpressionUUID->"11fb0259-bd42-604b-8102-\
31a710eacf1b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"p", "[", "x_", "]"}], ":=", 
  RowBox[{"PolynomialMod", "[", 
   RowBox[{
    RowBox[{"32", "+", 
     RowBox[{"80", "x"}], "+", 
     RowBox[{"96", 
      RowBox[{"x", "^", "2"}]}], "+", 
     RowBox[{"64", 
      RowBox[{"x", "^", "3"}]}], "+", 
     RowBox[{"24", 
      RowBox[{"x", "^", "4"}]}], "+", 
     RowBox[{"4", 
      RowBox[{"x", "^", "5"}]}]}], ",", "7"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"q", "[", "x_", "]"}], ":=", 
  RowBox[{"PolynomialMod", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], 
      RowBox[{"x", "^", "3"}]}], "+", 
     RowBox[{"2", 
      RowBox[{"x", "^", "2"}]}], "+", 
     RowBox[{"8", "x"}], "+", "12"}], ",", "7"}], "]"}]}], "\n", 
 RowBox[{"p", "[", "x", "]"}], "\n", 
 RowBox[{"q", "[", "x", "]"}]}], "Code",
 CellChangeTimes->{3.9797880678192787`*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"1abad0b7-3690-4640-bc35-936f3dca8b00"],

Cell[BoxData[
 RowBox[{"4", "+", 
  RowBox[{"3", " ", "x"}], "+", 
  RowBox[{"5", " ", 
   SuperscriptBox["x", "2"]}], "+", 
  SuperscriptBox["x", "3"], "+", 
  RowBox[{"3", " ", 
   SuperscriptBox["x", "4"]}], "+", 
  RowBox[{"4", " ", 
   SuperscriptBox["x", "5"]}]}]], "Output",
 CellChangeTimes->{3.979788075558729*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"11680fc4-f6d7-9349-aa93-07fad2c5f83e"],

Cell[BoxData[
 RowBox[{"5", "+", "x", "+", 
  RowBox[{"2", " ", 
   SuperscriptBox["x", "2"]}], "+", 
  RowBox[{"5", " ", 
   SuperscriptBox["x", "3"]}]}]], "Output",
 CellChangeTimes->{3.979788075564663*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"42e09c11-f401-ed43-bf3b-fff103cdf3cc"]
}, Open  ]]
}, Open  ]],

