      "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"operacion2", "=", 
     RowBox[{"{", "\n", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4", ",", "5"}], 
        "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "4", ",", "5", ",", "2", ",", "3"}], 
        "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"2", ",", "5", ",", "0", ",", "4", ",", "3", ",", "1"}], 
        "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"3", ",", "4", ",", "5", ",", "0", ",", "1", ",", "2"}], 
        "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"4", ",", "3", ",", "1", ",", "2", ",", "5", ",", "0"}], 
        "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"5", ",", "2", ",", "3", ",", "1", ",", "0", ",", "4"}], 
        "}"}]}], "\n", "}"}]}], ";"}]}]}]], "Code",
 CellChangeTimes->{{3.980398213642874*^9, 3.980398225190628*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"91a7fbfd-e35c-a540-a853-ba7fc0611c30"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"op2", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"CONTADORi", ",", "CONTADORj"}], "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"CONTADORi", "=", "1"}], ";", "\n", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Intersection", "[", 
          RowBox[{
           RowBox[{"{", "x", "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
            "G", "\[LeftDoubleBracket]", "CONTADORi", 
             "\[RightDoubleBracket]"}], "}"}]}], "]"}], "\[Equal]", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"CONTADORi", "++"}]}], "]"}], ";", "\n", 
      RowBox[{"CONTADORj", "=", "1"}], ";", "\n", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Intersection", "[", 
          RowBox[{
           RowBox[{"{", "y", "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
            "G", "\[LeftDoubleBracket]", "CONTADORj", 
             "\[RightDoubleBracket]"}], "}"}]}], "]"}], "\[Equal]", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"CONTADORj", "++"}]}], "]"}], ";", "\n", 
      RowBox[{"operacion2", "\[LeftDoubleBracket]", 
       RowBox[{"CONTADORi", ",", "CONTADORj"}], "\[RightDoubleBracket]"}]}]}],
     "\n", "]"}]}], ";"}]], "Code",
 CellChangeTimes->{3.9803982403016872`*^9},
 CellLabel->"In[23]:=",ExpressionUUID->"de165806-b4b2-2444-b7c4-98a8fb062c48"],

