Cell[BoxData[{
 RowBox[{"subgrupos", "=", 
  RowBox[{"Subsets", "[", 
   RowBox[{"G", ",", 
    RowBox[{"{", "4", "}"}]}], "]"}]}], "\n", 
 RowBox[{"subgrupos", "=", 
  RowBox[{"Subsets", "[", 
   RowBox[{"G", ",", 
    RowBox[{"{", "2", "}"}]}], "]"}]}]}], "Code",
 CellChangeTimes->{3.983851209911764*^9},
 CellLabel->"In[66]:=",ExpressionUUID->"ad8c61a5-fc2b-6741-9881-6e09019faeb5"],

