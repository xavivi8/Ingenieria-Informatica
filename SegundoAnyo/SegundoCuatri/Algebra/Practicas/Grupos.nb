Cell[CellGroupData[{

Cell["\<\
II) La descomposici\[OAcute]n en ciclos y transposiciones de cada permutaci\
\[OAcute]n\
\>", "Subsubsection",
 CellChangeTimes->{{3.9803972654880943`*^9, 3.980397272790056*^9}, {
  3.9809993528915176`*^9, 
  3.9809994027340164`*^9}},ExpressionUUID->"2475119d-4b42-2f4b-ac70-\
a325e23f44ac"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"k", "=", "32"}], ";"}], "\n", 
 RowBox[{"n", "=", "5"}], "\n", 
 RowBox[{
  RowBox[{"ciclos", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"X", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"i", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ciclos", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{"X", "\[NotEqual]", 
     RowBox[{"{", "}"}]}], ",", "\n", "\t", 
    RowBox[{
     RowBox[{"primero", "=", 
      RowBox[{"X", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
     ";", "\n", "\t", 
     RowBox[{"imagen", "=", "primero"}], ";", "\n", "\t", 
     RowBox[{"cadena", "=", 
      RowBox[{"{", "primero", "}"}]}], ";", "\n", "\t", 
     RowBox[{"While", " ", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"sigma", "[", 
          RowBox[{"k", ",", "n"}], "]"}], "[", "imagen", "]"}], "\[NotEqual]",
         "primero"}], ",", 
       RowBox[{
        RowBox[{"imagen", "=", 
         RowBox[{
          RowBox[{"sigma", "[", 
           RowBox[{"k", ",", "n"}], "]"}], "[", "imagen", "]"}]}], ";", "\n", 
        "\t\t", 
        RowBox[{"cadena", "=", 
         RowBox[{"Append", "[", 
          RowBox[{"cadena", ",", "imagen"}], "]"}]}]}]}], "]"}], ";", "\n", 
     "\t", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "cadena", "]"}], ">", "1"}], ",", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"ciclos", ",", "cadena"}], "]"}]}], "]"}], ";", "\n", "\t", 
     RowBox[{"X", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{"X", ",", "cadena"}], "]"}]}], ";"}]}], "\n", "\t", "]"}], 
  ";"}], "\n", "ciclos"}], "Code",
 CellChangeTimes->{
  3.9803987321903515`*^9, 3.98039893110227*^9, 3.9809994127403927`*^9, {
   3.981002324438778*^9, 3.981002338612383*^9}},
