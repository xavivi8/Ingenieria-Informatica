Cell[BoxData[{"\"\<Paridad\>\"", "\n", 
 RowBox[{"Signature", "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "4", ",", "3", ",", "5"}], "}"}], 
  "]"}], "\n", "\"\<Inversion\>\"", "\n", 
 RowBox[{
  RowBox[{"permutacion", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "4", ",", "3", ",", "5"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"inversion", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", "\n", "\t", 
   RowBox[{
    RowBox[{
     RowBox[{"Do", "[", "\n", "\t\t", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"i", "<", "j"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{
            "permutacion", "\[LeftDoubleBracket]", "j", 
             "\[RightDoubleBracket]"}], "<", " ", 
            RowBox[{
            "permutacion", "\[LeftDoubleBracket]", "i", 
             "\[RightDoubleBracket]"}]}]}], ",", 
          RowBox[{"inversion", "++"}]}], "]"}], ";"}], "\n", "\t", ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "i", ",", 
         RowBox[{"Length", "[", "permutacion", "]"}]}], "}"}]}], "]"}], ";"}],
     "\n", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "permutacion", "]"}]}], "}"}]}], "]"}], 
  ";"}], "\n", "inversion"}], "Code",
 CellChangeTimes->{{3.981604473274082*^9, 3.9816044866393566`*^9}, {
