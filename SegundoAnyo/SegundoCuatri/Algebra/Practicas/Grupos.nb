      "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"operacion2", "=", 
     RowBox[{"{", "\n", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "2", ",", "3", ",", "4", ",", "5"}], 
        "}"}], ",", "\n", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "4", ",", "5", ",", "2", ",", "3"}], 
        "}"}], ",", "\n", 
       RowBox[{"{", 
