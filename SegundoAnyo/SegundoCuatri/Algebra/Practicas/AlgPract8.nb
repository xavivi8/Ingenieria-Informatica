Cell["\<\
Una matriz es sim\[EAcute]trica si es igual a su traspuesta 
Una matriz es antisim\[EAcute]trica si es igual a la opuesta de su traspuesta\
\>", "Text",
 CellChangeTimes->{{3.9872427728781624`*^9, 
  3.9872427761241417`*^9}},ExpressionUUID->"f7cd2dc6-5f93-784a-b487-\
26eace11ab17"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
