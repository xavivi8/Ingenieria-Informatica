Cell["\<\
Ejercicio 3 rel 3\[LineSeparator]Estudiar si las matrices siguientes son sim\
\[EAcute]tricas o antisim\[EAcute]tricas\
\>", "Subsection",
 CellChangeTimes->{{3.9872426188737297`*^9, 
  3.987242658720049*^9}},ExpressionUUID->"e9fdf7fa-6b78-7c4d-9aa0-\
b5d775ca8405"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"aPract8Eje3Rel3", "=", 
   RowBox[{"(", GridBox[{
      {"1", "2", "3"},
      {"2", "2", "5"},
      {"3", "5", "7"}
     }], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bPract8Eje3Rel3", "=", 
   RowBox[{"(", GridBox[{
      {"1", "2", "4"},
      {"2", "2", "5"},
      {"3", "5", "7"}
     }], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cPract8Eje3Rel3", "=", 
   RowBox[{"(", GridBox[{
      {"0", "2", "3"},
      {
       RowBox[{"-", "2"}], "0", "5"},
      {
       RowBox[{"-", "3"}], 
       RowBox[{"-", "5"}], "0"}
     }], ")"}]}], ";"}]}], "Code",
