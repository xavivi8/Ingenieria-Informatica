Cell["\<\
El anillo de matrices cuadradas no es conmutativo porque A.B \[NotEqual] B.A.

Adem\[AAcute]s, tiene divisores de cero porque C y D son matrices no nulas, \
pero C.D es la matriz cero.\
\>", "Text",
 CellChangeTimes->{
  3.9872441555444317`*^9},ExpressionUUID->"0880a8a8-05e8-d046-8848-\
c3fe7e8ea8e7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Ejercicio 9 rel 3
Calcular los determinantes para las matrices:\
\>", "Subsection",
 CellChangeTimes->{{3.9872431651563835`*^9, 
  3.987243190180893*^9}},ExpressionUUID->"2bc24929-d7ee-a64d-9865-\
2475e4c767f3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"aPract8Eje9Rel3", "=", 
   RowBox[{"(", GridBox[{
      {"0", 
       RowBox[{"-", "1"}], "0", "2"},
      {"4", 
       RowBox[{"-", "3"}], "0", "6"},
      {"4", "4", "1", "3"},
      {"3", "5", 
       RowBox[{"-", "6"}], "0"}
     }], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bPract8Eje9Rel3", "=", 
   RowBox[{"(", GridBox[{
      {"1", 
       RowBox[{"2", "-", "I"}], 
       RowBox[{
        RowBox[{"-", "1"}], "+", 
        RowBox[{"2", "I"}]}]},
      {"1", "2", 
       RowBox[{
        RowBox[{"-", "2"}], "+", "I"}]},
      {
       RowBox[{"-", "1"}], 
       RowBox[{
        RowBox[{"-", "2"}], "+", "I"}], 
       RowBox[{"2", "-", 
        RowBox[{"2", "I"}]}]}
     }], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cPract8Eje9Rel3", "=", 
   RowBox[{"(", GridBox[{
      {
       RowBox[{"-", "4"}], "1", "1", "1", "1"},
      {"1", 
       RowBox[{"-", "4"}], "1", "1", "1"},
      {"1", "1", 
       RowBox[{"-", "4"}], "1", "1"},
      {"1", "1", "1", 
       RowBox[{"-", "4"}], "1"},
      {"1", "1", "1", "1", 
       RowBox[{"-", "4"}]}
     }], ")"}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.987243211834198*^9, 3.987243343841667*^9}},
 CellLabel->"In[67]:=",ExpressionUUID->"2d14d56f-527e-5d4d-8761-bf465ecada05"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Det", "[", "aPract8Eje9Rel3", "]"}], "\n", 
 RowBox[{"Det", "[", "bPract8Eje9Rel3", "]"}], "\n", 
 RowBox[{"Det", "[", "cPract8Eje9Rel3", "]"}]}], "Code",
 CellChangeTimes->{{3.987243352764599*^9, 3.9872433713472958`*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"5a824748-1e3a-3649-b9ed-99caa4249281"],

