 "- Rango(A)\n1) MatrixRank[A]\n2) RowReduce[A]\n- Inversa:\n1) Inverse[A]\n\
2) (A|I)\n3) ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["A", 
    RowBox[{"-", "1"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "385dcc0f-e2ad-b246-b38d-4192337959dc"],
 " = ",
