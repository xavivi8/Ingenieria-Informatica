      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "==", "b"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "y", ",", "z"}], "}"}]}], "]"}], "\n", 
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"a", ".", 
     RowBox[{"{", 
