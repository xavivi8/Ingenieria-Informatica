Cell[CellGroupData[{

Cell["\<\
Ejercicio 3 rel 3\[LineSeparator]Estudiar si las matrices siguientes son sim\
\[EAcute]tricas o antisim\[EAcute]tricas\
\>", "Subsection",
 CellChangeTimes->{{3.9872426188737297`*^9, 
  3.987242658720049*^9}},ExpressionUUID->"e9fdf7fa-6b78-7c4d-9aa0-\
b5d775ca8405"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"aPract8Eje3Rel3", "=", 
   RowBox[{"(", GridBox[{
      {"1", "2", "3"},
      {"2", "2", "5"},
      {"3", "5", "7"}
     }], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bPract8Eje3Rel3", "=", 
   RowBox[{"(", GridBox[{
      {"1", "2", "4"},
      {"2", "2", "5"},
      {"3", "5", "7"}
     }], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"cPract8Eje3Rel3", "=", 
   RowBox[{"(", GridBox[{
      {"0", "2", "3"},
      {
       RowBox[{"-", "2"}], "0", "5"},
      {
       RowBox[{"-", "3"}], 
       RowBox[{"-", "5"}], "0"}
     }], ")"}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.9872426633042774`*^9, 3.9872427524836655`*^9}, {
  3.987242876849516*^9, 3.9872428771669674`*^9}},
 CellLabel->"In[95]:=",ExpressionUUID->"d67b9497-a666-c544-8fd6-533095d8e589"],

Cell["\<\
Una matriz es sim\[EAcute]trica si es igual a su traspuesta 
Una matriz es antisim\[EAcute]trica si es igual a la opuesta de su traspuesta\
\>", "Text",
 CellChangeTimes->{{3.9872427728781624`*^9, 
  3.9872427761241417`*^9}},ExpressionUUID->"f7cd2dc6-5f93-784a-b487-\
