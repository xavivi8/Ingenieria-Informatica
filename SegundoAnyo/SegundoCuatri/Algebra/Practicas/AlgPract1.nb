Cell[CellGroupData[{

Cell["\<\
B) Razonar la veracidad o falsedad de la siguiente afirmaci\[OAcute]n: \
\[OpenCurlyDoubleQuote]En el anillo Z7[x] de polinomio 2x^3 -2x^2-8x-12 es \
irreducible\[CloseCurlyDoubleQuote].\
\>", "Subsubsection",
 CellChangeTimes->{{3.9797882705060387`*^9, 3.9797883521119385`*^9}, 
   3.979788576403473*^9, {3.9797898047356815`*^9, 
   3.979789811449127*^9}},ExpressionUUID->"bf95f0e6-299b-d041-b509-\
4a1a2edb9247"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"r", "[", "x_", "]"}], ":=", 
  RowBox[{"PolynomialMod", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"2", 
      SuperscriptBox["x", "3"]}], "-", 
     RowBox[{"2", 
      SuperscriptBox["x", "2"]}], "-", 
     RowBox[{"8", "x"}], "-", "12"}], ",", "7"}], "]"}]}], "\n", 
 RowBox[{"r", "[", "x", "]"}]}], "Code",
 CellChangeTimes->{{3.9797884622243557`*^9, 3.9797884762729187`*^9}, {
  3.979788513758032*^9, 3.979788517608843*^9}, {3.979788573700981*^9, 
  3.9797886175995865`*^9}, {3.9797897915117702`*^9, 3.9797897939710674`*^9}},
