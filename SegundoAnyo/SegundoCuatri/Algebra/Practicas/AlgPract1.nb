   RowBox[{
    RowBox[{
     RowBox[{"2", 
      SuperscriptBox["x", "3"]}], "-", 
     RowBox[{"2", 
      SuperscriptBox["x", "2"]}], "-", 
     RowBox[{"8", "x"}], "-", "12"}], ",", "7"}], "]"}]}], "\n", 
 RowBox[{"r", "[", "x", "]"}]}], "Code",
