9daaa8a3201d"],

Cell[CellGroupData[{

Cell["\<\
A) Aplicar si es posible, el algoritmo de Euclides para calcular en Z7[X] \
divisor de los polinomios
p(x)=32+80x+96x^2+64x^3+24x^4+4x^5
q(x)=-2x^3+2x^2+8x+12\
\>", "Subsubsection",
 CellChangeTimes->{{3.948259532255142*^9, 3.9482596318451385`*^9}, {
   3.948259894229271*^9, 3.948259976446211*^9}, 3.9482601734248257`*^9, {
   3.952601603718918*^9, 3.952601618233303*^9}, {3.9797879993720665`*^9, 
   3.9797881018938313`*^9}},ExpressionUUID->"11fb0259-bd42-604b-8102-\
31a710eacf1b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"p", "[", "x_", "]"}], ":=", 
  RowBox[{"PolynomialMod", "[", 
   RowBox[{
    RowBox[{"32", "+", 
     RowBox[{"80", "x"}], "+", 
     RowBox[{"96", 
      RowBox[{"x", "^", "2"}]}], "+", 
     RowBox[{"64", 
      RowBox[{"x", "^", "3"}]}], "+", 
     RowBox[{"24", 
      RowBox[{"x", "^", "4"}]}], "+", 
     RowBox[{"4", 
      RowBox[{"x", "^", "5"}]}]}], ",", "7"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"q", "[", "x_", "]"}], ":=", 
  RowBox[{"PolynomialMod", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], 
      RowBox[{"x", "^", "3"}]}], "+", 
     RowBox[{"2", 
      RowBox[{"x", "^", "2"}]}], "+", 
     RowBox[{"8", "x"}], "+", "12"}], ",", "7"}], "]"}]}], "\n", 
 RowBox[{"p", "[", "x", "]"}], "\n", 
 RowBox[{"q", "[", "x", "]"}]}], "Code",
 CellChangeTimes->{3.9797880678192787`*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"1abad0b7-3690-4640-bc35-936f3dca8b00"],

Cell[BoxData[
 RowBox[{"4", "+", 
  RowBox[{"3", " ", "x"}], "+", 
  RowBox[{"5", " ", 
   SuperscriptBox["x", "2"]}], "+", 
  SuperscriptBox["x", "3"], "+", 
  RowBox[{"3", " ", 
   SuperscriptBox["x", "4"]}], "+", 
  RowBox[{"4", " ", 
   SuperscriptBox["x", "5"]}]}]], "Output",
 CellChangeTimes->{3.979788075558729*^9, 3.9850752731011124`*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"02326011-3de2-1d4d-821a-686e2f62bfe5"],

Cell[BoxData[
 RowBox[{"5", "+", "x", "+", 
  RowBox[{"2", " ", 
   SuperscriptBox["x", "2"]}], "+", 
  RowBox[{"5", " ", 
   SuperscriptBox["x", "3"]}]}]], "Output",
 CellChangeTimes->{3.979788075558729*^9, 3.9850752731036816`*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"d7c6a272-f415-0f4e-af49-5cf1340e854b"]
}, Open  ]],

