}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
B) Razonar la veracidad o falsedad de la siguiente afirmaci\[OAcute]n: \
\[OpenCurlyDoubleQuote]En el anillo Z7[x] de polinomio 2x^3 -2x^2-8x-12 es \
irreducible\[CloseCurlyDoubleQuote].\
\>", "Subsubsection",
 CellChangeTimes->{{3.9797882705060387`*^9, 3.9797883521119385`*^9}, 
   3.979788576403473*^9, {3.9797898047356815`*^9, 
