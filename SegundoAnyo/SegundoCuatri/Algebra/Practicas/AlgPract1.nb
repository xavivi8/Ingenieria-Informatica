Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Euclides2", "[", "m_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"p", ",", "q", ",", "d"}], "}"}], ",", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "m", "]"}], "\[Equal]", "3"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"p", "[", "x_", "]"}], ":=", 
           RowBox[{"PolynomialMod", "[", 
            RowBox[{
             RowBox[{"m", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"m", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"q", "[", "x_", "]"}], ":=", 
           RowBox[{"PolynomialMod", "[", 
            RowBox[{
             RowBox[{"m", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", 
             RowBox[{"m", "[", 
              RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"d", "[", "x_", "]"}], ":=", 
           RowBox[{"PolynomialQuotientRemainder", "[", 
            RowBox[{
             RowBox[{"p", "[", "x", "]"}], ",", 
             RowBox[{"q", "[", "x", "]"}], ",", "x", ",", 
             RowBox[{"Modulus", "\[Rule]", 
              RowBox[{"m", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}]}], "]"}]}], ";"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"p", "[", "x_", "]"}], ":=", 
           RowBox[{"m", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", 
          RowBox[{
           RowBox[{"q", "[", "x_", "]"}], ":=", 
           RowBox[{"m", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"d", "[", "x_", "]"}], ":=", 
           RowBox[{"PolynomialQuotientRemainder", "[", 
            RowBox[{
             RowBox[{"p", "[", "x", "]"}], ",", 
             RowBox[{"q", "[", "x", "]"}], ",", "x"}], "]"}]}], ";"}]}], 
        "]"}], ";", 
       RowBox[{"Print", "[", 
        RowBox[{
         RowBox[{"p", "[", "x", "]"}], ",", "\"\< = (\>\"", ",", 
         RowBox[{"q", "[", "x", "]"}], ",", "\"\<) \[CenterDot] (\>\"", ",", 
         RowBox[{
          RowBox[{"d", "[", "x", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<) \n+\>\"", ",", 
         RowBox[{
          RowBox[{"d", "[", "x", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ";", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Exponent", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"d", "[", "x", "]"}], "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", "x"}], "]"}], "<", "0"}], 
         ",", 
         RowBox[{
          RowBox[{
          "Print", "[", "\"\<El m\[AAcute]ximo com\[UAcute]n divisor es\>\"", 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"Return", "[", 
           RowBox[{"q", "[", "x", "]"}], "]"}]}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "m", "]"}], "\[Equal]", "3"}], ",", 
           RowBox[{"Euclides2", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"q", "[", "x", "]"}], ",", 
              RowBox[{
               RowBox[{"d", "[", "x", "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"m", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}], "}"}], "]"}], ",", 
           RowBox[{"Euclides2", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"q", "[", "x", "]"}], ",", 
              RowBox[{
               RowBox[{"d", "[", "x", "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}]}], "]"}]}], 
        "]"}]}]}], "]"}]}], ";"}]}]], "Code",
 CellLabel->"In[40]:=",ExpressionUUID->"b05af692-d8ff-e846-9cff-70c9b8ca7ea0"],

Cell[CellGroupData[{

Cell["Ejercicio 1. A) Ordinaria 2 del curso 24/25", "Subsection",
 CellChangeTimes->{{3.948259428170553*^9, 3.9482594931084175`*^9}, {
  3.9482595294641857`*^9, 3.948259530297287*^9}, {3.948260255955908*^9, 
  3.9482602708542137`*^9}, {3.979787985707634*^9, 
  3.979787987705902*^9}},ExpressionUUID->"b8ec6aa5-1b92-f74c-822e-\
9daaa8a3201d"],

Cell[CellGroupData[{

Cell["\<\
A) Aplicar si es posible, el algoritmo de Euclides para calcular en Z7[X] \
divisor de los polinomios
p(x)=32+80x+96x^2+64x^3+24x^4+4x^5
q(x)=-2x^3+2x^2+8x+12\
\>", "Subsubsection",
 CellChangeTimes->{{3.948259532255142*^9, 3.9482596318451385`*^9}, {
   3.948259894229271*^9, 3.948259976446211*^9}, 3.9482601734248257`*^9, {
   3.952601603718918*^9, 3.952601618233303*^9}, {3.9797879993720665`*^9, 
   3.9797881018938313`*^9}},ExpressionUUID->"11fb0259-bd42-604b-8102-\
31a710eacf1b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"p", "[", "x_", "]"}], ":=", 
  RowBox[{"PolynomialMod", "[", 
   RowBox[{
    RowBox[{"32", "+", 
     RowBox[{"80", "x"}], "+", 
     RowBox[{"96", 
      RowBox[{"x", "^", "2"}]}], "+", 
     RowBox[{"64", 
      RowBox[{"x", "^", "3"}]}], "+", 
     RowBox[{"24", 
      RowBox[{"x", "^", "4"}]}], "+", 
     RowBox[{"4", 
      RowBox[{"x", "^", "5"}]}]}], ",", "7"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"q", "[", "x_", "]"}], ":=", 
  RowBox[{"PolynomialMod", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], 
      RowBox[{"x", "^", "3"}]}], "+", 
     RowBox[{"2", 
      RowBox[{"x", "^", "2"}]}], "+", 
     RowBox[{"8", "x"}], "+", "12"}], ",", "7"}], "]"}]}], "\n", 
 RowBox[{"p", "[", "x", "]"}], "\n", 
 RowBox[{"q", "[", "x", "]"}]}], "Code",
 CellChangeTimes->{3.9797880678192787`*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"1abad0b7-3690-4640-bc35-936f3dca8b00"],

Cell[BoxData[
 RowBox[{"4", "+", 
  RowBox[{"3", " ", "x"}], "+", 
  RowBox[{"5", " ", 
   SuperscriptBox["x", "2"]}], "+", 
  SuperscriptBox["x", "3"], "+", 
  RowBox[{"3", " ", 
   SuperscriptBox["x", "4"]}], "+", 
  RowBox[{"4", " ", 
   SuperscriptBox["x", "5"]}]}]], "Output",
 CellChangeTimes->{3.979788075558729*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"11680fc4-f6d7-9349-aa93-07fad2c5f83e"],

Cell[BoxData[
 RowBox[{"5", "+", "x", "+", 
  RowBox[{"2", " ", 
   SuperscriptBox["x", "2"]}], "+", 
  RowBox[{"5", " ", 
   SuperscriptBox["x", "3"]}]}]], "Output",
 CellChangeTimes->{3.979788075564663*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"42e09c11-f401-ed43-bf3b-fff103cdf3cc"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"c1", "[", "x_", "]"}], ":=", 
  RowBox[{"PolynomialMod", "[", 
   RowBox[{
    RowBox[{"PolynomialQuotient", "[", 
     RowBox[{
      RowBox[{"p", "[", "x", "]"}], ",", 
      RowBox[{"q", "[", "x", "]"}], ",", "x"}], "]"}], ",", "7"}], 
