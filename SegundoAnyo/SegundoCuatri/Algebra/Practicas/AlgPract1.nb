Cell[CellGroupData[{

Cell["Pr\[AAcute]ctica 1", "Section",
 CellChangeTimes->{{3.9355791003871403`*^9, 3.935579106140892*^9}, {
  3.9482593405840073`*^9, 
  3.9482593406950645`*^9}},ExpressionUUID->"3797e760-1388-0541-b35f-\
def2ba04bb89"],

Cell[BoxData[
 RowBox[{"\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Euclides2", "[", "m_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", "q", ",", "d"}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "m", "]"}], "\[Equal]", "3"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"p", "[", "x_", "]"}], ":=", 
            RowBox[{"PolynomialMod", "[", 
             RowBox[{
              RowBox[{"m", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"m", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"q", "[", "x_", "]"}], ":=", 
            RowBox[{"PolynomialMod", "[", 
             RowBox[{
              RowBox[{"m", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"m", "[", 
               RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"d", "[", "x_", "]"}], ":=", 
            RowBox[{"PolynomialQuotientRemainder", "[", 
             RowBox[{
              RowBox[{"p", "[", "x", "]"}], ",", 
              RowBox[{"q", "[", "x", "]"}], ",", "x", ",", 
              RowBox[{"Modulus", "\[Rule]", 
               RowBox[{"m", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}]}], "]"}]}], ";"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"p", "[", "x_", "]"}], ":=", 
            RowBox[{"m", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ";", 
           RowBox[{
            RowBox[{"q", "[", "x_", "]"}], ":=", 
            RowBox[{"m", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"d", "[", "x_", "]"}], ":=", 
            RowBox[{"PolynomialQuotientRemainder", "[", 
             RowBox[{
              RowBox[{"p", "[", "x", "]"}], ",", 
              RowBox[{"q", "[", "x", "]"}], ",", "x"}], "]"}]}], ";"}]}], 
         "]"}], ";", 
        RowBox[{"Print", "[", 
         RowBox[{
          RowBox[{"p", "[", "x", "]"}], ",", "\"\< = (\>\"", ",", 
          RowBox[{"q", "[", "x", "]"}], ",", "\"\<) \[CenterDot] (\>\"", ",", 
          RowBox[{
           RowBox[{"d", "[", "x", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<) \n+\>\"", ",", 
          RowBox[{
           RowBox[{"d", "[", "x", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ";", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Exponent", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"d", "[", "x", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", "x"}], "]"}], "<", "0"}], 
          ",", 
          RowBox[{
           RowBox[{
           "Print", "[", "\"\<El m\[AAcute]ximo com\[UAcute]n divisor es\>\"",
             "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", 
            RowBox[{"q", "[", "x", "]"}], "]"}]}], ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "m", "]"}], "\[Equal]", "3"}], ",", 
            RowBox[{"Euclides2", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"q", "[", "x", "]"}], ",", 
               RowBox[{
                RowBox[{"d", "[", "x", "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], ",", 
               RowBox[{"m", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}], "}"}], "]"}], ",", 
            RowBox[{"Euclides2", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"q", "[", "x", "]"}], ",", 
               RowBox[{
                RowBox[{"d", "[", "x", "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "]"}]}], "]"}]}], 
         "]"}]}]}], "]"}]}], ";"}], "\n"}]}]], "Code",
 CellChangeTimes->{{3.9492162409738464`*^9, 3.949216245069351*^9}, 
   3.952601575672573*^9},ExpressionUUID->"4e337985-8ae0-7047-9824-\
81b38c95c08c"],

Cell[CellGroupData[{

Cell["Ejercicio 1. A) Ordinaria 2 del curso 24/25", "Subsection",
 CellChangeTimes->{{3.948259428170553*^9, 3.9482594931084175`*^9}, {
  3.9482595294641857`*^9, 3.948259530297287*^9}, {3.948260255955908*^9, 
  3.9482602708542137`*^9}, {3.979787985707634*^9, 
  3.979787987705902*^9}},ExpressionUUID->"b8ec6aa5-1b92-f74c-822e-\
9daaa8a3201d"],

Cell[CellGroupData[{

Cell["\<\
A) Aplicar si es posible, el algoritmo de Euclides para calcular en Z7[X] \
divisor de los polinomios
p(x)=32+80x+96x^2+64x^3+24x^4+4x^5
q(x)=-2x^3+2x^2+8x+12\
\>", "Subsubsection",
 CellChangeTimes->{{3.948259532255142*^9, 3.9482596318451385`*^9}, {
   3.948259894229271*^9, 3.948259976446211*^9}, 3.9482601734248257`*^9, {
   3.952601603718918*^9, 3.952601618233303*^9}, {3.9797879993720665`*^9, 
   3.9797881018938313`*^9}},ExpressionUUID->"11fb0259-bd42-604b-8102-\
31a710eacf1b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"p", "[", "x_", "]"}], ":=", 
  RowBox[{"PolynomialMod", "[", 
   RowBox[{
    RowBox[{"32", "+", 
     RowBox[{"80", "x"}], "+", 
     RowBox[{"96", 
      RowBox[{"x", "^", "2"}]}], "+", 
     RowBox[{"64", 
      RowBox[{"x", "^", "3"}]}], "+", 
     RowBox[{"24", 
      RowBox[{"x", "^", "4"}]}], "+", 
     RowBox[{"4", 
      RowBox[{"x", "^", "5"}]}]}], ",", "7"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"q", "[", "x_", "]"}], ":=", 
  RowBox[{"PolynomialMod", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], 
      RowBox[{"x", "^", "3"}]}], "+", 
     RowBox[{"2", 
      RowBox[{"x", "^", "2"}]}], "+", 
     RowBox[{"8", "x"}], "+", "12"}], ",", "7"}], "]"}]}], "\n", 
 RowBox[{"p", "[", "x", "]"}], "\n", 
 RowBox[{"q", "[", "x", "]"}]}], "Code",
 CellChangeTimes->{3.9797880678192787`*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"1abad0b7-3690-4640-bc35-936f3dca8b00"],

Cell[BoxData[
 RowBox[{"4", "+", 
  RowBox[{"3", " ", "x"}], "+", 
  RowBox[{"5", " ", 
   SuperscriptBox["x", "2"]}], "+", 
  SuperscriptBox["x", "3"], "+", 
  RowBox[{"3", " ", 
   SuperscriptBox["x", "4"]}], "+", 
  RowBox[{"4", " ", 
   SuperscriptBox["x", "5"]}]}]], "Output",
 CellChangeTimes->{3.979788075558729*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"11680fc4-f6d7-9349-aa93-07fad2c5f83e"],

Cell[BoxData[
 RowBox[{"5", "+", "x", "+", 
  RowBox[{"2", " ", 
   SuperscriptBox["x", "2"]}], "+", 
  RowBox[{"5", " ", 
   SuperscriptBox["x", "3"]}]}]], "Output",
 CellChangeTimes->{3.979788075564663*^9},
 CellLabel->"Out[4]=",ExpressionUUID->"42e09c11-f401-ed43-bf3b-fff103cdf3cc"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"c1", "[", "x_", "]"}], ":=", 
  RowBox[{"PolynomialMod", "[", 
   RowBox[{
    RowBox[{"PolynomialQuotient", "[", 
     RowBox[{
      RowBox[{"p", "[", "x", "]"}], ",", 
      RowBox[{"q", "[", "x", "]"}], ",", "x"}], "]"}], ",", "7"}], 
   "]"}]}], "\n", 
 RowBox[{
  RowBox[{"r1", "[", "x_", "]"}], ":=", 
  RowBox[{"PolynomialMod", "[", 
   RowBox[{
    RowBox[{"PolynomialRemainder", "[", 
     RowBox[{
      RowBox[{"p", "[", "x", "]"}], ",", 
      RowBox[{"q", "[", "x", "]"}], ",", "x"}], "]"}], ",", "7"}], 
   "]"}]}], "\n", 
 RowBox[{"c1", "[", "x", "]"}], "\n", 
 RowBox[{"r1", "[", "x", "]"}]}], "Code",
 CellChangeTimes->{{3.979788125482252*^9, 3.9797881382343273`*^9}, {
  3.9797881937269096`*^9, 3.9797882006319294`*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"f41b9ee1-5daa-b34d-8f49-2d5e60d208dc"],

Cell[BoxData[
 RowBox[{"2", "+", 
  RowBox[{"5", " ", 
   SuperscriptBox["x", "2"]}]}]], "Output",
 CellChangeTimes->{
  3.9797881291923733`*^9, {3.979788167595997*^9, 3.9797882021237583`*^9}},
 CellLabel->"Out[23]=",ExpressionUUID->"d0627ac3-7b26-3f4e-b8e3-7e66c1777ea0"],

Cell[BoxData[
 RowBox[{"1", "+", "x", "+", 
  RowBox[{"4", " ", 
   SuperscriptBox["x", "2"]}]}]], "Output",
 CellChangeTimes->{
  3.9797881291923733`*^9, {3.979788167595997*^9, 3.9797882021274204`*^9}},
 CellLabel->"Out[24]=",ExpressionUUID->"edad5188-fb2a-ff47-a8fd-8dcd2abd829f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"c2", "[", "x_", "]"}], ":=", 
  RowBox[{"PolynomialMod", "[", 
   RowBox[{
    RowBox[{"PolynomialQuotient", "[", 
     RowBox[{
      RowBox[{"q", "[", "x", "]"}], ",", 
      RowBox[{"r1", "[", "x", "]"}], ",", "x"}], "]"}], ",", "7"}], 
   "]"}]}], "\n", 
 RowBox[{
  RowBox[{"r2", "[", "x_", "]"}], ":=", 
  RowBox[{"PolynomialMod", "[", 
   RowBox[{
    RowBox[{"PolynomialRemainder", "[", 
     RowBox[{
      RowBox[{"q", "[", "x", "]"}], ",", 
      RowBox[{"r1", "[", "x", "]"}], ",", "x"}], "]"}], ",", "7"}], 
   "]"}]}], "\n", 
 RowBox[{"c2", "[", "x", "]"}], "\n", 
 RowBox[{"r2", "[", "x", "]"}]}], "Code",
 CellChangeTimes->{{3.979788137012123*^9, 3.9797881635260506`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"c349a5a6-9ec7-d640-a226-656d81429e1c"],

Cell[BoxData[
 RowBox[{"5", "+", 
  RowBox[{"3", " ", "x"}]}]], "Output",
 CellChangeTimes->{3.9797881644969845`*^9, 3.979788207381529*^9},
 CellLabel->"Out[27]=",ExpressionUUID->"e98a2288-f64d-b640-8209-b950d91f41b7"],

