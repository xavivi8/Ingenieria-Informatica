 RowBox[{"Clear", "[", 
  RowBox[{"G", ",", "PE", ",", "B"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"G", "=", 
   RowBox[{"(", GridBox[{
      {"1", 
       RowBox[{"-", "2"}]},
      {
       RowBox[{"-", "2"}], "9"}
     }], ")"}]}], ";"}], "\n", 
 RowBox[{"G", " ", "\[Equal]", " ", 
