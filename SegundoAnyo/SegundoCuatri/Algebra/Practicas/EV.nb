Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Sesion", " ", "11"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Coordenadas", "[", 
      RowBox[{"X_", ",", "B_"}], "]"}], ":=", 
     RowBox[{"LinearSolve", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", "B", "]"}], ",", "X"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Sesion", " ", "12"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Param\[EAcute]tricas", "[", "Base_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Parte1", ",", "param\[EAcute]tricas"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Clear", "[", "\[Lambda]", "]"}], ";", 
        RowBox[{"(*", 
         RowBox[{"Borramos", " ", "las", " ", "variables", " ", 
          RowBox[{"\[Lambda]", "[", "i", "]"}], " ", "para", " ", "que", " ", 
          "sean", " ", "los", " ", "par\[AAcute]metros"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"Parte1", "=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"\[Lambda]", "[", "i", "]"}], "*", 
            RowBox[{"Base", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "Base", "]"}]}], "}"}]}], "]"}]}], ";", 
        " ", 
        RowBox[{"(*", 
         RowBox[{
         "Coordenada", " ", "a", " ", "coordenada", " ", "se", " ", "hace", 
          " ", "el", " ", "c\[AAcute]lculo"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"param\[EAcute]tricas", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"param\[EAcute]tricas", ",", 
             RowBox[{
              RowBox[{"Subscript", "[", 
               RowBox[{"x", ",", "i"}], "]"}], "\[Equal]", 
              RowBox[{"Parte1", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}], ";"}], " ", 
          RowBox[{"(*", 
           RowBox[{
           "A\[NTilde]adimos", " ", "la", " ", "ecuaci\[OAcute]n", " ", 
            "param\[EAcute]trica"}], "*)"}], "\n", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", 
             RowBox[{"Base", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", "param\[EAcute]tricas"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Sesi\[OAcute]n", " ", "12"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Impl\[IAcute]citas", "[", "Base_", "]"}], ":=", 
     RowBox[{"Eliminate", "[", 
      RowBox[{
       RowBox[{"Param\[EAcute]tricas", "[", "Base", "]"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"\[Lambda]", "[", "i", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "Base", "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"sesi\[OAcute]n", " ", "9"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Base2", "[", "Generadores_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"base", ",", "hermite", ",", "vectorcero"}], "}"}], ",", 
       RowBox[{
        RowBox[{"base", "=", 
         RowBox[{"{", "}"}]}], ";", 
        RowBox[{"hermite", "=", 
         RowBox[{"RowReduce", "[", "Generadores", "]"}]}], ";", "\n", 
        "\t\t\t\t\t\t\t", 
        RowBox[{"vectorcero", "=", 
         RowBox[{"Table", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{
              RowBox[{"Dimensions", "[", "Generadores", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"hermite", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "\[Equal]", "vectorcero"}], 
             ",", 
             RowBox[{
              RowBox[{"Break", "[", "]"}], ";"}], ",", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"base", ",", 
                RowBox[{"hermite", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "]"}], ";"}]}], "]"}], 
           ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{
             RowBox[{"Dimensions", "[", "Generadores", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ";", 
