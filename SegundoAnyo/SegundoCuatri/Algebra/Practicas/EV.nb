Cell["Calculamos la base desde las ecuaciones impl\[IAcute]citas", "Text",
 CellChangeTimes->{{3.9880233333801975`*^9, 
  3.988023352082535*^9}},ExpressionUUID->"c4785244-af5c-e84b-a023-\
858ff3d79b81"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Sesion", " ", "9"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dimensi\[OAcute]n", "=", "3"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Dimensi\[OAcute]n", " ", "del", " ", "subespacio"}], " ", "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "4"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Dimensi\[OAcute]n", " ", "del", " ", "espacio", " ", "vectorial"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SISTimpl\[IAcute]citas", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"dimensi\[OAcute]n", "\[Equal]", 
        RowBox[{"(", 
         RowBox[{"n", "-", "1"}], ")"}]}], ",", 
       RowBox[{"{", "impl\[IAcute]citas", "}"}], ",", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"impl\[IAcute]citas", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"n", "-", "dimensi\[OAcute]n"}]}], "}"}]}], "]"}]}], 
      "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Sistema", " ", "de", " ", "ecuaciones", " ", "lineales"}], ",", 
     " ", 
     RowBox[{
     "cuya", " ", "soluci\[OAcute]n", " ", "los", " ", "vectores", " ", "del",
       " ", "subespacio"}]}], " ", "*)"}], "\n", 
   RowBox[{"BaseImpl\[IAcute]citas", "[", 
    RowBox[{"SISTimpl\[IAcute]citas", ",", "4"}], "]"}]}]}]], "Code",
 CellChangeTimes->{{3.988023496480795*^9, 3.9880235398554745`*^9}, 
   3.9880263118357544`*^9, {3.9880263448969517`*^9, 3.9880263840699596`*^9}},
