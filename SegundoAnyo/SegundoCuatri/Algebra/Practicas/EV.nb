Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Sesion", " ", "8.", " ", "Matrices", " ", "elementales"}], "*)"}],
   "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"el1", "[", 
      RowBox[{"i_", ",", "j_", ",", "n_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "B", "}"}], ",", "\n", "\t\t\t\t", 
       RowBox[{
        RowBox[{"B", "=", 
         RowBox[{"IdentityMatrix", "[", "n", "]"}]}], ";", "\n", "\t\t\t\t", 
        RowBox[{
         RowBox[{"B", "\[LeftDoubleBracket]", 
          RowBox[{"i", ",", "i"}], "\[RightDoubleBracket]"}], "=", "0"}], ";",
         "\n", "\t\t\t\t", 
        RowBox[{
         RowBox[{"B", "\[LeftDoubleBracket]", 
          RowBox[{"j", ",", "j"}], "\[RightDoubleBracket]"}], "=", "0"}], ";",
         "\n", "\t\t\t\t", 
        RowBox[{
         RowBox[{"B", "\[LeftDoubleBracket]", 
          RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "=", "1"}], ";",
         "\n", "\t\t\t\t", 
        RowBox[{
         RowBox[{"B", "\[LeftDoubleBracket]", 
          RowBox[{"j", ",", "i"}], "\[RightDoubleBracket]"}], "=", 
         RowBox[{"B", "\[LeftDoubleBracket]", 
          RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}]}], ";", "\n", 
        "\t\t                   ", "B"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"el2", "[", 
      RowBox[{"i_", ",", "s_", ",", "n_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "B", "}"}], ",", "\n", "\t\t\t\t", 
       RowBox[{
        RowBox[{"B", "=", 
         RowBox[{"IdentityMatrix", "[", "n", "]"}]}], ";", "\n", "\t\t\t\t", 
        RowBox[{
         RowBox[{"B", "\[LeftDoubleBracket]", 
          RowBox[{"i", ",", "i"}], "\[RightDoubleBracket]"}], "=", "s"}], ";",
         "\n", "\t\t\t\t", "B"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"el3", "[", 
      RowBox[{"i_", ",", "j_", ",", "t_", ",", "n_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "B", "}"}], ",", "\n", "\t\t\t\t\t ", 
       RowBox[{
        RowBox[{"B", "=", 
         RowBox[{"IdentityMatrix", "[", "n", "]"}]}], ";", "\n", 
        "\t\t\t\t\t ", 
        RowBox[{
         RowBox[{"B", "\[LeftDoubleBracket]", 
          RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "=", "t"}], ";",
