Cell["\<\
Ejercicio 4 Ord Sea V el espacio vectorial de los polinomios de grado menos o \
igual que 2 con coeficientes en R
A) Considerar subconjuntos U={p\.b4(x):p(x)\[Element]V}, siendo p\.b4(x) \
respecto la variable x. Demostrar que U es subconjunto vectorial de V. \
Obtener, de forma razonada, base, dimensi\[OAcute]n, ecuaciones \
param\[EAcute]tricas e impl\[IAcute]citas de U.\
\>", "Subsection",
 CellChangeTimes->{{3.9876838319932976`*^9, 3.9876839790028114`*^9}, {
  3.98801430440345*^9, 
  3.9880143084590206`*^9}},ExpressionUUID->"c6b7a268-159b-7443-be45-\
6c02e72a34cc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "a", ",", " ", "b", ",", " ", "c", ",", " ", "x", ",", " ", "\[Lambda]"}], 
   "]"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"a", " ", "+", " ", 
    RowBox[{"b", "*", "x"}], " ", "+", " ", 
    RowBox[{"c", "*", 
     RowBox[{"x", "^", "2"}]}]}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"dp", " ", "=", " ", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"p", "[", "x", "]"}], ",", " ", "x"}], "]"}]}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Coordenadas", " ", "respecto", " ", "de", " ", "la", " ", "base", " ", 
    "can\[OAcute]nica", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "x", ",", " ", 
      RowBox[{"x", "^", "2"}]}], "}"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"coord", "[", "pol_", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Coefficient", "[", 
      RowBox[{"pol", ",", " ", "x", ",", " ", "i"}], "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "0", ",", " ", "2"}], "}"}]}], "]"}]}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"BaseVpol", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "x", ",", " ", 
      RowBox[{"x", "^", "2"}]}], "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"GeneradoresU", " ", "=", " ", 
   RowBox[{"coord", " ", "/@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"#", ",", " ", "x"}], "]"}], " ", "&"}], " ", "/@", " ", 
      "BaseVpol"}], ")"}]}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"BaseU", " ", "=", " ", 
   RowBox[{"Base2", "[", "GeneradoresU", "]"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Param\[EAcute]tricas", "[", "BaseU", "]"}], "\n"}], "\n", 
 RowBox[{"Impl\[IAcute]citas", "[", "BaseU", "]"}]}], "Code",
 CellChangeTimes->{3.987684627688402*^9},
 CellLabel->
  "In[115]:=",ExpressionUUID->"de28a167-5d7d-6b4f-b514-c6d88e2c4271"],

