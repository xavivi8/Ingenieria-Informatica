5aa05cd55bc1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalAAcute]ngulo", "[", 
    RowBox[{"x_", ",", " ", "y_", ",", " ", "p_"}], "]"}], " ", ":=", " ", 
   RowBox[{"ArcCos", "[", 
    RowBox[{
     RowBox[{"p", "[", 
      RowBox[{"x", ",", " ", "y"}], "]"}], " ", "/", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"p", "[", 
         RowBox[{"x", ",", " ", "x"}], "]"}], "]"}], " ", "*", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"p", "[", 
         RowBox[{"y", ",", " ", "y"}], "]"}], "]"}]}], ")"}]}], "]"}]}], 
  ";"}]], "Code",
 CellChangeTimes->{{3.9816018857633076`*^9, 3.981601957621954*^9}, 
   3.981602117932186*^9, 3.981602282042799*^9, {3.982235519774555*^9, 
