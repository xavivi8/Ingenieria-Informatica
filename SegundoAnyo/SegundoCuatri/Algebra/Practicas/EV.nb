Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"SSesion", " ", "07.", " ", "Sistemas", " ", "de", " ", 
    RowBox[{"ecuaciones", ".", " ", "Matrices"}], " ", "y", " ", 
    "determinante"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"cramer", "[", 
     RowBox[{"A_", ",", "b_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"A1", ",", "x", ",", "n", ",", "m"}], "}"}], ",", 
      "\[IndentingNewLine]", "\t\t", 
      RowBox[{
       RowBox[{"A1", "=", 
        RowBox[{"Transpose", "[", "A", "]"}]}], ";", "\n", "\t\t       ", 
       RowBox[{"n", "=", 
        RowBox[{
         RowBox[{"Dimensions", "[", "A", "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\t\t   ", 
       RowBox[{"m", "=", 
        RowBox[{
         RowBox[{"Dimensions", "[", "A", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\t\t   ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"m", "\[NotEqual]", "n"}], " ", "||", " ", 
          RowBox[{
           RowBox[{"Det", "[", "A", "]"}], "==", "0"}]}], ",", " ", 
         RowBox[{
         "Print", "[", "\"\<El sistema anterior no es de Cramer\>\"", "]"}], 
         ",", "\n", "\t\t       ", 
         RowBox[{
          RowBox[{"x", "=", 
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", "\t\t", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"A1", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "=", "b"}], ";", 
             RowBox[{
              RowBox[{"x", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "=", 
              RowBox[{
               RowBox[{"Det", "[", 
                RowBox[{"Transpose", "[", "A1", "]"}], "]"}], "/", 
               RowBox[{"Det", "[", "A", "]"}]}]}], ";", 
             RowBox[{"A1", "=", 
              RowBox[{"Transpose", "[", "A", "]"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}], ";", 
          RowBox[{"Print", "[", 
           RowBox[{
           "\"\<La soluci\[OAcute]n \n\t\t\t\t\tdel sistema de Cramer es \
\>\"", ",", " ", "x"}], "]"}]}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   "\n", 
   RowBox[{"(*", "*)"}], "\n", 
   RowBox[{"Clear", "[", "resolverSistema", "]"}], "\n", "\n", 
   RowBox[{
    RowBox[{"resolverSistema", "[", 
     RowBox[{"M_", ",", " ", "variables_", ",", " ", "nombre_"}], "]"}], " ", 
    ":=", " ", 
    RowBox[{"Module", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "A", ",", " ", "b", ",", " ", "amp", ",", " ", "rangoA", ",", " ", 
        "rangoAmp", ",", " ", "detA"}], "}"}], ",", "\n", "  ", "\n", "  ", 
      RowBox[{
       RowBox[{"A", " ", "=", " ", 
        RowBox[{"M", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", 
           RowBox[{"1", " ", ";;", " ", 
            RowBox[{"-", "2"}]}]}], "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"M", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", " ", 
           RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"amp", " ", "=", " ", "M"}], ";", "\n", "  ", "\n", "  ", 
       RowBox[{"Print", "[", "\"\<==============================\>\"", "]"}], 
       ";", "\n", "  ", 
       RowBox[{"Print", "[", "nombre", "]"}], ";", "\n", "  ", 
       RowBox[{"Print", "[", "\"\<==============================\>\"", "]"}], 
       ";", "\n", "  ", "\n", "  ", 
       RowBox[{"Print", "[", "\"\<Matriz ampliada:\>\"", "]"}], ";", "\n", 
       "  ", 
       RowBox[{"Print", "[", 
        RowBox[{"MatrixForm", "[", "amp", "]"}], "]"}], ";", "\n", "  ", "\n",
        "  ", 
       RowBox[{"Print", "[", "\"\<Matriz escalonada reducida:\>\"", "]"}], 
       ";", "\n", "  ", 
       RowBox[{"Print", "[", 
        RowBox[{"MatrixForm", "[", 
         RowBox[{"RowReduce", "[", "amp", "]"}], "]"}], "]"}], ";", "\n", 
       "  ", "\n", "  ", 
       RowBox[{"rangoA", " ", "=", " ", 
        RowBox[{"MatrixRank", "[", "A", "]"}]}], ";", "\n", "  ", 
       RowBox[{"rangoAmp", " ", "=", " ", 
        RowBox[{"MatrixRank", "[", "amp", "]"}]}], ";", "\n", "  ", "\n", 
       "  ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Rango de A = \>\"", ",", " ", "rangoA"}], "]"}], ";", 
       "\n", "  ", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Rango de la matriz ampliada = \>\"", ",", " ", "rangoAmp"}], 
        "]"}], ";", "\n", "  ", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"rangoA", " ", "!=", " ", "rangoAmp"}], ",", "\n", "   ", 
         RowBox[{
         "Print", "[", 
          "\"\<Conclusi\[OAcute]n: sistema incompatible. No tiene soluci\
\[OAcute]n.\>\"", "]"}], ",", "\n", "   ", "\n", "   ", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"rangoA", " ", "==", " ", 
             RowBox[{"Length", "[", "variables", "]"}]}], ",", "\n", "    ", 
            RowBox[{
            "Print", "[", 
             "\"\<Conclusi\[OAcute]n: sistema compatible determinado. Tiene \
soluci\[OAcute]n \[UAcute]nica.\>\"", "]"}], ",", "\n", "    ", 
            RowBox[{
            "Print", "[", 
             "\"\<Conclusi\[OAcute]n: sistema compatible indeterminado. Tiene \
infinitas soluciones.\>\"", "]"}]}], "\n", "    ", "]"}], ";", "\n", "   ", 
          "\n", "   ", 
          RowBox[{"Print", "[", "\"\<Soluci\[OAcute]n con Solve:\>\"", "]"}], 
          ";", "\n", "   ", 
          RowBox[{"Print", "[", 
           RowBox[{"Solve", "[", 
            RowBox[{
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"A", " ", ".", " ", "variables"}], " ", "==", " ", 
               "b"}], "]"}], ",", " ", "variables"}], "]"}], "]"}], ";", "\n",
           "   ", "\n", "   ", 
          RowBox[{"Print", "[", "\"\<Soluci\[OAcute]n con Reduce:\>\"", "]"}],
           ";", "\n", "   ", 
          RowBox[{"Print", "[", 
           RowBox[{"Reduce", "[", 
            RowBox[{
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"A", " ", ".", " ", "variables"}], " ", "==", " ", 
               "b"}], "]"}], ",", " ", "variables"}], "]"}], "]"}], ";", "\n",
           "   ", "\n", "   ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "A", "]"}], " ", "==", " ", 
             RowBox[{"Length", "[", 
              RowBox[{"A", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", "\n", "    ", 
            RowBox[{
             RowBox[{"detA", " ", "=", " ", 
              RowBox[{"Det", "[", "A", "]"}]}], ";", "\n", "    ", 
             RowBox[{"Print", "[", 
              RowBox[{"\"\<Determinante de A = \>\"", ",", " ", "detA"}], 
              "]"}], ";", "\n", "    ", "\n", "    ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"detA", " ", "!=", " ", "0"}], ",", "\n", "     ", 
               RowBox[{
                RowBox[{
                "Print", "[", "\"\<Soluci\[OAcute]n con LinearSolve:\>\"", 
                 "]"}], ";", "\n", "     ", 
                RowBox[{"Print", "[", 
                 RowBox[{"LinearSolve", "[", 
                  RowBox[{"A", ",", " ", "b"}], "]"}], "]"}]}], ",", "\n", 
               "     ", 
               RowBox[{
               "Print", "[", 
                "\"\<No se puede aplicar Cramer porque det(A)=0.\>\"", 
                "]"}]}], "\n", "     ", "]"}]}], ",", "\n", "    ", "\n", 
            "    ", 
            RowBox[{
            "Print", "[", 
             "\"\<No se puede aplicar Cramer porque la matriz A no es \
cuadrada.\>\"", "]"}]}], "\n", "    ", "]"}]}]}], "\n", "   ", "]"}]}]}], 
     "\n", "  ", "]"}]}], "\n", 
   RowBox[{"(*", "*)"}]}]}]], "Code",
 CellChangeTimes->{
