Cell[CellGroupData[{

Cell[TextData[{
 "Ejercicio 4 Extra 4 24/25\nSea V un espacio vectorial eucl\[IAcute]deo cuyo \
producto escalar tiene matriz de Gram respecto de la base B={",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "1"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "98470c65-4c7e-2f43-ac89-1e2f3183aa7d"],
 ",",
 Cell[BoxData[
  FormBox[
   SubscriptBox["v", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "289842e9-0f8f-7342-9c4b-ff597299577b"],
 "}, es G= ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {"1", 
       RowBox[{"-", "2"}]},
      {
       RowBox[{"-", "2"}], "9"}
     }], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "90373df7-cd17-0140-a390-3ece7bf74088"]
}], "Subsection",
 CellChangeTimes->{{3.9876907626783752`*^9, 3.9876908435675526`*^9}, {
  3.9876909829741592`*^9, 
  3.9876909934070168`*^9}},ExpressionUUID->"30ba0e7d-c1e7-d340-84a1-\
8c92f4ff6c58"],

Cell[CellGroupData[{

Cell["\<\
a) Razonar si B es una base ortonormal. Usa Gram-Schmidt, para calcular una \
base ortonormal, B\.b4, a partir de B\
\>", "Subsubsection",
 CellChangeTimes->{{3.987691003595236*^9, 3.987691045932108*^9}, {
  3.988028047598982*^9, 
  3.9880280568006077`*^9}},ExpressionUUID->"d9b44de2-5784-2e44-becc-\
6c1efcbca35a"],

Cell["\<\
B es ortogonal sii G es diagonal sii gij = 0 para todo i != j
B es unitaria sii gii=1 para todo i
B es ortonormal sii G=Identidad\
\>", "Text",
 CellChangeTimes->{
  3.988028046024477*^9},ExpressionUUID->"b07bfc91-010b-9e46-a9e1-\
d3d8b27e7c59"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"G", ",", "PE", ",", "B"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"G", "=", 
   RowBox[{"(", GridBox[{
      {"1", 
       RowBox[{"-", "2"}]},
      {
       RowBox[{"-", "2"}], "9"}
     }], ")"}]}], ";"}], "\n", 
 RowBox[{"G", " ", "\[Equal]", " ", 
  RowBox[{"IdentityMatrix", "[", "2", "]"}]}]}], "Code",
 CellChangeTimes->{{3.987691209646351*^9, 3.9876912488622856`*^9}, {
  3.9876912943932114`*^9, 3.98769134024107*^9}, {3.9880279265084324`*^9, 
  3.9880279326363945`*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"1494ba6d-f20c-cb45-a242-2fe0a596038c"],

Cell[BoxData["False"], "Output",
 CellChangeTimes->{3.9880279331136475`*^9},
 CellLabel->"Out[19]=",ExpressionUUID->"01814b92-0f8e-004a-aeaa-e6c11acbf818"]
}, Open  ]],

Cell["As\[IAcute] B no es ortonormal. Calcular B prima a partir de B", "Text",
 CellChangeTimes->{{3.9880279395253353`*^9, 
  3.988027940728285*^9}},ExpressionUUID->"3e95279d-e905-7344-835c-\
feacb394c6de"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
b) Calcular la matriz de Gram G\.b4, respecto de la base B\.b4obtenida en el \
apartado anterior \[DownQuestion]Qu\[EAcute] relaci\[OAcute]n hay entre G y G\
\.b4? Comprobar expl\[IAcute]citamente.\
\>", "Subsubsection",
 CellChangeTimes->{{3.9876910582422104`*^9, 
  3.9876911097192936`*^9}},ExpressionUUID->"c74933e8-f3dc-9246-8d3b-\
bf4a66446371"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GramSchmidt", "[", 
    RowBox[{"base_", ",", " ", "p_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "baseortogonal", "}"}], ",", "\n", 
     RowBox[{
      RowBox[{"baseortogonal", " ", "=", " ", 
       RowBox[{"{", 
        RowBox[{
        "base", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        "}"}]}], ";", "\n", 
      RowBox[{"Do", "[", "\n", 
       RowBox[{
        RowBox[{
         RowBox[{"AppendTo", "[", 
          RowBox[{"baseortogonal", ",", "\n", 
           RowBox[{
            RowBox[{"base", "\[LeftDoubleBracket]", 
             RowBox[{"i", " ", "+", " ", "1"}], "\[RightDoubleBracket]"}], 
            " ", "-", " ", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"p", "[", 
                  RowBox[{
                   RowBox[{"base", "\[LeftDoubleBracket]", 
                    RowBox[{"i", " ", "+", " ", "1"}], 
                    "\[RightDoubleBracket]"}], ",", " ", 
                   RowBox[{
                   "baseortogonal", "\[LeftDoubleBracket]", "j", 
                    "\[RightDoubleBracket]"}]}], "]"}], " ", "/", "\n", 
                 RowBox[{"p", "[", 
                  RowBox[{
                   RowBox[{
                   "baseortogonal", "\[LeftDoubleBracket]", "j", 
                    "\[RightDoubleBracket]"}], ",", " ", 
                   RowBox[{
                   "baseortogonal", "\[LeftDoubleBracket]", "j", 
                    "\[RightDoubleBracket]"}]}], "]"}]}], ")"}], " ", "*", 
               " ", 
               RowBox[{
               "baseortogonal", "\[LeftDoubleBracket]", "j", 
                "\[RightDoubleBracket]"}]}], ",", "\n", 
              RowBox[{"{", 
               RowBox[{"j", ",", " ", "i"}], "}"}]}], "]"}]}]}], "]"}], ";"}],
         " ", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"M\[EAcute]todo", " ", "de", " ", "Gram"}], "-", 
          "Schmidt"}], "*)"}], "\n", ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", 
          RowBox[{
           RowBox[{"Length", "[", "base", "]"}], " ", "-", " ", "1"}]}], 
         "}"}]}], "]"}], ";", "\n", 
      RowBox[{"Return", "[", "baseortogonal", "]"}], ";"}]}], "\n", "]"}]}], 
  ";"}]], "Code",
 CellChangeTimes->{{3.9876912921974354`*^9, 3.9876913089802265`*^9}, 
   3.987691346026085*^9, 3.9880279494355545`*^9},
 CellLabel->"In[20]:=",ExpressionUUID->"ca366004-6ee9-8e47-8188-9908c8312b3c"],

