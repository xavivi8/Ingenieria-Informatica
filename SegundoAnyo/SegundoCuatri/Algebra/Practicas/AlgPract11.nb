Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Sesion", " ", "10", " ", "Gram"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Gram", "[", 
     RowBox[{"base_", ",", "PE_"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"PE", "[", 
       RowBox[{
        RowBox[{"base", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{"base", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "base", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"Length", "[", "base", "]"}]}], "}"}]}], "]"}]}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Sesion", " ", "10", " ", "producto", " ", "escalar"}], "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PE2", "[", 
      RowBox[{"p_", ",", "q_"}], "]"}], ":=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "[", "x", "]"}], "*", 
        RowBox[{"q", "[", "x", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Code",
