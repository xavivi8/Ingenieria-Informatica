  3.9880279624385395`*^9}},ExpressionUUID->"28146ded-6565-f64e-9664-\
5c99610bbe01"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PE1", "[", 
    RowBox[{"x_", ",", " ", "y_"}], "]"}], " ", ":=", " ", 
   RowBox[{"x", ".", "G", ".", "y"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"B", " ", "=", " ", 
   RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"B", "'"}], " ", "=", " ", 
  RowBox[{"GramSchmidt", "[", 
   RowBox[{"B", ",", " ", "PE1"}], "]"}]}]}], "Code",
