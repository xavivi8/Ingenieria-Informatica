Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Sesion", " ", "10", " ", "Gram"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Gram", "[", 
     RowBox[{"base_", ",", "PE_"}], "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"PE", "[", 
       RowBox[{
        RowBox[{"base", "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{"base", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "base", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", 
        RowBox[{"Length", "[", "base", "]"}]}], "}"}]}], "]"}]}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Sesion", " ", "10", " ", "producto", " ", "escalar"}], "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PE2", "[", 
      RowBox[{"p_", ",", "q_"}], "]"}], ":=", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"p", "[", "x", "]"}], "*", 
        RowBox[{"q", "[", "x", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Sesion", " ", "10"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PE", "[", 
      RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
     RowBox[{"Expand", "[", 
      RowBox[{"x", ".", "A", ".", "y"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Sesion", " ", "10"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"GramSchmidt", "[", 
      RowBox[{"base_", ",", "p_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "baseortogonal", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"baseortogonal", "=", 
         RowBox[{"{", 
          RowBox[{"base", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"baseortogonal", ",", 
             RowBox[{
              RowBox[{"base", "[", 
               RowBox[{"[", 
                RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
              RowBox[{"Sum", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"p", "[", 
                    RowBox[{
                    RowBox[{"base", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", "+", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"baseortogonal", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "/", 
                   RowBox[{"p", "[", 
                    RowBox[{
                    RowBox[{"baseortogonal", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ",", 
                    RowBox[{"baseortogonal", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ")"}], "*", 
                 RowBox[{"baseortogonal", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "i"}], "}"}]}], "]"}]}]}], "]"}], ";"}], 
          " ", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"M\[EAcute]todo", " ", "de", " ", "Gram"}], "-", 
            "Schmidt"}], "*)"}], "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{
             RowBox[{"Length", "[", "base", "]"}], "-", "1"}]}], "}"}]}], 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "baseortogonal", "]"}], ";"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Sesion", " ", "10"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"B", "''"}], "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"B", "'"}], "[", 
         RowBox[{"[", "i", "]"}], "]"}], "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"PE1", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"B", "'"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"B", "'"}], "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"B", "'"}], "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", "*)"}]}]}]], "Code",
 CellChangeTimes->{
