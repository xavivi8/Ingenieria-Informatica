  "289842e9-0f8f-7342-9c4b-ff597299577b"],
 "}, es G= ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", GridBox[{
      {"1", 
       RowBox[{"-", "2"}]},
      {
       RowBox[{"-", "2"}], "9"}
     }], ")"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "90373df7-cd17-0140-a390-3ece7bf74088"]
}], "Subsection",
 CellChangeTimes->{{3.9876907626783752`*^9, 3.9876908435675526`*^9}, {
  3.9876909829741592`*^9, 
  3.9876909934070168`*^9}},ExpressionUUID->"30ba0e7d-c1e7-d340-84a1-\
8c92f4ff6c58"],

Cell[CellGroupData[{

Cell["\<\
a) Razonar si B es una base ortonormal. Usa Gram-Schmidt, para calcular una \
base ortonormal, B\.b4, a partir de B\
\>", "Subsubsection",
 CellChangeTimes->{{3.987691003595236*^9, 
  3.987691045932108*^9}},ExpressionUUID->"d9b44de2-5784-2e44-becc-\
6c1efcbca35a"],

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"G", ",", "PE", ",", "B"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"G", "=", 
   RowBox[{"(", GridBox[{
      {"1", 
       RowBox[{"-", "2"}]},
      {
       RowBox[{"-", "2"}], "9"}
     }], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"PE", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{"x", ".", "G", ".", "y"}]}]}], "Code",
 CellChangeTimes->{{3.987691209646351*^9, 3.9876912488622856`*^9}, {
  3.9876912943932114`*^9, 3.98769134024107*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"1494ba6d-f20c-cb45-a242-2fe0a596038c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"B", "=", 
   RowBox[{"(", GridBox[{
      {"1", "0"},
      {"0", "1"}
     }], ")"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"B", "'"}], "=", 
  RowBox[{"GramSchmidt", "[", 
   RowBox[{"B", ",", "PE"}], "]"}], 
  RowBox[{"(*", "Ortogonal", "*)"}]}]}], "Code",
 CellChangeTimes->{{3.9876912921974354`*^9, 3.9876913089802265`*^9}, 
   3.987691346026085*^9},
 CellLabel->"In[50]:=",ExpressionUUID->"ca366004-6ee9-8e47-8188-9908c8312b3c"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.987691342524*^9, 3.987691346300667*^9}},
 CellLabel->"Out[51]=",ExpressionUUID->"93be0888-22c3-dc47-830c-59294090819b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"B", "''"}], "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"B", "'"}], "[", 
      RowBox[{"[", "i", "]"}], "]"}], "/", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"PE", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"B", "'"}], "[", 
         RowBox[{"[", "i", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"B", "'"}], "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"B", "'"}], "]"}]}], "}"}]}], "]"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Ortogonal", " ", "y", " ", "unitaria"}], ",", " ", 
    RowBox[{"por", " ", "tanto", " ", "ortonormal"}]}], "*)"}]}]], "Code",
 CellChangeTimes->{3.987691355452442*^9},
 CellLabel->"In[52]:=",ExpressionUUID->"3c3eb9fd-5653-5c47-b640-31f5db135bc9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["2", 
      SqrtBox["5"]], ",", 
     FractionBox["1", 
      SqrtBox["5"]]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9876913564895096`*^9},
 CellLabel->"Out[52]=",ExpressionUUID->"6b5e9ff9-57bd-c746-bbc7-b08a463bd37a"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
