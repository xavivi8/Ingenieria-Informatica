Cell[CellGroupData[{

Cell["\<\
d) \[DownQuestion]Es B unitaria? En caso negativo, transformarla en base \
unitaria.\
\>", "Subsubsection",
 CellChangeTimes->{{3.981601762952612*^9, 3.9816017637482224`*^9}, {
   3.9816025843141193`*^9, 3.9816026322171917`*^9}, {3.982927733640337*^9, 
   3.982927758663128*^9}, 3.9846214096700745`*^9, {3.9870388771875095`*^9, 
   3.987039018228773*^9}, {3.9876907060189533`*^9, 
   3.987690724776026*^9}},ExpressionUUID->"7ca7d6fd-b846-0f4d-835c-\
61bf9590a271"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[CapitalAAcute]ngulo", "[", 
    RowBox[{"x_", ",", " ", "y_", ",", " ", "p_"}], "]"}], " ", ":=", " ", 
   RowBox[{"ArcCos", "[", 
    RowBox[{
     RowBox[{"p", "[", 
      RowBox[{"x", ",", " ", "y"}], "]"}], " ", "/", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sqrt", "[", 
        RowBox[{"p", "[", 
         RowBox[{"x", ",", " ", "x"}], "]"}], "]"}], " ", "*", " ", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"p", "[", 
         RowBox[{"y", ",", " ", "y"}], "]"}], "]"}]}], ")"}]}], "]"}]}], 
  ";"}]], "Code",
 CellChangeTimes->{{3.9816018857633076`*^9, 3.981601957621954*^9}, 
   3.981602117932186*^9, 3.981602282042799*^9, {3.982235519774555*^9, 
   3.982235564787422*^9}, {3.982235720799366*^9, 3.982235730708481*^9}, {
   3.982235788288891*^9, 3.982235833917431*^9}, 3.9829277617967796`*^9, {
   3.983421176513235*^9, 3.9834211814058743`*^9}, {3.983421256577215*^9, 
   3.9834212567482033`*^9}, 3.984621398389551*^9, {3.988027838395767*^9, 
   3.988027839360777*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"0ae95ad7-07d5-054e-b8bd-e4dc405099f4"],

