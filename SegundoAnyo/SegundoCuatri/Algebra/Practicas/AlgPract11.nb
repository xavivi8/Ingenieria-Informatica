}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"B", "''"}], " ", "=", " ", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"B", "'"}], "\[LeftDoubleBracket]", "i", 
      "\[RightDoubleBracket]"}], " ", "/", " ", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"PE1", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"B", "'"}], "\[LeftDoubleBracket]", "i", 
         "\[RightDoubleBracket]"}], ",", " ", 
        RowBox[{
         RowBox[{"B", "'"}], "\[LeftDoubleBracket]", "i", 
         "\[RightDoubleBracket]"}]}], "]"}], "]"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"i", ",", " ", 
      RowBox[{"Length", "[", 
       RowBox[{"B", "'"}], "]"}]}], "}"}]}], "]"}]}]], "Code",
 CellChangeTimes->{{3.988028012550684*^9, 3.9880280133260784`*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"24fac9c3-9341-7343-a770-d3f074beee94"],

