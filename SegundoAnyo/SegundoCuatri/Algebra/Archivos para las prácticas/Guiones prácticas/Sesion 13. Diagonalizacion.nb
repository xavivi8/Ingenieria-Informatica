bd4670fe21ab"],

Cell[TextData[{
 "La matriz ",
 StyleBox["P",
  FontSlant->"Italic"],
 ", es la matriz de cambio de la base de vectores propios a ",
 StyleBox["B",
  FontSlant->"Italic"],
 ", pero OJO, todo est\[AAcute] referenciado respecto a ",
 StyleBox["B, ",
  FontSlant->"Italic"],
 "y entonces ",
 StyleBox["B",
  FontSlant->"Italic"],
 " ={(1, 0, 0",
 Cell[BoxData[
  FormBox[
   SubscriptBox[")", "B"], TraditionalForm]],ExpressionUUID->
  "2353c2a4-007a-4b83-808e-d103b395e6d5"],
 ", (0, 1, 0",
 Cell[BoxData[
  FormBox[
   SubscriptBox[")", "B"], TraditionalForm]],ExpressionUUID->
  "ef06bb7e-a409-4656-94ad-e694a8a8bda0"],
 ",(0, 0, 1",
 Cell[BoxData[
  FormBox[
   SubscriptBox[")", "B"], TraditionalForm]],ExpressionUUID->
  "8ff26a08-3a73-4b00-8829-9a4be137089b"],
 "}, por tanto, ",
 StyleBox["P ",
  FontSlant->"Italic"],
 "podr\[IAcute]amos calcularla as\[IAcute]",
 StyleBox[":",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.7973999623681135`*^9, 3.7974000864455442`*^9}, {
