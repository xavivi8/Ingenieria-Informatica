Cell["Ejemplo 10. ", "Subsubsection",
 CellChangeTimes->{{3.5611064291537175`*^9, 3.5611064301521196`*^9}, {
   3.7973613042647715`*^9, 3.7973613267247486`*^9}, {3.7973975827052293`*^9, 
