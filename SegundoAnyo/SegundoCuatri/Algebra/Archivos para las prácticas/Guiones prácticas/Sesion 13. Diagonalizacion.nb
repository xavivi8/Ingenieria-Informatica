 TextJustification->1.,ExpressionUUID->"dff33742-574e-4c5d-a09b-b18298b86a3f"],

Cell["Primero calculamos su expresi\[OAcute]n matricial", "Text",
 CellChangeTimes->{{3.79739803936607*^9, 
  3.7973980504954977`*^9}},ExpressionUUID->"bbcdc3aa-5e43-4b8d-b334-\
500d02e915d6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Coordenadas", "[", 
    RowBox[{"X_", ",", "B_"}], "]"}], ":=", 
   RowBox[{"LinearSolve", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", "B", "]"}], ",", "X"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ExpMatricial", "[", 
    RowBox[{"f_", ",", "B1_", ",", "B2_"}], "]"}], ":=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Coordenadas", "[", 
       RowBox[{
        RowBox[{"f", "[", 
         RowBox[{"B1", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", "B2"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "B1", "]"}]}], "}"}]}], "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.7973980252151995`*^9, 
  3.7973980257251234`*^9}},ExpressionUUID->"8e9573f5-b816-4da1-b4b4-\
101fe4345ead"],

Cell[TextData[{
 "Definimos ",
 StyleBox["f",
  FontSlant->"Italic"],
 " usando la base can\[OAcute]nica, y tambi\[EAcute]n ",
 StyleBox["B,",
  FontSlant->"Italic"]
}], "Text",
 CellChangeTimes->{{3.7973980843350887`*^9, 3.797398138525406*^9}, {
  3.797398337887043*^9, 
  3.7973983442552185`*^9}},ExpressionUUID->"8cd1ef58-1e2c-4d76-a736-\
9d316f1997c6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"{", 
     RowBox[{"a_", ",", "b_", ",", "c_"}], "}"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"a", "+", "b", "+", "c"}], ",", 
     RowBox[{"a", "+", "b"}], ",", "c"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"B", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.797398059295512*^9, 3.797398072595395*^9}, {
  3.7973981427402973`*^9, 3.797398154497738*^9}, {3.797398241650135*^9, 
