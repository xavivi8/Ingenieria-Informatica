Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"CambioBase", "[", 
    RowBox[{"B1_", ",", "B2_"}], "]"}], ":=", 
   RowBox[{"ExpMatricial", "[", 
    RowBox[{"Identity", ",", "B1", ",", "B2"}], "]"}]}], 
