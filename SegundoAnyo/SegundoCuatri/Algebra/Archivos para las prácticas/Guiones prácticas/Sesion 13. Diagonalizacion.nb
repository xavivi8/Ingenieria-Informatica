   3.7974006264958844`*^9},ExpressionUUID->"cb1768fd-8fa1-4564-9c1f-\
752ab958042f"],

Cell[TextData[{
 "Sea ",
 StyleBox["f",
  FontSlant->"Italic"],
 ": ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "2"], TraditionalForm]],ExpressionUUID->
  "a6e71bd3-8e3c-4f3a-8fb2-583943366988"],
 "(\[DoubleStruckCapitalR]) \[LongRightArrow] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", "2"], TraditionalForm]],ExpressionUUID->
  "effa9eca-0b2a-4772-99a4-d2271b157e86"],
 "(\[DoubleStruckCapitalR]), el endomorfismo definido por ",
 StyleBox["f",
  FontSlant->"Italic"],
 "(",
 StyleBox["a ",
  FontSlant->"Italic"],
 "+ ",
 StyleBox["bx ",
  FontSlant->"Italic"],
 "+ ",
 StyleBox["c",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "04a400e7-258e-4f83-bdea-bfae7ef9d642"],
 ") = (",
 StyleBox["a",
  FontSlant->"Italic"],
 " + ",
 StyleBox["b",
  FontSlant->"Italic"],
 " + ",
 StyleBox["c",
  FontSlant->"Italic"],
 ") + (",
 StyleBox["a",
  FontSlant->"Italic"],
 " +",
 StyleBox["b",
  FontSlant->"Italic"],
 ")",
 StyleBox["x",
  FontSlant->"Italic"],
 " + ",
 StyleBox["c",
  FontSlant->"Italic"],
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "0fd35d3c-d6ab-4f38-b5ed-dc7ca4964795"],
 ". Calcular la expresi\[OAcute]n matricial de ",
 StyleBox["f",
  FontSlant->"Italic"],
 " respecto de la base ",
 StyleBox["B",
  FontSlant->"Italic"],
 " = {1 + ",
 StyleBox["x",
  FontSlant->"Italic"],
 " +",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "dd1e472c-82c5-44ca-ae89-63bbb80f11cf"],
 ", 1 + ",
 StyleBox["x",
  FontSlant->"Italic"],
 ", 1}, comprobar si ",
 StyleBox["f ",
  FontSlant->"Italic"],
 "es diagonalizable por semejanza y en caso afirmativo comprobarlo expl\
\[IAcute]citamente."
}], "Text",
 CellChangeTimes->{{3.797397621005128*^9, 3.797397875185341*^9}, {
  3.7973980317752295`*^9, 3.797398032145494*^9}, {3.797398169215515*^9, 
  3.7973982346055365`*^9}, {3.79739827320523*^9, 3.7973982747706165`*^9}, {
