Cell["\<\
Los valores propios son 2, 1 y 0, todos distintos, ya sabr\[IAcute]amos que \
es diagonalizable por semejanza, a\[UAcute]n as\[IAcute], lo comprobamos \
viendo que tiene una base de vectores propios:\
\>", "Text",
 CellChangeTimes->{{3.797398758335212*^9, 3.7973988264951954`*^9}},
 TextJustification->1.,ExpressionUUID->"69f0a8a1-dbb1-4cfd-b706-68fd3125fb89"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Det", "[", 
   RowBox[{
    RowBox[{"Eigensystem", "[", "A", "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}], "]"}], "\[NotEqual]", "0"}]], "Input",
 CellChangeTimes->{{3.797398667785488*^9, 3.797398690155151*^9}, {
  3.7973998596777296`*^9, 
  3.79739987139999*^9}},ExpressionUUID->"8499ccd0-708f-4126-ae85-\
b5623981c633"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{{3.7973986819452677`*^9, 3.797398691115611*^9}},
 CellLabel->
  "Out[424]=",ExpressionUUID->"df0ff376-2d47-4c76-a684-f6e48f1fbba3"]
}, Open  ]],

Cell[TextData[{
 "Por tanto, es diagonalizable por semejanza y {(0, 1, 0), (1, -2, 1), (0, \
-1, 2)} es una base de vectores propios (con coordenadas respecto de ",
 StyleBox["B",
  FontSlant->"Italic"],
 "), por tanto (0, 1, 0",
 Cell[BoxData[
  FormBox[
   SubscriptBox[")", "B"], TraditionalForm]],ExpressionUUID->
  "5ff8863d-5820-48af-ba76-e1edc99c43f9"],
 " = 1 + ",
 StyleBox["x",
  FontSlant->"Italic"],
 ", (1, -2, 1",
 Cell[BoxData[
  FormBox[
   SubscriptBox[")", "B"], TraditionalForm]],ExpressionUUID->
  "ca789b73-a08e-4537-9e7a-c40bf172fa24"],
 " = -",
 StyleBox["x",
  FontSlant->"Italic"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "8e4480ca-eed3-4440-a7e5-3f58282c7657"],
 ", y (0, -1, 2",
 Cell[BoxData[
  FormBox[
   SubscriptBox[")", "B"], TraditionalForm]],ExpressionUUID->
  "c88f1e9f-fdc1-4e5a-9688-5b870d44dcce"],
 " = 1 - ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "7a37f55e-0f6c-43e4-a70d-2e14da9b4850"],
 ".  Observemos que, en efecto,  son vectores propios asociados a los \
vectores propios 2, 1 y 0:"
}], "Text",
 CellChangeTimes->{{3.79739869286533*^9, 3.7973987210560675`*^9}, {
  3.797398830496495*^9, 3.7973989022852917`*^9}, {3.79739897303518*^9, 
  3.797399065005272*^9}, {3.7973990987154737`*^9, 3.797399269755574*^9}, {
  3.7973993375555305`*^9, 3.797399344114521*^9}, {3.797399444545272*^9, 
  3.797399460395417*^9}},ExpressionUUID->"7e6d60dd-0e5d-4232-8160-\
1ce2343987aa"],

Cell[TextData[{
 StyleBox["f",
  FontSlant->"Italic"],
 "(1 + ",
 StyleBox["x",
  FontSlant->"Italic"],
 ") = ",
 StyleBox["2",
  FontWeight->"Bold"],
 "\[CenterDot](1 + ",
 StyleBox["x",
  FontSlant->"Italic"],
 "), \n",
 StyleBox["f",
  FontSlant->"Italic"],
 "(-",
 StyleBox["x",
  FontSlant->"Italic"],
 " + ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "0539b4a5-06b7-4f18-95bc-d8bacfc8f230"],
 ") = ",
 StyleBox["1",
  FontWeight->"Bold"],
 "\[CenterDot](-",
 StyleBox["x",
  FontSlant->"Italic"],
 " + ",
