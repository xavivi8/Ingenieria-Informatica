Cell[CellGroupData[{

Cell["1. Diagonalizaci\[OAcute]n (por semejanza de un endomorfismo)", \
"Section",
 CellChangeTimes->{{3.795942121550845*^9, 3.7959421637268085`*^9}, {
   3.795943444086641*^9, 3.7959434453193865`*^9}, {3.7967151796380615`*^9, 
   3.7967151849180098`*^9}, {3.7967163936434174`*^9, 3.796716417658243*^9}, {
   3.7967455910277023`*^9, 3.7967455913151817`*^9}, {3.7973100427551346`*^9, 
   3.7973100666755114`*^9}, {3.797315234422002*^9, 3.7973152360662518`*^9}, 
   3.829972939791402*^9},ExpressionUUID->"e081d3fe-38d4-4882-a581-\
7e470598abba"],

Cell[TextData[{
 "Dado un endomorfismo, ",
 StyleBox["f",
  FontSlant->"Italic"],
 ": ",
 StyleBox["V",
  FontSlant->"Italic"],
 "  \[LongRightArrow] ",
 StyleBox["V,",
  FontSlant->"Italic"],
 " y dadas ",
 StyleBox["B",
  FontSlant->"Italic"],
 ", ",
 StyleBox["B",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote] dos bases de ",
 StyleBox["V",
  FontSlant->"Italic"],
 ", sabemos que las expresiones matriciales ",
 StyleBox["A",
  FontSlant->"Italic"],
 " y ",
 StyleBox["A",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote] de ",
 StyleBox["f ",
  FontSlant->"Italic"],
 "respectivamente de ",
 StyleBox["B",
  FontSlant->"Italic"],
 " y ",
 StyleBox["B\[CloseCurlyQuote]",
  FontSlant->"Italic"],
 ", son matrices semejantes, esto es, si ",
 StyleBox["P ",
  FontSlant->"Italic"],
 " es la matriz de cambio de base de ",
 StyleBox["B",
  FontSlant->"Italic"],
 " a ",
 StyleBox["B",
  FontSlant->"Italic"],
 "\[CloseCurlyQuote],"
}], "Text",
 CellChangeTimes->{{3.7967171489384937`*^9, 3.79671722691088*^9}, {
   3.7967172611385884`*^9, 3.7967172616082525`*^9}, {3.796742323041902*^9, 
   3.7967423238253736`*^9}, {3.7973587350344296`*^9, 3.797358998524328*^9}, {
   3.797359052324093*^9, 3.7973590576044407`*^9}, 3.797359786634433*^9, 
   3.7973970264951053`*^9},
 TextJustification->1.,ExpressionUUID->"82bfe09a-b415-45d5-a196-dd0048fdffed"],

Cell[BoxData[
 RowBox[{
  StyleBox["A",
   FontSlant->"Italic"], 
  StyleBox[" ",
   FontSlant->"Plain"], "=", " ", 
  RowBox[{
   SuperscriptBox[
    StyleBox["P",
     FontSlant->"Italic"], 
    StyleBox[
     RowBox[{"-", "1"}],
     FontSlant->"Plain"]], 
   StyleBox["\[CenterDot]",
    FontSlant->"Plain"], 
   StyleBox[
    RowBox[{"A", "'"}],
    FontSlant->"Italic"], 
   StyleBox["\[CenterDot]",
    FontSlant->"Italic"], 
   StyleBox["P",
    FontSlant->"Italic"]}]}]], "DisplayFormulaNumbered",
 CellChangeTimes->{{3.7967427882240534`*^9, 3.796742895572358*^9}, {
  3.7973590198642397`*^9, 3.7973590414641623`*^9}},
 TextAlignment->Center,ExpressionUUID->"ba55b008-da14-4bfd-98c6-3028915c0b5b"],

Cell[TextData[{
 "Un endomorfismo, ",
 StyleBox["f",
  FontSlant->"Italic"],
 ": ",
 StyleBox["V",
  FontSlant->"Italic"],
 "  \[LongRightArrow] ",
 StyleBox["V",
  FontSlant->"Italic"],
 " con matriz asociada respecto de una base ",
 StyleBox["A",
  FontSlant->"Italic"],
 ",",
 StyleBox[" ",
  FontSlant->"Italic"],
 "se dice que es ",
 StyleBox["diagonalizable por semejanza",
  FontVariations->{"Underline"->True}],
 " si existe una matriz diagonal ",
 StyleBox["D",
  FontSlant->"Italic"],
 " semejante a ",
 StyleBox["A",
  FontSlant->"Italic"],
 ", esto es, si existe una matriz regular ",
 StyleBox["P",
  FontSlant->"Italic"],
 ", tal que, ",
 StyleBox["D",
  FontSlant->"Italic"],
 " = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["P", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "1d70234e-9168-4b97-ab8d-fbb51e47cbdd"],
 "\[CenterDot]",
 StyleBox["A",
  FontSlant->"Italic"],
 "\[CenterDot]",
 StyleBox["P",
  FontSlant->"Italic"],
 "."
}], "Text",
 CellChangeTimes->{{3.797359080079129*^9, 3.797359302314247*^9}, 
   3.797397028785065*^9},
 TextJustification->1.,ExpressionUUID->"7786742b-ff41-4380-9d58-3bc6e2263c54"],

Cell[TextData[{
 "En teor\[IAcute]a se ha visto que, un endomorfismo ",
 StyleBox["f",
  FontSlant->"Italic"],
 ": ",
 StyleBox["V",
  FontSlant->"Italic"],
 "  \[LongRightArrow] ",
 StyleBox["V",
  FontSlant->"Italic"],
 "  es diagonalizable, s\[IAcute] y s\[OAcute]lo si, existe una base de \
vectores propios de ",
 StyleBox["V",
  FontSlant->"Italic"],
 ". Adem\[AAcute]s, la expresi\[OAcute]n matricial respecto de esa base de \
vectores propios, ser\[AAcute] la matriz diagonal en cuya diagonal aparecen \
los valores propios tantas veces como su multiplicidad."
}], "Text",
 CellChangeTimes->{{3.7959411533198276`*^9, 3.795941156238017*^9}, {
  3.795941200363332*^9, 3.7959412704428434`*^9}, {3.796714465923004*^9, 
  3.7967146330378304`*^9}, {3.79671481903825*^9, 3.7967148986278715`*^9}, {
  3.7967150538682423`*^9, 3.7967150598179207`*^9}, {3.7967423761586194`*^9, 
  3.7967427665516806`*^9}, {3.7973593221841707`*^9, 3.7973594324597883`*^9}, {
  3.797359813634469*^9, 3.79735983629424*^9}, {3.79740067587053*^9, 
  3.7974007065257483`*^9}},
 TextJustification->1.,ExpressionUUID->"6bb0a1e4-d5da-4b4e-b1ea-9dcd6379b8eb"],

Cell[TextData[{
 "Con Mathematica, el problema de la diagonalizaci\[OAcute]n por semejanza, \
esto es, determinar si existe una base de vectores propios, respecto de la \
cual, la matriz asociada al endomorfismo es diagonal, as\[IAcute] como de  la \
matriz regular ",
 StyleBox["P",
  FontSlant->"Italic"],
 ", est\[AAcute] totalmente resuelto con la funci\[OAcute]n ",
 StyleBox["Eigensystem[].",
  FontWeight->"Bold",
  FontColor->RGBColor[0.6, 0.4, 0.2]],
 StyleBox[" A esta funci\[OAcute]n le pasaremos la matriz asociada, y nos \
devolver\[AAcute]: los valores y vectores propios. ",
  FontColor->GrayLevel[0]]
}], "Text",
 CellChangeTimes->{{3.797359445334256*^9, 3.7973596284592204`*^9}, 
   3.797359751974454*^9, {3.7973598476540956`*^9, 3.7973598771156726`*^9}, {
   3.7973603635844703`*^9, 3.797360377064387*^9}, {3.7973614365046396`*^9, 
   3.7973616615545893`*^9}, {3.7973970567753386`*^9, 
   3.7973970812952805`*^9}, {3.7974007259856005`*^9, 3.7974007582859306`*^9}},
 TextJustification->1.,ExpressionUUID->"eb415245-3c80-4b5a-a936-f02759267037"],

Cell[TextData[{
 StyleBox["En los siguientes ejemplos veremos c\[OAcute]mo hacer los c\
\[AAcute]lculos, desde lo aprendido en las clases de teor\[IAcute]a, Y/o \
directamente usando las funciones de Mathematica ",
  FontColor->GrayLevel[0]],
 StyleBox["Eigenvalues[]",
  FontWeight->"Bold",
  FontColor->RGBColor[0.6, 0.4, 0.2]],
 StyleBox[", ",
  FontColor->GrayLevel[0]],
 StyleBox["Eigenvectors[]",
  FontWeight->"Bold",
  FontColor->RGBColor[0.6, 0.4, 0.2]],
 StyleBox[" y ",
  FontColor->GrayLevel[0]],
 StyleBox["Eigensystem[]",
  FontWeight->"Bold",
  FontColor->RGBColor[0.6, 0.4, 0.2]],
 StyleBox[".",
  FontColor->GrayLevel[0]]
}], "Text",
