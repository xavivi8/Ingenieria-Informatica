Cell[CellGroupData[{

Cell["Ejercicio 16 relaci\[OAcute]n 1", "Subsection",
 CellChangeTimes->{{3.970985534857996*^9, 
  3.970985546773861*^9}},ExpressionUUID->"996e43aa-daca-0a43-b237-\
14f549fad7f1"],

Cell["\<\
Se tienen las siguientes premisas:
\[OpenCurlyDoubleQuote]Si Fernando tiene suerte y llueve entonces estudia\
\[CloseCurlyDoubleQuote]\[LineSeparator]\[OpenCurlyDoubleQuote]Fernando \
aprobar\[AAcute] si y s\[OAcute]lo si estudia o tiene suerte\
\[CloseCurlyDoubleQuote]\[LineSeparator]\[OpenCurlyDoubleQuote]Si Fernando no \
tiene suerte entonces no \
llueve\[CloseCurlyDoubleQuote]\[LineSeparator]Sabiendo que llueve, utiliza la \
l\[OAcute]gica proposicional para responder a las siguientes preguntas:
i) \[DownQuestion]Aprobar\[AAcute] Fernando?
i)\[DownQuestion]Tendr\[AAcute] suerte Fernando?\
\>", "Text",
 CellChangeTimes->{{3.970985557743025*^9, 3.9709856709635334`*^9}, {
  3.970985777232092*^9, 
  3.9709857949567375`*^9}},ExpressionUUID->"2361403e-37cb-734a-baeb-\
d50ce97a56b8"],

Cell["\<\
Tener suerte (p)
Llover (q)
Estudiar (r)
Aprobar (s)\
\>", "Text",
 CellChangeTimes->{
  3.970985801905405*^9},ExpressionUUID->"48b48a8b-4a22-5c40-8db1-\
d04b81160e15"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Premisa1", "[", 
   RowBox[{"{", 
    RowBox[{"p_", ",", "q_", ",", "r_", ",", "s_"}], "}"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"p", "\[And]", "q"}], ")"}], "\[Implies]", "r"}], ")"}]}], "\n", 
 RowBox[{
  RowBox[{"Premisa2", "[", 
   RowBox[{"{", 
    RowBox[{"p_", ",", "q_", ",", "r_", ",", "s_"}], "}"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{"s", "\[Equivalent]", 
    RowBox[{"(", 
     RowBox[{"r", "\[Or]", "p"}], ")"}]}], ")"}]}], "\n", 
 RowBox[{
  RowBox[{"Premisa3", "[", 
   RowBox[{"{", 
    RowBox[{"p_", ",", "q_", ",", "r_", ",", "s_"}], "}"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"\[Not]", "p"}], ")"}], "\[Implies]", 
    RowBox[{"(", 
     RowBox[{"\[Not]", "q"}], ")"}]}], ")"}]}], "\n", 
 RowBox[{
  RowBox[{"Premisa4", "[", 
   RowBox[{"{", 
    RowBox[{"p_", ",", "q_", ",", "r_", ",", "s_"}], "}"}], "]"}], ":=", 
  "q"}], "\n", 
 RowBox[{
  RowBox[{"Conclusion1", "[", 
   RowBox[{"{", 
    RowBox[{"p_", ",", "q_", ",", "r_", ",", "s_"}], "}"}], "]"}], ":=", 
  "s"}], "\n", 
 RowBox[{
  RowBox[{"Conclusion2", "[", 
   RowBox[{"{", 
    RowBox[{"p_", ",", "q_", ",", "r_", ",", "s_"}], "}"}], "]"}], ":=", 
  "p"}], "\n", 
 RowBox[{
  RowBox[{"Argumentacion1", "[", 
   RowBox[{"{", 
    RowBox[{"p_", ",", "q_", ",", "r_", ",", "s_"}], "}"}], "]"}], ":=", 
  RowBox[{"Implies", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Premisa1", "[", 
      RowBox[{"{", 
       RowBox[{"p", ",", "q", ",", "r", ",", "s"}], "}"}], "]"}], "&&", 
     RowBox[{"Premisa2", "[", 
      RowBox[{"{", 
       RowBox[{"p", ",", "q", ",", "r", ",", "s"}], "}"}], "]"}], "&&", 
     RowBox[{"Premisa3", "[", 
      RowBox[{"{", 
       RowBox[{"p", ",", "q", ",", "r", ",", "s"}], "}"}], "]"}], "&&", 
     RowBox[{"Premisa4", "[", 
      RowBox[{"{", 
       RowBox[{"p", ",", "q", ",", "r", ",", "s"}], "}"}], "]"}]}], ",", 
    RowBox[{"Conclusion1", "[", 
     RowBox[{"{", 
      RowBox[{"p", ",", "q", ",", "r", ",", "s"}], "}"}], "]"}]}], 
   "]"}]}], "\n", 
 RowBox[{
  RowBox[{"Argumentacion2", "[", 
