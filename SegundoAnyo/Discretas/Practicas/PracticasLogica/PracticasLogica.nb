Cell["Ejercicio 17 relaci\[OAcute]n 1", "Subsection",
 CellChangeTimes->{{3.9709861037745323`*^9, 
  3.9709861064047737`*^9}},ExpressionUUID->"a9ec4f6c-053a-154a-9e61-\
