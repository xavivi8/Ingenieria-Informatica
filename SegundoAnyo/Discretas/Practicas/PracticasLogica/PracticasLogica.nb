Cell["\<\
Dar una forma enunciativa con 3 variables que sea tautolog\[IAcute]a y otra \
con 4 variables que sea contradicci\[OAcute]n. Comprobarlo con Mathematica.\
\>", "Subsection",
 CellChangeTimes->{
  3.970985412912979*^9},ExpressionUUID->"ef05bb1f-ff58-744a-a2cc-\
cd9700dcf3cb"],

Cell["\<\
Para inventarmelas parto de la siguiente idea:
algo o su negacion es tautolog\[IAcute]a
algo y su negaci\[OAcute]n es contradicci\[OAcute]n\
\>", "Text",
 CellChangeTimes->{
  3.970985513524185*^9},ExpressionUUID->"b69fd1a8-0859-584b-b8b5-\
2cbd11cd4eaf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"FormaEnunciativaT", "[", 
   RowBox[{"{", 
    RowBox[{"p_", ",", "q_", ",", "r_"}], "}"}], "]"}], ":=", 
  RowBox[{"Or", "[", 
   RowBox[{
    RowBox[{"Or", "[", 
     RowBox[{"p", ",", 
      RowBox[{"Not", "[", "p", "]"}]}], "]"}], ",", 
    RowBox[{"Implies", "[", 
     RowBox[{"r", ",", 
      RowBox[{"Xor", "[", 
       RowBox[{"r", ",", "p"}], "]"}]}], "]"}]}], "]"}]}], "\n", 
 RowBox[{"TablaVerdad", "[", 
  RowBox[{"FormaEnunciativaT", ",", 
   RowBox[{"{", 
    RowBox[{"\"\<p\>\"", ",", "\"\<q\>\"", ",", "\"\<r\>\""}], "}"}]}], 
  "]"}]}], "Code",
