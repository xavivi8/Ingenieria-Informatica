     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Imagen", "=", 
       RowBox[{"Union", "[", 
        RowBox[{"Imagen", ",", 
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{"{", "}"}], ",", 
           RowBox[{"f", "[", 
            RowBox[{"A", "[", 
