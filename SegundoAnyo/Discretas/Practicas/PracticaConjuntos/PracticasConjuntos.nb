Cell[BoxData[
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Length", "[", "Dominio", "]"}], "==", 
    RowBox[{"Length", "[", "Codominio", "]"}]}], ",", " ", 
   RowBox[{"(*", 
    RowBox[{
    "Compruebo", " ", "que", " ", "dominio", " ", "y", " ", "codominio", " ", 
     "tienen", " ", "los", " ", "mismos", " ", "elementos", " ", "para", " ", 
     "poder", " ", "definir", " ", "una", " ", "aplicaci\[OAcute]n", " ", 
     "biyectiva"}], "*)"}], "\n", "\t", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"i", "=", "1"}], ",", " ", 
     RowBox[{"i", "<=", 
