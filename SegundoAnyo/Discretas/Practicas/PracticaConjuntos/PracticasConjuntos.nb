Cell["d) Una aplicaci\[OAcute]n no sobreyectiva de P(AxB) en AxB", "Text",
 CellChangeTimes->{{3.971101522475363*^9, 
  3.9711015373974934`*^9}},ExpressionUUID->"8537c16d-f241-9c47-99cc-\
b21bf025d4b1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Dominio", "=", 
   RowBox[{"Subsets", "[", 
    RowBox[{"CARTESIANO", "[", 
     RowBox[{"{", 
      RowBox[{"X", ",", "Y"}], "}"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Codominio", "=", 
   RowBox[{"CARTESIANO", "[", 
    RowBox[{"{", 
     RowBox[{"X", ",", "Y"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", " ", 
   RowBox[{"i", "<=", 
    RowBox[{"Length", "[", "Dominio", "]"}]}], ",", " ", 
   RowBox[{"i", "++"}], ",", "\n", "\t\t", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", 
      RowBox[{"Dominio", "[", 
       RowBox[{"[", "i", "]"}], "]"}], "]"}], "=", 
     RowBox[{"Codominio", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], "\n", "]"}], "\n", 
 RowBox[{
  RowBox[{"A", "=", "Dominio"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"B", "=", "Codominio"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Imagen", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Imagen", "=", 
     RowBox[{"Union", "[", 
      RowBox[{"Imagen", ",", 
       RowBox[{"Append", "[", 
        RowBox[{
         RowBox[{"{", "}"}], ",", 
         RowBox[{"f", "[", 
          RowBox[{"A", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "]"}]}], "]"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "1", ",", 
      RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<El conjunto imagen es: \>\"", ",", "Imagen"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", "Imagen", "]"}], "\[Equal]", 
     RowBox[{"Length", "[", "B", "]"}]}], ",", 
    RowBox[{"Print", "[", "\"\<Es sobreyectiva\>\"", "]"}], ",", 
    RowBox[{"Print", "[", "\"\<No es sobreyectiva\>\"", "]"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", "A", "]"}], "\[Equal]", 
     RowBox[{"Length", "[", "Imagen", "]"}]}], ",", 
    RowBox[{"Print", "[", "\"\<Es inyectiva\>\"", "]"}], ",", 
    RowBox[{"Print", "[", "\"\<No es inyectiva\>\"", "]"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "A", "]"}], "\[Equal]", 
      RowBox[{"Length", "[", "B", "]"}]}], "&&", 
     RowBox[{
      RowBox[{"Length", "[", "B", "]"}], "\[Equal]", 
      RowBox[{"Length", "[", "Imagen", "]"}]}]}], ",", 
    RowBox[{"Print", "[", "\"\<Es biyectiva\>\"", "]"}], ",", 
    RowBox[{"Print", "[", "\"\<No es biyectiva\>\"", "]"}]}], "]"}], 
  ";"}]}], "Code",
 CellChangeTimes->{{3.971102053099972*^9, 3.971102064867216*^9}},
 CellLabel->"In[40]:=",ExpressionUUID->"762dc7be-f31a-6a42-a31a-93a1cf15c18d"],

