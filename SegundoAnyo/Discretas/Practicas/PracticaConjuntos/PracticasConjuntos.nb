Cell["\<\
b) Representa con Mathematica el diagrama de orden de X, Y y Z\
\>", "Text",
 CellChangeTimes->{{3.9711463279089127`*^9, 
  3.9711463561551247`*^9}},ExpressionUUID->"4f4b8396-3fa1-c041-bf9d-\
34022d804aa0"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "=", "X814"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R", "=", "R814"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Clear", "[", "Coord", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tabla", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"i1", ",", 
       RowBox[{"Length", "[", "A", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j1", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"B", "=", "A"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t1", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nivel", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{"B", "\[NotEqual]", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{
     RowBox[{"minimales", "=", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"nivel", "++"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"minimal", "=", "True"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Intersection", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"{", 
