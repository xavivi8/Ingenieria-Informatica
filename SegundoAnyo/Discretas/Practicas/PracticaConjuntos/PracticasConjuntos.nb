Cell["Demostraci\[OAcute]n de que A es una partici\[OAcute]n", "Text",
 CellChangeTimes->{{3.9711456009331017`*^9, 
  3.9711456091932087`*^9}},ExpressionUUID->"d9dd0acb-e00e-a341-af31-\
6b1809237652"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"A1", "=", 
   RowBox[{"{", "1", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"A2", "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "4"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"A1", "!=", 
    RowBox[{"{", "}"}]}], " ", "&&", " ", 
   RowBox[{"A2", "!=", 
    RowBox[{"{", "}"}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "ningun", " ", "elemento", " ", "de", " ", "la", " ", "particion", " ", 
    "es", " ", "vacio"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Intersection", "[", 
    RowBox[{"A1", ",", "A2"}], "]"}], "==", 
   RowBox[{"{", "}"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"son", " ", "disjuntos", " ", "dos", " ", "a", " ", "dos"}], ",", 
    " ", 
    RowBox[{
    "si", " ", "hay", " ", "mas", " ", "elementos", " ", "en", " ", "la", " ",
      "particion", " ", "hay", " ", "que", " ", "hacer", " ", "m\[AAcute]s", 
     " ", "comprobaciones"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"Union", "[", 
   RowBox[{"A1", ",", "A2"}], "]"}], "==", "A88", " ", 
  RowBox[{"(*", 
   RowBox[{
   "La", " ", "uni\[OAcute]n", " ", "de", " ", "todos", " ", "da", " ", "el", 
    " ", "total"}], "*)"}]}]}], "Code",
 CellChangeTimes->{{3.971145613635355*^9, 3.9711456204686756`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"197009aa-5cdd-164c-946a-27bbd0485cf3"],

