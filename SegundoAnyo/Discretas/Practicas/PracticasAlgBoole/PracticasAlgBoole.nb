      RowBox[{"Compl", "[", "y", "]"}]}], "]"}]}], ";"}], 
  RowBox[{"(*", "Implicacion", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f13", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"f11", "[", 
     RowBox[{"y", ",", "x"}], "]"}]}], ";"}], 
  RowBox[{"(*", "Contraimplicacion", "*)"}]}]}], "Code",
