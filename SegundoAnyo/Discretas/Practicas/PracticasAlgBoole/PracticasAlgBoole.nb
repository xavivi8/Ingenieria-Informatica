Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Forma can\[OAcute]nica en mint\[EAcute]rminos es: \"\>", 
   "\[InvisibleSpace]", "\<\"f103(x,y,z) = \"\>", "\[InvisibleSpace]", 
   TemplateBox[{
     TemplateBox[{
      "\"(\"", "\"x\"", "\"\[And]\"", "\"y\"", "\"\[And]\"", "\"z\"", 
       "\")\""}, "RowDefault"], "\" \[Or] \"", 
     TemplateBox[{"\"(\"", "\"x\"", "\"\[And]\"", 
       OverscriptBox["\"y\"", "_"], "\"\[And]\"", "\"z\"", "\")\""}, 
      "RowDefault"]},
    "RowDefault"]}],
  SequenceForm[
  "Forma can\[OAcute]nica en mint\[EAcute]rminos es: ", "f103(x,y,z) = ", 
   Row[{
     Row[{"(", "x", "\[And]", "y", "\[And]", "z", ")"}], " \[Or] ", 
     Row[{"(", "x", "\[And]", 
       OverBar["y"], "\[And]", "z", ")"}]}]],
  Editable->False]], "Print",
 CellChangeTimes->{3.974002156434494*^9, 3.9740116722186184`*^9},
