In[67]:=",ExpressionUUID->"52354abb-1e1b-6647-8006-241f33831bb8"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Forma can\[OAcute]nica en maxt\[EAcute]rminos es: \"\>", 
   "\[InvisibleSpace]", "\<\"f103(x,y,z) = \"\>", "\[InvisibleSpace]", 
   TemplateBox[{
     TemplateBox[{"\"(\"", "\"x\"", "\"\[Or]\"", 
       OverscriptBox["\"y\"", "_"], "\"\[Or]\"", 
       OverscriptBox["\"z\"", "_"], "\")\""}, "RowDefault"], "\" \[And] \"", 
     TemplateBox[{"\"(\"", "\"x\"", "\"\[Or]\"", "\"y\"", "\"\[Or]\"", 
       OverscriptBox["\"z\"", "_"], "\")\""}, "RowDefault"], "\" \[And] \"", 
     TemplateBox[{"\"(\"", 
       OverscriptBox["\"x\"", "_"], "\"\[Or]\"", 
       OverscriptBox["\"y\"", "_"], "\"\[Or]\"", "\"z\"", "\")\""}, 
      "RowDefault"], "\" \[And] \"", 
     TemplateBox[{"\"(\"", "\"x\"", "\"\[Or]\"", 
       OverscriptBox["\"y\"", "_"], "\"\[Or]\"", "\"z\"", "\")\""}, 
