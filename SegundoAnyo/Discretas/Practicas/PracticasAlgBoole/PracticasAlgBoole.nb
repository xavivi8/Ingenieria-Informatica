Cell["\<\
Sean A={a,b,c}, B={1,2,3}, A1={a,b} y B1={2,3}. Definir, si existe, una \
aplicaci\[OAcute]n biyectiva f:AxP(B1) -> P(A1)xB y hacer todas las \
comprobaciones expl\[IAcute]citamente\
\>", "Text",
 CellChangeTimes->{{3.971102097998461*^9, 
  3.971102187570099*^9}},ExpressionUUID->"4aa8fc1b-3c3b-b34c-ba9c-\
9e6210346bdc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"A18", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<a\>\"", ",", "\"\<b\>\"", ",", "\"\<c\>\""}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"B18", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2", ",", "3"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"A181", "=", 
   RowBox[{"{", 
    RowBox[{"\"\<a\>\"", ",", "\"\<b\>\""}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"B181", "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Dominio", "=", 
   RowBox[{"CARTESIANO", "[", 
    RowBox[{"{", 
     RowBox[{"A18", ",", 
      RowBox[{"Subsets", "[", "B181", "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Codominio", "=", 
   RowBox[{"CARTESIANO", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Subsets", "[", "A181", "]"}], ",", "B18"}], "}"}], "]"}]}], 
  ";"}], "\n", "Dominio", "\n", "Codominio", "\n", 
 RowBox[{
  RowBox[{
   StyleBox["A",
    FontColor->GrayLevel[0]], 
   StyleBox["=",
    FontColor->GrayLevel[0]], "Dominio"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   StyleBox["B",
    FontColor->GrayLevel[0]], 
   StyleBox["=",
    FontColor->GrayLevel[0]], "Codominio"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Imagen", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
