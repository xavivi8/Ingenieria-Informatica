Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "=", "A81"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R", "=", "R81a"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Clear", "[", "Coord", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tabla", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"i1", ",", 
       RowBox[{"Length", "[", "A", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j1", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"B", "=", "A"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t1", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nivel", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{"B", "\[NotEqual]", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{
     RowBox[{"minimales", "=", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"nivel", "++"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"minimal", "=", "True"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Intersection", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"B", "[", 
                    RowBox[{"[", "m1", "]"}], "]"}], ",", 
                    RowBox[{"B", "[", 
                    RowBox[{"[", "n1", "]"}], "]"}]}], "}"}], "}"}], ",", 
                 "R"}], "]"}], "\[NotEqual]", 
               RowBox[{"{", "}"}]}], "&&", 
              RowBox[{"n1", "\[NotEqual]", "m1"}]}], ",", 
             RowBox[{"minimal", "=", "False"}]}], "]"}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"m1", ",", "1", ",", 
            RowBox[{"Length", "[", "B", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"minimal", ",", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"minimales", ",", 
             RowBox[{"B", "[", 
              RowBox[{"[", "n1", "]"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"tabla", "[", 
             RowBox[{"[", "t1", "]"}], "]"}], "=", 
            RowBox[{"{", 
             RowBox[{"nivel", ",", 
              RowBox[{"B", "[", 
               RowBox[{"[", "n1", "]"}], "]"}], ",", "0"}], "}"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"t1", "++"}], ";"}]}], "]"}], ";"}], ",", 
       RowBox[{"{", 
        RowBox[{"n1", ",", "1", ",", 
         RowBox[{"Length", "[", "B", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"B", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{"B", ",", "minimales"}], "]"}]}], ";"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R1", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"R1", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"[", "i1", "]"}], "]"}], ",", 
        RowBox[{"A", "[", 
         RowBox[{"[", "i1", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i1", ",", "1", ",", 
      RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R", "=", 
   RowBox[{"Complement", "[", 
    RowBox[{"R", ",", "R1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R1", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"Intersection", "[", 
            RowBox[{"R", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"R", "[", 
                  RowBox[{"[", 
                   RowBox[{"k1", ",", "1"}], "]"}], "]"}], ",", 
                 RowBox[{"A", "[", 
                  RowBox[{"[", "j1", "]"}], "]"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"A", "[", 
                  RowBox[{"[", "j1", "]"}], "]"}], ",", 
                 RowBox[{"R", "[", 
                  RowBox[{"[", 
                   RowBox[{"k1", ",", "2"}], "]"}], "]"}]}], "}"}]}], "}"}]}],
             "]"}], "]"}], "\[Equal]", "2"}], ",", 
         RowBox[{
          RowBox[{"R1", "=", 
           RowBox[{"Union", "[", 
            RowBox[{"R1", ",", 
             RowBox[{"{", 
              RowBox[{"R", "[", 
               RowBox[{"[", "k1", "]"}], "]"}], "}"}]}], "]"}]}], ";"}]}], 
        "]"}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"j1", ",", "1", ",", 
        RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"k1", ",", "1", ",", 
      RowBox[{"Length", "[", "R", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R", "=", 
   RowBox[{"Complement", "[", 
    RowBox[{"R", ",", "R1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"puntos", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"t1", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"cont", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"tabla", "[", 
           RowBox[{"[", 
            RowBox[{"i1", ",", "1"}], "]"}], "]"}], "\[Equal]", "j1"}], ",", 
         RowBox[{"cont", "=", 
          RowBox[{"cont", "+", "1"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i1", ",", "1", ",", 
         RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"t1", "++"}], ";", "\[IndentingNewLine]", 
        RowBox[{"puntos", "=", 
         RowBox[{"Union", "[", 
          RowBox[{"puntos", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Text", "[", 
              RowBox[{
               RowBox[{"Style", "[", 
                RowBox[{
                 RowBox[{"tabla", "[", 
                  RowBox[{"[", 
                   RowBox[{"t1", ",", "2"}], "]"}], "]"}], ",", "Large", ",", 
                 "Bold", ",", "Red", ",", 
                 RowBox[{"Background", "\[Rule]", "None"}], ",", 
                 RowBox[{"FontFamily", "\[Rule]", "Times"}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"k1", "-", 
                  RowBox[{"(", 
                   RowBox[{"cont", "/", "2"}], ")"}], "-", ".1"}], ",", 
                 RowBox[{"j1", "+", ".1"}]}], "}"}]}], "]"}], ",", 
             RowBox[{"Point", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"k1", "-", 
                 RowBox[{"(", 
                  RowBox[{"cont", "/", "2"}], ")"}]}], ",", "j1"}], "}"}], 
              "]"}]}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"tabla", "[", 
          RowBox[{"[", 
           RowBox[{"t1", ",", "3"}], "]"}], "]"}], "=", 
         RowBox[{"k1", "-", 
          RowBox[{"(", 
           RowBox[{"cont", "/", "2"}], ")"}]}]}], ";"}], ",", 
       RowBox[{"{", 
        RowBox[{"k1", ",", "1", ",", "cont"}], "}"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"j1", ",", "1", ",", 
      RowBox[{"tabla", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"Length", "[", "A", "]"}], ",", "1"}], "]"}], "]"}]}], 
     "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Coord", "[", "elem_", "]"}], ":=", 
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"elem", "\[Equal]", 
        RowBox[{"tabla", "[", 
         RowBox[{"[", 
          RowBox[{"h1", ",", "2"}], "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"Coord", "[", "elem", "]"}], "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"tabla", "[", 
           RowBox[{"[", 
            RowBox[{"h1", ",", "3"}], "]"}], "]"}], ",", 
          RowBox[{"tabla", "[", 
           RowBox[{"[", 
            RowBox[{"h1", ",", "1"}], "]"}], "]"}]}], "}"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"h1", ",", "1", ",", 
       RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Coord", "[", 
     RowBox[{"A", "[", 
      RowBox[{"[", "i1", "]"}], "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i1", ",", "1", ",", 
      RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"AppendTo", "[", 
      RowBox[{"puntos", ",", 
       RowBox[{"Arrow", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Coord", "[", 
           RowBox[{"R", "[", 
            RowBox[{"[", 
             RowBox[{"t1", ",", "1"}], "]"}], "]"}], "]"}], ",", 
          RowBox[{"Coord", "[", 
           RowBox[{"R", "[", 
            RowBox[{"[", 
             RowBox[{"t1", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}], "]"}]}], 
      "]"}], ";"}], ",", 
    RowBox[{"{", 
     RowBox[{"t1", ",", "1", ",", 
      RowBox[{"Length", "[", "R", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{"Print", "[", "\"\<Diagrama de orden:\>\"", "]"}], "\n", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Graphics", "[", "puntos", "]"}], ",", 
   RowBox[{"AspectRatio", "\[Rule]", "1"}], ",", 
   RowBox[{"Background", "\[Rule]", "None"}]}], "]"}]}], "Code",
