  RowBox[{"A95", "=", 
   RowBox[{"Subsets", "[", 
    RowBox[{"{", 
     RowBox[{"6", ",", "8", ",", "2"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"D95", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", " ", 
   RowBox[{"i", "<=", 
    RowBox[{"Length", "[", "A95", "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", "\n", "\t", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"j", "=", "1"}], ",", " ", 
     RowBox[{"j", "<=", 
      RowBox[{"Length", "[", "A95", "]"}]}], ",", 
     RowBox[{"j", "++"}], ",", "\n", "\t\t", 
     RowBox[{"If", "[", 
