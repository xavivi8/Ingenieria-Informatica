Cell["\<\
Sea Consideramos la funci\[OAcute]n booleana elemental de 3 entradas: \
\>", "Text",
 CellChangeTimes->{{3.97114565098958*^9, 3.971145727409418*^9}, {
  3.9740028244008083`*^9, 3.9740028589368343`*^9}, {3.9740038312196274`*^9, 
  3.9740038342424526`*^9}},ExpressionUUID->"2583c2d1-fa37-3742-8488-\
3d790d91461e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"f3extra", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
  RowBox[{"f7", "[", 
   RowBox[{
    RowBox[{"f1", "[", 
     RowBox[{
      RowBox[{"Compl", "[", "y", "]"}], ",", "z"}], "]"}], ",", 
    RowBox[{"Compl", "[", 
     RowBox[{"f7", "[", 
      RowBox[{"x", ",", 
       RowBox[{"f11", "[", 
        RowBox[{"y", ",", 
         RowBox[{"Compl", "[", "z", "]"}]}], "]"}]}], "]"}], "]"}]}], 
   "]"}]}], "\n", 
 RowBox[{
  RowBox[{"f3extraLog", "[", 
   RowBox[{"{", 
    RowBox[{"x_", ",", "y_", ",", "z_"}], "}"}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"\[Not]", "y"}], ")"}], "\[Nor]", "z"}], ")"}], "\[Nand]", " ", 
    RowBox[{"(", 
     RowBox[{"\[Not]", 
      RowBox[{"(", 
       RowBox[{"x", "\[Nand]", 
        RowBox[{"(", 
         RowBox[{"y", "\[Implies]", 
          RowBox[{"(", 
           RowBox[{"\[Not]", "z"}], ")"}]}], ")"}]}], ")"}]}], ")"}]}], 
   ")"}]}]}], "Code",
 CellChangeTimes->{{3.9740028695029125`*^9, 3.974002984148901*^9}, {
  3.9740037636711674`*^9, 3.9740038998067226`*^9}},
 CellLabel->"In[75]:=",ExpressionUUID->"2f862d97-15c8-f049-8deb-752b558a9fdd"],

