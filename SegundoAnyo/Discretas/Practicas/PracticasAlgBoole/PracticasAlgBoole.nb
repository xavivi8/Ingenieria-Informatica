Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f1", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Compl", "[", 
     RowBox[{"f14", "[", 
      RowBox[{"x", ",", "y"}], "]"}], "]"}]}], ";"}], 
  RowBox[{"(*", "NOR", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f2", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"f8", "[", 
     RowBox[{
      RowBox[{"Compl", "[", "x", "]"}], ",", "y"}], "]"}]}], ";"}], 
  RowBox[{"(*", "--", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f4", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"f8", "[", 
     RowBox[{"x", ",", 
      RowBox[{"Compl", "[", "y", "]"}]}], "]"}]}], ";"}], 
  RowBox[{"(*", "--", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f6", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Mod", "[", 
     RowBox[{
      RowBox[{"x", "+", "y"}], ",", "2"}], "]"}]}], ";"}], 
  RowBox[{"(*", "XOR", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f9", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Compl", "[", 
     RowBox[{"f6", "[", 
      RowBox[{"x", ",", "y"}], "]"}], "]"}]}], ";"}], 
  RowBox[{"(*", "bicondicional", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f11", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
