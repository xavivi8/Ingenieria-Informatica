Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f14", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Compl", "[", 
     RowBox[{"f8", "[", 
      RowBox[{
       RowBox[{"Compl", "[", "x", "]"}], ",", 
       RowBox[{"Compl", "[", "y", "]"}]}], "]"}], "]"}]}], ";"}], 
