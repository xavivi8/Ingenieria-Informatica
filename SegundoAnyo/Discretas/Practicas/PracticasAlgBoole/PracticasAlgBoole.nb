Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f0", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", "0"}], ";"}], 
  RowBox[{"(*", 
