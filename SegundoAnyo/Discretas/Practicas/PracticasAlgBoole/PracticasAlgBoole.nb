Cell["\<\
Sea D el conjunto de los n\[UAcute]meros que son divisores positivos de 70. \
En D se considera la relaci\[OAcute]n de orden dada por:
\t\t\t\t\ta \[LessEqual] b \[DoubleLeftRightArrow] a divide a b\
\>", "Text",
 CellChangeTimes->{{3.971102097998461*^9, 3.971102187570099*^9}, {
  3.973836632045433*^9, 
  3.9738366397551193`*^9}},ExpressionUUID->"4aa8fc1b-3c3b-b34c-ba9c-\
9e6210346bdc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"D93", " ", "=", " ", 
   RowBox[{"Divisors", "[", 
    RowBox[{"2", "*", "6", "*", "8"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tam", " ", "=", " ", 
   RowBox[{"Length", "[", "D93", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RD93", " ", "=", " ", 
    RowBox[{"{", "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", " ", "=", " ", "1"}], ",", " ", 
    RowBox[{"i", " ", "<=", " ", "tam"}], ",", " ", 
    RowBox[{"i", "++"}], ",", "\n", "  ", 
    RowBox[{"For", "[", 
     RowBox[{
      RowBox[{"j", " ", "=", " ", "1"}], ",", " ", 
      RowBox[{"j", " ", "<=", " ", "tam"}], ",", " ", 
      RowBox[{"j", "++"}], ",", "\n", "    ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"D93", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
           RowBox[{"D93", "[", 
            RowBox[{"[", "j", "]"}], "]"}]}], "]"}], " ", "==", " ", "0"}], 
        ",", "\n", "      ", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"RD93", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"D93", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
            RowBox[{"D93", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "}"}]}], "]"}]}], "\n", "    ",
        "]"}]}], "\n", "  ", "]"}]}], "\n", "]"}], 
  "\n"}], "\n", "RD93"}], "Code",
 CellChangeTimes->{{3.971102195823683*^9, 3.9711022398366623`*^9}, 
   3.973836644617876*^9, {3.974006438115713*^9, 3.9740066681870537`*^9}, {
