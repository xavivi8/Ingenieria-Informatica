 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f10", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", "y"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"Igual", " ", "a", " ", "la", " ", "segunda", " ", "variable"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f12", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", "x"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"Igual", " ", "a", " ", "la", " ", "primera", " ", "variable"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f15", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", "1"}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"Constante", " ", "igual", " ", "a", " ", "1"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f8", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"x", "*", "y"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{"Conjunci\[OAcute]n", " ", "o", " ", "producto"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f7", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Compl", "[", 
     RowBox[{"f8", "[", 
      RowBox[{"x", ",", "y"}], "]"}], "]"}]}], ";"}], 
  RowBox[{"(*", "NAND", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f3", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Compl", "[", "x", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "Complemento", " ", "o", " ", "negaci\[OAcute]n", " ", "de", " ", "x"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f5", "[", 
     RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
    RowBox[{"Compl", "[", "y", "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "Complemento", " ", "o", " ", "negaci\[OAcute]n", " ", "de", " ", "y"}], 
   "*)"}]}]}], "Code",
