Cell["Ejercicio 11.9", "Subsection",
 CellChangeTimes->{{3.968316042262003*^9, 3.9683160519463043`*^9}, {
  3.9711452077746696`*^9, 3.971145208239649*^9}, {3.974020018835018*^9, 
  3.9740200203269196`*^9}},ExpressionUUID->"58e8953f-f1f0-8a4c-bab6-\
f1a4c2c9d77e"],

Cell["\<\
Sea c el resto de dividir tu DNI entre 100. Encontrar, si existen, los n\
\[UAcute]meros x\[Element]\[DoubleStruckCapitalZ] tales que verifiquen simult\
\[AAcute]neamente:
I. (c+2)|x
II. El resto de dividir x entre (c+3) es 1\
\>", "Text",
 CellChangeTimes->{{3.9683161074641304`*^9, 3.9683161233382397`*^9}, {
  3.968316204919525*^9, 3.9683162280469055`*^9}, {3.9711452117413197`*^9, 
  3.971145276728483*^9}, {3.971145348481861*^9, 3.971145349212324*^9}, {
  3.974020241953165*^9, 
  3.9740203847012615`*^9}},ExpressionUUID->"27d7784d-2719-3447-a53c-\
ebefd92a9abb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"c", "=", 
  RowBox[{"Mod", "[", 
   RowBox[{"26268082", ",", "100"}], "]"}]}]], "Code",
 CellChangeTimes->{{3.971145358887512*^9, 3.971145388230297*^9}, {
  3.974020393499176*^9, 3.9740203976505527`*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"29b89925-1385-804e-9651-f576243893c3"],

Cell[BoxData["82"], "Output",
 CellChangeTimes->{3.974020398449789*^9},
 CellLabel->"Out[20]=",ExpressionUUID->"77f6d50c-d724-f94d-946b-02e456bf6dba"]
}, Open  ]],

Cell["\<\
x tiene resto 0 al dividir entre c+2
x tiene resto 1 al dividir entre c+3\
\>", "Text",
 CellChangeTimes->{
  3.974020421049078*^9},ExpressionUUID->"0de6b2e9-753a-b945-b20c-\
4658fa443fdf"],

