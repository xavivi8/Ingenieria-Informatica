 RowBox[{
  RowBox[{"y", "[", "t_", "]"}], ":=", 
  RowBox[{"y0", "+", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"a", "/", "mcd"}], ")"}], "*", "t"}]}]}], "\n", 
 RowBox[{"x", "[", "t", "]"}], "\n", 
