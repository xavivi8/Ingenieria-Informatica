2b4919732d4e"],

Cell["\<\
Si x, y, z son los \[AAcute]ngulos de un tri\[AAcute]ngulo expresados en \
grados. Suponiendo que x, y, z son n\[UAcute]meros enteros, calcular todos \
los tri\[AAcute]ngulos cuyos \[AAcute]ngulos verifiquen la siguiente ecuaci\
\[OAcute]n
\t\t\t\t2x+5y=3z\
\>", "Text",
 CellChangeTimes->{{3.9740153606962605`*^9, 
  3.974015457072115*^9}},ExpressionUUID->"7e44379c-0189-7843-810e-\
cea800273bde"],

Cell["\<\
x+y+z=180
2x+5y=3z
2x+5y=3(180-x-y)
8y+5x=540\
\>", "Text",
 CellChangeTimes->{
  3.9740156759641304`*^9},ExpressionUUID->"5d8929c1-b7f4-464f-9ac4-\
d71d94072492"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"a", "=", "8"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"c", "=", "540"}], ";"}], "\n", 
 RowBox[{"mcd", "=", 
  RowBox[{"Euclides", "[", 
   RowBox[{"a", ",", "b"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"Mod", "[", 
   RowBox[{"c", ",", "mcd"}], "]"}], "==", "0"}], "\n", 
 RowBox[{"Bezout2", "[", 
  RowBox[{"a", ",", "b"}], "]"}]}], "Code",
 CellChangeTimes->{3.974015684457924*^9},
 CellLabel->"In[38]:=",ExpressionUUID->"ee3409aa-d88f-234e-8f55-81eb60c7a29b"],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{3.974015685203884*^9},
 CellLabel->"Out[41]=",ExpressionUUID->"bde82447-7c3e-7b4e-aa2c-a8a700ee49ed"],

