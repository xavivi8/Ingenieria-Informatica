              RowBox[{"j", ",", "1", ",", 
               RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Return", "[", "inverso", "]"}]}]}], "\[IndentingNewLine]",
          "]"}], ";"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", "\n", 
    RowBox[{"Capitulo", " ", "12", " ", "Congruencias", " ", "Ejemplo", " ", 
     RowBox[{"12.8", "."}]}], "\n", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"AlgChino2", "[", 
      RowBox[{"a_", ",", "m_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "M", ",", "b", ",", "Teorema", ",", "n", ",", "u", ",", "w", ",", 
         "x0"}], "}"}], ",", 
       RowBox[{
        RowBox[{"Teorema", "=", "\"\<s\[IAcute]\>\""}], ";", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", "a", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"GCD", "[", 
                RowBox[{
                 RowBox[{"m", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", 
                 RowBox[{"m", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "\[NotEqual]", 
               "1"}], ",", 
              RowBox[{
               RowBox[{"Teorema", "=", "\"\<no\>\""}], ";", 
               RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", 
              RowBox[{"i", "+", "1"}], ",", 
              RowBox[{"Length", "[", "m", "]"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{
             RowBox[{"Length", "[", "m", "]"}], "-", "1"}]}], "}"}]}], "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"Teorema", "\[Equal]", "\"\<s\[IAcute]\>\""}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Inverso", "[", 
             RowBox[{"x_", ",", "n_"}], "]"}], ":=", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", "inverso", "}"}], ",", 
              RowBox[{
               RowBox[{"Do", "[", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Mod", "[", 
                    RowBox[{
                    RowBox[{"j", "*", "x"}], ",", "n"}], "]"}], "\[Equal]", 
                    "1"}], ",", 
                   RowBox[{
                    RowBox[{"inverso", "=", "j"}], ";", 
                    RowBox[{"Break", "[", "]"}]}]}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"j", ",", "1", ",", 
                   RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", 
               "\[IndentingNewLine]", 
               RowBox[{"Return", "[", "inverso", "]"}]}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"M", "[", "1", "]"}], "=", "1"}], ";", 
           RowBox[{
            RowBox[{"M", "[", "i_", "]"}], ":=", 
            RowBox[{
             RowBox[{"M", "[", 
              RowBox[{"i", "-", "1"}], "]"}], "*", 
             RowBox[{"m", "[", 
              RowBox[{"[", 
               RowBox[{"i", "-", "1"}], "]"}], "]"}]}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"u", "[", "i_", "]"}], ":=", 
            RowBox[{"Inverso", "[", 
             RowBox[{
              RowBox[{"M", "[", "i", "]"}], ",", 
              RowBox[{"m", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"b", "[", "1", "]"}], "=", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{"a", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"m", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"w", "[", "i_", "]"}], ":=", 
            RowBox[{"Mod", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"a", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], "-", 
                 RowBox[{"b", "[", 
                  RowBox[{"i", "-", "1"}], "]"}]}], ")"}], "*", 
               RowBox[{"u", "[", "i", "]"}]}], ",", 
              RowBox[{"m", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"b", "[", "i_", "]"}], ":=", 
            RowBox[{
             RowBox[{"b", "[", 
              RowBox[{"i", "-", "1"}], "]"}], "+", 
             RowBox[{
              RowBox[{"w", "[", "i", "]"}], " ", 
              RowBox[{"M", "[", "i", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"x0", "=", 
            RowBox[{"b", "[", 
             RowBox[{"Length", "[", "a", "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{
            "\"\<Soluci\[OAcute]n: x = \>\"", ",", "x0", ",", "\"\< + t*\>\"",
              ",", 
             RowBox[{"M", "[", 
              RowBox[{"n", "+", "1"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Print", "[", 
            RowBox[{"TableForm", "[", 
             RowBox[{
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"a", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                   RowBox[{"m", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", "1", ",", "1", ",", 
                   "\"\<-\>\"", ",", 
                   RowBox[{"b", "[", "1", "]"}]}], "}"}], "}"}], ",", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"a", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{"m", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{"M", "[", "i", "]"}], ",", 
                    RowBox[{"u", "[", "i", "]"}], ",", 
                    RowBox[{"w", "[", "i", "]"}], ",", 
                    RowBox[{"b", "[", "i", "]"}]}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "2", ",", "n"}], "}"}]}], "]"}]}], "]"}],
               ",", 
              RowBox[{"TableHeadings", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Table", "[", 
                  RowBox[{"i", ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                  "\"\<a\>\"", ",", "\"\<m\>\"", ",", "\"\<M\>\"", ",", 
                   "\"\<u\>\"", ",", "\"\<w\>\"", ",", "\"\<b\>\""}], "}"}]}],
                 "}"}]}]}], "]"}], "]"}], ";"}], ",", 
          RowBox[{
           RowBox[{
           "Print", "[", 
            "\"\<No podemos aplicar el T\.aa Chino del Resto\>\"", "]"}], 
           ";"}]}], "]"}], ";"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", "\n", 
    RowBox[{
    "Capitulo", " ", "12", " ", "Sistema", " ", "de", " ", "numeracion", " ", 
     "Ejemplo", " ", 
     RowBox[{"12.15", "."}]}], "\n", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ToDecimal", "[", 
      RowBox[{"n_", ",", "b_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"M", ",", "n2"}], "}"}], ",", 
       RowBox[{
        RowBox[{"n2", "=", 
         RowBox[{
          RowBox[{"ToCharacterCode", "[", 
           RowBox[{"ToUpperCase", "[", "n", "]"}], "]"}], "-", "48"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"n2", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "\[GreaterEqual]", "17"}], ",", 
            RowBox[{
             RowBox[{"n2", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "-=", "7"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "n2", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"M", "=", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"n2", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "*", 
            RowBox[{"b", "^", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Length", "[", "n2", "]"}], "-", "i"}], ")"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "n2", "]"}]}], "}"}]}], "]"}]}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"FromDecimal", "[", 
      RowBox[{"n_", ",", "b_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n2", ",", "d"}], "}"}], ",", 
       RowBox[{
        RowBox[{"d", "=", 
         RowBox[{"{", "}"}]}], ";", 
        RowBox[{"n2", "=", "n"}], ";", "\[IndentingNewLine]", 
        RowBox[{"While", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Quotient", "[", 
            RowBox[{"n2", ",", "b"}], "]"}], ">", "0"}], ",", 
          RowBox[{
           RowBox[{"PrependTo", "[", 
            RowBox[{"d", ",", 
             RowBox[{"Mod", "[", 
              RowBox[{"n2", ",", "b"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"n2", "=", 
            RowBox[{"Quotient", "[", 
             RowBox[{"n2", ",", "b"}], "]"}]}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"PrependTo", "[", 
         RowBox[{"d", ",", 
          RowBox[{"Mod", "[", 
           RowBox[{"n2", ",", "b"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"d", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "\[GreaterEqual]", "10"}], ",", 
            RowBox[{
             RowBox[{"d", "[", 
              RowBox[{"[", "i", "]"}], "]"}], "+=", "7"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "[", "d", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"FromCharacterCode", "[", 
         RowBox[{"d", "+", "48"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"CambioBase", "[", 
     RowBox[{"n_", ",", "b1_", ",", "b2_"}], "]"}], ":=", 
    RowBox[{"FromDecimal", "[", 
     RowBox[{
      RowBox[{"ToDecimal", "[", 
       RowBox[{"n", ",", "b1"}], "]"}], ",", "b2"}], "]"}]}], "\n", 
   RowBox[{"(*", "\n", "\n", "*)"}]}]}]], "Code",
 CellChangeTimes->{{3.971099747921095*^9, 3.9710997943145237`*^9}, {
   3.9711016411492405`*^9, 3.971101642131468*^9}, {3.971102257079359*^9, 
