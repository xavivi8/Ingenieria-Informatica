 RowBox[{
  RowBox[{"v", "=", 
   RowBox[{"-", "667"}]}], ";"}], "\n", 
 RowBox[{"x0", "=", 
  RowBox[{"u", "*", 
   RowBox[{"c", "/", "mcd"}]}]}], "\n", 
 RowBox[{"y0", "=", 
  RowBox[{"v", "*", 
   RowBox[{"c", "/", "mcd"}]}]}]}], "Code",
 CellChangeTimes->{{3.974014720851618*^9, 3.974014726360882*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"e9146c71-b26b-1940-9418-875cd33b99d4"],

