Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Reduce", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"0", "<=", 
     RowBox[{"x", "[", "t", "]"}]}], " ", "&&", " ", 
    RowBox[{"0", "<=", 
     RowBox[{"y", "[", "t", "]"}]}]}], ",", "t", ",", " ", "Integers"}], 
  "]"}]], "Code",
 CellChangeTimes->{3.974016224552973*^9},
 CellLabel->"In[18]:=",ExpressionUUID->"f2a96046-a2e2-484b-9a26-72349e1ba88f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"t", "\[Element]", 
   TemplateBox[{},
    "Integers"]}], "&&", 
  RowBox[{"26", "\[LessEqual]", "t", "\[LessEqual]", "38"}]}]], "Output",
 CellChangeTimes->{3.9740162253562813`*^9},
 CellLabel->"Out[18]=",ExpressionUUID->"400a1253-8b44-5c41-8d4b-8dc55562db4c"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"t", "=", "26"}], ",", " ", 
   RowBox[{"t", "<=", "38"}], ",", " ", 
   RowBox[{"t", "++"}], ",", "\n", "\t", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Para t = \>\"", ",", "t"}], "]"}], ";", "\n", "\t", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Triples = \>\"", ",", " ", 
      RowBox[{"x", "[", "t", "]"}], ",", "\"\<--------------\>\"", ",", 
      RowBox[{"3", "*", 
       RowBox[{"x", "[", "t", "]"}]}]}], "]"}], ";", "\n", "\t", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Canastas = \>\"", ",", " ", 
      RowBox[{"y", "[", "t", "]"}], ",", "\"\<--------------\>\"", ",", 
      RowBox[{"2", "*", 
       RowBox[{"y", "[", "t", "]"}]}]}], "]"}], ";"}]}], "\n", "\t", 
  "]"}]], "Code",
 CellChangeTimes->{3.9740162317850037`*^9},
 CellLabel->"In[19]:=",ExpressionUUID->"489fe3a8-db68-fb41-839e-5dfc17784efe"],

