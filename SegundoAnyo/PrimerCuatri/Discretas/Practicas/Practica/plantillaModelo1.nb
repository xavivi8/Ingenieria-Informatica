Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"AnalisisRB", "[", 
     RowBox[{"A_", ",", "R_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], ",", 
      RowBox[{
       RowBox[{"falloReflexiva", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"R", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"A", "[", 
                RowBox[{"[", "n", "]"}], "]"}], ",", 
               RowBox[{"A", "[", 
                RowBox[{"[", "n", "]"}], "]"}]}], "}"}]}], "]"}], ",", "Null",
            ",", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"falloReflexiva", ",", 
             RowBox[{"A", "[", 
              RowBox[{"[", "n", "]"}], "]"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"n", ",", 
           RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"falloSimetrica", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{"R", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"R", "[", 
                RowBox[{"[", 
                 RowBox[{"m", ",", "2"}], "]"}], "]"}], ",", 
               RowBox[{"R", "[", 
                RowBox[{"[", 
                 RowBox[{"m", ",", "1"}], "]"}], "]"}]}], "}"}]}], "]"}], ",",
            "Null", ",", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"falloSimetrica", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"R", "[", 
                RowBox[{"[", 
                 RowBox[{"m", ",", "2"}], "]"}], "]"}], ",", 
               RowBox[{"R", "[", 
                RowBox[{"[", 
                 RowBox[{"m", ",", "1"}], "]"}], "]"}]}], "}"}]}], "]"}]}], 
          "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", 
           RowBox[{"Length", "[", "R", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"falloTransitiva", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"R", "[", 
                 RowBox[{"[", 
                  RowBox[{"p", ",", "1"}], "]"}], "]"}], "\[Equal]", 
                RowBox[{"R", "[", 
                 RowBox[{"[", 
                  RowBox[{"q", ",", "2"}], "]"}], "]"}]}], ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"MemberQ", "[", 
                  RowBox[{"R", ",", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"R", "[", 
                    RowBox[{"[", 
                    RowBox[{"q", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"R", "[", 
                    RowBox[{"[", 
                    RowBox[{"p", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}], 
                 ",", "Null", ",", 
                 RowBox[{"AppendTo", "[", 
                  RowBox[{"falloTransitiva", ",", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"R", "[", 
                    RowBox[{"[", 
                    RowBox[{"q", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"R", "[", 
                    RowBox[{"[", 
                    RowBox[{"q", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"R", "[", 
                    RowBox[{"[", 
                    RowBox[{"p", ",", "1"}], "]"}], "]"}], ",", 
                    RowBox[{"R", "[", 
                    RowBox[{"[", 
                    RowBox[{"p", ",", "2"}], "]"}], "]"}]}], "}"}]}], "}"}]}],
                   "]"}]}], "]"}]}], "]"}], ";"}], ",", 
            RowBox[{"{", 
             RowBox[{"q", ",", 
              RowBox[{"Length", "[", "R", "]"}]}], "}"}]}], "]"}], ";"}], ",", 
         RowBox[{"{", 
          RowBox[{"p", ",", 
           RowBox[{"Length", "[", "R", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"falloAntisimetrica", "=", 
        RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"R", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"R", "[", 
                  RowBox[{"[", 
                   RowBox[{"r", ",", "2"}], "]"}], "]"}], ",", 
                 RowBox[{"R", "[", 
                  RowBox[{"[", 
                   RowBox[{"r", ",", "1"}], "]"}], "]"}]}], "}"}]}], "]"}], "&&", 
             RowBox[{"!", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"ToString", "[", 
                 RowBox[{"R", "[", 
                  RowBox[{"[", 
                   RowBox[{"r", ",", "1"}], "]"}], "]"}], "]"}], "\[Equal]", 
                RowBox[{"ToString", "[", 
                 RowBox[{"R", "[", 
                  RowBox[{"[", 
                   RowBox[{"r", ",", "2"}], "]"}], "]"}], "]"}]}], ")"}]}]}], 
            ",", 
            RowBox[{
             RowBox[{"AppendTo", "[", 
              RowBox[{"falloAntisimetrica", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"R", "[", 
                  RowBox[{"[", 
                   RowBox[{"r", ",", "1"}], "]"}], "]"}], ",", 
                 RowBox[{"R", "[", 
                  RowBox[{"[", 
                   RowBox[{"r", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}], 
             ";"}]}], "]"}], ";"}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", 
           RowBox[{"Length", "[", "R", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"falloReflexiva", "\[Equal]", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Print", "[", "\"\<R es reflexiva\>\"", "]"}], ",", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<R no es reflexiva, falla en los elementos: \>\"", ",", 
           "falloReflexiva"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"falloSimetrica", "\[Equal]", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Print", "[", "\"\<R es sim\[EAcute]trica\>\"", "]"}], ",", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<R no es sim\[EAcute]trica, falla en los pares: \>\"", ",", 
           "falloSimetrica"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"falloTransitiva", "\[Equal]", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Print", "[", "\"\<R es transitiva\>\"", "]"}], ",", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<R no es transitiva, falla en los pares: \>\"", ",", 
           "falloTransitiva"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"falloAntisimetrica", "\[Equal]", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Print", "[", "\"\<R es antisim\[EAcute]trica\>\"", "]"}], 
         ",", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<R no es antisim\[EAcute]trica, falla en los pares: \>\"", ",", 
           "falloAntisimetrica"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Union", "[", 
           RowBox[{
           "falloReflexiva", ",", "falloSimetrica", ",", "falloTransitiva"}], 
           "]"}], "\[Equal]", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{
         "Print", "[", "\"\<R es una relaci\[OAcute]n de equivalencia\>\"", 
          "]"}], ",", 
         RowBox[{
         "Print", "[", "\"\<R no es relaci\[OAcute]n de equivalencia\>\"", 
          "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Union", "[", 
           RowBox[{
           "falloReflexiva", ",", "falloAntisimetrica", ",", 
            "falloTransitiva"}], "]"}], "\[Equal]", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{
         "Print", "[", "\"\<R es una relaci\[OAcute]n de orden\>\"", "]"}], 
         ",", 
         RowBox[{
         "Print", "[", "\"\<R no es relaci\[OAcute]n de orden\>\"", "]"}]}], 
        "]"}], ";"}]}], "]"}]}], ";"}], "\n"}]], "Input",
