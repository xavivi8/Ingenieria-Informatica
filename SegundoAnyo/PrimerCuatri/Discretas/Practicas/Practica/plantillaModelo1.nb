Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MINIMO", "[", 
    RowBox[{"A_", ",", "R_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"minimo", ",", "mini", ",", "n", ",", "m"}], "}"}], ",", 
     RowBox[{
      RowBox[{"minimo", "=", 
       RowBox[{"{", "}"}]}], ";", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"mini", "=", "True"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Do", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{"R", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"A", "[", 
                  RowBox[{"[", "n", "]"}], "]"}], ",", 
                 RowBox[{"A", "[", 
                  RowBox[{"[", "m", "]"}], "]"}]}], "}"}]}], "]"}], ",", ",", 
             RowBox[{
              RowBox[{"mini", "=", "False"}], ";", 
              RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"m", ",", "1", ",", 
             RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{"mini", ",", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"minimo", ",", 
              RowBox[{"A", "[", 
               RowBox[{"[", "n", "]"}], "]"}]}], "]"}], ";", 
            RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "1", ",", 
          RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ";", 
      "minimo"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.974103190741377*^9},
 CellLabel->"In[93]:=",ExpressionUUID->"a42b727a-166e-0b46-9344-a567f5788533"],

