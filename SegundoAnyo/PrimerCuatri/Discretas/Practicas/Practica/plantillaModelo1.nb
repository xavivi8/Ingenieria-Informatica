Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Inverso2", "[", 
    RowBox[{"x_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "Cocientes", ",", "Euclides", ",", "Resto", ",", "a1", ",", "a2"}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Euclides", "[", 
        RowBox[{"n1_", ",", "n2_"}], "]"}], ":=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{"n1", ",", "n2"}], "]"}], "\[Equal]", "0"}], ",", "n2", 
         ",", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"Cocientes", ",", 
            RowBox[{"Quotient", "[", 
             RowBox[{"n1", ",", "n2"}], "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Euclides", "[", 
           RowBox[{"n2", ",", 
            RowBox[{"Mod", "[", 
             RowBox[{"n1", ",", "n2"}], "]"}]}], "]"}]}]}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"Resto", "[", 
        RowBox[{"1", ",", "x1_", ",", "x2_"}], "]"}], ":=", 
       RowBox[{"x1", "-", 
        RowBox[{"x2", "*", 
         RowBox[{"Cocientes", "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Resto", "[", 
        RowBox[{"2", ",", "x1_", ",", "x2_"}], "]"}], ":=", 
       RowBox[{"x2", "-", 
        RowBox[{
         RowBox[{"Resto", "[", 
          RowBox[{"1", ",", "x1", ",", "x2"}], "]"}], "*", 
         RowBox[{"Cocientes", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Resto", "[", 
        RowBox[{"k_", ",", "x1_", ",", "x2_"}], "]"}], ":=", 
       RowBox[{"Expand", "[", 
        RowBox[{
         RowBox[{"Resto", "[", 
          RowBox[{
           RowBox[{"k", "-", "2"}], ",", "x1", ",", "x2"}], "]"}], "-", 
         RowBox[{
          RowBox[{"Resto", "[", 
           RowBox[{
            RowBox[{"k", "-", "1"}], ",", "x1", ",", "x2"}], "]"}], "*", 
          RowBox[{"Cocientes", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}]}], "]"}]}], ";", 
      RowBox[{"a1", "=", 
       RowBox[{"Abs", "[", "x", "]"}]}], ";", 
      RowBox[{"a2", "=", 
       RowBox[{"Abs", "[", "n", "]"}]}], ";", 
      RowBox[{"Cocientes", "=", 
       RowBox[{"{", "}"}]}], ";", 
      RowBox[{"Euclides", "[", 
       RowBox[{"a1", ",", "a2"}], "]"}], ";", 
      RowBox[{"Return", "[", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Resto", "[", 
           RowBox[{
            RowBox[{"Length", "[", "Cocientes", "]"}], ",", "1", ",", "0"}], 
           "]"}], "*", 
          RowBox[{"Sign", "[", "x", "]"}]}], ",", "n"}], "]"}], "]"}], 
      ";"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[119]:=",ExpressionUUID->"7fc77314-58fa-2741-8c6b-e04c5a7585d1"],

