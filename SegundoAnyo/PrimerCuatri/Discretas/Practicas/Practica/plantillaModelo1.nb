                 RowBox[{
                  RowBox[{"A", "[", 
                   RowBox[{"[", "n", "]"}], "]"}], ",", 
                  RowBox[{"B", "[", 
                   RowBox[{"[", "m", "]"}], "]"}]}], "}"}], "}"}], ",", "R"}],
               "]"}], "\[Equal]", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{
             RowBox[{"cinfer", "=", "False"}], ";", 
             RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"m", ",", "1", ",", 
            RowBox[{"Length", "[", "B", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"cinfer", ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"cotasinferiores", ",", 
            RowBox[{"A", "[", 
             RowBox[{"[", "n", "]"}], "]"}]}], "]"}]}], "]"}], ";"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ";", "\n", 
     RowBox[{"infimo", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"maxi", "=", "True"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{"R", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"cotasinferiores", "[", 
                 RowBox[{"[", "m", "]"}], "]"}], ",", 
                RowBox[{"cotasinferiores", "[", 
                 RowBox[{"[", "n", "]"}], "]"}]}], "}"}]}], "]"}], ",", ",", 
            RowBox[{
             RowBox[{"maxi", "=", "False"}], ";", 
             RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"m", ",", "1", ",", 
            RowBox[{"Length", "[", "cotasinferiores", "]"}]}], "}"}]}], "]"}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"maxi", ",", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"infimo", ",", 
             RowBox[{"cotasinferiores", "[", 
              RowBox[{"[", "n", "]"}], "]"}]}], "]"}], ";", 
           RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ";"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"Length", "[", "cotasinferiores", "]"}]}], "}"}]}], "]"}], 
     ";", "\n", "infimo"}]}], "\n", "]"}]}]], "Input",
 CellLabel->
  "In[111]:=",ExpressionUUID->"24696b80-d5a9-6e4a-ba02-a179adc80d8d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RETICULODISTRIBUTIVO", "[", 
   RowBox[{"A_", ",", "R_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"distributive", ",", "i", ",", "j", ",", "k"}], "}"}], ",", 
    RowBox[{
     RowBox[{"distributivo", "=", "True"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"TrueQ", "[", 
                 RowBox[{
                  RowBox[{"SUPREMO", "[", 
                   RowBox[{"A", ",", 
                    RowBox[{"Union", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"A", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "}"}], ",", 
                    RowBox[{"INFIMO", "[", 
                    RowBox[{"A", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"A", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], ",", 
                    RowBox[{"A", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], "}"}], ",", "R"}], 
                    "]"}]}], "]"}], ",", "R"}], "]"}], "==", 
                  RowBox[{"INFIMO", "[", 
                   RowBox[{"A", ",", 
                    RowBox[{"Union", "[", 
                    RowBox[{
                    RowBox[{"SUPREMO", "[", 
                    RowBox[{"A", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"A", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{"A", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "}"}], ",", "R"}], 
                    "]"}], ",", 
                    RowBox[{"SUPREMO", "[", 
                    RowBox[{"A", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"A", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{"A", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], "}"}], ",", "R"}], 
                    "]"}]}], "]"}], ",", "R"}], "]"}]}], "]"}], ",", ",", 
                RowBox[{
                 RowBox[{"distributivo", "=", "False"}], ";"}]}], "]"}], 
              ";"}], "         ", "\[IndentingNewLine]", ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ";"}], 
          "\n", "      ", ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", "1", ",", 
            RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
       "   ", ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", 
         RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ";", "\n", 
     "distributivo"}]}], "\n", "]"}]}]], "Input",
 CellLabel->
  "In[112]:=",ExpressionUUID->"d452d2e8-82eb-8846-8e6d-2453e7a593c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"COMPLEMENTADO", "[", 
   RowBox[{"A_", ",", "R_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"complementado", ",", "k"}], "}"}], ",", 
    RowBox[{
     RowBox[{"complementado", "=", "True"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"COMPLEMENTO", "[", 
           RowBox[{"A", ",", "R", ",", 
            RowBox[{"A", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], "]"}], "\[Equal]", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"complementado", "=", "False"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", 
         RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "complementado"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[116]:=",ExpressionUUID->"ab2d4f2a-937b-2941-8f62-e9cd1378854d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"COMPLEMENTO", "[", 
   RowBox[{"A_", ",", "R_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"complemento", ",", "k"}], "}"}], ",", 
    RowBox[{
     RowBox[{"complemento", "=", 
      RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"INFIMO", "[", 
            RowBox[{"A", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"A", "[", 
                RowBox[{"[", "k", "]"}], "]"}], ",", "n"}], "}"}], ",", "R"}],
             "]"}], "\[Equal]", 
           RowBox[{"MINIMALES", "[", 
            RowBox[{"A", ",", "R"}], "]"}]}], "&&", 
          RowBox[{
           RowBox[{"SUPREMO", "[", 
            RowBox[{"A", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"A", "[", 
                RowBox[{"[", "k", "]"}], "]"}], ",", "n"}], "}"}], ",", "R"}],
             "]"}], "\[Equal]", 
           RowBox[{"MAXIMALES", "[", 
            RowBox[{"A", ",", "R"}], "]"}]}]}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"complemento", ",", 
           RowBox[{"A", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", 
         RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", "complemento"}]}], "]"}]}]], "Input",
 CellLabel->
  "In[113]:=",ExpressionUUID->"b18f236b-960f-174b-80c6-e30d128b8abf"],

