   RowBox[{"Complement", "[", 
    RowBox[{"R", ",", "R1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"puntos", "=", 
   RowBox[{"{", "}"}]}], ";", 
  RowBox[{"t1", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"cont", "=", "0"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"tabla", "[", 
           RowBox[{"[", 
            RowBox[{"i1", ",", "1"}], "]"}], "]"}], "\[Equal]", "j1"}], ",", 
