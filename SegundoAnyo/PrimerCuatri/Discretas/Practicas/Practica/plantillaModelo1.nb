Cell[BoxData[
 RowBox[{
  RowBox[{"RETICULO", "[", 
   RowBox[{"A_", ",", "R_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "reticulo", ",", "cotassuperiores", ",", "cotasinferiores", ",", 
      "csuper", ",", "cinfer", ",", "supremo", ",", "infimo", ",", "mini", 
      ",", "maxi", ",", "n", ",", "m", ",", "x1", ",", "x2"}], "}"}], ",", 
    RowBox[{
     RowBox[{"reticulo", "=", "True"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"cotassuperiores", "=", 
            RowBox[{"{", "}"}]}], ";", 
           RowBox[{"cotasinferiores", "=", 
            RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"csuper", "=", "True"}], ";", 
              RowBox[{"cinfer", "=", "True"}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Intersection", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"A", "[", 
                    RowBox[{"[", "x1", "]"}], "]"}], ",", 
                    RowBox[{"A", "[", 
                    RowBox[{"[", "n", "]"}], "]"}]}], "}"}], "}"}], ",", 
                   "R"}], "]"}], "\[Equal]", 
                 RowBox[{"{", "}"}]}], ",", 
                RowBox[{"csuper", "=", "False"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Intersection", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"A", "[", 
                    RowBox[{"[", "x2", "]"}], "]"}], ",", 
                    RowBox[{"A", "[", 
                    RowBox[{"[", "n", "]"}], "]"}]}], "}"}], "}"}], ",", 
                   "R"}], "]"}], "\[Equal]", 
                 RowBox[{"{", "}"}]}], ",", 
                RowBox[{"csuper", "=", "False"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Intersection", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"A", "[", 
                    RowBox[{"[", "n", "]"}], "]"}], ",", 
                    RowBox[{"A", "[", 
                    RowBox[{"[", "x1", "]"}], "]"}]}], "}"}], "}"}], ",", 
                   "R"}], "]"}], "\[Equal]", 
                 RowBox[{"{", "}"}]}], ",", 
                RowBox[{"cinfer", "=", "False"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Intersection", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"A", "[", 
                    RowBox[{"[", "n", "]"}], "]"}], ",", 
                    RowBox[{"A", "[", 
                    RowBox[{"[", "x2", "]"}], "]"}]}], "}"}], "}"}], ",", 
                   "R"}], "]"}], "\[Equal]", 
                 RowBox[{"{", "}"}]}], ",", 
                RowBox[{"cinfer", "=", "False"}]}], "]"}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{"csuper", ",", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"cotassuperiores", ",", 
                  RowBox[{"A", "[", 
                   RowBox[{"[", "n", "]"}], "]"}]}], "]"}]}], "]"}], ";", 
              RowBox[{"If", "[", 
               RowBox[{"cinfer", ",", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"cotasinferiores", ",", 
                  RowBox[{"A", "[", 
                   RowBox[{"[", "n", "]"}], "]"}]}], "]"}]}], "]"}], ";"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", "1", ",", 
               RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"supremo", "=", 
            RowBox[{"{", "}"}]}], ";", 
           RowBox[{"infimo", "=", 
            RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"mini", "=", "True"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Do", "[", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Intersection", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"cotassuperiores", "[", 
                    RowBox[{"[", "n", "]"}], "]"}], ",", 
                    RowBox[{"cotassuperiores", "[", 
                    RowBox[{"[", "m", "]"}], "]"}]}], "}"}], "}"}], ",", 
                    "R"}], "]"}], "\[Equal]", 
                   RowBox[{"{", "}"}]}], ",", 
                  RowBox[{"mini", "=", "False"}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"m", ",", "1", ",", 
                  RowBox[{"Length", "[", "cotassuperiores", "]"}]}], "}"}]}], 
               "]"}], ";", "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{"mini", ",", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"supremo", ",", 
                  RowBox[{"cotassuperiores", "[", 
                   RowBox[{"[", "n", "]"}], "]"}]}], "]"}]}], "]"}], ";"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", "1", ",", 
               RowBox[{"Length", "[", "cotassuperiores", "]"}]}], "}"}]}], 
            "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"supremo", "\[Equal]", 
              RowBox[{"{", "}"}]}], ",", 
             RowBox[{"reticulo", "=", "False"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"maxi", "=", "True"}], ";", "\[IndentingNewLine]", 
              RowBox[{"Do", "[", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Intersection", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"cotasinferiores", "[", 
                    RowBox[{"[", "m", "]"}], "]"}], ",", 
                    RowBox[{"cotasinferiores", "[", 
                    RowBox[{"[", "n", "]"}], "]"}]}], "}"}], "}"}], ",", 
                    "R"}], "]"}], "\[Equal]", 
                   RowBox[{"{", "}"}]}], ",", 
                  RowBox[{"maxi", "=", "False"}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"m", ",", "1", ",", 
                  RowBox[{"Length", "[", "cotasinferiores", "]"}]}], "}"}]}], 
               "]"}], ";", "\n", 
              RowBox[{"If", "[", 
               RowBox[{"maxi", ",", 
                RowBox[{"AppendTo", "[", 
                 RowBox[{"infimo", ",", 
                  RowBox[{"cotasinferiores", "[", 
                   RowBox[{"[", "n", "]"}], "]"}]}], "]"}]}], "]"}], ";"}], 
             "\n", "         ", ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", "1", ",", 
               RowBox[{"Length", "[", "cotasinferiores", "]"}]}], "}"}]}], 
            "]"}], ";", "\n", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"infimo", "\[Equal]", 
              RowBox[{"{", "}"}]}], ",", 
             RowBox[{"reticulo", "=", "False"}]}], "]"}], ";"}], "\n", 
          "      ", ",", 
          RowBox[{"{", 
           RowBox[{"x1", ",", "1", ",", 
            RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
       "   ", ",", 
       RowBox[{"{", 
        RowBox[{"x2", ",", "1", ",", 
         RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ";", "\n", 
     "reticulo"}]}], "\n", "]"}]}]], "Input",
 CellChangeTimes->{3.9741031876486855`*^9, 3.9741040213565197`*^9},
 CellLabel->
  "In[108]:=",ExpressionUUID->"8fa8571b-d4dd-6e44-8ec6-8b59e1448de1"],

