      RowBox[{"tabla", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"Length", "[", "A", "]"}], ",", "1"}], "]"}], "]"}]}], 
     "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Coord", "[", "elem_", "]"}], ":=", 
