Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "=", "Deje2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R", "=", "Reje2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Clear", "[", "Coord", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tabla", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"i1", ",", 
       RowBox[{"Length", "[", "A", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j1", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"B", "=", "A"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"t1", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nivel", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{
    RowBox[{"B", "\[NotEqual]", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{
     RowBox[{"minimales", "=", 
      RowBox[{"{", "}"}]}], ";", 
     RowBox[{"nivel", "++"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"minimal", "=", "True"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Intersection", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"B", "[", 
                    RowBox[{"[", "m1", "]"}], "]"}], ",", 
                    RowBox[{"B", "[", 
                    RowBox[{"[", "n1", "]"}], "]"}]}], "}"}], "}"}], ",", 
                 "R"}], "]"}], "\[NotEqual]", 
               RowBox[{"{", "}"}]}], "&&", 
              RowBox[{"n1", "\[NotEqual]", "m1"}]}], ",", 
             RowBox[{"minimal", "=", "False"}]}], "]"}], ";"}], ",", 
          RowBox[{"{", 
           RowBox[{"m1", ",", "1", ",", 
            RowBox[{"Length", "[", "B", "]"}]}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{"minimal", ",", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"minimales", ",", 
             RowBox[{"B", "[", 
              RowBox[{"[", "n1", "]"}], "]"}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"tabla", "[", 
             RowBox[{"[", "t1", "]"}], "]"}], "=", 
            RowBox[{"{", 
             RowBox[{"nivel", ",", 
              RowBox[{"B", "[", 
               RowBox[{"[", "n1", "]"}], "]"}], ",", "0"}], "}"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"t1", "++"}], ";"}]}], "]"}], ";"}], ",", 
       RowBox[{"{", 
        RowBox[{"n1", ",", "1", ",", 
         RowBox[{"Length", "[", "B", "]"}]}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"B", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{"B", ",", "minimales"}], "]"}]}], ";"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R1", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"AppendTo", "[", 
     RowBox[{"R1", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"A", "[", 
         RowBox[{"[", "i1", "]"}], "]"}], ",", 
        RowBox[{"A", "[", 
         RowBox[{"[", "i1", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i1", ",", "1", ",", 
      RowBox[{"Length", "[", "A", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R", "=", 
   RowBox[{"Complement", "[", 
    RowBox[{"R", ",", "R1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"R1", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"Intersection", "[", 
            RowBox[{"R", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"R", "[", 
                  RowBox[{"[", 
                   RowBox[{"k1", ",", "1"}], "]"}], "]"}], ",", 
                 RowBox[{"A", "[", 
                  RowBox[{"[", "j1", "]"}], "]"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"A", "[", 
                  RowBox[{"[", "j1", "]"}], "]"}], ",", 
                 RowBox[{"R", "[", 
                  RowBox[{"[", 
                   RowBox[{"k1", ",", "2"}], "]"}], "]"}]}], "}"}]}], "}"}]}],
             "]"}], "]"}], "\[Equal]", "2"}], ",", 
         RowBox[{
          RowBox[{"R1", "=", 
           RowBox[{"Union", "[", 
            RowBox[{"R1", ",", 
             RowBox[{"{", 
              RowBox[{"R", "[", 
