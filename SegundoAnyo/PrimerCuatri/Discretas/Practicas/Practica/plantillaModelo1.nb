 RowBox[{
  RowBox[{"INFIMO", "[", 
   RowBox[{"A_", ",", "B_", ",", "R_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
