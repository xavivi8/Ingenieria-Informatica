Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"AlgChino2", "[", 
    RowBox[{"a_", ",", "m_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "M", ",", "b", ",", "Teorema", ",", "n", ",", "u", ",", "w", ",", 
       "x0"}], "}"}], ",", 
     RowBox[{
      RowBox[{"Teorema", "=", "\"\<s\[IAcute]\>\""}], ";", 
      RowBox[{"n", "=", 
       RowBox[{"Length", "[", "a", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"GCD", "[", 
              RowBox[{
               RowBox[{"m", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"m", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "\[NotEqual]", "1"}],
             ",", 
            RowBox[{
             RowBox[{"Teorema", "=", "\"\<no\>\""}], ";", 
             RowBox[{"Break", "[", "]"}], ";"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"i", "+", "1"}], ",", 
            RowBox[{"Length", "[", "m", "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{
           RowBox[{"Length", "[", "m", "]"}], "-", "1"}]}], "}"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"Teorema", "\[Equal]", "\"\<s\[IAcute]\>\""}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"Inverso", "[", 
           RowBox[{"x_", ",", "n_"}], "]"}], ":=", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", "inverso", "}"}], ",", 
            RowBox[{
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Mod", "[", 
                   RowBox[{
                    RowBox[{"j", "*", "x"}], ",", "n"}], "]"}], "\[Equal]", 
                  "1"}], ",", 
                 RowBox[{
                  RowBox[{"inverso", "=", "j"}], ";", 
                  RowBox[{"Break", "[", "]"}]}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", "1", ",", 
                 RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Return", "[", "inverso", "]"}]}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"M", "[", "1", "]"}], "=", "1"}], ";", 
         RowBox[{
          RowBox[{"M", "[", "i_", "]"}], ":=", 
          RowBox[{
           RowBox[{"M", "[", 
            RowBox[{"i", "-", "1"}], "]"}], "*", 
           RowBox[{"m", "[", 
            RowBox[{"[", 
             RowBox[{"i", "-", "1"}], "]"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"u", "[", "i_", "]"}], ":=", 
          RowBox[{"Inverso", "[", 
           RowBox[{
            RowBox[{"M", "[", "i", "]"}], ",", 
            RowBox[{"m", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"b", "[", "1", "]"}], "=", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"a", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"m", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"w", "[", "i_", "]"}], ":=", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"a", "[", 
                RowBox[{"[", "i", "]"}], "]"}], "-", 
               RowBox[{"b", "[", 
                RowBox[{"i", "-", "1"}], "]"}]}], ")"}], "*", 
             RowBox[{"u", "[", "i", "]"}]}], ",", 
            RowBox[{"m", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"b", "[", "i_", "]"}], ":=", 
          RowBox[{
           RowBox[{"b", "[", 
            RowBox[{"i", "-", "1"}], "]"}], "+", 
           RowBox[{
            RowBox[{"w", "[", "i", "]"}], " ", 
            RowBox[{"M", "[", "i", "]"}]}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"x0", "=", 
          RowBox[{"b", "[", 
           RowBox[{"Length", "[", "a", "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{
          "\"\<Soluci\[OAcute]n: x = \>\"", ",", "x0", ",", "\"\< + t*\>\"", 
           ",", 
           RowBox[{"M", "[", 
            RowBox[{"n", "+", "1"}], "]"}]}], "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          RowBox[{"TableForm", "[", 
           RowBox[{
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"a", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"m", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", "1", ",", "1", ",", 
                 "\"\<-\>\"", ",", 
                 RowBox[{"b", "[", "1", "]"}]}], "}"}], "}"}], ",", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"a", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], ",", 
                  RowBox[{"m", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], ",", 
                  RowBox[{"M", "[", "i", "]"}], ",", 
                  RowBox[{"u", "[", "i", "]"}], ",", 
                  RowBox[{"w", "[", "i", "]"}], ",", 
                  RowBox[{"b", "[", "i", "]"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "2", ",", "n"}], "}"}]}], "]"}]}], "]"}], 
            ",", 
            RowBox[{"TableHeadings", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Table", "[", 
                RowBox[{"i", ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                "\"\<a\>\"", ",", "\"\<m\>\"", ",", "\"\<M\>\"", ",", 
                 "\"\<u\>\"", ",", "\"\<w\>\"", ",", "\"\<b\>\""}], "}"}]}], 
              "}"}]}]}], "]"}], "]"}], ";"}], ",", 
        RowBox[{
         RowBox[{
         "Print", "[", "\"\<No podemos aplicar el T\.aa Chino del Resto\>\"", 
          "]"}], ";"}]}], "]"}], ";"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[125]:=",ExpressionUUID->"b81b44be-7233-304a-8ed7-ae3e04035be9"],

