{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (make)",
      "type": "shell",
      "command": "PATH=/ucrt64/bin:$PATH make -f Makefile -j all",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\msys64\\usr\\bin\\bash.exe",
          "args": ["-c"]              // <- sin -l
        }
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Run",
      "type": "shell",
      "command": "PATH=/ucrt64/bin:$PATH ./build/MediExpress",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\msys64\\usr\\bin\\bash.exe",
          "args": ["-c"]
        }
      },
      "dependsOn": "Build (make)"
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "PATH=/ucrt64/bin:$PATH make -f Makefile clean",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\msys64\\usr\\bin\\bash.exe",
          "args": ["-c"]
        }
      }
    }
  ]
}