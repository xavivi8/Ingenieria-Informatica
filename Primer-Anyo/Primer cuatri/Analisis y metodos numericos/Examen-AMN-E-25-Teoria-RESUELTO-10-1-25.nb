Cell[BoxData[
 RowBox[{
  RowBox[{"p1", "[", "x_", "]"}], ":=", 
  RowBox[{"a", " ", "+", " ", 
   RowBox[{"b", " ", 
    RowBox[{"(", 
     RowBox[{"x", "-", "0"}], ")"}]}], "+", " ", 
   RowBox[{"c", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "-", "0"}], ")"}], "^", "2"}]}]}]}]], "Input",
 CellChangeTimes->{{3.8978276825624485`*^9, 3.8978277026728196`*^9}, {
  3.9459507766330843`*^9, 3.9459507808141356`*^9}},
