Cell[CellGroupData[{

Cell[TextData[{
 "\n \t12.- Dada la integral ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{" ", "0"}], 
     RowBox[{" ", "2"}]], 
    RowBox[{
     StyleBox[
      FractionBox[
       RowBox[{"1", "+", 
        RowBox[{"2", "x"}]}], 
       FormBox[
        RowBox[{"1", "+", "x", "+", 
         SuperscriptBox["x", "2"]}],
        TraditionalForm]],
      FontSize->18], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"3bb198b8-113f-49fb-b6ac-4855c9c387de"],
 " , calcular su valor exacto. Aproximar tambi\[EAcute]n su valor utilizando \
la f\[OAcute]rmula de Simpson simple.\n\t\t"
}], "Section",
 CellChangeTimes->{{3.500751345359375*^9, 3.500751379984375*^9}, {
   3.500790035609375*^9, 3.500790048953125*^9}, {3.569509423875*^9, 
   3.56950942659375*^9}, {3.570537368580125*^9, 3.57053737997075*^9}, {
   3.599199111625*^9, 3.5991991196875*^9}, {3.723477468774*^9, 
