Cell[TextData[{
 "Soluci\[OAcute]n:\nLa funci\[OAcute]n f es un polinomio, por tanto es \
derivable todas las veces que queramos y en todos los puntos del plano. Para \
buscar los puntos que podr\[IAcute]an ser extremos calculamos las derivadas \
parciales e igualamos a cero.\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", 
     RowBox[{"(", 
      RowBox[{"x", ",", "y"}], ")"}]}], "=", 
    RowBox[{"y", "*", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox["x", "2"], "-", 
       RowBox[{"12", 
        SuperscriptBox["y", "2"]}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"85ff236d-ef41-4c93-ab42-f78d089e0c9c"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"y", "-", 
    RowBox[{
     SuperscriptBox["x", "2"], "y"}], "-", 
    RowBox[{"12", 
     SuperscriptBox["y", "3"]}]}], TraditionalForm]],ExpressionUUID->
  "3ce085df-bf98-4a52-a7ca-21d93d92f504"],
 "\n\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "x"], 
    RowBox[{"f", "(", 
     RowBox[{"x", ",", "y"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "c57135b5-4469-4f52-984b-a066af7027f2"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "2"}], "xy"}], TraditionalForm]],ExpressionUUID->
  "598610d2-4779-45c9-b670-de751e29145c"],
 " = 0 \[DoubleLongRightArrow] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"xy", "=", "0"}], TraditionalForm]],ExpressionUUID->
  "a599a9cb-2bf4-457b-87ce-938cfdd589dd"],
 "\n\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[PartialD]", "y"], 
    RowBox[{"f", "(", 
     RowBox[{"x", ",", "y"}], ")"}]}], TraditionalForm]],ExpressionUUID->
  "5dfb0f9b-1ab6-4100-9d0b-fe4d62823ca0"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    SuperscriptBox["x", "2"], "-", 
    RowBox[{"36", 
     SuperscriptBox["y", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "7f3ef550-1cf4-4e36-9e46-76fb3d9423a1"],
 " = 0\n\nDe la primera ecuaci\[OAcute]n sabemos que x=0 \[OAcute] y=0.\nSi \
x=0, la segunda ecuaci\[OAcute]n queda como ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    RowBox[{"36", 
     SuperscriptBox["y", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "8c9ddb77-6575-45b1-98e6-e4709c6ccb08"],
 " = 0. De donde ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "bd1f6e0f-1e2b-497b-88a1-0833b8ef4946"],
 " = 1/36, es decir, y = 1/6 \[OAcute] y = -1/6.\nSi y=0, la segunda ecuaci\
\[OAcute]n queda como ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "-", 
    SuperscriptBox["x", "2"]}], TraditionalForm]],ExpressionUUID->
  "88b9e567-0bec-42a6-8c53-86c77bbc99d1"],
 " = 0. De donde ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "7798ba5a-56e9-43d4-9352-0854e70d110e"],
 " = 1, es decir, x = 1 \[OAcute] x = -1.\n\nLas soluciones son (0,1/6), \
(0,-1/6), (1,0) y (-1,0). Esos son los puntos donde se anulan las dos \
derivadas parciales.\n\nPara ver si son m\[AAcute]ximos, m\[IAcute]nimos o \
puntos de silla calculamos el hessiano.\n\nHessiano (x,y) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         SubscriptBox["\[PartialD]", 
          RowBox[{"x", ",", "x"}]], 
         RowBox[{"f", "(", 
          RowBox[{"x", ",", "y"}], ")"}]}], 
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"x", ",", "y"}]], "f"}], 
         RowBox[{"(", 
          RowBox[{"x", ",", "y"}], ")"}]}]},
       {
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"x", ",", "y"}]], "f"}], 
         RowBox[{"(", 
          RowBox[{"x", ",", "y"}], ")"}]}], 
        RowBox[{
         RowBox[{
          SubscriptBox["\[PartialD]", 
           RowBox[{"y", ",", "y"}]], "f"}], 
         RowBox[{"(", 
          RowBox[{"x", ",", "y"}], ")"}]}]}
      }], ")"}], "|"}], TraditionalForm]],ExpressionUUID->
  "62ddb34d-acc0-4246-af50-693a501e468d"],
 "= ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         RowBox[{"-", "2"}], "y"}], 
        RowBox[{
         RowBox[{"-", "2"}], "x"}]},
       {
        RowBox[{
         RowBox[{"-", "2"}], "x"}], 
        RowBox[{
         RowBox[{"-", "72"}], "y"}]}
      }], ")"}], "|"}], TraditionalForm]],ExpressionUUID->
  "0725bbe3-43b5-46c3-b7ad-2eb3b3dfe14f"],
 "\nHessiano (1,0) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{"(", GridBox[{
       {"0", 
        RowBox[{"-", "2"}]},
       {
        RowBox[{"-", "2"}], "0"}
      }], ")"}], "|"}], TraditionalForm]],ExpressionUUID->
  "2c61c60a-be74-4e5f-9197-f48d992d1d0a"],
 "= -4 < 0 (Punto de silla)\nHessiano (-1,0) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{"(", GridBox[{
       {"0", "2"},
       {"2", "0"}
      }], ")"}], "|"}], TraditionalForm]],ExpressionUUID->
  "eef423f3-fa3c-4438-8dff-2aa14b89d75f"],
 "= -4 < 0 (Punto de silla)\nHessiano (0,1/6) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{
         RowBox[{"-", "2"}], "/", "6"}], "0"},
       {"0", 
        RowBox[{"-", "12"}]}
      }], ")"}], "|"}], TraditionalForm]],ExpressionUUID->
  "ac8feb9c-4f28-4d8a-bddc-058af128673e"],
 "= 4 > 0 (Habr\[AAcute] un m\[AAcute]ximo o m\[IAcute]nimo local. Para saber \
si es m\[AAcute]ximo o m\[IAcute]nimo, estudiamos la derivada segunda en la x \
o la y, en el punto en cuesti\[OAcute]n. As\[IAcute], al ver que ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"x", ",", "x"}]], 
     RowBox[{"f", "(", 
      RowBox[{"0", ",", 
       RowBox[{"1", "/", "6"}]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "2"}], "/", "6"}], "<", "0"}]}], TraditionalForm]],
  ExpressionUUID->"d0a06f9d-3882-4d8a-b76e-340a5fb49aa7"],
 ", concluimos que hay un m\[AAcute]ximo local.)\nHessiano (0,-1/6) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"2", "/", "6"}], "0"},
       {"0", "12"}
      }], ")"}], "|"}], TraditionalForm]],ExpressionUUID->
  "9c61be32-96cd-4aed-9e01-112649afbbc2"],
 "= 4 > 0 (Habr\[AAcute] un m\[AAcute]ximo o m\[IAcute]nimo local. Para saber \
si es m\[AAcute]ximo o m\[IAcute]nimo, estudiamos la derivada segunda en la x \
o la y, en el punto en cuesti\[OAcute]n. As\[IAcute], al ver que ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", 
      RowBox[{"x", ",", "x"}]], 
     RowBox[{"f", "(", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{"-", "1"}], "/", "6"}]}], ")"}]}], "=", 
    RowBox[{
     RowBox[{"2", "/", "6"}], ">", "0"}]}], TraditionalForm]],ExpressionUUID->
  "5152753d-32ec-4e2b-ad5a-a30bc3c3dd0e"],
 ", concluimos que hay un m\[IAcute]nimo local.)\n\nCon el Mathematica:"
}], "Text",
 CellChangeTimes->{{3.610967983265625*^9, 3.610968082640625*^9}, {
