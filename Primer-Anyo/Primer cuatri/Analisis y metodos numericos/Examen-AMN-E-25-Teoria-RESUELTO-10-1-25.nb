        FontWeight->"Plain"], 
       RowBox[{
        StyleBox["0",
         FontWeight->"Plain"], ",", " ", 
        SubscriptBox["1", " "]}], 
       StyleBox[")",
        FontWeight->"Plain"]}]}]}]}], TraditionalForm]],ExpressionUUID->
  "859504b9-5b82-41e6-8b40-c2ece0cc84a9"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["1",
     FontWeight->"Plain"], 
    StyleBox["+",
     FontWeight->"Plain"], 
    StyleBox[" ",
     FontWeight->"Plain"], 
    RowBox[{
     StyleBox["2",
      FontWeight->"Plain"], 
     StyleBox["*",
      FontWeight->"Plain"], 
     RowBox[{
      StyleBox["f",
       FontWeight->"Plain"], "(", 
      RowBox[{
       SubscriptBox["0", " "], ",", " ", 
       SubscriptBox["1", " "]}], 
      StyleBox[")",
       FontWeight->"Plain"]}]}], 
    StyleBox["+",
     FontWeight->"Plain"], 
    RowBox[{
     StyleBox["2",
