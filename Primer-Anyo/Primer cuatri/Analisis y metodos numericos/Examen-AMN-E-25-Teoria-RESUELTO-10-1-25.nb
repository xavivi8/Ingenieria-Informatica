Cell[TextData[{
 "Evaluando la funci\[OAcute]n en los extremos del intervalo y en el punto de \
derivada cero, encontramos que el m\[IAcute]nimo se encuentra en ",
 Cell[BoxData[
  FractionBox["1", 
   SqrtBox["3"]]], "Output",
  CellChangeTimes->{{3.9470853350836463`*^9, 3.947085347532468*^9}},
  ExpressionUUID->"042e892a-5574-40c5-bfeb-0297c0c60606"],
 "."
}], "Text",
