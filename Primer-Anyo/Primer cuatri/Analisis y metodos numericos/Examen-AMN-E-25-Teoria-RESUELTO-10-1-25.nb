Cell[TextData[{
 "Soluci\[OAcute]n:\nPara calcular la integral definida, calculamos una \
primitiva de la funci\[OAcute]n.\n\n\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{" ", "0"}], 
     RowBox[{" ", "2"}]], 
    RowBox[{
     StyleBox[
      FractionBox[
       RowBox[{"1", "+", 
        RowBox[{"2", "x"}]}], 
       FormBox[
        RowBox[{"1", "+", "x", "+", 
         SuperscriptBox["x", "2"]}],
        TraditionalForm]],
      FontSize->18], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"5f452aa2-81d9-434f-9e18-0139cc7d82a4"],
 "\nObservamos que se trata de un cociente, donde el numerador es la derivada \
del denominador, por tanto\n\n\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{" ", "0"}], 
     RowBox[{" ", "2"}]], 
    RowBox[{
     StyleBox[
      FractionBox[
       RowBox[{"1", "+", 
        RowBox[{"2", "x"}]}], 
       FormBox[
        RowBox[{"1", "+", "x", "+", 
         SuperscriptBox["x", "2"]}],
        TraditionalForm]],
      FontSize->18], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"89254549-5574-469a-b9c4-724af403d082"],
 " = Log ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{"1", "+", "x", "+", 
     SuperscriptBox["x", "2"]}], "|"}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"2c08fdac-3a00-4b36-8e02-cc9bc794c8ed"],
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["|", 
    RowBox[{"x", "=", "0"}], 
    RowBox[{"x", "=", "2"}]], TraditionalForm]],
  FontSize->16,ExpressionUUID->"288aabb0-d8a4-41a6-ba1e-a321a25d0a7a"],
 " = Log ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{"1", "+", "2", "+", 
     SuperscriptBox["2", "2"]}], "|"}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"5e721ea4-c980-424f-99d6-9537e7411b09"],
 "- Log ",
 Cell[BoxData[
  FormBox[
   RowBox[{"|", 
    RowBox[{"1", "+", "0", "+", 
     SuperscriptBox["0", "2"]}], "|"}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"bb4f6a4a-66aa-47e9-9491-eeb2a3ab25e1"],
 "= Log 7 - Log  1 = Log 7\n\nEl m\[EAcute]todo de Simpson consiste en \
aproximar la integral definida de una funci\[OAcute]n en un intervalo [a,b] \
utilizando los valores de la funci\[OAcute]n en los extremos y en el punto \
medio.\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "a", "b"], 
    RowBox[{
     RowBox[{"f", "(", "x", ")"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "4965800f-91d6-4e93-9106-70d1cce69892"],
 " \[TildeEqual]  ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     RowBox[{"f", "(", "a", ")"}], "+", 
     RowBox[{"4", " ", 
      RowBox[{"f", "(", 
       FractionBox[
        RowBox[{"a", "+", "b"}], "2"], ")"}]}], "+", 
     RowBox[{"f", "(", "b", ")"}]}], "6"], TraditionalForm]],ExpressionUUID->
  "fdd2f1cb-ac10-4621-b8f4-bece055455c3"],
 " (b-a)\nEn este caso,\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "2"], 
    RowBox[{
     StyleBox[
      FractionBox[
       RowBox[{"1", "+", 
        RowBox[{"2", "x"}]}], 
       FormBox[
        RowBox[{"1", "+", "x", "+", 
         SuperscriptBox["x", "2"]}],
        TraditionalForm]],
      FontSize->18], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "c28fde1f-f353-4456-80f3-c831ce7bd31c"],
 " \[TildeEqual]  ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     RowBox[{"f", "(", "a", ")"}], "+", 
     RowBox[{"4", " ", 
      RowBox[{"f", "(", 
       FractionBox[
        RowBox[{"a", "+", "b"}], "2"], ")"}]}], "+", 
     RowBox[{"f", "(", "b", ")"}]}], "6"], TraditionalForm]],ExpressionUUID->
  "4e345a48-fe11-40e7-a2b8-8e6b40a26523"],
 " (b-a) =  ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     RowBox[{"f", "(", "0", ")"}], "+", 
     RowBox[{"4", " ", 
      RowBox[{"f", "(", 
       FractionBox[
        RowBox[{"0", "+", "2"}], "2"], ")"}]}], "+", 
     RowBox[{"f", "(", "2", ")"}]}], "6"], TraditionalForm]],ExpressionUUID->
  "35c81d95-6396-40f3-bd5c-868a54d0f5da"],
 " (2-0)= ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      FractionBox["1", "1"], ")"}], " ", "+", " ", 
     RowBox[{"4", " ", 
      RowBox[{"(", 
       FractionBox[
        RowBox[{"1", "+", "2"}], 
        RowBox[{"1", "+", "1", "+", "1"}]], ")"}]}], "+", 
     RowBox[{"(", 
      FractionBox["5", "7"], ")"}]}], "3"], TraditionalForm]],ExpressionUUID->
  "75015410-2f63-483e-87e7-ed489e3b0e06"],
 " = ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"1", "+", "4", " ", "+", " ", 
     FractionBox["5", "7"]}], "3"], TraditionalForm]],ExpressionUUID->
  "37dae8d4-76f3-419a-aebf-68dbea2ed252"],
 "=",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     FractionBox[
      RowBox[{"7", "+", "28", "+", "5"}], "7"], " "}], "3"], 
   TraditionalForm]],ExpressionUUID->"57fe9b94-8f22-419e-8a28-8f35b1a994df"],
 "=",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"40", " "}], "21"], TraditionalForm]],ExpressionUUID->
  "e5028601-58bc-41eb-b3d0-6529e7841e46"],
 "\n\t\nCon el Mathematica,"
}], "Text",
 CellChangeTimes->{{3.724760320859419*^9, 3.724760355444619*^9}, {
   3.7247603885946193`*^9, 3.7247604823038197`*^9}, {3.7249537218392277`*^9, 
   3.724953946599829*^9}, {3.7254242816588144`*^9, 3.7254242819396143`*^9}, {
   3.9459512210557833`*^9, 3.9459512525666475`*^9}, {3.9459512895717163`*^9, 
   3.9459513963313417`*^9}, {3.94595144036075*^9, 3.945951447412242*^9}, {
   3.945951504104905*^9, 3.945951519493729*^9}, {3.9459515550304923`*^9, 
   3.945951598246628*^9}, {3.945953317547082*^9, 3.9459536251976895`*^9}, 
   3.945953759339439*^9},
 FontSize->18,ExpressionUUID->"edb454c3-2442-4c92-a744-409458005259"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "[", "x_", "]"}], ":=", " ", 
  FractionBox[
   RowBox[{"1", "+", 
    RowBox[{"2", "x"}]}], 
   RowBox[{"1", "+", "x", "+", 
    SuperscriptBox["x", "2"]}]]}]], "Input",
 CellChangeTimes->{{3.914842478354336*^9, 3.914842500869671*^9}, {
  3.9459514543706427`*^9, 3.9459514551597166`*^9}},
 FontSize->18,
 CellLabel->"In[19]:=",ExpressionUUID->"b731c8bf-a193-4273-9452-18956c64a03c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"2", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"f", "[", "0", "]"}], "+", 
     RowBox[{"4", 
      RowBox[{"f", "[", "1", "]"}]}], "+", 
     RowBox[{"f", "[", "2", "]"}]}], ")"}], "/", "6"}]}]], "Input",
 CellChangeTimes->{{3.9148425107281384`*^9, 3.9148425256805987`*^9}},
 FontSize->18,
 CellLabel->"In[20]:=",ExpressionUUID->"761c8478-f37c-4639-bc1e-222c29e6c029"],

Cell[BoxData[
 FractionBox["40", "21"]], "Output",
