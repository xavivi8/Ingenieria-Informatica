Cell[TextData[{
 "Soluci\[OAcute]n:\nNos encontramos con la diferencia de dos expresiones que \
se hacen cada vez mas grandes y tienden a infinito: tendr\[IAcute]amos una \
indeterminaci\[OAcute]n.\n\nPara tratar de resolver el problema, \
multiplicamos y dividimos por el \[OpenCurlyDoubleQuote]conjugado\
\[CloseCurlyDoubleQuote]:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox[
     RowBox[{
      SuperscriptBox["n", "2"], "+", 
      RowBox[{"3", "n"}], "+", "1"}]], "-", 
    SqrtBox[
     RowBox[{
      SuperscriptBox["n", "2"], "-", 
      RowBox[{"2", "n"}], "+", "3"}]]}], TraditionalForm]],ExpressionUUID->
  "0e6af9d7-02b3-459e-a8eb-cd21771713ea"],
 "= ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SqrtBox[
        RowBox[{
         SuperscriptBox["n", "2"], "+", 
         RowBox[{"3", "n"}], "+", "1"}]], "-", 
       SqrtBox[
        RowBox[{
         SuperscriptBox["n", "2"], "-", 
         RowBox[{"2", "n"}], "+", "3"}]]}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       SqrtBox[
        RowBox[{
         SuperscriptBox["n", "2"], "+", 
         RowBox[{"3", "n"}], "+", "1"}]], "+", 
       SqrtBox[
        RowBox[{
         SuperscriptBox["n", "2"], "-", 
         RowBox[{"2", "n"}], "+", "3"}]]}], ")"}]}], 
    RowBox[{
     SqrtBox[
      RowBox[{
       SuperscriptBox["n", "2"], "+", 
       RowBox[{"3", "n"}], "+", "1"}]], "+", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["n", "2"], "-", 
       RowBox[{"2", "n"}], "+", "3"}]]}]], TraditionalForm]],ExpressionUUID->
  "e7e464ef-2b8f-4955-8a92-646e0e23f3c4"],
 "= ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    FormBox[
     FractionBox[
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["n", "2"], "+", 
          RowBox[{"3", "n"}], "+", "1"}], ")"}], " ", "-", " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["n", "2"], "-", 
          RowBox[{"2", "n"}], "+", "3"}], ")"}]}], ")"}], 
      RowBox[{
       SqrtBox[
        RowBox[{
         SuperscriptBox["n", "2"], "+", 
         RowBox[{"3", "n"}], "+", "1"}]], "+", 
       SqrtBox[
        RowBox[{
         SuperscriptBox["n", "2"], "-", 
         RowBox[{"2", "n"}], "+", "3"}]]}]],
     TraditionalForm]}], TraditionalForm]],ExpressionUUID->
  "1b11a674-7c48-4b74-90ab-df452130c629"],
 "=",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    FormBox[
     FractionBox[
      RowBox[{
       RowBox[{"5", "n"}], "-", "2"}], 
      RowBox[{
       SqrtBox[
        RowBox[{
         SuperscriptBox["n", "2"], "+", 
         RowBox[{"3", "n"}], "+", "1"}]], "+", 
       SqrtBox[
        RowBox[{
         SuperscriptBox["n", "2"], "-", 
         RowBox[{"2", "n"}], "+", "3"}]]}]],
     TraditionalForm]}], TraditionalForm]],ExpressionUUID->
  "a1a46e19-b567-4441-8616-e1dbb43dfc2d"],
 "\n\nEl numerador es un polinomio de grado 1. El denominador no es un \
polinomio, pero es una suma dos ra\[IAcute]ces cuadradas de polinomios de \
grado dos, es decir, en cierta medida ser\[IAcute]a parecido a polinomios de \
grado 1, por ello dividimos por n, numerador y denominador:\n\t",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     RowBox[{"5", "n"}], "-", "2"}], 
    RowBox[{
     SqrtBox[
      RowBox[{
       SuperscriptBox["n", "2"], "+", 
       RowBox[{"3", "n"}], "+", "1"}]], "+", 
     SqrtBox[
      RowBox[{
       SuperscriptBox["n", "2"], "-", 
       RowBox[{"2", "n"}], "+", "3"}]]}]], TraditionalForm]],ExpressionUUID->
  "8a5e1c72-fafb-4667-941e-a5978122b56f"],
 "= ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     FractionBox[
      RowBox[{"5", "n"}], "n"], "-", 
     FractionBox["2", "n"]}], 
    RowBox[{
     FractionBox[
      SqrtBox[
       RowBox[{
        SuperscriptBox["n", "2"], "+", 
        RowBox[{"3", "n"}], "+", "1"}]], "n"], "+", " ", 
     FractionBox[
      SqrtBox[
       RowBox[{
        SuperscriptBox["n", "2"], "-", 
        RowBox[{"2", "n"}], "+", "3"}]], "n"]}]], TraditionalForm]],
  ExpressionUUID->"60ec9595-7a77-4ad4-9fea-c482b8d55a44"],
 " = ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"5", " ", "-", " ", 
     FractionBox["2", "n"]}], 
    RowBox[{
     SqrtBox[
      FractionBox[
       RowBox[{
        SuperscriptBox["n", "2"], "+", 
        RowBox[{"3", "n"}], "+", "1"}], 
       SuperscriptBox["n", "2"]]], " ", "+", " ", 
     SqrtBox[
      FractionBox[
       RowBox[{
        SuperscriptBox["n", "2"], "-", 
        RowBox[{"2", "n"}], "+", "3"}], 
       SuperscriptBox["n", "2"]]]}]], TraditionalForm]],ExpressionUUID->
  "c45ceb8d-4800-42ae-9c51-3d20270420d1"],
 " = ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"5", " ", "-", " ", 
     FractionBox["2", "n"]}], 
    RowBox[{
     SqrtBox[
      RowBox[{"1", "+", 
       FractionBox["3", "n"], "+", 
       FractionBox["1", 
        SuperscriptBox["n", "2"]]}]], " ", "+", " ", 
     SqrtBox[
      RowBox[{"1", "-", 
       FractionBox["2", "n"], "+", 
       FractionBox["3", 
        SuperscriptBox["n", "2"]]}]]}]], TraditionalForm]],ExpressionUUID->
  "3c6da24c-a48f-44bd-adaa-b908c7adfcfe"],
 "  \[LongRightArrow]  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["5", 
     RowBox[{" ", 
      RowBox[{
       SqrtBox[
        RowBox[{"1", "+", "0", "+", "0"}]], "+", " ", 
       SqrtBox[
        RowBox[{"1", "+", "0", "+", "0"}]]}]}]], "=", 
    FractionBox["5", "2"]}], TraditionalForm]],ExpressionUUID->
  "47501259-0c5e-4cd8-bfaf-cdcc0fbfe357"],
 ".\n\nLa n puede entrar en la ra\[IAcute]z cuadrada como ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["n", "2"], TraditionalForm]],ExpressionUUID->
  "9c5d24e3-dd9f-4717-981d-fbdbd4af101b"],
 ". Simplificando y haciendo que n tienda a infinito, nos encontramos que el \
l\[IAcute]mite vale ",
 Cell[BoxData[
  FormBox[
   FractionBox["5", "2"], TraditionalForm]],ExpressionUUID->
  "8fa9d99e-6098-4b9f-a503-57eb2be778ce"],
 ".\n\nCon el Mathematica,"
}], "Text",
