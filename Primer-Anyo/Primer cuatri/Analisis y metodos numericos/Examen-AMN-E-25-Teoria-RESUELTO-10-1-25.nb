       FontWeight->"Plain"]}]}]}], TraditionalForm]],ExpressionUUID->
  "2ccd2672-013d-44d3-9721-8ec87877a15c"],
 " = ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"3", "+", 
     RowBox[{"2", "*", 
      RowBox[{"(", 
       RowBox[{"2", "+", "3", "-", "1"}], ")"}]}], "+", 
     RowBox[{"2", "*", 
      RowBox[{"(", 
       RowBox[{"2", "+", "3"}], ")"}]}]}],
    FontWeight->"Plain"], TraditionalForm]],ExpressionUUID->
  "4b416797-e167-4e26-990b-78b2ca33033b"],
 " =  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"3", "+", 
     RowBox[{"2", "*", "4"}], "+", 
     RowBox[{"2", "*", "5"}]}],
    FontWeight->"Plain"], TraditionalForm]],ExpressionUUID->
  "5e766166-5c98-4c4f-9dab-c081dd7d6d26"],
 " = 3+8+10 = 21.\nLa aproximaci\[OAcute]n de y(4) por el m\[EAcute]todo de \
Taylor de segundo orden ser\[IAcute]a ",
 Cell[BoxData[
  FormBox["21", TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"bff46329-4670-46e7-838f-2450910961f2"],
 ".\n\nCon el Mathematica,"
}], "Text",
