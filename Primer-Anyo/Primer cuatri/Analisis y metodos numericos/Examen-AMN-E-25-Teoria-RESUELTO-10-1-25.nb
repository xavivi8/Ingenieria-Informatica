  3.9470854726327477`*^9}},ExpressionUUID->"e88739e1-3037-41e3-8719-\
47854dfcac54"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "\n \t9.- Resolver la ecuaci\[OAcute]n diferencial ",
 StyleBox["y\[CloseCurlyQuote]\[CloseCurlyQuote] - y\[CloseCurlyQuote] = 2x+1",
  FontSize->18],
 ".\n\t \t"
}], "Section",
 CellChangeTimes->{{3.500751345359375*^9, 3.500751379984375*^9}, {
   3.500790035609375*^9, 3.500790048953125*^9}, {3.569509423875*^9, 
   3.56950942659375*^9}, {3.570537368580125*^9, 3.57053737997075*^9}, {
   3.599199111625*^9, 3.5991991196875*^9}, {3.723477468774*^9, 
   3.723477473212*^9}, {3.723478212648*^9, 3.723478232406*^9}, {
   3.723478462157*^9, 3.723478463176*^9}, {3.723478670633*^9, 
   3.723478671652*^9}, {3.72356892631*^9, 3.7235690780550003`*^9}, {
   3.723569130146*^9, 3.723569177783*^9}, {3.7235692175769997`*^9, 
   3.723569247399*^9}, {3.723569308648*^9, 3.723569328826*^9}, {
   3.723569485984*^9, 3.723569513233*^9}, {3.7236081819960003`*^9, 
   3.7236083309300003`*^9}, {3.7236509376520233`*^9, 3.7236509459610233`*^9}, 
   3.7236517258530235`*^9, 3.723651765606024*^9, {3.7236521565550237`*^9, 
   3.7236522309350233`*^9}, {3.7238353873130035`*^9, 3.723835410693304*^9}, {
   3.7239071598070183`*^9, 3.723907162602418*^9}, {3.724158365534717*^9, 
   3.724158429733717*^9}, {3.724164938261321*^9, 3.724164963029321*^9}, 
   3.7254239244656124`*^9, {3.819906851493*^9, 3.8199068540039997`*^9}, 
   3.8210788920438013`*^9, 3.8522912440128613`*^9, {3.906787819127457*^9, 
   3.9067878202973323`*^9}, {3.9126170464248657`*^9, 
   3.9126170497759066`*^9}, {3.9452694204438677`*^9, 
   3.9452694608387218`*^9}, {3.945270067143374*^9, 3.945270068293731*^9}, 
   3.9458646546782618`*^9},
 FontFamily->"Arial",
 FontSize->18,
 FontColor->RGBColor[0., 0.25098039215686274`, 0.5019607843137255],
 Background->RGBColor[
  0.807843137254902, 0.9058823529411765, 
   1.],ExpressionUUID->"98e57b7b-678d-4b1c-958b-ef0a1963e1d2"],

Cell[TextData[{
 "Soluci\[OAcute]n:\nSe trata de una ecuaci\[OAcute]n diferencial lineal de \
coeficientes constantes completa. \n1) Se resuelve en primer lugar, la ecuaci\
\[OAcute]n diferencial homog\[EAcute]nea: y\[CloseCurlyQuote]\
\[CloseCurlyQuote] - y\[CloseCurlyQuote] = 0. \n\tPara ello se resuelve la \
ecuaci\[OAcute]n polin\[OAcute]mica asociada: ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "269d731c-9ff7-4cf4-aa40-b132e74d8e0b"],
 " - x = 0; x(x-1) = 0; x=0 \[OAcute] x=1.\n\tSi las soluciones de la ecuaci\
\[OAcute]n polin\[OAcute]mica son 0 y 1, la soluci\[OAcute]n general de la \
ecuaci\[OAcute]n diferencial homog\[EAcute]nea es:\n\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "h"], TraditionalForm]],ExpressionUUID->
  "01b09ac1-2b35-45eb-9f1c-1d5aa8ba374f"],
 "(x) = ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "1"], TraditionalForm]],ExpressionUUID->
  "6fd7272f-d746-4a87-b7da-6ededecc34f9"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"0", "*", "x"}]], TraditionalForm]],ExpressionUUID->
  "22483f55-1eb7-4d25-9c9f-c46ad8d2fe2b"],
 " +  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "2"], TraditionalForm]],ExpressionUUID->
  "e6079d42-6b01-4e23-9352-ff3a0c9ec4f3"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"1", "*", "x"}]], TraditionalForm]],ExpressionUUID->
  "9ae506c6-93d6-4269-b121-3ae1823f696a"],
 " =  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "1"], TraditionalForm]],ExpressionUUID->
  "55a8a16f-0a73-4676-8a55-942d7e9d1a3a"],
 " +  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "2"], TraditionalForm]],ExpressionUUID->
  "78557888-f284-49a6-83af-378f30e16909"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", "x"], TraditionalForm]],ExpressionUUID->
  "196e0fb0-8fd0-47fd-bb24-39e440904dc6"],
 ", con ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "1"], TraditionalForm]],ExpressionUUID->
  "413fe865-df11-442a-87aa-361e31ab0737"],
 " , ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "2"], TraditionalForm]],ExpressionUUID->
  "9cf6238d-712c-4f2c-b5b4-5437b2e173b4"],
 " n\[UAcute]meros reales cualesquiera\n2) A continuaci\[OAcute]n se busca \
una soluci\[OAcute]n particular de la ecuaci\[OAcute]n diferencial completa: \
y\[CloseCurlyQuote]\[CloseCurlyQuote] - y\[CloseCurlyQuote] = 2x + 1.\n\tNos \
fijamos en que el t\[EAcute]rmino independiente es un polinomio de grado 1. \
Como las constantes son soluci\[OAcute]n de la ecuaci\[OAcute]n \
homog\[EAcute]nea, elevamos el grado de los polinomios y probamos con una \
funci\[OAcute]n del tipo  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "p"], TraditionalForm]],ExpressionUUID->
  "39cdecdd-83fa-4d56-be3b-b5f9651aea78"],
 "(x) = a x + b ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "d05b39ce-f8bc-45fe-b97c-bb22aa42d2ac"],
 ".\n\t",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "p"], TraditionalForm]],ExpressionUUID->
  "21e58bb6-0808-4171-b520-6dfad31a6d63"],
 "(x) = a x + b ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "f75da9a9-6e93-4742-9bed-9fcadfc4f7bc"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "p"], "'"}], TraditionalForm]],ExpressionUUID->
  "3680de85-b029-4bf3-a800-eda44f31537c"],
 "(x) = a + 2 b ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "dcc67561-ba76-4e5c-b3bf-d35bc0332ad8"],
 "\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "p"], "''"}], TraditionalForm]],ExpressionUUID->
  "95ba64a7-cc2f-4820-b0e1-e4e357319209"],
 "(x) = 2 b\nAhora sustituimos en la ecuaci\[OAcute]n diferencial:\n\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "p"], "''"}], TraditionalForm]],ExpressionUUID->
  "247f533d-7ac2-434e-86b7-8b3023d7e356"],
 " - ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "p"], "'"}], TraditionalForm]],ExpressionUUID->
  "b4217fdc-24c0-4822-9ecb-1e74357c2449"],
 " = 2b  - (a + 2 b x ) = 2b - a -2 b x = 2x+1\nDe donde 2b-a=1, -2b=2 . Por \
tanto, b=-1, a=2b-1=-2-1=-3\n\tLa soluci\[OAcute]n particular es  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "p"], TraditionalForm]],ExpressionUUID->
  "f8d9a7d8-dc7a-4136-840c-b40222266b4b"],
 "(x) = -3x-",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "2"], TraditionalForm]],ExpressionUUID->
  "2675df6e-c2e0-4943-bb3a-279250588f96"],
 ".\nLa soluci\[OAcute]n general es y(x) = ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"-", "3"}], "x"}], "-", 
    FormBox[
     SuperscriptBox["x", "2"],
     TraditionalForm], "+", 
    SubscriptBox["C", "1"]}], TraditionalForm]],ExpressionUUID->
  "1460c780-8ff6-423b-9832-4c1f25efdf5a"],
 " + ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "2"], TraditionalForm]],ExpressionUUID->
  "aba78ca4-fe98-41da-b7ef-72c5280d135f"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[ExponentialE]", "x"], TraditionalForm]],ExpressionUUID->
  "0560f14a-d126-4ad5-8969-34c58e53579e"],
 " , con ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "1"], TraditionalForm]],ExpressionUUID->
  "35936dfe-09f0-4005-83fe-f0da3963c6ec"],
 " , ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["C", "2"], TraditionalForm]],ExpressionUUID->
  "4c8afbfb-53fb-4149-8e5a-a2f39f7571a6"],
 " n\[UAcute]meros reales cualesquiera.\n\nCon el Mathematica"
}], "Text",
