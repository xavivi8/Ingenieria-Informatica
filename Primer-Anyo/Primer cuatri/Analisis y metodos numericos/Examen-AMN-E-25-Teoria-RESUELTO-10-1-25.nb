Cell[TextData[{
 "Soluci\[OAcute]n:\nTenemos que buscar un polinomio en el intervalo [0,1] y \
otro en el [1,2]. Los dos polinomios deben ser de grado menor o igual a dos y \
deben \[OpenCurlyDoubleQuote]unir\[CloseCurlyDoubleQuote] con clase 1 en el \
punto 1 (es decir, deben tener el mismo valor en el punto 1 y la misma \
derivada).\ns(x)=",
 Cell[BoxData[
  FormBox[
   TagBox[GridBox[{
      {"\[Piecewise]", GridBox[{
         {
          RowBox[{
           RowBox[{"p1", "(", "x", ")"}], " ", "=", 
           RowBox[{"a", "+", 
            RowBox[{"b", "(", 
             RowBox[{"x", "-", "0"}], ")"}], "+", 
            SuperscriptBox[
             RowBox[{"c", "(", 
              RowBox[{"x", "-", "0"}], ")"}], "2"]}]}], 
          RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", "1"}]},
         {
          RowBox[{
           RowBox[{"p2", "(", "x", ")"}], "=", 
           RowBox[{"d", "+", 
            RowBox[{"e", "(", 
             RowBox[{"x", "-", "1"}], ")"}], "+", 
            SuperscriptBox[
             RowBox[{"f", "(", 
              RowBox[{"x", "-", "1"}], ")"}], "2"]}]}], 
          RowBox[{"1", "\[LessEqual]", "x", "\[LessEqual]", "2"}]}
        },
        AllowedDimensions->{2, Automatic},
        Editable->True,
        GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
        GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.84]}, 
            Offset[0.27999999999999997`]}, "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}},
        Selectable->True]}
     },
     GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
     GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.35]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}],
    "Piecewise",
    DeleteWithContents->True,
    Editable->False,
    SelectWithContents->True,
    Selectable->False,
    StripWrapperBoxes->True], TraditionalForm]],ExpressionUUID->
  "7a5dc931-21a9-4130-9fb0-fffbf5af2a9c"],
 "\nPara calcular el polinomio p1(x) usamos los datos: ",
 StyleBox["f(0)=0, f \[OpenCurlyQuote](0)=",
  FontSize->16,
  FontSlant->"Italic"],
 StyleBox["\[Pi]",
  FontSize->18,
  FontSlant->"Italic"],
 StyleBox[", f (1)= 0\np1(0)=a+0+0 = 0\np1\[CloseCurlyQuote](0)=0+b+0 = ",
  FontSize->16,
  FontSlant->"Italic"],
 StyleBox["\[Pi]",
  FontSize->18,
  FontSlant->"Italic"],
 StyleBox["\np1(1)=a+b*1+c*1^2=0+",
  FontSize->16,
  FontSlant->"Italic"],
 StyleBox["\[Pi]  ",
  FontSize->18,
  FontSlant->"Italic"],
 StyleBox["+ c=0 \[DoubleLongRightArrow] c=-",
  FontSize->16,
  FontSlant->"Italic"],
 StyleBox["\[Pi]",
  FontSize->18,
  FontSlant->"Italic"],
 StyleBox["\n",
  FontSize->16,
  FontSlant->"Italic"],
 "\nUna vez calculado el polinomio p1(x) = ",
 StyleBox["\[Pi] * ",
  FontSize->18,
  FontSlant->"Italic"],
 "x - ",
 StyleBox["\[Pi]",
  FontSize->18,
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SuperscriptBox["x", "2"]}], TraditionalForm]],ExpressionUUID->
  "f4d22906-5ee7-4f29-9941-e8f78450bf95"],
 ", calculamos su derivada en el punto 1, p1\[CloseCurlyQuote](x) = ",
 StyleBox["\[Pi]",
  FontSize->18,
  FontSlant->"Italic"],
 " - 2*",
 StyleBox["\[Pi] *",
  FontSize->18,
  FontSlant->"Italic"],
 "x, p1\[CloseCurlyQuote](1)=",
 StyleBox["\[Pi]",
  FontSize->18,
  FontSlant->"Italic"],
 " - 2*",
 StyleBox["\[Pi] *1 = \[Pi] - 2*\[Pi]   = - \[Pi] ",
  FontSize->18,
  FontSlant->"Italic"],
 ".\nEl polinomio p2(x) debe cumplir\np2(1) = d + 0 + 0 = 0\np2\
\[CloseCurlyQuote](1) = 0 + e + 0 = -",
 StyleBox["\[Pi] ",
  FontSize->18,
  FontSlant->"Italic"],
 "\np2(2) = d + e*",
 StyleBox[" ",
  FontSize->18,
  FontSlant->"Italic"],
 "(2-1) + f*",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"2", "-", "1"}], ")"}], "2"], TraditionalForm]],ExpressionUUID->
  "36b87d33-5f40-4c30-b722-19a9775b04d8"],
 " = 0 - ",
 StyleBox["\[Pi] ",
  FontSize->18,
  FontSlant->"Italic"],
 " + f  = -",
 StyleBox["\[Pi] ",
  FontSize->18,
  FontSlant->"Italic"],
 " + f = 0  ",
 StyleBox["\[DoubleLongRightArrow] f = ",
  FontSize->16,
  FontSlant->"Italic"],
 StyleBox["\[Pi] ",
  FontSize->18,
  FontSlant->"Italic"],
 StyleBox["\n",
  FontSize->16,
  FontSlant->"Italic"],
 "\nPor tanto, el polinomio p2(x)=-",
 StyleBox["\[Pi]",
  FontSize->18,
  FontSlant->"Italic"],
 "(x-1)+",
 StyleBox["\[Pi]",
  FontSize->18,
  FontSlant->"Italic"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"x", "-", "1"}], ")"}], "2"], TraditionalForm]],ExpressionUUID->
  "09ef6ea3-a31b-4ae3-946e-32805df1066c"],
 " y tenemos calculada la funci\[OAcute]n spline.\n\ns(x)=",
 Cell[BoxData[
  FormBox[
   TagBox[GridBox[{
      {"\[Piecewise]", GridBox[{
         {
          RowBox[{
           RowBox[{"p1", "(", "x", ")"}], " ", "=", 
           RowBox[{
            RowBox[{
             StyleBox["\[Pi]",
              FontSize->18,
              FontSlant->"Italic"], 
             StyleBox[" ",
              FontSize->18,
              FontSlant->"Italic"], 
             StyleBox["*",
              FontSize->18,
              FontSlant->"Italic"], 
             StyleBox[" ",
              FontSize->18,
              FontSlant->"Italic"], "x"}], "-", 
            RowBox[{
             StyleBox["\[Pi]",
              FontSize->18,
              FontSlant->"Italic"], " ", 
             FormBox[
              RowBox[{" ", 
               SuperscriptBox["x", "2"]}],
              TraditionalForm]}]}]}], 
          RowBox[{"0", "\[LessEqual]", "x", "\[LessEqual]", "1"}]},
         {
          RowBox[{
           RowBox[{"p2", "(", "x", ")"}], "=", 
           RowBox[{
            RowBox[{"-", 
             RowBox[{
              StyleBox["\[Pi]",
               FontSize->18,
               FontSlant->"Italic"], "(", 
              RowBox[{"x", "-", "1"}], ")"}]}], "+", 
            RowBox[{
             StyleBox["\[Pi]",
              FontSize->18,
              FontSlant->"Italic"], " ", 
             FormBox[
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"x", "-", "1"}], ")"}], "2"],
              TraditionalForm]}]}]}], 
          RowBox[{"1", "\[LessEqual]", "x", "\[LessEqual]", "2"}]}
        },
        AllowedDimensions->{2, Automatic},
        Editable->True,
        GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
        GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
        GridBoxSpacings->{"Columns" -> {
            Offset[0.27999999999999997`], {
             Offset[0.84]}, 
            Offset[0.27999999999999997`]}, "Rows" -> {
            Offset[0.2], {
             Offset[0.4]}, 
            Offset[0.2]}},
        Selectable->True]}
     },
     GridBoxAlignment->{"Columns" -> {{Left}}, "Rows" -> {{Baseline}}},
     GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{1.}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.35]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}],
    "Piecewise",
    DeleteWithContents->True,
    Editable->False,
    SelectWithContents->True,
    Selectable->False,
    StripWrapperBoxes->True], TraditionalForm]],ExpressionUUID->
  "28c02b6c-be98-492d-a823-be535f013d20"],
 "\n\nCon el Mathematica"
}], "Text",
