Cell[TextData[{
 "Soluci\[OAcute]n:\nComenzamos calculando el cociente que aparece. Para ello \
multiplicamos y dividimos por el conjugado del denominador.\n\t\t",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"3", "+", "\[ImaginaryI]"}], 
    RowBox[{"2", "-", "\[ImaginaryI]"}]], TraditionalForm]],ExpressionUUID->
  "2b992214-5608-4697-bb0d-4d4ee4d9a436"],
 " = ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     RowBox[{"(", 
      RowBox[{"3", "+", "\[ImaginaryI]"}], ")"}], 
     RowBox[{"(", 
      RowBox[{"2", "+", "\[ImaginaryI]"}], ")"}]}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"2", "-", "\[ImaginaryI]"}], ")"}], 
     RowBox[{"(", 
      RowBox[{"2", "+", "\[ImaginaryI]"}], ")"}]}]], TraditionalForm]],
  ExpressionUUID->"d56aa5a6-19d8-45c4-b3ff-5031e1a60c55"],
 " = ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"(", 
     RowBox[{"6", "+", 
      RowBox[{"5", "\[ImaginaryI]"}], "+", " ", 
      SuperscriptBox["\[ImaginaryI]", "2"]}], ")"}], 
    RowBox[{"4", "+", "1"}]], TraditionalForm]],ExpressionUUID->
  "32fe0b1e-01b2-4a69-bde2-8681befaf0e8"],
 " = ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"5", "+", 
     RowBox[{"5", "\[ImaginaryI]"}]}], "5"], TraditionalForm]],ExpressionUUID->
  "f75ebd91-d7bd-4b08-88fd-9a78b90cbecb"],
 " = 1 + \[ImaginaryI]  \n\nPara calcular las ra\[IAcute]ces, es conveniente \
escribir el n\[UAcute]mero en forma polar.\n\nEl argumento de 1 + \
\[ImaginaryI] es ",
 Cell[BoxData[
  FormBox[
   FractionBox["\[Pi]", "4"], TraditionalForm]],ExpressionUUID->
  "e8fac708-10f4-4ce4-b0d6-b110ceee05c5"],
 ", pues est\[AAcute] en la bisectriz del primer cuadrante (parte real y \
parte imaginaria positivas e iguales).\nEl m\[OAcute]dulo es ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox[
     RowBox[{
      SuperscriptBox["1", "2"], "+", 
      SuperscriptBox["1", "2"]}]], "=", 
    SqrtBox["2"]}], TraditionalForm]],ExpressionUUID->
  "dc5efdf4-befa-4616-8b12-bc1bb639d4a0"],
 "\n\nLas tres ra\[IAcute]ces c\[UAcute]bicas del n\[UAcute]mero complejo 1 + \
\[ImaginaryI] tendr\[AAcute]n el mismo m\[OAcute]dulo; la ra\[IAcute]z c\
\[UAcute]bica de su m\[OAcute]dulo. Los argumentos ser\[AAcute]n: un tercio \
del argumento de 1 + \[ImaginaryI], un tercio del argumento de 1 + \
\[ImaginaryI]  m\[AAcute]s un tercio de vuelta completa y un tercio del \
argumento de 1 + \[ImaginaryI]  m\[AAcute]s dos tercios de vuelta.\n\n\t",
 Cell[BoxData[
  FormBox[
   RadicalBox[
    RowBox[{"1", "+", "\[ImaginaryI]"}], "3"], TraditionalForm]],
  ExpressionUUID->"c7b1ed1a-cedf-4d55-b113-54fec6c3496c"],
 "= ",
 Cell[BoxData[
  FormBox[
   RadicalBox[
    SubscriptBox[
     SqrtBox["2"], 
     FractionBox["\[Pi]", "4"]], "3"], TraditionalForm]],ExpressionUUID->
  "31806ec9-9253-41ff-ba9d-a44a5c413a5f"],
 "= ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox[
     RowBox[{"(", 
      RadicalBox["2", "6"], ")"}], 
     FractionBox[
      RowBox[{"(", 
       FractionBox["\[Pi]", "4"], ")"}], "3"]]}], TraditionalForm]],
  ExpressionUUID->"25d0eaf4-3675-40b4-ad70-94e744590c38"],
 ",  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", 
     RadicalBox["2", "6"], ")"}], 
    RowBox[{
     FractionBox[
      RowBox[{"(", 
       FractionBox["\[Pi]", "4"], ")"}], "3"], "+", 
     FractionBox[
      RowBox[{"2", "\[Pi]"}], "3"]}]], TraditionalForm]],ExpressionUUID->
  "1ab6d814-d93f-46d2-a027-781b5441a1b7"],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      RadicalBox["2", "6"], ")"}], 
     RowBox[{
      FractionBox[
       RowBox[{"(", 
        FractionBox["\[Pi]", "4"], ")"}], "3"], "+", 
      RowBox[{"2", 
       FractionBox[
        RowBox[{"2", "\[Pi]"}], "3"]}]}]], "}"}], TraditionalForm]],
  ExpressionUUID->"83623012-5313-4525-9459-ee1f0ea8bba5"],
 " = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox[
     RowBox[{"(", 
      RadicalBox["2", "6"], ")"}], 
     FractionBox["\[Pi]", "12"]]}], TraditionalForm]],ExpressionUUID->
  "39428537-badd-4ace-860b-d324e8927da9"],
 ",  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", 
     RadicalBox["2", "6"], ")"}], 
    RowBox[{
     FractionBox["\[Pi]", "12"], "+", 
     FractionBox[
      RowBox[{"2", "\[Pi]"}], "3"]}]], TraditionalForm]],ExpressionUUID->
  "75f50e91-29ac-4b4d-bbff-04d0e666d964"],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      RadicalBox["2", "6"], ")"}], 
     RowBox[{
      FractionBox["\[Pi]", "12"], "+", 
      FractionBox[
       RowBox[{"4", "\[Pi]"}], "3"]}]], "}"}], TraditionalForm]],
  ExpressionUUID->"d2671df1-0db8-4db9-8031-6022381d47db"],
 " = \n\t\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    SubscriptBox[
     RowBox[{"(", 
      RadicalBox["2", "6"], ")"}], 
     FractionBox["\[Pi]", "12"]]}], TraditionalForm]],ExpressionUUID->
  "37867063-fee9-43b8-b61d-aa047884849c"],
 ",  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    RowBox[{"(", 
     RadicalBox["2", "6"], ")"}], 
    FractionBox[
     RowBox[{"9", "\[Pi]"}], "12"]], TraditionalForm]],ExpressionUUID->
  "9b9d21bc-9e80-4932-83b5-b0c5d8f86ce1"],
 ",  ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{"(", 
      RadicalBox["2", "6"], ")"}], 
     FractionBox[
      RowBox[{"17", "\[Pi]"}], "12"]], "}"}], TraditionalForm]],
  ExpressionUUID->"54e5cc0d-2950-4ac3-a5f0-5376e44303a7"],
 " ."
}], "Text",
 CellChangeTimes->{{3.610967983265625*^9, 3.610968082640625*^9}, {
