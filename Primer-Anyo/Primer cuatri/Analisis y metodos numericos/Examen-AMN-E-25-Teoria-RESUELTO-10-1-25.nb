Cell["\<\
Las derivadas parciales se anulan en 4 puntos. Para estudiar lo que ocurre en \
estos puntos, calculamos el hessiano de la funci\[OAcute]n y evaluamos en los \
puntos encontrados.\
\>", "Text",
 CellChangeTimes->{{3.9470845734027243`*^9, 3.947084643141927*^9}, {
  3.947084851313965*^9, 3.9470848801631193`*^9}, {3.94708501879522*^9, 
  3.947085068222467*^9}, {3.947085119003357*^9, 
  3.9470851275893283`*^9}},ExpressionUUID->"faa3e9c4-cbd2-4ce1-b3fd-\
92384b9058cc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"hess", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"Det", "[", 
    RowBox[{"(", GridBox[{
       {
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"u", ",", "v"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "2"}], "}"}]}], "]"}], 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"u", ",", "v"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"v", ",", "1"}], "}"}]}], "]"}]},
       {
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"u", ",", "v"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"u", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"v", ",", "1"}], "}"}]}], "]"}], 
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"u", ",", "v"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"v", ",", "2"}], "}"}]}], "]"}]}
      }], ")"}], "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u", "->", "x"}], ",", 
     RowBox[{"v", "->", "y"}]}], "}"}]}]}]], "Input",
 CellChangeTimes->{{3.9470842802207437`*^9, 3.9470843449970846`*^9}, {
  3.947084389666985*^9, 3.94708441847319*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"9752fb52-3a39-48d5-a0b2-a9534844e931"],

