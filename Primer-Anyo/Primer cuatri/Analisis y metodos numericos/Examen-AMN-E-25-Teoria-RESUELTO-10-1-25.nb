   Ticks->{Automatic, Automatic}]], "Output",
  CellChangeTimes->{{3.9459588049937906`*^9, 3.9459588532041245`*^9}, {
   3.945958890034523*^9, 3.945958923964649*^9}},ExpressionUUID->
  "fc910181-3c86-4db4-a4e8-23f79524d903"],
 "\n\t",
 StyleBox["f(x) = ",
  FontSize->18],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "3"], "-", 
    RowBox[{"3", "x"}], "-", "5"}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"f4229207-db94-49e5-9a29-650cda41c2e3"],
 "\n\t",
 StyleBox["f \[OpenCurlyQuote](x) = ",
  FontSize->18],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"3", 
     SuperscriptBox["x", "2"]}], "-", "3"}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"a0d42cd8-6612-455e-8689-64507db47142"],
 "\n\tx0=3\n\tx1=x0-f(x0)/f\[CloseCurlyQuote](x0)= 3 - f(3) / f\
\[CloseCurlyQuote](3) = 3 -",
 StyleBox[" (",
  FontSize->18],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["3", "3"], "-", 
     RowBox[{"3", "*", "3"}], "-", "5"}], ")"}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"c6ce8e69-44bc-4515-ad2b-e675d7e9d0eb"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", "*", 
       SuperscriptBox["3", "2"]}], "-", "3"}], ")"}]}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"c63dcc50-352d-4f61-a669-fb577df111d2"],
 " = 3 - (27-9-5)/(27-3) = 3 - 13/24 = (72-13)/24 = 59/24 \n\tx2=x1-f(x1)/f\
\[CloseCurlyQuote](x1)= 59/24 - f(59/24) / f\[CloseCurlyQuote](59/24) = \
(59/24) -",
 StyleBox[" (",
  FontSize->18],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"59", "/", "24"}], ")"}], "3"], "-", 
     RowBox[{"3", "*", 
      RowBox[{"59", "/", "24"}]}], "-", "5"}], ")"}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"d9bbc4a7-9870-4e37-903a-bfe4a52dc137"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"3", "*", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"59", "/", "24"}], ")"}], "2"]}], "-", "3"}], ")"}]}], 
   TraditionalForm]],
  FontSize->18,ExpressionUUID->"3d570b0c-c36c-431a-98c9-b91afd27eaf2"],
 " \n\t"
}], "Text",
 CellChangeTimes->{{3.610967983265625*^9, 3.610968082640625*^9}, {
   3.6109681208125*^9, 3.61096812653125*^9}, {3.610976777453125*^9, 
   3.610976922484375*^9}, {3.610977092296875*^9, 3.610977288828125*^9}, {
   3.6109957936514254`*^9, 3.6109958150390635`*^9}, 3.6109962528538322`*^9, {
   3.6424694360273438`*^9, 3.6424694787837896`*^9}, {3.6424700316294107`*^9, 
