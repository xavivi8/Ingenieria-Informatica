Cell[TextData[{
 "\n\t4.- Calcular, si existe, el l\[IAcute]mite de la sucesi\[OAcute]n  ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"{", 
     RowBox[{
      SqrtBox[
       RowBox[{
        SuperscriptBox["n", "2"], "+", 
        RowBox[{"3", "n"}], "+", "1"}]], "-", 
      SqrtBox[
       RowBox[{
        SuperscriptBox["n", "2"], "-", 
        RowBox[{"2", "n"}], "+", "3"}]]}], "}"}],
    FontSize->18], TraditionalForm]],ExpressionUUID->
  "33a2eb71-5f78-4ff1-bbf4-ec410793114e"],
 " . \n \t"
}], "Section",
