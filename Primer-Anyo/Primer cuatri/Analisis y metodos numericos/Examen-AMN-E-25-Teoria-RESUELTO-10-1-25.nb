 RowBox[{"hess", "[", 
  RowBox[{"0", ",", 
   RowBox[{
    RowBox[{"-", "1"}], "/", "6"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9470844247367134`*^9, 3.947084434700265*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"7b90ee46-1feb-4011-a8c7-4310c95a914a"],

