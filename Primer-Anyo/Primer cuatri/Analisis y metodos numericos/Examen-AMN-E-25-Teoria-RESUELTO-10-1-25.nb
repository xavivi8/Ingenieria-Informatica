  FontSize->18,ExpressionUUID->"0e94ff0e-2930-4d72-a8d0-a9f81d21173a"],
 " = ",
 Cell[BoxData[
  FormBox[
   FractionBox["A", "n"], TraditionalForm]],
  FontSize->18,ExpressionUUID->"05258d1f-8c98-421a-9e93-92e71d29913a"],
 " + ",
 Cell[BoxData[
  FormBox[
   FractionBox["B", 
