Cell[TextData[{
 "\n \t10.- Calcular el polinomio de ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[DoubleStruckCapitalP]", "3"], TraditionalForm]],
  FontSize->18,ExpressionUUID->"46e3f416-c0ce-4e8e-b227-ecaafad4afe6"],
 " que interpola ",
 StyleBox["f(1) = 1, f \[OpenCurlyQuote](1) = 2, f \[OpenCurlyQuote]\
\[CloseCurlyQuote](1)= -2, f (2) = 3",
  FontSize->18],
 ".\n\t\t"
}], "Section",
 CellChangeTimes->{{3.500751345359375*^9, 3.500751379984375*^9}, {
   3.500790035609375*^9, 3.500790048953125*^9}, {3.569509423875*^9, 
