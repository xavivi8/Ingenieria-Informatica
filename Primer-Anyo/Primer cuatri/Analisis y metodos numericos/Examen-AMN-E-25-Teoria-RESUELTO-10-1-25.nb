Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"p1", "[", "0", "]"}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"p1", "'"}], "[", "0", "]"}], "==", "\[Pi]"}], ",", 
     RowBox[{
      RowBox[{"p1", "[", "1", "]"}], "==", "0"}], ",", 
     RowBox[{
      RowBox[{"p2", "[", "1", "]"}], "==", "0"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"p1", "'"}], "[", "1", "]"}], "==", 
      RowBox[{
       RowBox[{"p2", "'"}], "[", "1", "]"}]}], ",", 
     RowBox[{
      RowBox[{"p2", "[", "2", "]"}], "==", "0"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], "}"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.897827242214202*^9, 3.8978273159510064`*^9}, {
  3.8978274207494955`*^9, 3.897827421854704*^9}, {3.897827816426961*^9, 
