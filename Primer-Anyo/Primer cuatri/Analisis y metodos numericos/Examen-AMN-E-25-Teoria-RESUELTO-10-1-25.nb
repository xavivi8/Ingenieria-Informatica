       StyleBox["0",
        FontWeight->"Plain"], ",", " ", 
       SubscriptBox["1", " "]}], 
      StyleBox[")",
       FontWeight->"Plain"]}]}]}], TraditionalForm]],ExpressionUUID->
  "27396cce-fe9a-4427-8873-e3cc47f224f6"],
 " = ",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{"1", "+", 
     RowBox[{"2", "*", 
      RowBox[{"(", 
       RowBox[{"0", "+", "1", "-", "1"}], ")"}]}], "+", 
     RowBox[{"2", "*", 
      RowBox[{"(", 
       RowBox[{"0", "+", "1"}], ")"}]}]}],
    FontWeight->"Plain"], TraditionalForm]],ExpressionUUID->
  "f7555641-dcb5-4076-b149-52ba97a04393"],
 " = 1+2*0+2*1 = ",
 Cell[BoxData[
  FormBox["3", TraditionalForm]],ExpressionUUID->
  "b0fdf4a4-a54e-44dd-a477-55a2c5b891c6"],
 "\n",
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     SubscriptBox["y", "2"], "=", 
     RowBox[{
      SubscriptBox["y", "1"], "+", 
      RowBox[{"h", " ", 
       RowBox[{"f", "(", 
        RowBox[{
         SubscriptBox["x", 
          RowBox[{"1", " "}]], ",", " ", 
         SubscriptBox["y", 
          RowBox[{"1", " "}]]}], ")"}]}], "+", 
      RowBox[{
       FractionBox[
        SuperscriptBox["h", "2"], "2"], 
       RowBox[{"g", "(", 
        RowBox[{
         SubscriptBox["x", "1"], ",", " ", 
         SubscriptBox["y", 
          RowBox[{"1", " "}]]}], ")"}]}]}]}],
    FontWeight->"Plain"], TraditionalForm]],ExpressionUUID->
  "83354fa4-aef7-4ac0-aa8f-68b847d19e1b"],
 " \[DoubleLongRightArrow] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox[
     SubscriptBox["y", "2"],
     FontWeight->"Plain"], 
    StyleBox["=",
     FontWeight->"Plain"], 
    RowBox[{
     StyleBox["3",
      FontWeight->"Plain"], 
     StyleBox["+",
