  "4daabc7b-f55e-4f12-aef7-dfde52a2364f"],
 "\nLos puntos de corte de las dos l\[IAcute]neas se calculan resolviendo el \
sistema:\n\t\t\ty=3\n\t\t",
 Cell[BoxData[
  SuperscriptBox["x", "2"]],
  FontSlant->"Italic",ExpressionUUID->"a74738b3-085d-4446-971f-5b492260b5cf"],
 StyleBox["+ ",
  FontSlant->"Italic"],
 Cell[BoxData[
  SuperscriptBox["y", "2"]],
  FontSlant->"Italic",ExpressionUUID->"58ce3d71-a991-4d8e-bb44-241fdc6f8197"],
 " =",
 StyleBox[" 25.",
  FontSlant->"Italic"],
 "\nSustituyendo el valor de y en la segunda ecuaci\[OAcute]n:\n\t\t",
 Cell[BoxData[
  SuperscriptBox["3", "2"]],
  FontSlant->"Italic",ExpressionUUID->"d750df26-df4c-4593-9540-8a2d6df619b5"],
 StyleBox["+ ",
  FontSlant->"Italic"],
 Cell[BoxData[
  SuperscriptBox["y", "2"]],
  FontSlant->"Italic",ExpressionUUID->"dde2ac26-5ff4-4c61-9776-5f676eb8e62b"],
 " =",
 StyleBox[" 25 \[DoubleLongRightArrow] ",
  FontSlant->"Italic"],
 Cell[BoxData[
  SuperscriptBox["3", "2"]],
  FontSlant->"Italic",ExpressionUUID->"09cf3c6b-3386-49ad-8fe5-9e1c6f1b2701"],
 StyleBox["+ ",
  FontSlant->"Italic"],
 Cell[BoxData[
  SuperscriptBox["y", "2"]],
  FontSlant->"Italic",ExpressionUUID->"e33e9445-d92c-4589-ad71-fd4f8f1e2c57"],
 StyleBox[" = 25",
  FontSlant->"Italic"],
 "\n\nVemos que x var\[IAcute]a en el intervalo [-4,4]. Para cada valor de x, \
la y var\[IAcute]a entre y=3 e y= ",
 Cell[BoxData[
  FormBox[
   SqrtBox[
    RowBox[{"25", "-", 
     SuperscriptBox["x", "2"]}]], TraditionalForm]],ExpressionUUID->
  "5cf62083-d42a-4484-8d19-7ccf6a21efb1"],
 ".\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{"-", "4"}], "4"], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SubsuperscriptBox["\[Integral]", "3", 
        SqrtBox[
         RowBox[{"25", "-", 
          SuperscriptBox["x", "2"]}]]], 
       RowBox[{"y", 
        RowBox[{"\[DifferentialD]", "y"}]}]}], ")"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],
  FontSize->16,ExpressionUUID->"1a0ff09f-6b9e-4192-90d1-625d4e8d72f8"],
 StyleBox["=",
  FontSize->16],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", 
      RowBox[{" ", 
       RowBox[{"-", "4"}]}], 
      RowBox[{" ", "4"}]], 
     RowBox[{"(", 
      FractionBox[
       SuperscriptBox["y", "2"], "2"], ")"}]}], 
    SubsuperscriptBox["|", 
     RowBox[{"y", "=", "3"}], 
     RowBox[{"y", "=", 
      SqrtBox[
       RowBox[{"25", "-", 
        SuperscriptBox["x", "2"]}]]}]], 
    RowBox[{"\[DifferentialD]", "x"}]}], TraditionalForm]],
  FontSize->16,ExpressionUUID->"8372567a-1ffd-424a-84be-1c72096964e8"],
 StyleBox[" =  ",
  FontSize->16],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{" ", 
      RowBox[{"-", "4"}]}], 
     RowBox[{" ", "4"}]], 
    RowBox[{
     RowBox[{"(", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"25", "-", 
          SuperscriptBox["x", "2"]}], ")"}], " ", "-", " ", "9"}], "2"], 
      ")"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],
  FontSize->16,ExpressionUUID->"61e949c1-6bf6-4b08-98f1-a34fb418e9fd"],
 StyleBox[" =  ",
  FontSize->16],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", 
     RowBox[{" ", 
      RowBox[{"-", "4"}]}], 
     RowBox[{" ", "4"}]], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"8", "-", 
       FractionBox[
        SuperscriptBox["x", "2"], "2"]}], ")"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],
  FontSize->16,ExpressionUUID->"696ef38a-a097-4eee-8f5a-3fa0e0b599e6"],
 StyleBox[" = (8 x - ",
  FontSize->16],
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     SuperscriptBox["x", "3"], "6"], ")"}], TraditionalForm]],
  FontSize->16,ExpressionUUID->"26f8148f-227b-4104-8227-c8840c6cf4b5"],
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["|", 
    RowBox[{"x", "=", 
     RowBox[{"-", "4"}]}], 
    RowBox[{"x", "=", "4"}]], TraditionalForm]],
  FontSize->16,ExpressionUUID->"a0a308a2-f30d-4ba0-935c-9d990c5c488c"],
 StyleBox[" = ",
  FontSize->16],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"8", "*", "4"}], "-", 
      FractionBox[
       SuperscriptBox["4", "3"], "6"]}], ")"}], "-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"8", "*", 
       RowBox[{"(", 
        RowBox[{"-", "4"}], ")"}]}], "-", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"-", "4"}], ")"}], "3"], "6"]}], ")"}]}], TraditionalForm]],
  FontSize->16,ExpressionUUID->"93a370bd-35e2-4bfd-99c8-cc7d9065dcac"],
 StyleBox[" = ",
  FontSize->16],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"32", "-", 
     FractionBox["64", "6"]}], ")"}], TraditionalForm]],
  FontSize->16,ExpressionUUID->"a6cda678-9365-44fd-8f6e-7b464769d263"],
 " ",
 StyleBox["- ",
  FontSize->16],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "32"}], "-", 
     FractionBox[
      RowBox[{"-", "64"}], "6"]}], ")"}], TraditionalForm]],
  FontSize->16,ExpressionUUID->"7add9e1d-ad9e-472a-904a-4fd388522f5c"],
 " ",
 StyleBox["= ",
  FontSize->16],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{"64", "-", 
     FractionBox["128", "6"]}], ")"}], TraditionalForm]],
  FontSize->16,ExpressionUUID->"47c75822-d773-41cc-8947-50f050c61a5b"],
 " ",
 StyleBox["= ",
  FontSize->16],
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    FractionBox["128", "3"], ")"}], TraditionalForm]],
  FontSize->16,ExpressionUUID->"d65b8159-38b1-4028-b644-bdb748383175"],
 StyleBox[" .\n",
  FontSize->16],
 "La integral vale 1/6."
}], "Text",
