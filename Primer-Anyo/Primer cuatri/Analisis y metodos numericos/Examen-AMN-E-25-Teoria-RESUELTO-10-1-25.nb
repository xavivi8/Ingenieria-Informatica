Cell[TextData[{
 "Soluci\[OAcute]n:\nDado que la diferencia de grados entre numerador y \
denominador es de 2 a favor del denominador, la serie converge. Para sumar, \
descomponemos la fracci\[OAcute]n en suma de fracciones simples. Para ello \
hallamos las ra\[IAcute]ces del denominador:\n\t\t ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["n", "3"], "+", 
     RowBox[{"4", 
      SuperscriptBox["n", "2"]}], "+", 
     RowBox[{"3", "n"}]}], "=", 
    RowBox[{
     RowBox[{"n", "(", 
      RowBox[{
       SuperscriptBox["n", "2"], "+", 
       RowBox[{"4", "n"}], "+", "3"}], ")"}], "=", "0"}]}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"c78e827d-f3e2-4183-97f5-f66f698e8ce7"],
 " \[DoubleLongRightArrow] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "0"}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"e77e76a6-26c3-4874-86ff-ce7d0b582bb3"],
 " \[OAcute] ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["n", "2"], "+", 
     RowBox[{"4", "n"}], "+", "3"}], "=", "0"}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"a2ec6bf3-0d33-42d6-a1d4-42426f1eae5a"],
 " \[DoubleLongRightArrow] (Resolviendo la ecuaci\[OAcute]n de segundo grado) \
 ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "=", "0"}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"829aba1f-0998-406a-8c4b-fd2b39d13ad0"],
 " \[OAcute] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", " ", "=", " ", 
    RowBox[{"-", "1"}]}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"b6871747-0b9e-491e-a6f7-169ca388d30d"],
 " \[OAcute] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", " ", "=", " ", 
    RowBox[{"-", "3"}]}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"c73b556c-d442-47ae-8448-28c46fe77219"],
