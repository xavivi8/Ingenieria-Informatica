Cell[TextData[{
 "\n \t13.- Calcular la funci\[OAcute]n spline de grado 2 y clase 1, con \
nodos 0, 1 y 2, que interpola los datos ",
 StyleBox["f(0)=0, f(1)=0, f(2)=0, f \[OpenCurlyQuote](0) = \[Pi]",
  FontSize->18],
 ".\n\t\t"
}], "Section",
 CellChangeTimes->{{3.500751345359375*^9, 3.500751379984375*^9}, {
   3.500790035609375*^9, 3.500790048953125*^9}, {3.569509423875*^9, 
