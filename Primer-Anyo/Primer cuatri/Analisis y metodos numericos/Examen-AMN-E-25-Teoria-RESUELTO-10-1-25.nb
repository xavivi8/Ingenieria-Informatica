Cell[TextData[{
 "\n \t5.- Calcular la suma de la serie ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "1"}], "\[Infinity]"], 
    FractionBox[
     RowBox[{
      RowBox[{"6", "n"}], "+", "12"}], 
     RowBox[{
      SuperscriptBox["n", "3"], "+", 
      RowBox[{"4", 
       SuperscriptBox["n", "2"]}], "+", 
      RowBox[{"3", "n"}]}]]}], TraditionalForm]],
  FontSize->18,ExpressionUUID->"7afacb0b-57db-4eb6-9199-aa7a3e9c8deb"],
 ".\n \t"
}], "Section",
