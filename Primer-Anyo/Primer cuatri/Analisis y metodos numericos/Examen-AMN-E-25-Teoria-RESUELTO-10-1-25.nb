Cell[CellGroupData[{

Cell[TextData[{
 "\n \t14.- Utilizando el m\[EAcute]todo de Taylor de segundo orden, \
aproximar el valor de ",
 StyleBox["y(4)",
  FontSize->18,
  FontSlant->"Italic"],
 ", siendo ",
 StyleBox["y(x)",
  FontSize->18,
  FontSlant->"Italic"],
 " la soluci\[OAcute]n de la ecuaci\[OAcute]n diferencial ",
 StyleBox["y\[CloseCurlyQuote] =  y + x - 1",
  FontSize->18,
  FontSlant->"Italic"],
 "  con la condici\[OAcute]n inicial ",
 StyleBox["y(0)=1",
  FontSize->18,
  FontSlant->"Italic"],
 ". Dar dos saltos con paso ",
 StyleBox["h=2",
  FontSize->18,
  FontSlant->"Italic"],
 ".\n\t\t"
}], "Section",
