 CellLabel->"In[7]:=",ExpressionUUID->"7c429026-f9ef-4520-b8f9-1253cd4083e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"p2", "[", "x_", "]"}], ":=", " ", 
  RowBox[{"d", " ", "+", " ", 
   RowBox[{"e", " ", 
    RowBox[{"(", 
     RowBox[{"x", "-", "1"}], ")"}]}], " ", "+", " ", 
   RowBox[{"f", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "-", "1"}], ")"}], "^", "2"}]}]}]}]], "Input",
 CellChangeTimes->{{3.8978277207312365`*^9, 3.897827738900174*^9}, {
  3.945950784908356*^9, 3.9459507879517717`*^9}},
