Cell[TextData[{
 StyleBox["3.-",
  FontWeight->"Bold"],
 " Calcular la integral de la funci\[OAcute]n f(x,y)= ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "2"], "+", 
    RowBox[{"2", 
     SuperscriptBox["y", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "78dbe705-c10b-43d9-99f1-8340ac56957a"],
 " en la regi\[OAcute]n A={(x,y) \[Epsilon] ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]", "2"], TraditionalForm]],
  ExpressionUUID->"c4d82fa0-79b4-440d-9c90-b9614768d194"],
 "/ y \[GreaterEqual] 0, y \[GreaterEqual] x-2, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "72b338fc-accc-4229-8425-179dadbec01c"],
 " \[LessEqual] x}.\n\nSOLUCIONES:    ",
 StyleBox["1)",
  FontWeight->"Bold"],
