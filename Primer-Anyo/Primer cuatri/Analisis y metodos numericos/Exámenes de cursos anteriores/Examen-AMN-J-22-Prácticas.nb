  FormBox[
   SuperscriptBox["\[DoubleStruckCapitalR]", "2"], TraditionalForm]],
  ExpressionUUID->"731dfaed-d61d-422b-b5a5-148278fe344d"],
 "/ y \[GreaterEqual] 0, y \[GreaterEqual] x-2, ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["y", "2"], TraditionalForm]],ExpressionUUID->
  "a5d791e1-ccc1-4ddc-b813-b590735c9961"],
 " \[LessEqual] x}.\n\nSOLUCIONES:    ",
 StyleBox["1)",
  FontWeight->"Bold"],
 "  4.7409, ",
