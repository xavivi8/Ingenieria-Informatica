Cell[TextData[{
 StyleBox["1.- ",
  FontWeight->"Bold"],
 "Calcular los extremos relativos (m\[AAcute]ximos, m\[IAcute]nimos y puntos \
de silla) de la funci\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", 
     RowBox[{"(", 
      RowBox[{"x", ",", "y"}], ")"}]}], "=", 
    RowBox[{
     SuperscriptBox["y", "4"], "+", 
     SuperscriptBox["x", "2"], "-", 
     RowBox[{"8", 
      SuperscriptBox["y", "2"]}], "+", "4"}]}], TraditionalForm]],
  ExpressionUUID->"c0db1081-6ae7-4591-89c9-758e036f2ea5"],
 ". Se cumple que:\n1) No tiene m\[IAcute]nimos locales,            2) No \
tiene puntos de silla\t3)  En (2,0) hay un m\[AAcute]ximo local,             \
4) En (0,0) hay punto de silla,               5) En (0,2) hay un \
m\[AAcute]ximo local,\n"
}], "Text",
