Cell[TextData[{
 "Este examen puede suponer hasta 3  puntos de la nota final.\nSe puede \
utilizar calculadora, apuntes, libros, el Mathematica y \
\[OpenCurlyDoubleQuote]pendrive\[CloseCurlyDoubleQuote] con los archivos de \
pr\[AAcute]cticas y de Docencia Virtual.\nNo hay que entregar los pasos o \
razonamientos, solo elegir la respuesta correcta. ",
 StyleBox["Cada respuesta incorrecta restar\[AAcute] un cuarto de acierto.",
  FontWeight->"Bold"],
 "\nAl final se introducen las respuestas en el formulario online y se \
entrega esta hoja."
}], "Text",
 CellChangeTimes->{{3.610977073734375*^9, 3.610977077671875*^9}, {
