Cell[TextData[{
 StyleBox["5.- ",
  FontWeight->"Bold"],
 "Calcular una aproximaci\[OAcute]n de la soluci\[OAcute]n y(x), de la ecuaci\
\[OAcute]n diferencial y\[CloseCurlyQuote] =",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{"x", "+", "y"}]}], TraditionalForm]],ExpressionUUID->
  "7e2807d8-c102-4d23-ae51-7a633e80bfb2"],
