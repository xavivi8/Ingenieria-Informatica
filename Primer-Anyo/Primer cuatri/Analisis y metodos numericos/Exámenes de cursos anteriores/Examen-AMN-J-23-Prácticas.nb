Cell[TextData[{
 StyleBox["3.- ",
  FontWeight->"Bold"],
 "El conjunto de las soluciones de la ecuaci\[OAcute]n 2 < ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    SuperscriptBox["x", "2"], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x", "-", "3"}], ")"}], 
     RowBox[{"(", 
      RowBox[{"x", "+", "3"}], ")"}]}]], TraditionalForm]],ExpressionUUID->
  "9041cf49-33b6-4efb-9b7e-29d39b95f070"],
