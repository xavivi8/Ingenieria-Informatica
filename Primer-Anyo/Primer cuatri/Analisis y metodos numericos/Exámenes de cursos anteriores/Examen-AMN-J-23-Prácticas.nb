Cell[TextData[{
 StyleBox["1.- ",
  FontWeight->"Bold"],
 "Calcular los extremos relativos (m\[AAcute]ximos, m\[IAcute]nimos y puntos \
de silla) de la funci\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", 
     RowBox[{"(", 
      RowBox[{"x", ",", "y"}], ")"}]}], "=", 
    RowBox[{
     SuperscriptBox["y", "4"], "+", 
     SuperscriptBox["x", "2"], "-", 
     RowBox[{"8", 
      SuperscriptBox["y", "2"]}], "+", "4"}]}], TraditionalForm]],
  ExpressionUUID->"d9f52691-5fec-4c0e-8502-e6f55f6add1f"],
 ". Se cumple que:\n1) No tiene m\[IAcute]nimos locales,            2) No \
tiene puntos de silla\t3)  En (2,0) hay un m\[AAcute]ximo local,             \
4) En (1,0) hay punto de silla,               5) En (0,-2) hay un \
m\[IAcute]nimo local,\n"
}], "Text",
