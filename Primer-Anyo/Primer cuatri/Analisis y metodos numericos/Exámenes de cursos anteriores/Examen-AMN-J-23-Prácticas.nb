Cell[TextData[{
 StyleBox["2.- ",
  FontWeight->"Bold"],
 "Calcular el \[AAcute]rea de un toro de radio grande 5 y radio \
peque\[NTilde]o 2, sumando las \[AAcute]reas generadas al girar dos \
semicircunferencias (",
 Cell[BoxData[
  RowBox[{
   RowBox[{"f", 
    RowBox[{"(", "x", ")"}]}], "=", 
   RowBox[{"5", "+", 
    SqrtBox[
     RowBox[{"4", "-", 
      SuperscriptBox["x", "2"]}]]}]}]],
  CellChangeTimes->{3.89758133109828*^9},ExpressionUUID->
  "64abb9f4-a56a-4493-938f-9a54077dfc11"],
 " y  ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"g", 
    RowBox[{"(", "x", ")"}]}], "=", 
   RowBox[{"5", "-", 
    SqrtBox[
     RowBox[{"4", "-", 
      SuperscriptBox["x", "2"]}]]}]}]],
  CellChangeTimes->{3.89758133109828*^9},ExpressionUUID->
  "6e68a450-4703-4eaa-9034-ffcb40c16dfe"],
