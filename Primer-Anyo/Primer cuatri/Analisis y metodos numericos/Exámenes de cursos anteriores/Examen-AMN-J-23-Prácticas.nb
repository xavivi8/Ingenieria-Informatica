Cell[TextData[{
 StyleBox["5.- ",
  FontWeight->"Bold"],
 "Calcular una aproximaci\[OAcute]n de la soluci\[OAcute]n y(x), de la ecuaci\
\[OAcute]n diferencial y\[CloseCurlyQuote] = ",
 Cell[BoxData[
  FormBox[
   RowBox[{"x", "+", "y"}], TraditionalForm]],ExpressionUUID->
  "c9c631e4-0e31-4371-9ca4-6a0e18336406"],
 " con la condici\[OAcute]n y(2) = -1, en el punto 4, utilizando el \
m\[EAcute]todo de Runge-Kutta cl\[AAcute]sico con paso h=0.5.\n\tEl quinto \
decimal de la aproximaci\[OAcute]n de y(4) es: \n\n1) 0, \t\t\t2) 9, \t\t\t3) \
4, \t\t\t4) 7, \t\t\t5) 6"
}], "Text",
