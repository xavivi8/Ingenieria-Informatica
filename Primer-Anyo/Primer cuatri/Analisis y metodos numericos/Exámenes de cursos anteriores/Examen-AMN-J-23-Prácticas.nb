Cell[TextData[{
 StyleBox["2.-",
  FontWeight->"Bold"],
 " Calcular el \[AAcute]rea de un toro de radio grande 5 y radio peque\
\[NTilde]o 2, sumando las \[AAcute]reas generadas al girar dos \
semicircunferencias (",
 Cell[BoxData[
  RowBox[{
   RowBox[{"f", 
    RowBox[{"(", "x", ")"}]}], "=", 
   RowBox[{"5", "+", 
    SqrtBox[
     RowBox[{"4", "-", 
      SuperscriptBox["x", "2"]}]]}]}]],
  CellChangeTimes->{3.89758133109828*^9},ExpressionUUID->
  "b108c260-351e-441a-a4cf-ef0522620ca9"],
 " y  ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"g", 
    RowBox[{"(", "x", ")"}]}], "=", 
   RowBox[{"5", "-", 
    SqrtBox[
     RowBox[{"4", "-", 
      SuperscriptBox["x", "2"]}]]}]}]],
  CellChangeTimes->{3.89758133109828*^9},ExpressionUUID->
  "6920f52f-bc4e-4fd0-b91f-f9ca96a91a2b"],
