Cell[TextData[{
 "11.- Utilizar el m\[EAcute]todo de Newton para aproximar la \
soluci\[OAcute]n de la ecuaci\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "3"], "+", "x", "+", "1"}], "=", "0"}], 
   TraditionalForm]],ExpressionUUID->"ccf2c24a-d160-4b80-b1dc-54d850866a3b"],
