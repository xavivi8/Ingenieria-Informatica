Cell[TextData[{
 "10.- Calcular, si existe, el l\[IAcute]mite de de la funci\[OAcute]n \
f(x,y)= ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["x", "2"], " ", "-", " ", 
     SuperscriptBox["y", "2"]}], 
    RowBox[{
     SuperscriptBox["x", "2"], " ", "+", " ", 
     SuperscriptBox["y", "2"]}]], TraditionalForm]],ExpressionUUID->
  "be5d0c31-6779-49e0-a34b-d91997fd4c2e"],
 " en el infinito."
}], "Text",
