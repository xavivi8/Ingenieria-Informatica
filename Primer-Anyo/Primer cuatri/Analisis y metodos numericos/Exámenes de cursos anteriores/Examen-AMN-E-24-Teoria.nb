Cell[TextData[{
 "2.- Calcular el m\[OAcute]dulo y el argumento de  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "+", " ", 
    RowBox[{"\[ImaginaryI]", " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       FractionBox["\[Pi]", "2"], "\[ImaginaryI]"}]]}], "+", 
    RowBox[{
     SuperscriptBox["\[ImaginaryI]", "2"], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       FractionBox["\[Pi]", "2"], 
       SuperscriptBox["\[ImaginaryI]", "2"]}]]}], "+", 
    RowBox[{
     SuperscriptBox["\[ImaginaryI]", "3"], " ", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       FractionBox["\[Pi]", "2"], 
       SuperscriptBox["\[ImaginaryI]", "3"]}]]}]}], TraditionalForm]],
  ExpressionUUID->"09e1499b-456a-4537-b3db-9cf647913f6d"],
