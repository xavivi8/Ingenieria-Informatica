Cell[TextData[{
 "8.- Calcular los extremos absolutos (m\[AAcute]ximos y m\[IAcute]nimos) de \
la funci\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", 
     RowBox[{"(", 
      RowBox[{"x", ",", "y"}], ")"}]}], "=", 
    RowBox[{
     RowBox[{"2", "x"}], "-", 
     RowBox[{"2", "y"}], "+", "7"}]}], TraditionalForm]],ExpressionUUID->
  "24ddeca5-593d-4e90-8588-cbc58ebb3469"],
 " en el conjunto de puntos que cumplen ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SuperscriptBox["x", "2"], "+", 
    SuperscriptBox["y", "2"]}], "=", "8"}]],ExpressionUUID->
  "3e12aa1c-a538-4e83-879d-80e23efe5587"],
 "."
