Cell[TextData[{
 "7.- Calcular los extremos relativos (m\[AAcute]ximos, m\[IAcute]nimos y \
puntos de silla) de la funci\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", 
     RowBox[{"(", 
      RowBox[{"x", ",", "y"}], ")"}]}], "=", 
    RowBox[{
     SuperscriptBox["x", "2"], "-", 
     RowBox[{"4", "x"}], "+", 
     RowBox[{"2", "x", " ", "y"}], "-", 
     SuperscriptBox["y", "2"], "-", 
     RowBox[{"2", "y"}], "+", "1"}]}], TraditionalForm]],ExpressionUUID->
  "da36fbbf-4ad6-4ae6-b317-bb74427baa8e"],
 "."
}], "Text",
