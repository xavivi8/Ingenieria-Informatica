Cell[TextData[{
 "5.- Estudiar si la serie ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "1"}], "\[Infinity]"], 
    RowBox[{"(", 
     FractionBox[
      SqrtBox[
       RowBox[{"n", "+", "1"}]], 
      RowBox[{"n", "(", 
       RowBox[{"n", "+", "2"}], ")"}]], ")"}]}], TraditionalForm]],
  ExpressionUUID->"73c7a307-a1f9-427a-9535-16b74688d927"],
 " se puede sumar. Para ello, calcular, si existe, la integral impropia ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "1", "\[Infinity]"], 
    RowBox[{
     SuperscriptBox["x", 
      RowBox[{
       RowBox[{"-", "3"}], "/", "2"}]], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "35a2c241-c637-46e6-a987-5cdd45917a15"],
 " y comparar la serie dada con la serie ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"n", "=", "1"}], "\[Infinity]"], 
    SuperscriptBox["n", 
     RowBox[{
      RowBox[{"-", "3"}], "/", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "7c5a2289-603c-47ad-b85f-d846b2e2be8e"],
 "."
}], "Text",
