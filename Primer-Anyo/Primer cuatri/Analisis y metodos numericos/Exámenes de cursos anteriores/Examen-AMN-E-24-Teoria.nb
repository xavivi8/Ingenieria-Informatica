 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "3"], "+", "x", "+", "1"}], TraditionalForm]],
  ExpressionUUID->"32f91075-f36d-4141-8e1f-764f582f906d"],
 "."
}], "Text",
