Cell[TextData[{
 "Este examen supone entre 6 y 10 puntos de la nota final.\nNo se puede \
utilizar calculadora, s\[OAcute]lo bol\[IAcute]grafo y papel.\nEs fundamental \
que los ",
 StyleBox["razonamientos sean correctos",
  FontWeight->"Bold"],
 " y que los resultados sean correctos ",
 StyleBox["cuando se puedan comprobar",
  FontWeight->"Bold"],
 " y, si esto no es posible, que al menos los ",
 StyleBox["resultados no sean absurdos.",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.610977073734375*^9, 3.610977077671875*^9}, {
   3.610977304453125*^9, 3.610977405828125*^9}, 3.6109946063489404`*^9, {
   3.610996437542557*^9, 3.6109964489149766`*^9}, 3.6424768970883904`*^9, 
   3.64541096253166*^9, {3.662402489289149*^9, 3.662402550060625*^9}, {
   3.724512051184802*^9, 3.7245120605916023`*^9}, {3.7245121063620024`*^9, 
