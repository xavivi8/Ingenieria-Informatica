Cell[TextData[{
 "10.- Estudiar los intervalos de el crecimiento de la funci\[OAcute]n f(x) = \
",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["x", "3"], "+", 
    RowBox[{"2", "x"}], "+", "1"}], TraditionalForm]],ExpressionUUID->
  "5425182a-b4ad-42f4-ba82-8c57477dcd5f"],
 ". \[DownQuestion]Cu\[AAcute]ntos ceros tiene? Evaluarla en -1 y 1. Aplicar \
el m\[EAcute]todo de bisecci\[OAcute]n 2 veces partiendo del intervalo [-1,1]."
}], "Text",
 CellChangeTimes->{{3.610967983265625*^9, 3.610968082640625*^9}, {
