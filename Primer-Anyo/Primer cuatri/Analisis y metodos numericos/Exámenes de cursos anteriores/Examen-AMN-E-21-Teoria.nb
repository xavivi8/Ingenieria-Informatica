Cell[TextData[{
 "11.- Sabemos que la integral ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubsuperscriptBox["\[Integral]", "0", "4"], 
     RowBox[{
      FractionBox["1", 
       RowBox[{"x", "+", "1"}]], 
      RowBox[{"\[DifferentialD]", "x"}]}]}], "=", 
    RowBox[{"log", " ", "5"}]}], TraditionalForm]],ExpressionUUID->
  "47029432-b563-451f-9c19-23da7d1c2bc2"],
 ", aproximar la integral por el m\[EAcute]todo del punto medio compuesta, \
considerando dos intervalos, y obtener una fracci\[OAcute]n que aproxime log \
5."
}], "Text",
 CellChangeTimes->{{3.610967983265625*^9, 3.610968082640625*^9}, {
