Cell[TextData[{
 "4.- Realizar cuatro iteraciones por el m\[EAcute]todo de Newton para \
aproximar la soluci\[OAcute]n de la ecuaci\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["x", "3"], TraditionalForm]],ExpressionUUID->
  "560c3478-fc1f-42eb-8457-8baf954c8455"],
 "+ 3x + cos x -2=0 partiendo de ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "1041a3df-2993-4ec1-9998-634a088e79d8"],
 "=0. El valor de ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "4"], TraditionalForm]],ExpressionUUID->
  "349b4bbe-9c71-496e-866a-c172cf5306a2"],
 " con 10 cifras decimales es: \n\n\n1) 0.3393167250, 2) 0.4988619908, 3) \
0.5652441238, 4) 0.6443318729, 5) 0.8575419966"
}], "Text",
