Cell[TextData[{
 "5.- La aproximaci\[OAcute]n de la integral de ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "1"], 
    RowBox[{
     FractionBox["1", 
      RowBox[{"1", "+", 
       RowBox[{"2", "x"}], "+", 
       RowBox[{"2", 
