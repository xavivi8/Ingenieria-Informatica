 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "0"], TraditionalForm]],ExpressionUUID->
  "29ea3f67-688a-4297-a186-0437ec01f1e9"],
 "=0. El valor de ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "4"], TraditionalForm]],ExpressionUUID->
  "75a8227c-634b-4224-8d5d-da7d1b7a3932"],
 " con 10 cifras decimales es: \n\n\n1) 0.3393167250, 2) 0.4988619908, 3) \
0.5652441238, 4) 0.6443318729, 5) 0.8575419966"
}], "Text",
