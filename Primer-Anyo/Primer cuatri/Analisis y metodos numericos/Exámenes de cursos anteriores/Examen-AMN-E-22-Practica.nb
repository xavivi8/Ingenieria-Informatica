Cell[TextData[{
 "1.- El l\[IAcute]mite de la sucesi\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    FractionBox[
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox["1", "3"], " ", "+", " ", 
        SuperscriptBox["2", "3"], " ", "+", " ", 
        SuperscriptBox["3", "3"], " ", "+"}], " ", "..."}], " ", "+", " ", 
      SuperscriptBox["n", "3"]}], 
     RowBox[{
      RowBox[{"2", 
