Cell[TextData[{
 "12.- Aproximar el valor de la integral ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "1", "5"], 
    RowBox[{
     FractionBox["1", 
      FormBox["x",
       TraditionalForm]], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],
  FontSize->16,ExpressionUUID->"a4ec2b19-7c49-49db-a958-71601eebf76a"],
 " (que es ",
 StyleBox["Log 5",
  FontSlant->"Italic"],
 ") utilizando la f\[OAcute]rmula de Simpson compuesta considerando dos \
intervalos de igual longitud y aplicando la f\[OAcute]rmula de Simpson simple \
en cada uno de ellos."
}], "Text",
