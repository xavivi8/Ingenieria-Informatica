Cell[TextData[{
 "7.- Calcular, si existe, el l\[IAcute]mite de la funci\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", 
     RowBox[{"(", 
      RowBox[{"x", ",", "y"}], ")"}]}], "=", " ", 
    StyleBox[
     RowBox[{"cos", "(", 
      FractionBox[
       RowBox[{"x", " ", "y", " ", 
        RowBox[{"(", 
         RowBox[{"x", "+", "y"}], ")"}]}], 
       RowBox[{
        SuperscriptBox["x", "2"], 
        StyleBox["+",
         FontSlant->"Italic"], 
        SuperscriptBox["y", "2"]}]], ")"}],
     FontSize->18]}], TraditionalForm]],
  FontSize->16,ExpressionUUID->"da36fbbf-4ad6-4ae6-b317-bb74427baa8e"],
 StyleBox[" ",
  FontSize->16],
 "en el punto (0,0)."
}], "Text",
