Cell[TextData[{
 "1.- Razonar cu\[AAcute]l de los siguientes n\[UAcute]meros es racional y \
expresarlo como cociente de dos n\[UAcute]meros enteros:\n",
 StyleBox["0,010101010101... = ",
  FontSize->16],
 Cell[BoxData[
  FormBox[
   StyleBox[
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"n", "=", "1"}], "\[Infinity]"], 
