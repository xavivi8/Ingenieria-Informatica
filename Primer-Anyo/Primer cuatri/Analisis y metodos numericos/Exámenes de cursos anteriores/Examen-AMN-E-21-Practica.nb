Cell[TextData[{
 "5.- La aproximaci\[OAcute]n de la integral de ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "1"], 
    RowBox[{
     FractionBox["1", 
      RowBox[{"1", "+", 
       RowBox[{"2", 
        SuperscriptBox["x", "2"]}]}]], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "2b106397-8277-441d-bf2f-c6398359ed96"],
 " utilizando la f\[OAcute]rmula de Simpson compuesta haciendo 10 trozos en \
el intervalo [0,1] es: \n\n\n\n\n1) 0.67551081752318, 2) 0.67551081757654, 3) \
0.67551081751321, 4) 0.67551081756955, 5) 0.67551081752162"
