Cell[TextData[{
 "8.- Calcular los extremos relativos (m\[AAcute]ximos, m\[IAcute]nimos y \
puntos de silla) de la funci\[OAcute]n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"f", 
     RowBox[{"(", 
      RowBox[{"x", ",", "y"}], ")"}]}], "=", 
    RowBox[{
     SuperscriptBox[
      RowBox[{
       SuperscriptBox["x", "2"], "(", 
       RowBox[{"x", "-", "2"}], ")"}], "2"], "+", " ", 
     SuperscriptBox["y", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "1338845f-ae50-4c75-a617-dcd325d52547"],
