Cell[TextData[{
 "4.- Aproximar el valor de la integral ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "0", "1"], 
    RowBox[{
     FractionBox["x", 
      RowBox[{"1", "+", "x", "+", 
       RowBox[{"2", 
        SuperscriptBox["x", "2"]}]}]], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "ba27b459-3afa-412f-b85f-701d5abf94b1"],
 " utilizando la f\[OAcute]rmula\n\t\t\t\t\t",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "a", "b"], 
    RowBox[{
     RowBox[{"f", "(", "x", ")"}], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "9ea28fca-9a30-4efa-a3bd-d9b93bfcc853"],
 "\[TildeEqual]  ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     RowBox[{"f", "(", "a", ")"}], "+", 
     RowBox[{"3", " ", 
      RowBox[{"f", "(", 
       FractionBox[
        RowBox[{
         RowBox[{"2", "a"}], "+", "b"}], "3"], ")"}]}], "+", 
     RowBox[{"3", 
      RowBox[{"f", "(", 
       FractionBox[
        RowBox[{"a", "+", 
         RowBox[{"2", "b"}]}], "3"], ")"}]}], "+", 
     RowBox[{"f", "(", "b", ")"}]}], "8"], TraditionalForm]],ExpressionUUID->
  "9ca1a48e-5c47-4866-96a1-9a223181cc65"],
 " (b-a)\ncompuesta partiendo en 20 trozos iguales el intervalo [0,1]. El s\
\[EAcute]ptimo decimal de la aproximaci\[OAcute]n es: \n1) 6, \t\t\t2) 2, \t\t\
\t3) 4, \t\t\t4) 7, \t\t\t5) 8"
}], "Text",
