  FormBox[
   RowBox[{
    RowBox[{"f", 
     RowBox[{"(", 
      RowBox[{"x", ",", "y"}], ")"}]}], "=", 
    RowBox[{"x", "-", 
     RowBox[{"2", "y"}], "+", "7"}]}], TraditionalForm]],ExpressionUUID->
  "24ddeca5-593d-4e90-8588-cbc58ebb3469"],
