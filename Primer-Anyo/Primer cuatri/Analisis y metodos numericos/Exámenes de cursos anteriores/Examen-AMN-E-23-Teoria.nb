Cell[TextData[{
 "12.- Aproximar el valor de la integral ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubsuperscriptBox["\[Integral]", "1", "4"], 
    RowBox[{
     FractionBox["1", 
      FormBox["x",
       TraditionalForm]], 
     RowBox[{"\[DifferentialD]", "x"}]}]}], TraditionalForm]],ExpressionUUID->
  "b8d1a563-61e3-4d1d-aadb-cd222c9c4c94"],
 " (que es ",
 StyleBox["Log 4",
  FontSlant->"Italic"],
 ") utilizando la f\[OAcute]rmula del trapecio compuesta, considerando tres \
subintervalos de igual longitud y aplicando la f\[OAcute]rmula del trapecio \
en cada uno de ellos."
}], "Text",
