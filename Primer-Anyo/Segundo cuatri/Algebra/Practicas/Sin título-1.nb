 RowBox[{
  RowBox[{
   RowBox[{"Euclides2", "[", "m_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", ",", "q", ",", "d"}], "}"}], ",", 
     RowBox[{
